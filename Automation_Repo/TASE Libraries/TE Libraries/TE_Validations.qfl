'***********************************************************************************
'Name of the Function   : 'Verify_WinRadioButton_State(p_radioButtonName, p_State, p_parentName)
'Author		     						:
'Description		    		 : Activate TE Window
'     Input Parameters     :p_checkboxName, p_State,  p_parentName
'p_checkboxName : 
'p_State : 
'p_parentName :
'Creation Date : 
'***********************************************************************************
'Verify_WinRadioButton_State(p_checkboxName, p_State,  p_parentName)
Public Function Verify_WinRadioButton_State(p_checkboxName, p_State,  p_parentName)
    If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Verify_WinRadioButton_State"
       SelectWinTab = "Verify_WinCheckBox_State"
       strStepName = "TE Window Menu Interaction with Menu Item :" & p_menuItem & "."
       on error resume next
       err.clear
       If  p_radioButtonName <>""Then
           Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" & p_parentName)
	       Set OBJ = ObjectFactory("WinRadioButton", ParentObject, "regexpwndtitle:=" & p_radioButtonName)
		   If not OBJ Is Nothing then
			  TempValue = OBJ.GetROProperty ("checked")
			  If  UCase(TempValue) <>  UCase(p_State) Then
			     Call ReporterFunction(strLibraryFileName,"Verify_WinRadioButton_State","2","Verify Win Radiobutton :","The expected given value: " & UCase(p_State) & " for RadioButton: [" & p_radioButtonName &  "] is not the same as the current value: " &TempValue)
                 strStatus = "FAILED"
                 strMsg = "Verify Win Radiobutton : The expected given value: " & UCase(p_State) & " for RadioButton: [" & p_radioButtonName &  "] is not the same as the current value: " &TempValue        
              Else 
                 Call ReporterFunction(strLibraryFileName,"Verify_WinRadioButton_State","2","Verify Win Radiobutton :","The expected given value: " & UCase(p_State) & " for RadioButton: [" & p_radioButtonName &  "] is the same as the current value: " &TempValue)
                 strStatus = "PASSED"
                 strMsg = "Verify Win Radiobutton : The expected given value: " & UCase(p_State) & " for RadioButton: [" & p_radioButtonName &  "] is the same as the current value: " &TempValue
                 blnCaptureFlag = True
                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                    ImagePath=CaptureScreenshot(strStepName,ParentObject,True,True,True)
                 End If                
              End if
           Else
              Call ReporterFunction(strLibraryFileName,"Verify_WinRadioButton_State","2","Verify Win Radiobutton :","The radiobutton " & p_radioButtonName & " has NOT been found.")	
              strStatus = "FAILED"
              strMsg = "Verify Win Radiobutton : The radiobutton " & p_radioButtonName & " has NOT been found."  
           End If
       Else
          Call ReporterFunction(strLibraryFileName,"Verify_WinRadioButton_State","2","Verify Win Radiobutton :","The radiobutton name is empty.")	
          strStatus = "FAILED"
          strMsg = "Verify Win Radiobutton : The radiobutton name is empty."  
       End If          
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		Verify_WinRadioButton_State = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		Verify_WinRadioButton_State = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If	
End function

'Name of the Function   : 'Verify_WinEdit_Text (p_editField, p_Text,p_parentName)
'Author		     						:
'Description		    		 : Activate TE Window
'     Input Parameters     :p_checkboxName, p_Text,  p_parentName
'p_checkboxName : 
'p_Text : 
'p_parentName :
'Creation Date : 
'***********************************************************************************
'Verify_WinEdit_Text (p_editField, p_Text,p_parentName)
Public Function Verify_WinEdit_Text (p_editField, p_Text,p_parentName)
    If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Verify_WinEdit_Text"
       SelectWinTab = "Verify_WinEdit_Text"
       strStepName = "TE Window Menu Interaction with Menu Item :" & p_menuItem & "."
       on error resume next
       err.clear
       If p_editField <> "" Then
          Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" & p_parentName)
	      Set OBJ = ObjectFactory("WinEdit", ParentObject, "attached text:=" & p_editField )
		  If not OBJ Is Nothing then
			 TempValue = OBJ.GetROProperty ("text")
			 If  TempValue <>  p_Text Then
			     Call ReporterFunction(strLibraryFileName,"Verify_WinEdit_Text","2","Verify WinEdit :","The expected given value: " & p_Text & " for the WinEdit Field: [" & p_editField &  "] is not the same as the current value: " &TempValue)
                 strStatus = "FAILED"
                 strMsg = "Verify WinEdit : The expected given value: " & p_Text & " for the WinEdit Field: [" & p_editField &  "] is not the same as the current value: " &TempValue        
             Else 
                 Call ReporterFunction(strLibraryFileName,"Verify_WinEdit_Text","2","Verify WinEdit :","The expected given value: " & p_Text & " for the WinEdit Field: [" & p_editField &  "] is the same as the current value: " &TempValue)
                 strStatus = "PASSED"
                 strMsg = "Verify WinEdit : The expected given value: " & p_Text & " for the WinEdit Field: [" & p_editField &  "] is the same as the current value: " &TempValue
                 blnCaptureFlag = True
                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                    ImagePath=CaptureScreenshot(strStepName,ParentObject,True,True,True)
                 End If                
             End if
           Else
              Call ReporterFunction(strLibraryFileName,"Verify_WinEdit_Text","2","Verify WinEdit :","The WinEdit " & p_editField & " has NOT been found.")	
              strStatus = "FAILED"
              strMsg = "Verify WinEdit : The WinEdit " & p_editField & " has NOT been found."  
           End If
       Else
          Call ReporterFunction(strLibraryFileName,"Verify_WinEdit_Text","2","Verify WinEdit :","The WinEdit name is empty.")	
          strStatus = "FAILED"
          strMsg = "Verify Win Radiobutton : The WinEdit name is empty."  
       End If          
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		Verify_WinEdit_Text = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		Verify_WinEdit_Text = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If	
End function


'***********************************************************************************
'Name of the Function   : 'Verify_WinComboBox (p_comboBoxName,p_WndId, p_Value,p_parentName)
'Author		     						:
'Description		    		 : Activate TE Window
'     Input Parameters     :p_comboBoxName, p_Text,  p_parentName,p_WndId
'p_comboBoxName : 
'p_Text : 
'p_parentName :
'p_WndId : 
'Creation Date : 
'***********************************************************************************
'Verify_WinComboBox (p_comboBoxName,p_WndId, p_Value,p_parentName)
Public Function Verify_WinComboBox (p_comboBoxName,p_WndId, p_Value,p_parentName)
    If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Verify_WinComboBox"
       SelectWinTab = "Verify_WinComboBox"
       strStepName = "TE Window Menu Interaction with Menu Item :" & p_menuItem & "."
       on error resume next
       err.clear
       If p_WndId <> "" Then
          Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" &p_parentName)
	      Set OBJ = ObjectFactory("WinComboBox", ParentObject, "window id:=" & p_WndId )
	      If not OBJ Is Nothing then
			 TempValue = OBJ.GetROProperty("text")
	         If  TempValue <>  p_Value Then
			     Call ReporterFunction(strLibraryFileName,"Verify_WinComboBox","2","Verify WinCombo :","The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is not the same as the current value: " &TempValue)
                 strStatus = "FAILED"
                 strMsg = "Verify WinCombo : The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is not the same as the current value: " &TempValue        
             Else 
                 Call ReporterFunction(strLibraryFileName,"Verify_WinComboBox","2","Verify WinCombo :","The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is the same as the current value: " &TempValue)
                 strStatus = "PASSED"
                 strMsg = "Verify WinCombo : The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is the same as the current value: " &TempValue
                 blnCaptureFlag = True
                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                    ImagePath=CaptureScreenshot(strStepName,ParentObject,True,True,True)
                 End If                
             End if
           Else
              Call ReporterFunction(strLibraryFileName,"Verify_WinComboBox","2","Verify WinCombo :","The WinCombo " & p_comboBoxName & " has NOT been found.")	
              strStatus = "FAILED"
              strMsg = "Verify WinCombo : The WinCombo " & p_comboBoxName & " has NOT been found."  
           End If
       Else
          Call ReporterFunction(strLibraryFileName,"Verify_WinComboBox","2","Verify WinCombo :","The WinCombo name is empty.")	
          strStatus = "FAILED"
          strMsg = "Verify WinCombo : The WinCombo name is empty."  
       End If          
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		Verify_WinComboBox = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		Verify_WinComboBox = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If	
End function
