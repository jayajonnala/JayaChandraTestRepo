  ''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : ConvertDate
'Author		     :
'Description		     : Converts date into proper text format that is accepted by system(ex: 31052020)
'Input Parameters	     :  DtDate,DtDate_Increment
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function ConvertDate
'**********************************************************************************
  Public Function ConvertDateTxt(DtDate,DtDate_Increment)
    DtDate_New=FormatDateTime(DateAdd("d",DtDate_Increment,DtDate),0)
	If IsDate(DtDate_New) Then
			NewDate= ConvertDoubledigit(CSTR(Day(DtDate_New))) +""+ConvertDoubledigit( Cstr(Month(DtDate_New))) + ""+ Cstr(Year(DtDate_New))
  			ConvertDateTxt = NewDate
	Else
			DateVal=Cstr(DtDate)
			ConvertDateTxt =Left(DtDate,2) +""+ Mid(DtDate,4,2)+ ""+Right(DtDate,4)
	End If
  
  End Function
  Public Function ConvertDateTxtYYYY(DtDate)
'  DtDate=Cdate(DtDate)
	If IsDate(DtDate) Then
			NewDate=  Cstr(Year(DtDate)) +""+ConvertDoubledigit( Cstr(Month(DtDate))) + ""+ ConvertDoubledigit(CSTR(Day(DtDate)))
  			ConvertDateTxtYYYY = NewDate
	Else
			DateVal=Cstr(DtDate)
			ConvertDateTxt =Left(DtDate,2) +""+ Mid(DtDate,4,2)+ ""+Right(DtDate,4)
	End If
  
  End Function  
  'Name of the Function   : CaptureScreenshot_Mainframe(p_TEWindowShortName_Value) 
'Author		     						:
'Description		    		 : Capture Screenshot of Mainframe Application.
'     Input Parameters     : p_TEWindowShortName_Value,resultstring
'p_TEWindowShortName_Value : Short Name and Value of Class Name (Ex:short name:=A)
'Creation Date : 
'***********************************************************************************
'Function CaptureScreenshot_Mainframe(p_TEWindowShortName_Value) 
Public Function CaptureScreenshot_Mainframe(p_TEWindowShortName_Value) 
	If Not (Environment.Value("blnFatalError")) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CaptureScreenshot_Mainframe"
	       strStepName = "Capture the Screen"
		   Set ParentObject = TeWindow("short name:=" & p_TEWindowShortName_Value,"index:=0")
		   'Set ParentObject = ObjectFactory("TeWindow", Nothing, "short name:="& p_TEWindowShortName_Value)
    	'Window("hwnd:="& cstr(browserProperty)).Activate
'		ImagePath =CaptureSAPObject(ParentObject)
				blnCaptureFlag = True
     			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		           ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
		       End If
    	
    	strStatus = "DONE"
    	strMsg = "Mainframe Application Screenshot Captured."
    	Call ReporterFunction(strLibraryFileName,"CaptureScreenshot_Mainframe","2",strStepName,strMsg)
    	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	 End If
	End If
End Function
'***********************************************************************************
'Name of the Function   : CloseAllMainframeSessions(p_TEWindowShortName_Value)
'Author		     						:
'Description		    		 : Close AllMainframeSessions 
'p_TEWindowShortName_Value : Short Name and Value of Class Name (Ex:short name:=A)
'     Input Parameters     : p_TEWindowName,p_TEWindowShortName_Value,strTextDialog,strTextDialogButton
'strTextDialog : Text field value of the Dialog screen.(Ex: PC5250)
'strTextDialogButton : Text field value of the Dialog screen WinButton(Ex : &No)
'Creation Date : 
'***********************************************************************************
'Function CloseAllMainframeSessions(p_TEWindowShortName_Value)
'***********************************************************************************
Public Function CloseAllMainframeSessions(p_TEWindowShortName_Value,strTextDialog,strTextDialogButton)

  If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseSessionsSAP"
       strFuncName = "CloseAllMainframeSessions"
       strStepName = "Close_All_Existing_Mainframe_Application"
       on error resume next
       err.clear
'       If err.number<>0 Then
	Do  
		   Closed = False
		   Set ParentObject = TeWindow("short name:=" & p_TEWindowShortName_Value,"index:=0")
		   Set OBJ = ParentObject.TeScreen("label:=.*","index:=0")
		   'Set ParentObject = ObjectFactory("TeWindow", Nothing, "short name:=" & p_TEWindowShortName_Value)
		   'Set OBJ = ObjectFactory("TeScreen", ParentObject, "label:=.*")
		   If  not OBJ Is Nothing then
		       OBJ.highlight
		       'ImagePath =CaptureSAPObject_Doc(OBJ,False)
'		       blnCaptureFlag = True
'		       If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'                  ImagePath=CaptureScreenshot(strStepName,OBJ,True,False,False)' Taking the snapshot of the complete window        
'               End If
                Window("nativeclass:=PCSWS.*").Close
                If Dialog("text:=" & strTextDialog).WinButton("text:=" & strTextDialogButton).Exist(5) Then
                   Call CloseDialogPopUpScreen(strTextDialog,strTextDialogButton)
                End If
                If Window("nativeclass:=PCSWS.*").Exist(5) Then
                   Closed = False
                Else 
                   Closed = True
                End If                
  				
                'Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,"Values Used:"& vbNewLine &" TEWindowName:TEWindow"&vbNewLine&" TEScreenName:TEScreen")        			   
           End If 
     Loop Until Closed = True
   strStatus = "DONE" 
   strMsg=" All Existing Mainframe Application Window Closed Successfully."
'   blnCaptureFlag = True
'   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'      Set objWindow = Window("text:=Program Manager")
'      ImagePath=CaptureScreenshot(strStepName,objWindow,True,False,False)' Taking the snapshot of the complete window       
'   End If
'   If blnDefault_eSwiftReporting Then  
'      Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
'   End If
 'End If 
End If 
End Function   
'************************************************************************************
'End Function - CloseAllMainframeSessions
'************************************************************************************
'Name of the Function   : Launch_Mainframe(p_profile,p_TEWindowShortName_Value,strTextDialog,strTextDialogButton)
'Author     :
'Description     : Launch into Mainframe Application
'       p_profile    :-valid profile
'Input Parameters     : p_profile,p_TEWindowShortName_Value
'Output Parameters      :Null
'Creation Date : 
'Modified By : 
'Modified  Date: 
'***********************************************************************************
'Function Launch_Mainframe(p_profile,p_TEWindowShortName_Value,strTextDialog,strTextDialogButton)
'***********************************************************************************
Public Function Launch_Mainframe(p_profile,p_TEWindowShortName_Value,strTextDialog,strTextDialogButton)
  Call CloseAllMainframeSessions(p_TEWindowShortName_Value,strTextDialog,"&No")
  If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Launch_Mainframe"
       strFuncName = "Launch_Mainframe"
       strStepName = "Launching GOLD/Artemis Application."
       p_Input= "Emulator : pcsws.exe"&" and Profile : "&p_profile&""
       on error resume next
       err.clear
          Dim LocalShell
          Set LocalShell = CreateObject("WScript.Shell")
	'LocalShell.Run """C:\Program Files\IBM\Personal Communications\pcsws.exe """ & """S:\SAPTAORTL\TE Libraries\ARTEMIS Profile\GRAS4.WS"""
	   LocalShell.Run """C:\Program Files (x86)\IBM\Client Access\Emulator\pcsws.exe """ & "" & chr(34) & p_profile & chr(34) & ""
	   wait 60
     End If
      If Dialog("text:=" & strTextDialog).WinButton("text:=OK").Exist(5) Then
         Dialog("text:=" & strTextDialog).WinButton("text:=OK").Click
         wait 2
      End If 
        Call CloseDialogPopUpScreen(strTextDialog,strTextDialogButton)
        If Dialog("text:=Open WorkStation Profile").Exist(5) Then
           Dialog("text:=Open WorkStation Profile").WinButton("text:=Open").Click
           Wait 10          
        End If
         If Dialog("text:=" & strTextDialog).WinButton("text:=OK").Exist(5) Then
            Dialog("text:=" & strTextDialog).WinButton("text:=OK").Click
            wait 2
         End If
     'End If 
    strStatus = "DONE"
    strMsg = "The Application Launched Successfully."
    If blnDefault_eSwiftReporting Then  
	   Call UpdateResultHtml(strStepName,p_Input,strMsg,strStatus,"")
	End If     
End Function

'================ End of Function===================

'**********************************************************************************
'Name of the Function   : Login_Mainframe
'Author     :
'Description     : Login into Mainframe Application
'       p_userName :- valid username
'       p_password :-valid Password
'       p_TEWindowShortName_Value : ShortName Value of TEWindow (Ex: "A")
'Input Parameters     : p_password,p_password,p_TEWindowShortName_Value
'Output Parameters      :Null
'Creation Date : 
'Modified By : 
'Modified  Date: 
'***********************************************************************************
'Function Login_Mainframe(p_TEWindowShortName_Value,p_userName,p_password)
'***********************************************************************************
Public Function Login_Mainframe(p_TEWindowShortName_Value,p_userName,p_password)

   Call SetTEField(p_TEWindowShortName_Value,"User",p_userName)
   Call SetTEField(p_TEWindowShortName_Value,"Password",p_password)
End Function
