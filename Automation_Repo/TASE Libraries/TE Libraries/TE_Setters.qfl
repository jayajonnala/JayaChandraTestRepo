             End If
           Else 
                Call ReporterFunction(strLibraryFileName,"GetROPropery_WinRadioButton","2","Get WinRadiobutton Property :","The radiobutton " & p_radioButtonName & " has NOT been found.")
                strStatus = "FAILED"
                strMsg = "Get WinRadiobutton Property : The radiobutton " & p_radioButtonName & " has NOT been found"                   
            End if
          Else
             Call ReporterFunction(strLibraryFileName,"GetROPropery_WinRadioButton","2","Get WinRadiobutton Property :","The radiobutton name is empty.")	
             strStatus = "FAILED"
             strMsg = "Get WinRadiobutton Property : The radiobutton name is empty."  
          End If 
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		GetROProperty_WinCheckBox = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		GetROProperty_WinCheckBox = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If		
End function

'***********************************************************************************

'Name of the Function   : 'Set_WinEdit (p_editField, p_Text,p_parentName)
'Author		     						:
'Description		    		 : Set the value for WinEdit field
'     Input Parameters     :p_editField, p_Text,p_parentName
'p_editField : 
'p_Text :
'p_parentName :
'Creation Date : 
'***********************************************************************************
'GetROPropery_WinRadioButton (p_radioButtonName, p_Property, p_dtColumn, p_parentName)
Public function Set_WinEdit (p_editField, p_Text,p_parentName)
   If p_editFIeld <> "" Then
   
	Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" & p_parentName)
	Set OBJ = ObjectFactory("WinEdit", ParentObject, "attached text:=" & p_editField & ";regexpwndclass:=Edit")
		If not OBJ Is Nothing then
			OBJ.set (p_Text)
			wait(3)
			TempValue = OBJ.GetROProperty("text")
	            If  TempValue <>  p_Text Then
					createEventMessage "FAILED","Verify WinEdit Set","Set WinEdit","The Edit Field " & p_editField & " has NOT been set to the value " & p_Text,""
					'Msgbox  "The expected given value: " & p_Text & " for the WinEdit: [" & p_editField &  "] is not the same as the current value: " &TempValue & " WindEdit is not set Correct."
				Else
					createEventMessage "INFO","Verify WinEdit Set","Set WinEdit","The Edit Field " & p_editField & " has been set to the value " & p_Text,""
					'Msgbox  "The expected given value: " & p_Text & " for the WinEdit: [" & p_editField &  "] is the same as the current value: " &TempValue 
				End If
		Else
			createEventMessage "FAILED","Set WinEdit","Set WinEdit","The WinEdit " & p_editField & " has NOT been found",""
		End if	

		Else
			createEventMessage "FAILED","Set WinEdit","Set WinEdit","The WinEdit name is empty ",""
		End If
end function

'***********************************************************************************


'Name of the Function   : 'GetROProperty_WinEdit (p_editField, p_property, p_dtColumn,p_parentName)
'Author		     						:
'Description		    		 : Activate TE Window
'     Input Parameters     :p_editField, p_parentName,p_Property, p_dtColumn
'p_editField : 
'p_parentName :
'p_Property :
'p_dtColumn :
'Creation Date : 
'***********************************************************************************
'GetROProperty_WinEdit (p_editField, p_property, p_dtColumn,p_parentName)
Public Function GetROProperty_WinEdit (p_editField, p_property, p_dtColumn,p_parentName)
    If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetROProperty_WinEdit"
       SelectWinTab = "GetROProperty_WinEdit"
       strStepName = "TE Window Menu Interaction with Menu Item :" & p_menuItem & "."
       on error resume next
       err.clear
	   If  p_radioButtonName <> ""Then
           Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" & p_parentName)
	       Set OBJ = ObjectFactory("WinRadioButton", ParentObject, "regexpwndtitle:=" & p_radioButtonName)
		   If not OBJ Is Nothing then
			 TempValue = OBJ.GetROProperty (p_Property)
			 Call ReporterFunction(strLibraryFileName,"GetROProperty_WinEdit","2","Get WinEdit Property :","The property " & p_Property & " had the following value " & TempValue & ".")
             strStatus = "DONE"
             strMsg = "Get WinEdit Property : The property " & p_Property & " had the following value " & TempValue & "."
             'DDL_DATASOURCE.setParameter p_dtColumn,Value..........................Need to Check
             Call ReporterFunction(strLibraryFileName,"GetROProperty_WinEdit","2","Get WinEdit Property :","The value: " & TempValue & " was written to the DataTable Field: " & p_dtColumn)
             strStatus = "DONE"
             strMsg = "Get WinEdit Property : The value: " & TempValue & " was written to the DataTable Field: " & p_dtColumn      
             blnCaptureFlag = True
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                ImagePath=CaptureScreenshot(strStepName,ParentObject,True,True,True)
             End If
           Else 
                Call ReporterFunction(strLibraryFileName,"GetROProperty_WinEdit","2","Get WinEdit Property :","The WinEdit " & p_editField & " has NOT been found.")
                strStatus = "FAILED"
                strMsg = "Get WinEdit Property : The WinEdit " & p_editField & " has NOT been found."                   
            End if
          Else
             Call ReporterFunction(strLibraryFileName,"GetROProperty_WinEdit","2","Get WinEdit Property :","The WinEdit name is empty.")	
             strStatus = "FAILED"
             strMsg = "Get WinEdit Property : The WinEdit name is empty."  
          End If 
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		GetROProperty_WinEdit = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		GetROProperty_WinEdit = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If		
End function


Public function Set_WinComboBox (p_comboBoxName, p_Value,p_WndId,p_parentName)
   If p_WndId <> "" Then
   
	Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" &p_parentName)
	Set OBJ = ObjectFactory("WinComboBox", ParentObject, "window id:=" & p_WndId )
		If not OBJ Is Nothing then
			OBJ.Select (p_Value)
			ParentObject.click
			wait (3)
			TempValue = OBJ.GetROProperty("text")
	            If  TempValue <>  p_Value Then
					createEventMessage "FAILED","Verify WinCombo Set","Set WinCombo","The Combobox " & p_comboBoxName & " has NOT been set to the value " & p_Value,""
					'msgbox  "The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is not the same as the current value: " & TempValue & " WinComboBox is not set correct."
				Else
					createEventMessage "INFO","Verify WinCombo Set","Set WinCombo","The Combobox " & p_comboBoxName & " has been set to the value " & p_Value,""
					'Msgbox  "The expected given value: " & p_Value & " for the WinComboBox: [" & p_comboBoxName &  "] is the same as the current value: " & TempValue 
				End If
		Else
			createEventMessage "FAILED","Set WinCombo","Set WinCombo","The WinCombo " & p_comboBoxName & " has NOT been found",""
		End if	

		Else
			createEventMessage "FAILED","Set WinCombo","Set WinCombo","The WinCombo name is empty" ,""
		End If
end function
