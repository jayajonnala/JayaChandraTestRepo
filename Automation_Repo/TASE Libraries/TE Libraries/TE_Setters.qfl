    If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetROProperty_WinCheckBox"
       SelectWinTab = "GetROProperty_WinCheckBox"
       strStepName = "TE Window Menu Interaction with Menu Item :" & p_menuItem & "."
       on error resume next
       err.clear
	   If p_checkboxName <> "" Then
	      Set ParentObject = ObjectFactory("Dialog", Nothing, "regexpwndtitle:=" & p_parentName)
	      Set OBJ = ObjectFactory("WinCheckBox", ParentObject, "regexpwndtitle:=" & p_checkboxName)
		  If not OBJ Is Nothing then
			 Value = OBJ.GetROProperty (p_Property)
			 Call ReporterFunction(strLibraryFileName,"GetROProperty_WinCheckBox","2","Get WinCheckbox Property :","The property " & p_Property & " had the following value " & Value & ".")
             strStatus = "DONE"
             strMsg = "Get WinCheckbox Property : The property " & p_Property & " had the following value " & Value & "."
             'DDL_DATASOURCE.setParameter p_dtColumn,Value..........................Need to Check
             Call ReporterFunction(strLibraryFileName,"GetROProperty_WinCheckBox","2","Get WinCheckbox Property :","The value: " & Value & " was written to the DataTable Field: " & p_dtColumn)
             strStatus = "DONE"
             strMsg = "Get WinCheckbox Property : The value: " & Value & " was written to the DataTable Field: " & p_dtColumn         
             blnCaptureFlag = True
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                ImagePath=CaptureScreenshot(strStepName,ParentObject,True,True,True)
             End If
           Else 
                Call ReporterFunction(strLibraryFileName,"GetROProperty_WinCheckBox","2","Get WinCheckbox Property :","The WinCheckbox " & p_checkboxName & " has NOT been found.")
                strStatus = "FAILED"
                strMsg = "Get WinCheckbox Property : The WinCheckbox " & p_checkboxName & " has NOT been found"                   
            End if
          Else
             Call ReporterFunction(strLibraryFileName,"GetROProperty_WinCheckBox","2","Get WinCheckbox Property ::","The WinCheckbox name is emptya.")	
             strStatus = "FAILED"
             strMsg = "Get WinCheckbox Property : The WinCheckbox name is empty."  
          End If 
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
		GetROProperty_WinCheckBox = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,ParentObject,True,False,False)
	Else
		GetROProperty_WinCheckBox = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If	
 End If		
End function
