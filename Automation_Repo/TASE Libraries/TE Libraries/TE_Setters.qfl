          End If
       Else
          Call ReporterFunction(strLibraryFileName,"Set_WinRadioButton","2","Set Win Radiobutton :","The radiobutton name is empty.")	
          strStatus = "FAILED"
          strMsg = "Set Win Radiobutton : The radiobutton name is empty."  
       End If          
      
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	If strStatus = "FAIL"  Then
