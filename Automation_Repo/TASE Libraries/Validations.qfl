''**********************************************************************************
'Name of the Function   :  VerifyGridCellContentbyName
'Author		     : Ritu
'Description		     : Verifies the contents of cell of a Gui Grid which is present in a normal window .
'                                     gridName: Name of the grid found by object spy
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked  
'                                     gridIndex: Index of the grid  
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 08/05/2012
'***********************************************************************************
'Function  VerifyGridCellContentbyName(gridName,gridRowNumber,gridColumnName,gridIndex,expectedValue)
'***********************************************************************************
Public Function VerifyGridCellContentbyName(gridName,gridRowNumber,gridColumnName,gridIndex,expectedValue)
 
 If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyGridCellContentbyName"
	strStepName = " Verify  Content " & "'"  & expectedValue & "'"  & " in column: " & "'"  & gridColumnName & "'"  & " in GuiGrid"
If gridRowNumber<>"" or  gridColumnName <> "" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","name:="&gridName,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 
'strStepName = " Verify  Content " & "'"  & expectedValue & "'"  & " in GuiGrid"
			If objGuiGrid.Exist then
					   On Error Resume Next
					    strCellValueFetched = objGuiGrid.GetCellData(gridRowNumber,gridColumnName)
						 
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentbyName","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
                              strMsg = " Actual value in the Grid cell  : " & strCellValueFetched & " matches  with the expected value:  " & expectedValue & "" 
                              blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
		            	  		End If
						 Else
						
							  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentbyName","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  strMsg = " Actual value in the Grid cell : " & strCellValueFetched & " did not match with the expected value: " & expectedValue & ""
							 
						 End If
						 
						
						If Err.Number=-2147220983 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentbyName","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg = " Column not found in the Gui Grid"
										  
						End If
						
			Else 
					   Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentbyName","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentbyName","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContentbyName-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyGridCellContentbyName-- Function Call"
End If


If strStatus = "FAIL"  Then
		VerifyGridCellContentbyName = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		VerifyGridCellContentbyName = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If
End function

'************************************************************************************
'End Function -   VerifyGridCellContentbyName
'************************************************************************************


