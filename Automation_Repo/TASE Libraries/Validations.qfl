'**************************************************************************************************************
'Name of the Function   :  VerifyCellStatus
'Author		     : Nikhil
'Date 			: 18/ Nov/2011	
'Description		     :  This function verifies whether a cell in Table or Grid is Editable or not
'                                       
'Input Parameters	     :  ObjToBeVerified :-  object of GuiTable/GuiGrid that is to be verified
'											  strRowNumber :- Row Number of the Cell    			                          		
' 											 strColumnName :- Column name of the Cell
'                                     		
'Output Parameters        : Null
'
' Example					:     VerifyCellStatus(obj,rowNum,columnName)  
'															
'**************************************************************************************************************
'Function VerifyCellStatus(objToBeVerified,strRowNumber,strColumnName)
'**************************************************************************************************************

Public Function VerifyCellStatus(objToBeVerified,strRowNumber,strColumnName)

	Dim blnCellStatus

	blnCellStatus = objToBeVerified.IsCellEditable(strRowNumber,strColumnName)
	
	If blnCellStatus Then
		VerifyCellStatus = True
		
	Else
		VerifyCellStatus = False
		
	End If

End Function
'**************************************************************************************************************
' End Function VerifyCellStatus(objToBeVerified,strRowNumber,strColumnName)
'**************************************************************************************************************

'**********************************************************************************
'Name of the Function   :  VerfiyContentInTable
'Author		     : Madhurima
'Description		     : Verifies if the cell data is present in the table or not and then selects the cell if present.
'			                           tableName :- Name property of the table
'                                     columnName:-Column in which the cell has to be found 
'                                     expectedValue:-the cell data to be searched
'Input Parameters	     :  tableName,columnName,expectedValue
'Output Parameters        :Null
'Creation Date : 27/12/2011
'***********************************************************************************
'Function VerfiyContentInTable(tableName,columnName,expectedValue)
'***********************************************************************************
Public Function VerifyContentInTable(tableName,columnName,expectedValue)

  If Not (Environment.Value("blnFatalError") or textboxValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyContentInTable"
	strStepName = "Verify if  " & expectedValue & " exists in Table"
 Flag=0
 If  tableName<>"" and columnName<>""  and expectedValue<>"" Then
  
   
  Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
  If  objTable.Exist Then
	  noOfRows=objTable.GetROProperty("rowcount")
	  For i=1 to noOfRows
		  On Error Resume Next
          fetchedCellValue=objTable.GetCellData(i,columnName)
          'msgbox Err.Number
         If Err.Number=-2147220983 Then
					Call ReporterFunction(strLibraryFileName,"VerifyContentInTable","1","Table Data Field","Column Not Found. Check the --columnName--Parameter of--VerfiyContentInTable-- Function Call")
					strMsg = "Column Not Found. Check the --columnName--Parameter of --VerifyContentInTable-- Function Call"
					strStatus = "FAIL"
					'blnObjectError=True
					 Flag=1
					Exit For
					
		  End If
		  Err.Clear
		  If INSTR(1,fetchedCellValue,expectedValue,1)<>0 Then
              objTable.SelectCell i,columnName
			    Call StoreExcel(i,"ID_rowIndex")
			  Call ReporterFunction(strLibraryFileName,"VerifyContentInTable","2","Table Cell","Table Cell is found")
		     strMsg = "Actual Value "&fetchedCellValue&" is equal to the expected value : " & expectedValue
		      strStatus = "Pass"
			  Flag=1
			   blnCaptureFlag = True
			              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
		            	  End If
			  Exit For
		  End If
	  Next
	  If Flag=0 Then
          Call ReporterFunction(strLibraryFileName,"VerifyContentInTable","1","Table Cell","Table Cell is not found")
		      strMsg = "Table Cell is not found.Please verify the screen."
		      strStatus = "FAIL"
		     
	  End If
  Else
		Call ReporterFunction(strLibraryFileName,"VerifyContentInTable","1","Table Data Field","Table Object Missing")
		strMsg = "Table Not Found- Please Check the Screen"
		strStatus = "FAIL"
		blnObjectError=True
End If
Else
	Call ReporterFunction(strLibraryFileName,"VerifyContentInTable","1","Table Data Field","Parameters Not Passed Properly.Check the--VerfiyContentInTable--Function Call")
	strMsg = "Paramaters Not Passed Properly.Check the--VerfiyContentInTable--Function Call"
	strStatus = "FAIL"
End If

   
	If strStatus = "FAIL"  Then
		VerifyContentInTable = strMsg
		blnMainFailFlag = True
		 ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	Else
		VerifyContentInTable = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTable=Nothing
End If
End Function
'************************************************************************************
'End Function - VerfiyContentInTable
'************************************************************************************


'**********************************************************************************
'Name of the Function   :  VerifyTextAreaValue
'Author		     :  Ritu
'Description		     : Verifies Text in a  TextArea having gui component type as 203 in a normal window (gui component type as 21)
'                                     expectedValue:- Value to be verified   
'Input Parameters	     :  expectedValue
'Output Parameters        :
'Creation Date : 02/01/2011
'***********************************************************************************
'Function VerifyTextAreaValue(expectedValue)
'***********************************************************************************
Public Function VerifyTextAreaValue(expectedValue)

 If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextAreaValue"
	strStepName = " Verify " & "'" & expectedValue & "'" & " in Text Area"
	
  Set objTextArea = SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiTextArea("guicomponenttype:=203","name:=shell")
   If objTextArea.Exist then
		     textBoxtype= objTextArea.getROProperty("type")
			 
             
	         strTextAreaText =objTextArea.GetROProperty("value")
               If UCASE(expectedValue)=UCASE(strTextAreaText) Then
							 Call ReporterFunction(strLibraryFileName,"VerifyTextAreaValue","2","TextArea","Expected Value :-"&expectedValue&"   Matched With Contents of Text Area ")
							  strStatus = "PASS"
							  strMsg = "Actual Value of the Text Area: "&strTextAreaText&" matches with the Expected Value: "&expectedValue&""
							  blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
		            	  End If
							   
					 Else
						     Call ReporterFunction(strLibraryFileName,"VerifyTextAreaValue","1","TextArea","Expected Value :-"&expectedValue &"   did not Match  With Contents of Text Area" )
						      strMsg="Actual Value of the Text Area: "&strTextAreaText&" does not match with the Expected Value: "&expectedValue& "	"
						      strStatus = "FAIL"
						      
					End If
			Else 
			   Call ReporterFunction(strLibraryFileName,"VerifyTextAreaValue","1","Text Area","TextArea Object Missing")
			   strStatus = "FAIL"
			   strMsg = "TextArea Object Missing"
			   blnObjectError=True
			End If

If strStatus = "FAIL"  Then
		VerifyTextAreaValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
	Else
		VerifyTextAreaValue = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
			
			
			
 Set objTextArea=Nothing
 
End If
End function
'************************************************************************************
'End Function - VerifyTextAreaValue
'***************************************************************************************


'**************************************************************************************************************
'Name of the Function   :  VerifyComboBoxValue
'Author		     : Nikhil
'Date 			: 2/ Jan/2012	
'Description		     :  This function verifies whether a cell in Table or Grid is Editable or not                                      
'Input Parameters	     :  comboAttachedText :-  attachedtext property of combo box as seen in object spy
'										     expectedValue :- value which is to be compared with runtime value                                  		
'Output Parameters        : Null
' Example					:     VerifyComboBoxValue(comboAttachedText ,expectedValue)  														
'**************************************************************************************************************
'Function VerifyComboBoxValue(comboAttachedText ,expectedValue)
'**************************************************************************************************************
Public Function VerifyComboBoxValue(comboAttachedText ,expectedValue)
	
	If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyComboBoxValue"
	
	Dim objCombo 
	strStepName = "Verify Combo Box Value "
	If comboAttachedText <>"" Then

		''objCombo = SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiComboBox("guicomponenttype:=34","attachedtext:="&comboAttachedText)

		Set objCombo = SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiComboBox("guicomponenttype:=34","attachedtext:="&comboAttachedText)
		If objCombo.Exist Then
			runtimeComboValue = objCombo.GetROProperty("selecteditem")
			If UCASE(expectedValue)= UCASE(runtimeComboValue)Then
				Call ReporterFunction(strLibraryFileName,"VerifyComboBoxValue","0"," Combo Box ","Actual Value of the Combo Box is equal to the Expected Value")
                strStatus="PASS"
			    strMsg = "Actual Value of the Combo Box: "&runtimeComboValue&" is equal to the Expected Value:  "&expectedValue&""
			    blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objCombo,False,False,False)
		            	  End If
							   
				
			Else
				Call ReporterFunction(strLibraryFileName,"VerifyComboBoxValue","1"," Combo Box ","Actual Value of the Combo Box is not equal to the Expected Value")
                strStatus="FAIL"
			    strMsg = "Actual Value of the Combo Box: "&runtimeComboValue&" is not equal to the Expected Value:  "&expectedValue&""
				
			End If
		Else 
			Call ReporterFunction(strLibraryFileName,"VerifyComboBoxValue","1"," Combo Box ","Combo Box Not Found. Please Verify the Screen")
            strStatus="FAIL"
			strMsg = "Combo Box Not Found. Please Verify the Screen"
			blnObjectError=True
		
		End If
	Else
		Call ReporterFunction(strLibraryFileName,"VerifyComboBoxValue","1","Check Box","Function Parameter Not Passed Properly. Check the --VerifyComboBoxValue-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --VerifyComboBoxValue-- Function Call--"	
	End If
	
	
	
	If strStatus = "FAIL"  Then
		VerifyComboBoxValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objCombo,False,False,False)
	Else
		VerifyComboBoxValue = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
	Set objCombo = Nothing
End If
End Function 
'**************************************************************************************************************
'End Function - VerifyComboBoxValue(comboAttachedText ,expectedValue)
'**************************************************************************************************************

''**********************************************************************************
'Name of the Function   :  VerifyGridCellContent
'Author		     : Ritu
'Description		     : Verifies the contents of cell of a Gui Grid which is present in a normal window .
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 08/05/2012
'***********************************************************************************
'Function  VerifyGridCellContent(gridRowNumber,gridColumnName,gridTitle,expectedValue)
'***********************************************************************************
Public Function VerifyGridCellContent(gridTitle,gridRowNumber,gridColumnName,gridIndex,expectedValue)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyGridCellContent"
	strStepName = " Verify  Content " & "'" & expectedValue & "'"  & " in GuiGrid"

If gridRowNumber<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
						 strCellValueFetched = objGuiGrid.GetCellData(gridRowNumber,gridColumnName)
						 
						 		
						
						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
                              End If
                              
                            
           	
							
						 Else
							  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
							  strMsg =  " Actual value in the Grid cell  :  "  & strCellValueFetched &   "  does not match with the expected value:    "   &  expectedValue & ""
							  
							  End If
							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						 End If
							 
			Else 	   Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContent-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyGridCellContent-- Function Call"
End If

If strStatus = "FAIL"  Then
		VerifyGridCellContent = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		VerifyGridCellContent = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   VerifyGridCellContent
'************************************************************************************


