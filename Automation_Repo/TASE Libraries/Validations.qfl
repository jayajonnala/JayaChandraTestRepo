'********************************************************************************
'Name of the Function   : VerifyColumnGuiGrid
'Description		     : Verify if a column exists in GuiGrid
'Input Parameters	     :  ColumnName
'											gridIndex	
'											gridName
'Creation Date : 21/11/2012

'***********************************************************************************
'Function VerifyColumnGuiGrid(gridName,gridIndex,columnName)
'***********************************************************************************

Public Function VerifyColumnGuiGrid(gridName,gridIndex,columnName)
	
	If Not (Environment.Value("blnFatalError") or columnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyColumnGuiGrid"
	
	strStepName = "Verify if a column-  "& columnName& " exists in GuiGrid"
	If  columnName <> "" then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGridGui = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGridGui.Exist  Then
				On Error Resume Next
			objGridGui.SelectColumn columnName
				If Err.Number = 0 Then
        			  strStatus = "PASS"
					  strMsg = "Grid contains the Column: "& columnName
					   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
		            	  		End If
					  
                ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"VerifyColumnGuiGrid","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					strStatus = "FAIL" 
					strMsg =  "Column: "& columnName&" Not Found Within Gui Grid . Please Verify Screen"
					
					Err.Clear
			   end if
		  Else
							Call ReporterFunction(strLibraryFileName,"VerifyColumnGuiGrid","1","Gui Grid","Grid Object Not Found. Check the --VerifyColumnGuiGrid-- Function Call")
							strStatus = "FAIL" 
							strMsg = "Grid Object Not Found. Check the --VerifyColumnGuiGrid-- Function Call"
							blnObjectError=True
							
				End If
        	Else
		Call ReporterFunction(strLibraryFileName,"VerifyColumnGuiGrid","1","Gui Grid","Function Parameter Not Passed Properly. Check the --VerifyColumnGuiGrid-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --VerifyColumnGuiGrid-- Function Call"
	End If
	
	If strStatus = "FAIL"  Then
		VerifyColumnGuiGrid = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
	
	Else
		VerifyColumnGuiGrid = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,columnName,strMsg,strStatus,"")
	End If
	End If
	Set objGridGuiGuiComp80=Nothing
	Set objGridGuiComp201=Nothing
	Set objGrid=Nothing
End Function
'******************************************************************************************
'End Function VerifyColumnGuiGrid(gridName,gridIndex,columnName)
'******************************************************************************************

''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : CheckifGuiLabelExists
'Author		     : Sudha Arepalli
'Description		     : checks if Gui Label exists and returns a boolean value
'Input Parameters	     :  Content to be verfied
'Output Parameters        : Boolean value
'Creation Date : 09/05/2012
'***********************************************************************************
'Function CheckifGuiLabelExists(Content)
'***********************************************************************************

Function CheckifGuiLabelExists(Content)
 
   If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CheckifGuiLabelExists"
	
	strStepName = "Check if Gui Label exists "

    If Content <>"" Then
	
     set   objLabel = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiLabel("content:="&Content,"guicomponenttype:=30")
               If objLabel.Exist Then
					Call ReporterFunction(strLibraryFileName,"CheckifGuiLabelExists","2",Content,"Gui Label with value "&Content &" exists in the screen")	
					strMsg = "Gui Label with value "&Content&" exists in the screen"	
					CheckifGuiLabelExists=true
					strStatus = "PASS"
					blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
		            	  		End If
						 Else
					strStatus = "FAIL" 
					Call ReporterFunction(strLibraryFileName,"CheckifGuiLabelExists","1"," Status bar Content","Gui Label with value "&Content &" doesn't exist  in the screen")	
					strMsg = "Gui Label with value "&Content&" doesn't exist  in the screen"
					CheckifGuiLabelExists=false
					blnObjectError=True
				End If
       	Else
    	Call ReporterFunction(strLibraryFileName,"CheckifGuiLabelExists","1","Gui Label","Function Parameter Not Passed Properly. Check the --CheckifGuiLabelExists-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --CheckifGuiLabelExists-- Function Call-"
	End If
	


If strStatus = "FAIL"  Then
		CheckifGuiLabelExists = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
		
	Else
		CheckifGuiLabelExists = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
	
End If
End Function


''**************************************************************************************************************************************************************************************
'End Function - CheckifGuiLabelExists
'*************************************************************************************************************************************************************************************


Public Function VerifyTableCellContentByRefForArgos(tableName,refColumnName,refCellValue,TableColumnName,expectedValue)

    If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTableCellContentByRefForArgos"
	
If refColumnName<>"" or  TableColumnName <> "" or  tableName<>"" or refCellValue <>"" Then
Set objGuiTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
strStepName = " Verify  Content " & "'"  & expectedValue & "'"  & " in GuiTable"
			If objGuiTable.Exist then
					   On Error Resume Next
					   strRowNum=objGuiTable.FindRowByCellContent(refColumnName,refCellValue)
						If Err.Number = 0 Then
							strRowVal=objGuiTable.GetCellData(strRowNum,TableColumnName)
							strCellValueFetched = objGuiTable.GetCellData (strRowNum,TableColumnName)
							If Err.Number=-2147220983 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","1","Column in Gui Table"," column Name : "&TableColumnName&"  does not exist in"& vbNewLine&" Gui Table with name   "&tableName )
'										  strStatus = "FAIL"
										  
										  'Exit Function
							End If
							If UCASE(expectedValue)=UCASE(strCellValueFetched) or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in "& vbNewLine&"Gui Table with Title"&tableName )
									strStatus = "PASS"
									strMsg = " Actual value in the Table cell  : " & strCellValueFetched & " matches  with the expected value: "&expectedValue&""
									blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
		            	  End If
							Else
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in"& vbNewLine&" Gui Table with Title"&tableName )
									'strStatus = "FAIL"
									strMsg = " Actual value in the Table cell : " & strCellValueFetched & " did not match with the expected value: "&expectedValue&""
									
							End If
						Elseif  Err.Number = -2147220983 Then	' Verifies whether column is present in the Table
							Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","1","Gui Table","Column Not Found Within Gui Table . Please Verify The Screen")
							'strStatus="FAIL"
							strMsg =  "Column Not Found Within Gui Table . Please Verify Screen"
							Err.Clear
						end if
						 
			Else 
					   Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","1","Gui Table","Gui Table Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Table Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRefForArgos","1","Cell in Gui Table","Function Parameter Not Passed Properly. Check the -- VerifyTableCellContentByRefForArgos-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyTableCellContentByRefForArgos-- Function Call"
End If

If strStatus <> "PASS"  Then
'		VerifyTableCellContentByRefForArgos = False
		VerifyTableCellContentByRefForArgos = strMsg
		'blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
	Else
		VerifyTableCellContentByRefForArgos = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiTable=Nothing
End If
End function


Public Function VerifyEmptyTextBoxContent(textboxAttachedText,textboxName,textboxIndex,expectedValue,blnIsItPopup)





If Not (Environment.Value("blnFatalError")) Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyEmptyTextBoxContent"
    
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = " Verify Content of TextBox"
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If textboxName<> "" OR textboxAttachedText<>"" OR textboxIndex<>"" Then
         If objTextbox.Exist then
                      textboxValue = objTextbox.getROProperty("value")
                      If expectedValue=UCASE(textboxValue) or expectedValue=LCASE(textboxValue) or INSTR(1,textboxValue,expectedValue,1)<>null  Then
                          Call ReporterFunction(strLibraryFileName,"VerifyEmptyTextBoxContent","2","TextBox","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of Text Box")
                          strStatus = "PASS"
                          strMsg = "Actual Value of the TextBox : " &textboxValue & "   is equal to the Expected Value: " &expectedValue&" "
                            blnCaptureFlag = True
                          If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                          ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
                          End If
                         
                      Else
                          Call ReporterFunction(strLibraryFileName,"VerifyEmptyTextBoxContent","1","TextBox","Supplied Value :-"&expectedValue &"  "& vbNewLine&"     didnot Match  with Contents of Text Box" )
                          strStatus = "FAIL"
                          strMsg = "Actual Text Box Value : " &textboxValue & "  does not match with the expected Value: " &expectedValue&" "
                          
                     End If
         else
               'strStepName = "TextBox: " &textboxAttachedText& "  -No Such Object Found"
               Call ReporterFunction(strLibraryFileName,"VerifyEmptyTextBoxContent","1","Text Box","Text Box Object Missing")
               strStatus = "FAIL"
               strMsg = "Text Box Object Missing"
               blnObjectError=True
         End If
else
        Call ReporterFunction(strLibraryFileName,"VerifyEmptyTextBoxContent","1","TextBox","Function Parameter Not Passed Properly. Check the --VerifyEmptyTextBoxContent-- Function Call")
       strStatus="FAIL"
       strMsg = "Function Parameter Not Passed Properly. Check the --VerifyEmptyTextBoxContent-- Function Call"
End If
     
If  blnObjectError  Then
        Environment.Value("blnFatalError")=True
    End If





  If strStatus = "FAIL"  Then
        VerifyEmptyTextBoxContent = strMsg
        blnMainFailFlag = True
        ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
    Else
        VerifyEmptyTextBoxContent = True
    End If
    If blnDefault_eSwiftReporting Then  
    
        Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
    End If
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
Set objWindow=Nothing
End If
End function


Public Function IfTabExists(tabStripName,tabName,blnIsItPopup)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : IfTabExists"
	Dim objTabStrip,objWindow
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName = "Verify if tab exist: " & tabName 
	If tabStripName <> "" and tabName <> "" Then
     	Set objTabStrip1 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTabStrip(guiTab,"name:="&tabStripName)
		Set objTabStrip2 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTabStrip("name:="&tabStripName) 'to identify child tabstrips
		Set objTabStrip = SetObj(objTabStrip1,objTabStrip2)
		If  objTabStrip.Exist   Then
			strAllItems = objTabStrip.GetROProperty("allitems")
			strAllItems = ";"&strAllItems
			strTabNameAppended =";"&tabName&";" 
			If instr(1,strAllItems,strTabNameAppended,1) Then
				''objTabStrip.Select tabName
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTabStrip,False,False,True)
	          End if
				Call ReporterFunction(strLibraryFileName,"IfTabExists","2","Tab Field","Tab Exists :-"& vbNewLine &" Tab Name : "&tabName)
				strStatus="DONE"
				strMsg="Tab Exists"
			Else
				'Call ReporterFunction(strLibraryFileName,"IfTabExists","1","Tab Field","Tab Not Found Within The Tab Strip . Please Verify --IfTabExists-- Function Call")
				strStatus = "FAIL"
				strMsg = " Tab Not Found Within The Tab Strip. Please Verify --IfTabExists-- Function Call"
				'blnObjectError=True	
			End If
		Else 
			'Call ReporterFunction(strLibraryFileName,"IfTabExists","1","Tab Field","Tab Strip Not Found. Please Verify --IfTabExists-- Function Call")
			strStatus = "FAIL"
			 strMsg = " Tab Strip Not Found. Please Verify --IfTabExists-- Function Call"
			 'blnObjectError=True
		End If
	Else 
		'Call ReporterFunction(strLibraryFileName,"IfTabExists","1","Tab Field","Function Parameter Not Passed Properly. Check the --IfTabExists-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --IfTabExists-- Function Call"
	End If	
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    IfTabExists = strMsg
'		    blnMainFailFlag = True
'		    ImagePath=CaptureScreenshot(strStepName,objTabStrip,False,False,True)
	   Else
		    IfTabExists = True
	   End If
	strStatus="DONE"
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
	Set objTabStrip = nothing

Set objTabStrip=Nothing
Set objWindow=Nothing
End If
End Function

Public Function IfTableCellContentExists(tableRowNumber,tableColumnName,tableName,expectedValue)

If Not (Environment.Value("blnFatalError") or tableColumnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : IfTableCellContentExists"
    strStepName = " Verify  Content in   " & tableColumnName & "  column in Gui Table"
	
If tableRowNumber<>"" and tableColumnName <> "" and tableName<>"" Then
			Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
			
			If objTable.Exist then					  
			            
					    strMsg= "Table cell content verified successfully"
					    
	
					   On Error Resume Next
						 strCellValueFetched = objTable.GetCellData (tableRowNumber,tableColumnName)
						If Err.Number=-2147220983 Then
						
										  'Call ReporterFunction(strLibraryFileName,"IfTableCellContentExists","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in "& vbNewLine&"Gui Table with name"&tableName )
										  'strStatus = "FAIL"
										
									     Exit Function
						End If
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>null Then
							 Call ReporterFunction(strLibraryFileName,"IfTableCellContentExists","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in "& vbNewLine&"Gui Table with name"&tableName )
							  strStatus = "PASS"
                              strMsg = " Actual value: "&strCellValueFetched&" in the table cell matches  with the expected value: "&expectedValue&""
                              blnCaptureFlag = True
			                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		                     ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
		                     End If
						 Else
							  'Call ReporterFunction(strLibraryFileName,"IfTableCellContentExists","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in"& vbNewLine&" Gui Table with name"&tableName )
							  'strStatus = "FAIL"
							  strMsg = " Actual value: "&strCellValueFetched&" in the table cell did not match with the expected value: "&expectedValue&""
							  
						 End If
			Else 
					   'Call ReporterFunction(strLibraryFileName,"IfTableCellContentExists","1","Gui Table","Gui Table Object Missing")
					   'strStatus = "FAIL"
					   strMsg = " Gui table Object Missing"
					   blnObjectError=True
			End If
Else
      'Call ReporterFunction(strLibraryFileName,"IfTableCellContentExists","1","Cell in Gui Table","Function Parameter Not Passed Properly. Check the -- IfTableCellContentExists-- Function Call")
	  'strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - IfTableCellContentExists-- Function Call"
End If

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
strStatus = "PASS"
	If strStatus = "FAIL"  Then
		IfTableCellContentExists = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	Else
		IfTableCellContentExists = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTable=Nothing
End If
End function


Function VerifyStatusBarConditon(Content)
 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyStatusBarConditon"
	
	strStepName = "Verify Status Bar "
	Set objStatusBar=SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar)
    objStatusBarText = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar).GetROProperty("text")
	CompareType="CONTAIN"
    If Content <>"" Then
		Select Case UCASE(CompareType)
			   Case "CONTAIN"
				If instr(1, UCASE(objStatusBarText), UCASE(Content), vbTextCompare) Then
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBarConditon","2"," Status bar Content","Actual Value is equal to the Expected Value")	
				strStatus = "PASS"
				strMsg = "Actual Value: " & "'" & objStatusBarText & "'" & " is equal to the Expected Value : " & "'" & Content& "'" &  " "
				blnCaptureFlag = True				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'		   			ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
				End If 
				
				Else
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBarConditon","2"," Status bar Content","Actual Value is not equal to the Expected Value ")	
				strStatus = "Done"
				blndefectFlag =True
				strMsg = "Actual Value: " & objStatusBarText & "  is not equal to the Expected Value: " & "'" & Content& "'" &  " "	
				End If
		End Select
	Else
    	Call ReporterFunction(strLibraryFileName,"VerifyStatusBarConditon","2","StatusBar","Function Parameter Not Passed Properly. Check the --VerifyStatusBarConditon-- Function Call")
			strStatus = "Done" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyStatusBarConditon-- Function Call"
	End if
	
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "Done"  Then
		VerifyStatusBarConditon = strMsg
		blnMainFailFlag = True
'		ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
	Else
		VerifyStatusBarConditon = True
	End If
	If blnDefault_eSwiftReporting Then  
'		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
	  ' //////////Word Document ///////////
		'	If bDocFlag= 1 Then
			'	Check=CheckStatus_Doc(status)
			'	If Check=1 Then
			'		imageDocPath=CaptureSAPObject_Doc(SAPWindowObject)
			'		Call StoreSteps(strStepName)
			'		Call storeCoordinates(objStatusBar)
			'		call drawShapeImage(imageDocPath)
             '       Call InsertImage(imageDocPath)
			'		Call InsertStepsDoc()
			'		oDicSteps.RemoveAll
			'	End If
			' End If
			    ' //////////Word Document ///////////
	Set objStatusBar=Nothing
	End If
End Function
''**********************************************************************************
'Name of the Function   :  IfGuiGridExists
'Author		     : 
'Description		     : Verifies the GuiGrid is present in the SAP Screen .
'			                      'gridTitle:- Title of the Gui grid         
'                                            gridIndex - Index of the Gui Grid                                    
'Input Parameters	     :  gridTitle,gridIndex
'Output Parameters        : Null
'Creation Date :
'***********************************************************************************
'Function  IfGuiGridExists(gridTitle,gridIndex)
'***********************************************************************************
Public Function IfGuiGridExists(gridTitle,gridIndex)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : IfGuiGridExists"
	strStepName = " Verify  GuiGrid " & "'" & gridTitle & "'"  & " Exists"

If  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"IfGuiGridExists","1","Gui Grid"," Grid Title : "&gridTitle)
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						            End If
							 
			Else 	   Call ReporterFunction(strLibraryFileName,"IfGuiGridExists","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"IfGuiGridExists","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContent-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - IfGuiGridExists-- Function Call"
End If

If strStatus = "FAIL"  Then
		IfGuiGridExists = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		IfGuiGridExists = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   IfGuiGridExists
'************************************************************************************
Public Function VerifyGridMultiCellContent(gridTitle,gridNoOfRows,gridColumnName,gridIndex,expectedValue)
  Dim Iterator
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyGridMultiCellContent"
	strStepName = " Verify  Content " & "'" & expectedValue & "'"  & " in All GuiGrid"

If gridNoOfRows<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
				 For Iterator = 1 To gridNoOfRows
							
						     strCellValueFetched = objGuiGrid.GetCellData(Iterator,gridColumnName)
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
						      If Iterator >= gridNoOfRows Then
						          Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							   strStatus = "PASS"
							   strMsg = " Actual value in All the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							   blnCaptureFlag = True
			              	                  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		               ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
                                                        End If
                                                 Exit For    
						      End If                  
                                             Else
							  Call ReporterFunction(strLibraryFileName,"VerifyGridMultiCellContent","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
							  strMsg =  " Actual value in the Grid cell  :  "  & strCellValueFetched &   "  does not match with the expected value:    "   &  expectedValue & ""
	                                    Exit For
	                                      End If
	                                   Next
	                                   							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridMultiCellContent","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						 End If
							 
			Else 	   Call ReporterFunction(strLibraryFileName,"VerifyGridMultiCellContent","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyGridMultiCellContent","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridMultiCellContent-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyGridMultiCellContent-- Function Call"
End If

If strStatus = "FAIL"  Then
		VerifyGridMultiCellContent = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		VerifyGridMultiCellContent = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   VerifyGridMultiCellContent
'************************************************************************************


'******************************************************************************************************
'Name of the Function   : VerifyIfGuiTreeExist
'Description		     : Verify Existance of Gui Tree
'Input Parameters	     :  treeIndex - Index of the tree in which the item is present
'										
'Output Parameters        : 
'******************************************************************************************************
'Function VerifyIfGuiTreeExist(treeIndex)
'******************************************************************************************************
Public Function VerifyIfGuiTreeExist(treeIndex)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyIfGuiTreeExist"
	   strStepName="Validate that the Gui Tree Index: "  & itemText &  " Exists"
If treeIndex <>"" Then

Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
			  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
Call ReporterFunction(strLibraryFileName,"VerifyIfGuiTreeExist","2"," Activate Item in GuiTree","Item Activated:- "&itemText)
strStatus = "DONE"
strMsg="Validated successfully that Gui Tree exists."
else
		Call ReporterFunction(strLibraryFileName,"successfully","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		blnObjectError=True
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		
End If
Else
		Call ReporterFunction(strLibraryFileName,"VerifyIfGuiTreeExist","1"," Gui Tree Not Exist","Function Parameter Not Passed Properly. Check the --VerifyIfGuiTreeExist-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --VerifyIfGuiTreeExist-- Function Call-"	
End If
Set  objTree =nothing
Set normalObj=nothing
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    VerifyIfGuiTreeExist = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    VerifyIfGuiTreeExist = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath&";"&itemText,strMsg,strStatus,"")
	   End If
	   If strStatus = "FAIL"  Then
		    VerifyIfGuiTreeExist = False
	   Else
		    VerifyIfGuiTreeExist = True
	   End If
' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
 End If
End Function
'*****************************************************************************************************
'End Function - VerifyIfGuiTreeExist
