'**************************************************************************************************************
'Name of the Function   :  VerifyObjectStatus
'Author		     : Nikhil
'Date 			: 18/ Nov/2011	
'Description		     :  This function verifies whether an SAP object (Textbox,Checkbox,RadioButton)  is Enabled or not.
'                                       
'Input Parameters	     :  ObjToBeVerified :-  An SAP object that needs to be verified
'											                           		                                     		
'Output Parameters        : Null
'
' Example					:     VerifyObjectStatus(obj)  
'															
'**************************************************************************************************************
'Function VerifyObjectStatus(obj)  
'**************************************************************************************************************
Public Function VerifyObjectStatus(objToBeVerified)

    If objToBeVerified.GetROProperty("enabled") Then
		VerifyObjectStatus = true
	Else
		VerifyObjectStatus = false
   	End If

End Function

