''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : VerifyifGuiLabelExists
'Author		     :Shriya
'Description		     : Verifies if Gui Label exiss   
'Input Parameters	     :  Content to be verfied
'Output Parameters        : Null
'Creation Date : 09/05/2012
'***********************************************************************************
'Function VerifyifGuiLabelExists(Content)
'***********************************************************************************

Function VerifyifGuiLabelExists(Content)

 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyifGuiLabelExists"
	
	strStepName = "Verify if Gui Label exists "

    If Content <>"" Then
     set   objLabel = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiLabel("content:="&Content,"guicomponenttype:=30")
               If objLabel.Exist Then
					Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists","2",Content,"Gui Label with value "&Content &" exists in the screen")	
					strStatus = "PASS"
					strMsg = "Gui Label with value "&Content&" exists in the screen"	
					blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
                              End If
					
					Else
					Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists","1"," Status bar Content","Gui Label with value "&Content &" doesn't exist  in the screen")	
					strStatus = "FAIL"
					blndefectFlag =True
					strMsg = "Gui Label with value "&Content&" doesn't exist  in the screen"
					blnObjectError=True
				End If
       	Else
    	Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists","1","Gui Label","Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExists-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExists-- Function Call-"
	End if


If strStatus = "FAIL"  Then
		VerifyifGuiLabelExists = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
    
	Else
		VerifyifGuiLabelExists = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If

End If
End Function


''************************************************************************************
'End Function - VerifyStatusBar
'************************************************************************************

'**********************************************************************************
'Name of the Function   :  VerifyTextPopup
'Author		     :  Ritu
'Description		     : Verifies Text in a  Popup Window
'                                     expectedValue:- Value to be verified   
'Input Parameters	     :  expectedValue
'Output Parameters        :
'Creation Date : 10/05/2012
'***********************************************************************************
'Function VerifyTextPopup(expectedValue)
'***********************************************************************************
Public Function VerifyTextPopup(expectedValue)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextPopup"
	 
	 strStepName = " Verify " & "'" & expectedValue & "'" & " in Popup"
	
  Set objTextPopup = SAPGuisession(sessionObject).sapguiwindow(WindowObject1)
   If objTextPopup.Exist then
		     popupText= objTextPopup.getROProperty("text")
            
            If UCASE(expectedValue)=UCASE(popupText) Then
							 Call ReporterFunction(strLibraryFileName,"VerifyTextPopup","2","Popup","Expected Value :-"&expectedValue&"   Matched With Contents of Popup ")
							  strStatus = "PASS"
							  strMsg = "Actual Text of the Popup: "&popupText&" is equal to the Expected Value: "&expectedValue&""
							  blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objTextPopup,False,False,False)
		            	  End If
					
						     Call ReporterFunction(strLibraryFileName,"VerifyTextPopup","1","Popup","Expected Value :-"&expectedValue &"   Did not Match  With Contents of Popup" )
						      strMsg="Actual Text of the Popup: "&popupText&" is not equal to the Expected Value: "&expectedValue&""
						      strStatus = "FAIL"
			Else
			
			Call ReporterFunction(strLibraryFileName,"VerifyTextPopup","1","Popup","Function Parameter Not Passed Properly. Check the --VerifyTextPopup-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyTextPopup-- Function Call-"
				End If
			  
			Else 
			   Call ReporterFunction(strLibraryFileName,"VerifyTextPopup","1","Popup","Popup Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Popup Object Missing"
			   blnObjectError=True
			End If
		


If strStatus = "FAIL"  Then
		VerifyTextPopup = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextPopup,False,False,False)
	Else
		VerifyTextPopup = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If			
 Set objTextPopup=Nothing
End If
End function
'*************************************************************************************************************************************************
'End Function - VerifyTextPopup
'***********************************************************************************************************************************************

'**********************************************************************************
'Name of the Function   :  VerifyTableCellContentByRef
'Author		     : Ranjith
'Modified by : Santu
'Description		     : Verifies the contents of cell of a Gui Table which is present in a normal window .
'			                        TableColumnName :- Reference Column name of Table
'									 refCellValue :-  Reference Column value
'			                          tableColumnName :- Column name of Table from where value is to be checked
'			                          tableName:- Name of the Gui Table        
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  tableName,refColumnName,TableColumnName,refCellValue,expectedValue
'Output Parameters        : Null
'Creation Date : 08/10/2012
'***********************************************************************************
'Function  VerifyTableCellContentByRef(tableName,refColumnName,refCellValue,TableColumnName,expectedValue)
'***********************************************************************************
Public Function VerifyTableCellContentByRef(tableName,refColumnName,refCellValue,TableColumnName,expectedValue)

    If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTableCellContentByRef"
	
If refColumnName<>"" or  TableColumnName <> "" or  tableName<>"" or refCellValue <>"" Then
Set objGuiTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
strStepName = " Verify  Content " & "'"  & expectedValue & "'"  & " in GuiTable"
			If objGuiTable.Exist then
					   On Error Resume Next
					   strRowNum=objGuiTable.FindRowByCellContent(refColumnName,refCellValue)
						If Err.Number = 0 Then
							strRowVal=objGuiTable.GetCellData(strRowNum,TableColumnName)
							strCellValueFetched = objGuiTable.GetCellData (strRowNum,TableColumnName)
							If Err.Number=-2147220983 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","1","Column in Gui Table"," column Name : "&TableColumnName&"  does not exist in"& vbNewLine&" Gui Table with name   "&tableName )
'										  strStatus = "FAIL"
										  
										  'Exit Function
							End If
							If UCASE(expectedValue)=UCASE(strCellValueFetched) or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in "& vbNewLine&"Gui Table with Title"&tableName )
									strStatus = "PASS"
									strMsg = " Actual value in the Table cell  : " & strCellValueFetched & " matches  with the expected value: "&expectedValue&""
									blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
		            	  End If
							Else
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in"& vbNewLine&" Gui Table with Title"&tableName )
									strStatus = "FAIL"
									strMsg = " Actual value in the Table cell : " & strCellValueFetched & " did not match with the expected value: "&expectedValue&""
									
							End If
						Elseif  Err.Number = -2147220983 Then	' Verifies whether column is present in the Table
							Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","1","Gui Table","Column Not Found Within Gui Table . Please Verify The Screen")
							strStatus="FAIL"
							strMsg =  "Column Not Found Within Gui Table . Please Verify Screen"
							Err.Clear
						end if
						 
			Else 
					   Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","1","Gui Table","Gui Table Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Table Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentByRef","1","Cell in Gui Table","Function Parameter Not Passed Properly. Check the -- VerifyTableCellContentByRef-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyTableCellContentByRef-- Function Call"
End If

If strStatus = "FAIL"  Then
'		VerifyTableCellContentByRef = False
		VerifyTableCellContentByRef = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
	Else
		VerifyTableCellContentByRef = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiTable=Nothing
End If
End function

'************************************************************************************
'End Function -   VerifyTableCellContentByRef
'************************************************************************************

