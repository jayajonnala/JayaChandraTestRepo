'**********************************************************************************
'Name of the Function   :  InputValidation(inputValue)
'Author		     : Nishanth 
'Description		     : Validates whether the input is from Excel sheet.
'Input Parameters	     : Inputvalue -  Column Name (or) Raw input
'Output Parameters        : If it is a Column Name , it will return the Exact value . Else it will return the Raw value itself
'Creation Date : 26/10/2010
'************************************************************************************
'Function InputValidation(inputValue)
'***********************************************************************************
'Function InputValidation(inputValue)
'   Const ForReading = 1, ForWriting = 2, ForAppending = 8
'       Iterationrow = getEnvironmentVariable("ExcelIterationIndex")
'	   dataPath1 = getEnvironmentVariable("inputExcelPath")
'	   sheetName = getEnvironmentVariable("sheetNameEnv")
'	   firstThree  = (LEFT(UCASE(inputValue),3))
'	   If firstThree = "ID_" Then
'	   		newArray=split(sheetName,"/",-1,1)
'			for i=0 to Ubound(newArray)
'				newsheetName=newsheetName+newArray(i)
'			next
'		   	Datatable.AddSheet newsheetName
'		   	Datatable.AddSheet runTimeSheetName
'		   	Datatable.ImportSheet dataPath1,runTimeSheetName,runTimeSheetName
'		   	Datatable.SetCurrentRow (Iterationrow)
'		   On Error Resume Next
'		   If Datatable.GetSheet = newsheetName Then
'			   	Datatable.SetCurrentRow (Iterationrow)	
'		   else 
'		   		Datatable.ImportSheet dataPath1,newsheetName,newsheetName
'		   		Datatable.SetCurrentRow (Iterationrow)	
'		   End If				  
'			On error resume next
'			InputValidation =  Datatable(inputValue,runTimeSheetName)
'			If Err.Number = -2147220907  or Err.Number = -2147220908 Then
'			  	InputValidation = Datatable(inputValue,newsheetName)
'			End If
'		else
'			 InputValidation = inputValue
'		End If
' End Function

 
Function InputValidation(inputValue)
       Iterationrow = getEnvironmentVariable("ExcelIterationIndex")
	   dataPath1 = getEnvironmentVariable("inputExcelPath")
	   sheetName = getEnvironmentVariable("sheetNameEnv")
			 firstThree  = (LEFT(UCASE(inputValue),3))
			 If  firstThree = "ID_" Then
			  On Error Resume Next
			  InputValidation=getData(dataPath1,runTimeSheetName,Iterationrow,inputValue) 'getting data from the Runtime sheet 
			  If  Err.Number=3265 or  Err.Number= -2147467259  Then 'validation for file /sheet /column exitance in the Runtime sheet 
				   Err.Number=0 'resetting error
				   InputValidation=getData(dataPath1,sheetName,Iterationrow,inputValue) 'getting data  from the t-code sheet
				   If  Err.Number=3265 or  Err.Number= -2147467259 Then
					   Msgbox "Column not found the sheet .Please check"
						ExitTest
				   End If
		  	  End If
			else
				 InputValidation = inputValue   'returns the same input value if  it is not begining with "ID_"
			End If
			 If Instr(1,UCASE(InputValidation),"<RANDOM(",vbTextCompare)>0 or CSTR(UCASE(InputValidation))="<DATE>" or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE+",vbTextCompare)=1 Then
			      InputValidation = processControlFlags(InputValidation)	
			End If
End Function
 
Function processControlFlags(InputValidation)
	 If Instr(1,UCASE(InputValidation),"<RANDOM(",vbTextCompare) Then
	  				   posRandom =Instr(1,UCASE(InputValidation),"RANDOM(",vbTextCompare)
	                  				posLength = posRandom+7
	                  				charLength = MID(InputValidation,posLength,1)
					  startPosition = 10^(charLength-1)
                   					   RandomNum = RandomNumber (Cint(startPosition),10^charLength) 
	                				  temp = Len(MID(InputValidation,posRandom-2))
					  If IsEmpty(temp) Then
                   						     processControlFlags=RandomNum
					Else
	               					   processControlFlags=MID(InputValidation,1,(LEN(InputValidation)-temp)) & RandomNum	
					End If	
     elseIf CSTR(UCASE(InputValidation))="<DATE>" or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE+",vbTextCompare)=1 Then
	                Interval=MID(InputValidation,6)
					  If Interval="" Then
	                      Interval=0
                     End If
                    reqDate = DateAdd("d",Interval,Cstr(Date))
					 varDay = DatePart("D",reqDate)
                     varMonth = DatePart("M",reqDate)
                     varYear = DatePart("YYYY",reqDate)
					 processControlFlags =  varDay & "." &  varMonth & "." &  varYear					
	End If
End Function



Function getData(dataPath1,sheetName,Iterationrow,inputValue)
 Const adOpenStatic = 3
 Const adLockOptimistic = 3
   Set cn = CreateObject("ADODB.Connection")
		cn.Open "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" & dataPath1 & _
				";Extended Properties=Excel 8.0"
		query = "Select * from ["&sheetName&"$]"
		Set rs = CreateObject("ADODB.Recordset")
		rs.Open query, cn, adOpenStatic, adLockOptimistic
				 For x = 2 to Iterationrow
				  rs.MoveNext
				 Next
		        getData=rs.Fields(inputValue)
				rs.Close
				cn.Close
				Set rs=nothing
				Set cn=nothing

End Function
'************************************************************************************
'End Function - InputValidation
'************************************************************************************


''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : VerifyStatusBar
'Author		     :Niranjan S
'Description		     : Verifies status bar content     
'Input Parameters	     :  Content to be verfied
'Output Parameters        : Null
'Creation Date : 18/11/2010
'***********************************************************************************
'Function VerifyStatusBar(Content)
'***********************************************************************************

Function VerifyStatusBar(Content)
 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyStatusBar"
	
	strStepName = "Verify Status Bar "
	Set objStatusBar=SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar)
    objStatusBarText = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar).GetROProperty("text")
	CompareType="CONTAIN"
    If Content <>"" Then
		Select Case UCASE(CompareType)
			   Case "CONTAIN"
				If instr(1, UCASE(objStatusBarText), UCASE(Content), vbTextCompare) Then
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBar","2"," Status bar Content","Actual Value is equal to the Expected Value")	
				strStatus = "PASS"
				strMsg = "Actual Value: " & "'" & objStatusBarText & "'" & " is equal to the Expected Value : " & "'" & Content& "'" &  " "
				blnCaptureFlag = True				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   			ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
				End If 
				
				Else
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBar","1"," Status bar Content","Actual Value is not equal to the Expected Value ")	
				strStatus = "FAIL"
				blndefectFlag =True
				strMsg = "Actual Value: " & objStatusBarText & "  is not equal to the Expected Value: " & "'" & Content& "'" &  " "	
				End If
		End Select
	Else
    	Call ReporterFunction(strLibraryFileName,"VerifyStatusBar","1","StatusBar","Function Parameter Not Passed Properly. Check the --VerifyStatusBar-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyStatusBar-- Function Call"
	End if
	
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyStatusBar = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
	Else
		VerifyStatusBar = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
	  ' //////////Word Document ///////////
		'	If bDocFlag= 1 Then
			'	Check=CheckStatus_Doc(status)
			'	If Check=1 Then
			'		imageDocPath=CaptureSAPObject_Doc(SAPWindowObject)
			'		Call StoreSteps(strStepName)
			'		Call storeCoordinates(objStatusBar)
			'		call drawShapeImage(imageDocPath)
             '       Call InsertImage(imageDocPath)
			'		Call InsertStepsDoc()
			'		oDicSteps.RemoveAll
			'	End If
			' End If
			    ' //////////Word Document ///////////
	Set objStatusBar=Nothing
	End If
End Function


''************************************************************************************
'End Function - VerifyStatusBar
'************************************************************************************


'**********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   :  ValidateStatusBarMsg()
'Author		     : Ritu
'Description		     : This function validates if the values entered in the text boxes are generating any SAP Error or Warning messages.
'Input Parameters	     :  Null
'Output Parameters        : Null
'Creation Date : 25/11/2010
'***********************************************************************************
'Function  ValidateStatusBarMsg()
'***********************************************************************************

Public Function ValidateStatusBarMsg()

 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ValidateStatusBarMsg"
	
strStepName = "Verify Status Bar Message "
Set objStatusBarText= SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiStatusBar(guiStatusBar) 

If  objStatusBarText.Exist Then
    Dim StatusBarMessageType
    StatusBarMessageType =objStatusBarText.GetROProperty("messagetype")
    
    
    If  UCASE (StatusBarMessageType) = "E" Then
         Call ReporterFunction(strLibraryFileName,"ValidateStatusBarMsg","1"," Text Box ","Text Box Value Error")	
         strStatus = "FAIL"
		 blndefectFlag = True
         strMsg = objStatusBarText.GetROProperty ("text")
        ' strScreenshotName = CaptureSAPObject(SAPWindowObject)
         blnObjectError=True
		 'Call UpdateSummaryReportIntermediate()	
          'ExitTestIteration
           blnObjectError=True
          
   ElseIf  UCASE (StatusBarMessageType) = "W" Then
          Do while  UCASE (StatusBarMessageType) = "W" 
                  strMsg =  objStatusBarText.GetROProperty ("text")
                  'strScreenshotName = CaptureSAPObject(SAPWindowObject)
				   sapguisession(sessionObject).sapguiwindow(windowObject).SendKey ENTER
                    Call ReporterFunction(strLibraryFileName,"ValidateStatusBarMsg","3"," Text Box ","Text Box Value Warning Message")
                     strStatus = "DONE"
                     endTime = Timer()
                      timeConsumed =FormatNumber(endTime - startTime,2)
                      If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   			ImagePath=CaptureScreenshot(strStepName,objStatusBarText,False,False,False)
				End If 
                      'Call update_Html(strStatus,val,strMsg,timeConsumed,strStepName,strScreenshotName)
                      StatusBarMessageType =objStatusBarText.GetROProperty("messagetype")
			   Loop
			   
			   
			   
    ElseIf  UCASE (StatusBarMessageType) = "S" Then
             strMsg =  objStatusBarText.GetROProperty ("text")
'             strScreenshotName = CaptureSAPObject(SAPWindowObject)
			 strStatus = "PASS"
			 blnCaptureFlag = True				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   			ImagePath=CaptureScreenshot(strStepName,objStatusBarText,False,False,False)
				End If 
			 blnObjectError=True
	Else
        strStatus = "Pass"
        strMsg = " Validation Passed: No Error or Warning Message"
         blnObjectError=True
         blnCaptureFlag = True				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   			ImagePath=CaptureScreenshot(objStatusBarText,strStepName)
				End If 
   End If
Else 
    Call ReporterFunction(strLibraryFileName,"ValidateStatusBarMsg","1","Status Bar","Object Missing")
    strStatus = "FAIL"
    strMsg = " The Object is not Found, Please verify the Screen"
    'strScreenshotName = CaptureSAPObject(SAPWindowObject)
    blnObjectError=True
End If


If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		ValidateStatusBarMsg = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(objStatusBar,strStepName)
	Else
		ValidateStatusBarMsg = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
''htmlFile.close
End If
End Function
''************************************************************************************
'End Function - ValidateStatusBarMsg
'************************************************************************************

'**********************************************************************************
'Name of the Function   : CheckScreen
'Author		     :Ritu
'Description		     : Screen Validations			        
'Input  Parameters	     : tcode - valid  SAP Transaction Code
  '                                          Content - Text in theSAP Screen
'Output Parameters        :
'Creation Date : 26/10/2010
'***********************************************************************************
'Function CheckScreen(tcode,Content)
'***********************************************************************************8
Public Function CheckScreen(tcode,Content)

  If Not (Environment.Value("blnFatalError")) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CheckScreen"
	
 strStepName  = "Screen Validation for " & tcode
SAPScreen_text = SAPGuiSession(sessionObject).SAPGuiWindow(windowObject).GetROProperty("text")
 If instr(1, UCASE(SAPScreen_text ), UCASE(Content), vbTextCompare) Then
	Call ReporterFunction(strLibraryFileName,"CheckScreen","0","SAP Screen ","Validation : Passed")
    strStatus = "PASS" 
	strMsg = "Click here : Expected screen"
	blnCaptureFlag= True
	 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   ImagePath=CaptureScreenshot("<SKIPSTEP>",windowObject,False,False,False)
'		   ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
	End If 
 else 
	Call ReporterFunction(strLibraryFileName,"CheckScreen","1","SAP Screen ","Validation : The screen did not pass the Validation")
    strStatus = "FAIL" 
	blndefectFlag =True
	strMsg = "Validation : The screen did not pass the Validation"
 end if 
	     
	     
	  If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
		
	End If

	If strStatus = "FAIL"  Then
		CheckScreen = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot("<SKIPSTEP>",windowObject,False,False,False)
'		ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
	Else
		CheckScreen = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
          
 End If 
End Function
 '**********************************************************************************
'End Function -  CheckScreen
'***********************************************************************************

'**********************************************************************************
'Name of the Function   :  VerifyCheckBoxValue
'Author		     : Ritu
'Modified By : Tapaswinee
'Description		     : Verifies  Check Box Value
'			                           checkboxName :- name property of the checkbox to be selected	        
'                                     expectedValue- Expected On or Off Status of  the checkbox to be selected	 
'Input Parameters	     : checkboxName,expectedValue
'Output Parameters        :Null
'Example : Call VerifyCheckBoxValue("VBAK-AUTLF","yes")
'Creation Date : 03/08/2011
'Modification Date :12/12/2011 
'***********************************************************************************
'Function VerifyCheckBoxValue(checkboxName,expectedValue)
'***********************************************************************************

Public Function VerifyCheckBoxValue(checkboxName,expectedValue)
 
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyCheckBoxValue"
	
  strStepName= "Verifies Check Box Value"
   If checkboxName <> "" and expectedValue <> "" Then
        Select Case lcase(expectedValue)
           Case "true", "1", "yes", "y", "on", "check", "checked"
            Check_val = "TRUE"
        Case "false", "0", "no", "n", "off", "uncheck", "unchecked", "un-check", "un-checked", "un check", "un checked" 
             Check_val = "FALSE"
        End Select
       Set objCheckbox=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiCheckBox("guicomponenttype:=42","name:="&checkboxName)
       If objCheckbox.Exist Then
	         OnOffStatus = objCheckbox.GetROProperty("selected")
			 If UCASE(OnOffStatus)=UCASE(Check_val) Then
				   Call ReporterFunction(strLibraryFileName,"VerifyCheckBoxValue","0"," Check Box ","Actual Value of the Checkbox is equal to the Expected Value")
                   strStatus="PASS"
			       strMsg = "Actual Value of the Checkbox is equal to the Expected Value"
			        blnCaptureFlag = True
			      If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            ImagePath=CaptureScreenshot(strStepName,objCheckbox,False,False,False)
	   End if
			 Else 
                    Call ReporterFunction(strLibraryFileName,"VerifyCheckBoxValue","1"," Check Box ","Actual Value of the Checkbox is not equal to the Expected Value")
                    strStatus="FAIL"
			        strMsg = "Actual Value of the Checkbox is not equal to the Expected Value"
					
			  End If        
       Else 
          Call ReporterFunction(strLibraryFileName,"VerifyCheckBoxValue","1","Check Box","Object Missing")
	      strStatus="FAIL"
	      strMsg = " The Object is not Found, Please verify the Screen"
          blnObjectError=True
       End If
   Else 
           Call ReporterFunction(strLibraryFileName,"VerifyCheckBoxValue","1","Check Box","Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call")
		   strStatus="FAIL"
		   strMsg = "Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call-Str err"
   End If
   
   If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyCheckBoxValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objCheckbox,False,False,False)
		Else
		VerifyCheckBoxValue = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
  Set objCheckbox=Nothing
End If
End Function
'************************************************************************************
'End Function - VerifyCheckBoxValue
'************************************************************************************


''**********************************************************************************
'Name of the Function   :  VerifyTableCellContent
'Author		     : Madhurima
'Description		     : Verifies the contents of cell of a Gui Table which is present in a normal window .
'			                          tableRowNumber :- Row number of table from where value is to be checked
'			                          tableColumnName :- Column name of table from where value is to be checked
'			                          tableName :- Name of the Gui Table         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  tableRowNumber,tableColumnName,tableName,expectedValue
'Output Parameters        : Null
'Creation Date : 05/08/2011
'***********************************************************************************
'Function  VerifyTableCellContent(tableRowNumber,tableColumnName,tableName,expectedValue)
'***********************************************************************************
Public Function VerifyTableCellContent(tableRowNumber,tableColumnName,tableName,expectedValue)

If Not (Environment.Value("blnFatalError") or tableColumnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTableCellContent"
    strStepName = " Verify  Content in   " & tableColumnName & "  column in Gui Table"
	
If tableRowNumber<>"" and tableColumnName <> "" and tableName<>"" Then
			Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
			
			If objTable.Exist then					  
			            
					    strMsg= "Table cell content verified successfully"
					    
	
					   On Error Resume Next
						 strCellValueFetched = objTable.GetCellData (tableRowNumber,tableColumnName)
						If Err.Number=-2147220983 Then
						
										  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContent","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in "& vbNewLine&"Gui Table with name"&tableName )
										  strStatus = "FAIL"
										
									     Exit Function
						End If
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1) or expectedValue = Replace(strCellValueFetched," ","") Then
							 Call ReporterFunction(strLibraryFileName,"VerifyTableCellContent","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in "& vbNewLine&"Gui Table with name"&tableName )
							  strStatus = "PASS"
                              strMsg = " Actual value: "&strCellValueFetched&" in the table cell matches  with the expected value: "&expectedValue&""
                              blnCaptureFlag = True
			                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		                     ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
		                     End If
						 Else
							  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContent","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & tableRowNumber &" column Name :"&tableColumnName&"in"& vbNewLine&" Gui Table with name"&tableName )
							  strStatus = "FAIL"
							  strMsg = " Actual value: "&strCellValueFetched&" in the table cell did not match with the expected value: "&expectedValue&""
							  
						 End If
			Else 
					   Call ReporterFunction(strLibraryFileName,"VerifyTableCellContent","1","Gui Table","Gui Table Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui table Object Missing"
					   blnObjectError=True
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyTableCellContent","1","Cell in Gui Table","Function Parameter Not Passed Properly. Check the -- VerifyTableCellContent-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyTableCellContent-- Function Call"
End If

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyTableCellContent = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	Else
		VerifyTableCellContent = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTable=Nothing
End If
End function

'************************************************************************************
'End Function -   VerifyTableCellContent
'************************************************************************************


'**********************************************************************************
'Name of the Function   :  VerifyTextBoxContent
'Description		     : Verifies the contents of Textbox which is present in a normal window .
'                                                                    textboxName:- name property of the text box 
'			                           textboxAttachedText :- attachedtext property of the textbox
'			                      textboxIndex :- ordinal identifier(index) of the textbox    
'                                      expectedValue :- Value to be checked    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Input Parameters	     :  textboxName,textboxAttachedText,textboxIndex,expectedValue
'Output Parameters        : Null
'***********************************************************************************
'Function VerifyTextBoxContent(textboxName,textboxAttachedText,textboxIndex,expectedValue)
'***********************************************************************************
Public Function VerifyTextBoxContent(textboxAttachedText,textboxName,textboxIndex,expectedValue,blnIsItPopup)

  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextBoxContent"
	
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = " Verify Content of TextBox" &textboxAttachedText
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If textboxName<> "" OR textboxAttachedText<>"" OR textboxIndex<>"" Then
		 If objTextbox.Exist then
					  textboxValue = Trim(objTextbox.getROProperty("value"))
					  If expectedValue=UCASE(textboxValue) or expectedValue=LCASE(textboxValue) or INSTR(1,textboxValue,expectedValue,1)<>null or expectedValue = Replace(textboxValue," ","") OR expectedValue = textboxValue Then
						
						Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContent","2","TextBox","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of Text Box")
						  strStatus = "PASS"
						  strMsg = "Actual Value of the TextBox : " &textboxValue & "   is equal to the Expected Value: " &expectedValue&" "
						  strStepName = " Verify Content of TextBox " &expectedValue
						    blnCaptureFlag = True
			              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
		            	  End If
						 
					  Else
						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContent","1","TextBox","Supplied Value :-"&expectedValue &"  "& vbNewLine&"     didnot Match  with Contents of Text Box" )
						  strStatus = "FAIL"
						  strMsg = "Actual Text Box Value : " &textboxValue & "  does not match with the expected Value: " &expectedValue&" "
			              
					 End If
		 else 
			   'strStepName = "TextBox: " &textboxAttachedText& "  -No Such Object Found"
			   Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContent","1","Text Box","Text Box Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Text Box Object Missing"
			   blnObjectError=True
		 End If
 else
    	Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContent","1","TextBox","Function Parameter Not Passed Properly. Check the --VerifyTextBoxContent-- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --VerifyTextBoxContent-- Function Call"
 End If
 	
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyTextBoxContent = strMsg
		blnMainFailFlag = True
	    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	Else
		VerifyTextBoxContent = True
	End If
	If blnDefault_eSwiftReporting Then  
	
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
Set objWindow=Nothing
End If
End function
'************************************************************************************
'End Function -  VerifyTextBoxContent
'************************************************************************************
Public Function VerifyTextBoxContentIconName(textboxName,textboxIndex,expectedValue,blnIsItPopup)

  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextBoxContentIconName"
	
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = " Verify Content of TextBox"
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"Index:="&textboxIndex)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"Index:="&textboxIndex)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If textboxName<> "" OR textboxIndex<>"" Then
		 If objTextbox.Exist then
					  textboxValue = objTextbox.getROProperty("iconname")
					  If expectedValue=UCASE(textboxValue) or expectedValue=LCASE(textboxValue) or INSTR(1,textboxValue,expectedValue,1)<>null  Then
						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContentIconName","2","TextBox","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of Text Box")
						  strStatus = "PASS"
						  strMsg = "Actual Value of the TextBox : " &textboxValue & "   is equal to the Expected Value: " &expectedValue&" "
						    blnCaptureFlag = True
			              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
		            	  End If
						 
					  Else
						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContentIconName","1","TextBox","Supplied Value :-"&expectedValue &"  "& vbNewLine&"     didnot Match  with Contents of Text Box" )
						  strStatus = "FAIL"
						  strMsg = "Actual Text Box Value : " &textboxValue & "  does not match with the expected Value: " &expectedValue&" "
			              
					 End If
		 else 
			   'strStepName = "TextBox: " &textboxName& "  -No Such Object Found"
			   Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContentIconName","1","Text Box","Text Box Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Text Box Object Missing"
			   blnObjectError=True
		 End If
 else
    	Call ReporterFunction(strLibraryFileName,"VerifyTextBoxContentIconName","1","TextBox","Function Parameter Not Passed Properly. Check the --VerifyTextBoxContentIconName-- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --VerifyTextBoxContentIconName-- Function Call"
 End If
 	
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyTextBoxContentIconName = strMsg
		blnMainFailFlag = True
	    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	Else
		VerifyTextBoxContentIconName = True
	End If
	If blnDefault_eSwiftReporting Then  
	
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
Set objWindow=Nothing
End If
End function

'**********************************************************************************
'Name of the Function   :  VerifyErrorPopup
'Author		     : Ritu
'Description		     : This function validates if the values entered in the text boxes are generating any SAP Error  Popups
'Input Parameters	     : Null
'Output Parameters        :Null
'Creation Date : 09/22/2011
'***********************************************************************************
'Function VerifyErrorPopup()
'***********************************************************************************

Public Function VerifyErrorInfoPopup()
If Not (Environment.Value("blnFatalError")) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyErrorInfoPopup"
strLibraryFileName= VerifyErrorInfoPopup	
strStepName = "Verify Error or Information Pop up "
Set errWindow = SAPGuiSession(sessionObject).SAPGuiWindow("guicomponenttype:=22","text:=Error")
Set infoWindow = SAPGuiSession(sessionObject).SAPGuiWindow("guicomponenttype:=22","text:=Information")
Set errObj= SAPGuiSession(sessionObject).SAPGuiWindow(windowObject1).SAPGuiEdit("guicomponenttype:=31","attachedtext:=Error message")
Set infoObj = SAPGuiSession(sessionObject).SAPGuiWindow(windowObject1).SAPGuiEdit("guicomponenttype:=31","attachedtext:=Information message")

If  errWindow.Exist Then
	strMsg = errObj.GetROProperty("value")
	strScreenshotName = CaptureSAPObject(errObj)
    SAPGuiSession(sessionObject).SAPGuiWindow(windowObject1).SAPGuiButton("guicomponenttype:=40","tooltip:=Confirm.*").Click
    ImagePath=CaptureScreenshot(strStepName,errObj,False,False,False)
    If SAPwindowObject1.Exist Then
      SAPwindowObject1.Close
   End If
  Call ReporterFunction(strLibraryFileName,"VerifyErrorInfoPopup","1"," Error Popup","Value Entered is incorrect")	
  strStatus = "FAIL"
  blndefectFlag =True
  
  
  	VerifyErrorInfoPopup = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,errObj,False,False,False)
	
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
  
  
   ExitTestIteration
   'Call UpdateSummaryReportIntermediate()
   
   ElseIf infoWindow.Exist Then
   Do While infoObj.Exist
      strMsg = infoObj.GetROProperty("value")
	 	ImagePath=CaptureScreenshot(strStepName,infoObj,False,False,False)
	  sapguisession(sessionObject).sapguiwindow(windowObject1).SendKey ENTER
	  Call ReporterFunction(strLibraryFileName,"VerifyErrorInfoPopup","3"," Text Box ","Text Box Value Information Pop-up")
      strStatus = "DONE"
      endTime = Timer()
      timeConsumed =FormatNumber(endTime - startTime,2)
     If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
   Loop      
End If

		VerifyErrorInfoPopup = True


	
'End If	
'htmlFile.close
Set errWindow = nothing
Set infoWindow = nothing
Set errObj = nothing
Set infoObj =nothing

End If
End Function

'************************************************************************************
'End Function -  VerifyErrorInfoPopup
'************************************************************************************


