		VerifyTableCellContentPopup = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,false,false,False)
	Else
		VerifyTableCellContentPopup = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If



Set objTable=Nothing
