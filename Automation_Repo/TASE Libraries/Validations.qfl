Public Function VerifyTableCellContentPopupByRef(tableName,refColumnName,refCellValue,TableColumnName,expectedValue)
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTableCellContentPopupByRef"
	
strStepName = " Verify  Content " & "'"  & expectedValue & "'"  & " in GuiTable"
If refColumnName<>"" or  TableColumnName <> "" or  tableName<>"" or refCellValue <>"" Then
Set objGuiTable= SAPGuisession(sessionObject).sapguiwindow(windowObject1).sapguitable(guiTable,"name:="&tableName)

			If objGuiTable.Exist then
					   On Error Resume Next
					   strRowNum=objGuiTable.FindRowByCellContent(refColumnName,refCellValue)
						If Err.Number = 0 Then
							strRowVal=objGuiTable.GetCellData(strRowNum,TableColumnName)
							strCellValueFetched = objGuiTable.GetCellData (strRowNum,TableColumnName)
							If Err.Number=-2147220983 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","1","Column in Gui Table"," column Name : "&TableColumnName&"  does not exist in"& vbNewLine&" Gui Table with name   "&tableName )
										  strStatus = "FAIL"
										  
										  'Exit Function
							End If
							If UCASE(expectedValue)=UCASE(strCellValueFetched) or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","2","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in "& vbNewLine&"Gui Table with Title"&tableName )
									strStatus = "PASS"
									strMsg = " Actual value in the Table cell  : " & strCellValueFetched & " matches  with the expected value: " & expectedValue &" "
									blnCaptureFlag= True
							   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
		            	  		End If
							Else
									Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","1","Cell in Gui Table","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & strRowNum &" column Name :"&TableColumnName&"in"& vbNewLine&" Gui Table with Title"&tableName )
									strStatus = "FAIL"
									strMsg = " Actual value in the Table cell : " & strCellValueFetched & " did not match with the expected value: " & expectedValue &" "
									
							End If
						Elseif  Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
							Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","1","Gui Table","Column Not Found Within Gui Table . Please Verify The Screen")
							strStatus="FAIL"
							strMsg =  "Column Not Found Within Gui Table . Please Verify Screen"
						
							Err.Clear
						end if
						 
			Else 
					   Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","1","Gui Table","Gui Table Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Table Object Missing"

					   blnObjectError=True
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentPopupByRef","1","Cell in Gui Table","Function Parameter Not Passed Properly. Check the -- VerifyTableCellContentPopupByRef-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameters Not Passed Properly. Check the - VerifyTableCellContentPopupByRef-- Function Call"
End If


If strStatus = "FAIL"  Then
		VerifyTableCellContentPopupByRef = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiTable,False,False,False)
	Else
		VerifyTableCellContentPopupByRef = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiTable=Nothing
End If
End function

'************************************************************************************
'End Function -   VerifyTablePopupCellContentByRef
