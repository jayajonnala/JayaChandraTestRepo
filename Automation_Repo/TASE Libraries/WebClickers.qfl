Public Function ClickSAPListUniversal(creationTime,sapattachedText)

If Not (Environment.Value("blnFatalError") or sapattachedText = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickSAPListUniversal"
	
'	ALMvalue=Environment.Value("ALMFlag")
