Public Function SelectSAPUITabStrip(creationTime,windowText,htmlTag,htmlId,innertext,className,TitleOrIndex,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUITabStrip"
	
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If

strStepName = "Select Tab"

if innertext<> "" OR className<> "" then 
If blnIsItPopup Then
    Set objSAPUITabStrip =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUITabStrip("class:="& className,"innertext:="&innertext,"html tag:="&htmlTag ,"htmlId:="&htmlId)
else
    Set objSAPUITabStrip= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUITabStrip("class:="& className,"innertext:="&innertext,"html tag:="&htmlTag ,"htmlId:="&htmlId)
End If
    If  objSAPUITabStrip.Exist(gObjectTimeoutLimit)  then 
		If TitleOrIndex<>"" Then
		      objSAPUITabStrip.Select TitleOrIndex
              strMsg = "Tab selected Successfully"

              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITabStrip,False,False,True)
				End If
				
              strStatus  = "DONE"
           Call ReporterFunction("WebClickers","SelectSAPUITabStrip","2",strStepName,strMsg)
        Else
      		strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUITabStrip-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectSAPUITabStrip","1",strStepName,strMsg) 
          
       End if
    else 
	   strStatus ="FAIL"
       strMsg = "Tab object is not Found, Please verify the Screen"
       blnObjectError=True
       Call ReporterFunction("WebClickers","SelectSAPUITabStrip","1",strStepName,strMsg)   
        
 End If
  Else
      		strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUITabStrip-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectSAPUITabStrip","1",strStepName,strMsg) 
          
       End if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SelectSAPUITabStrip = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITabStrip,FALSE,False,TRUE)
	Else
		SelectSAPUITabStrip = True
	End If
	If blnDefault_eSwiftReporting Then  
