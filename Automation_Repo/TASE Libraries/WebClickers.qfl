		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objPage
	Dim imageObj
	strStepName = "Click  "&ImageNumber & "th Image"
	Set objPage = Browser("creationtime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime)
	
	If objPage.Exist(gObjectTimeoutLimit)  Then
		If tableClass <>"" and imageNumber<>"" Then
			Set objdsc = description.Create()
			objdsc("html tag").value ="IMG"
			Set imageObj =objPage.WebTable("html tag:=table","index:=0","class:="&tableclass).ChildObjects(objdsc)
			imageNumber=Cint(imageNumber)
			imageObj(imageNumber).highlight
			imageObj(imageNumber).Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,imageObj,True,True,True)
			End if
			strStatus = "DONE"
