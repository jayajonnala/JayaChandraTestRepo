Public Function ClickWebButtonFrame(creationTime,frameTitle,frameName,buttonClass,buttonName,buttonHtmlTag,buttonIndex)
functionName = "ClickWebButtonFrame"
strStepName = "Click WebButton "&innertext&" on frame"
If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then '*** innertext property should be checked here
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : "&functionName

'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
	'End If

	Dim objWebButton
	If frameTitle<>"" AND frameName="" Then
		Set objWebButton= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).WebButton("class:="&buttonClass,"name:="&buttonName,"html tag:=" &buttonHtmlTag,"index:="& buttonIndex)
	ElseIf frameName<>"" AND frameTitle=""  Then
		Set objWebButton= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("name:="&frameName).WebButton("class:="&buttonClass,"name:="&buttonName,"html tag:=" &buttonHtmlTag,"index:="& buttonIndex)
	Else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -frame properties in the -- Function Call"
		Call ReporterFunction(strLibraryFileName,functionName,"1",strStepName,strMsg)
	End If
		
	If buttonName<>"" or buttonClass<> "" or  buttonIndex<>"" or buttonHtmlTag<>"" Then
	
		If  objWebButton.Exist(gObjectTimeoutLimit)  then 
			objWebButton.highlight
			objWebButton.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebButton,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "WebButton : "& buttonName & " clicked successfully"
			Call ReporterFunction(strLibraryFileName,functionName,"2",strStepName,strMsg)
		Else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "WebButton: " & buttonName & " Not found"
			Call ReporterFunction(strLibraryFileName,functionName,"1",strStepName,strMsg)
			
		End If
	Else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --"&functionName&"-- Function Call"
        Call ReporterFunction(strLibraryFileName,functionName,"1",strStepName,strMsg)
    End If

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebButtonFrame= strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebButton,False,False,True)
	Else
		ClickWebButtonFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")

	End If
	Set objWebButton=Nothing
End If
End Function


