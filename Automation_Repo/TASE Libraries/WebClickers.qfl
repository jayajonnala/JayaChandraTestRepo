Public Function  ClickWebButtonUniversal(creationTime,buttonName)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebButtonUniversal"
	
	LinkCondition = 0
	
	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objScreen
	strStepName = "Click WebButton: "&ButtonName
	
	Set objScreen= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
	If buttonName<> "" Then
		If objScreen.Exist(gObjectTimeoutLimit)  then 
			Set oDesc=Description.Create()
			oDesc("micclass").value="WebButton"
			Set list=objScreen.ChildObjects(oDesc)
			For i=0 to list.count-1
				If list(i).getroproperty("name")=buttonName Then
					list(i).click
					LinkCondition = 1
			Exit for
				End If
			Next
			If LinkCondition=1 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objScreen,True,True,True)
				End if
				strStatus = "DONE"
				strMsg= "Button : "& buttonName &" is clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickWebButtonUniversal","2",strStepName,strMsg)
			Else
				blnObjectError=True
				strStatus = "FAIL"    
				strMsg = "Button: " & buttonName & " Not found"
				Call ReporterFunction(strLibraryFileName,"ClickWebButtonUniversal","1",strStepName,strMsg)
			end if
		Else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Page Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebButtonUniversal","1",strStepName,strMsg)
		end if
	Else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebButtonUniversal-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickWebButtonUniversal","1",strStepName,strMsg)
	End if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebButtonUniversal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objScreen,True,True,True)
	Else
		ClickWebButtonUniversal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objScreen)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objScreen=Nothing
End If
End function 
