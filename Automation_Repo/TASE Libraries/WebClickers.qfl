Public Function ClickWebList(creationTime,windowText,weblistName,weblistIndex,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or weblistName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebList"
	
	'ALMvalue=Environment.Value("ALMFlag")
	'If  ALMvalue=1 Then
		'PopUpCreationtime=Cint(creationTime) + 1
	'else
		PopUpCreationtime=Cint(creationTime)
	'End If
	
	Dim objWeblist
	strStepName = "Click List : "&weblistName&" "
	If blnIsItPopup Then
		Set objWeblist =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebList("name:="&weblistName,"html tag:=SELECT","index:="&weblistIndex)
	else
		Set objWeblist= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebList("name:="&weblistName,"html tag:=SELECT","index:="&weblistIndex)
	End If
	If weblistName <> "" Then
		If  objWeblist.Exist(gObjectTimeoutLimit)  then 
		
			objWeblist.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWeblist,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Weblist : "&weblistName&" clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebList","2",strStepName,strMsg)
		else
			blnObjectError=True
		  	strStatus = "FAIL"    
		 	strMsg = "Weblist: " & weblistName & " Not found"
		 	Call ReporterFunction(strLibraryFileName,"ClickWebList","1",strStepName,strMsg)
		
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebList-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickWebList","1",strStepName,strMsg)

	end if
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWeblist,False,False,True)
	Else
		ClickWebList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,weblistName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWeblist)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objWeblist=Nothing
End If
End function 

Public Function ClickSAPUIButton(creationTime,windowText,htmltag,innertext,className,index,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickSAPUIButton"
	
'ALMvalue=Environment.Value("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If     
strStepName = "Click  "&innertext
If blnIsItPopup Then
	Set objSAPUIButton =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUIButton("class:="&className,"innertext:="&innertext,"html tag:=" &htmltag,"index:="& index)
else
    Set objSAPUIButton= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUIButton("class:="&className,"innertext:="&innertext,"html tag:=" &htmltag,"index:="& index)
End If
If innertext<>"" or className<> "" or  index<>"" Then
    If  objSAPUIButton.Exist(gObjectTimeoutLimit) then 
             objSAPUIButton.highlight
             objSAPUIButton.Click
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPUIButton,True,True,True)
			End If
             strStatus  = "DONE"
             Call ReporterFunction("WebClickers","ClickSAPUIButton","2",strStepName,strMsg)
      else
     		strMsg = innertext&" Button Not found"
     		strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","ClickSAPUIButton","1",strStepName,strMsg)
      		blnObjectError = True
   		
    end if
Else
     strMsg = "Function Parameter Not Passed Properly. Check the --ClickSAPUIButton-- Function Call"
     strStatus  = "FAIL"
     Call ReporterFunction("WebClickers","ClickSAPUIButton","1",strStepName,strMsg)
End if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		ClickSAPUIButton = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIButton,FALSE,False,TRUE)
	Else
		ClickSAPUIButton = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If

End Function
