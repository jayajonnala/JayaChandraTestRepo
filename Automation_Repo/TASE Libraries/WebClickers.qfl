		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Link: " & LinkText & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickLinkText","1",strStepName,strMsg)
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickLinkText-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickLinkText","1",strStepName,strMsg)
	end if
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
