Public Function ClickWebElementFrameSAPList(creationTime,FrameTitle,listName ,listHtmlTag,listhtmlid,listIndex,val,WebElementIndex)

	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then 
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementFrameSAPList"

'		ALMvalue=Environment.Value("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objWebElementFrameSAPList
		strStepName   = "Select Item :  "&val& " from List"&listName

		Set objWebElementFrameSAPList =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).Frame("title:=" & FrameTitle).SAPList("name:="& listName,"html tag:="& listHtmlTag,"html id:=" &listhtmlid,"index:=" &listIndex)

		If  objWebElementFrameSAPList.Exist(gObjectTimeoutLimit)  then 
			If listhtmlid <> ""  Then '*** val can be null, so don't check for val parameter
	
				objWebElementFrameSAPList.Click
				Wait 5
				Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:=" &FrameTitle).WebElement("innertext:=" &val,"index:=" &WebElementIndex).Highlight
				Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:=" &FrameTitle).WebElement("innertext:=" &val,"index:=" &WebElementIndex).Click
				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebElementFrameSAPList,False,False,True)
				End if
				strStatus = "DONE"
				strMsg= "Web Element in SAP list clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickWebElementFrameSAPList","2",strStepName,strMsg)
				
			Else
			    strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebElementFrameSAPList-- Function Call"
				Call ReporterFunction(strLibraryFileName,"ClickWebElementFrameSAPList","1",strStepName,strMsg)
				strStatus = "FAIL"
	
			End if
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "SAPList: " & SapAttachedText & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementFrameSAPList","1",strStepName,strMsg)
		end if
		
		If  blnObjectError  Then
			Environment.Value("blnFatalError")=True
		End If
		
		If strStatus = "FAIL"  Then
			ClickWebElementFrameSAPList = strMsg
			blnMainFailFlag = True
			ImagePath=CaptureScreenshot(strStepName,objWebElementFrameSAPList,False,False,True)
		Else
			ClickWebElementFrameSAPList = True
		End If
		If blnDefault_eSwiftReporting Then  
			Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
		End If
		
		' //////////Word Document //////////////////////////////////////////////////////////
		'If blnCreateTrainingDoc Then 
		'	Check=CheckStatus_Doc(strStatus)
		'	If Check=1 Then
		'		Call storeCoordinates(objWebElementFrameSAPList)
		'		Call StoreSteps(strStepName)
		'	End If
		'End If
			' //////////Word Document ///////////
		'Set objWebElementFrameSAPList=Nothing
   
End If
End function 


Public Function ClickWebElementSAPListSAPPortal(creationTime,SapAttachedText ,SAPListIndex,val)

If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementSAPListSAPPortal"
	
	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objWebElementSAPListSAPPortal
	strStepName = "Select Item :  "&val& " from "&SapAttachedText
	
	Set objWebElementSAPListSAPPortal =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPList("sap attached text:="&SapAttachedText,"html tag:=INPUT","index:=" & SAPListIndex)
	If  objWebElementSAPListSAPPortal.Exist(gObjectTimeoutLimit)  then 
		If SapAttachedText <> ""  and val <>"" Then
			objWebElementSAPListSAPPortal.WebElement("innertext:="&val,"index:=0").Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebElementSAPListSAPPortal,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Web Element in SAP list clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPListSAPPortal","2",strStepName,strMsg)
		else
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPListSAPPortal","1",strStepName,"SAP List: " & SapAttachedText & " Function Parameter Not Passed Properly")
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the --ClickWebElementSAPListSAPPortal-- Function Call"
		end if
	else
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg =  "SAPList Object: " & SapAttachedText & " Not found"
		Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPListSAPPortal","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebElementSAPListSAPPortal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElementSAPListSAPPortal,False,False,True)
	Else
		ClickWebElementSAPListSAPPortal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebElementSAPListSAPPortal)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objWebElementSAPListSAPPortal=Nothing
End If
End function 
