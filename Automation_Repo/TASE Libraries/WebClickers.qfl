Public Function ClickLinkSAPFrame(creationTime,frameTitle,linkClass,linkName)

If Not (Environment.Value("blnFatalError") or linkName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickLinkSAPFrame"

	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	Dim objLink
	strStepName   = "Click Link:  "&linkName
	Set objLink = Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPFrame("title:="&frameTitle,"name:="&frameName,"index:="&frameIndex).Link("class:="&linkClass, "name:="&linkName,"index:=0")
	If linkClass <>"" Then
		If objLink.Exist(gObjectTimeoutLimit)  Then
		
			objLink.highlight
			objLink.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Link : "&linkName& " is Clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickLinkSAPFrame","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Link: " & linkName & " Object Missing"
			Call ReporterFunction(strLibraryFileName,"ClickLinkSAPFrame","1",strStepName,strMsg)
		
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickLinkSAPFrame-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickLinkSAPFrame","1",strStepName,strMsg)

	end if
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickLinkSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
	Else
		ClickLinkSAPFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,linkName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objLink)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objLink=Nothing
End If
End function 
