		'PopUpCreationtime=Cint(creationTime) + 1
	'else
		PopUpCreationtime=Cint(creationTime)
	'End If
	
	Dim objWeblink
	strStepName = "Click Link : "&weblinkText&" "
	If blnIsItPopup Then
		Set objWeblink =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebLink("text:="&WebLinkText,"html tag:="&webLinkHtmlTag,"index:="&WebLinkIndex)
	else
		Set objWeblink= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebLink("text:="&WebLinkText,"html tag:="& webLinkHtmlTag,"index:="&WebLinkIndex)
	End If
	If WebLinkText <> "" Then
		If  objWeblink.Exist(gObjectTimeoutLimit)  then 
		
			objWeblink.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWeblink,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "WebLink : "&WebLinkText&" clicked successfully"
