			strMsg = "Function Parameter Not Passed Properly. Check the -ClickImageWebTableByNumber-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickImageWebTableByNumber","1",strStepName,strMsg)
		end if
	else 
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "Page not found"
