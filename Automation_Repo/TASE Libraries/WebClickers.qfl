	If strStatus = "FAIL"  Then
		ClickWebLink = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWeblink,False,False,True)
	Else
		ClickWebLink = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,WebLinkText,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWeblink)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objWeblink=Nothing
End If
End function 



Public Function ClickWebButtonBabbleWay(creationTime,windowText,buttonName,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebButtonBabbleWay"

'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If     

	Dim objButton
	strStepName   = "Click WebButton: "&buttonName
	
	If blnIsItPopup Then
		Set objButton =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebButton("name:="&buttonName)

	else
		Set objButton= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebButton("name:="&buttonName)
	End If
	If buttonName<>"" Then
		If  objButton.Exist(60)  then 
			'objButton.highlight
			wait 2
			objButton.Click()
			wait 2
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Button: "& buttonName &" clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebButtonBabbleWay","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Button: " & buttonName & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebButtonBabbleWay","1",strStepName,strMsg)
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebButtonBabbleWay-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickWebButtonBabbleWay","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebButtonBabbleWay = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
	Else
		ClickWebButtonBabbleWay = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objButton=Nothing
End If
End function 



Public Function ClickLinkBabbleWay(creationTime,windowText,linkClass,linkName,linkHtmlID,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or linkName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickLinkBabbleWay"
	
'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If
	
	Dim objLink
	strStepName = "Click Link :"& Replace(LinkName,"\","")&" In Portal"
	
	If blnIsItPopup Then
		Set objLink =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).Link("class:="&linkClass, "name:="&linkName,"html id:="&linkHtmlID)
	else
		Set objLink= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Link("class:="&linkClass, "name:="&linkName,"html id:="&linkHtmlID)
	End If
	
	If linkName<>"" Then 
		If objLink.Exist(60) Then
			objLink.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Link : "&LinkName&" Clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickLinkBabbleWay","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Link: " & linkName & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickLinkBabbleWay","1",strStepName,strMsg)
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickLinkBabbleWay-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickLinkBabbleWay","1",strStepName,strMsg)
	end if
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickLinkBabbleWay = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
	Else
		ClickLinkBabbleWay = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,linkName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objLink)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objLink=Nothing
End If
End function 


Public Function ClickWebElementInnetText(creationTime,windowText,htmltag,innertext,indexNumber,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then '*** innertext property should be checked here
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementInnetText"
		PopUpCreationtime=Cint(creationTime)
'	End If

	Dim objWebElement
	strStepName  = "Click WebElement: "&innertext


	If blnIsItPopup Then
		Set objWebElement= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
		'Set objWebElement =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebElement("innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
	else
		Set objWebElement= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
	End If
	If innertext<> "" OR htmltag<> "" OR className<> "" OR indexNumber <> "" Then
		If  objWebElement.Exist(gObjectTimeoutLimit)  then 
			'objWebElement.highlight
			wait 2
			objWebElement.Click
			
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebElement,True,False,False)
			End if
			strStatus = "DONE"
			strMsg= "Web Element : "&innertext& " clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementInnetText","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "WebElement: " & innertext & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementInnetText","1",strStepName,strMsg) 
			
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ClickWebElementInnetText-- Function Call"
               Call ReporterFunction(strLibraryFileName,"ClickWebElementInnetText","1",strStepName,strMsg )
			
        end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebElementInnetText = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,True)
	Else
		ClickWebElementInnetText = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If
' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebElement)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
   ' //////////Word Document ///////////
	Set objWebElement=Nothing
End If
End function
