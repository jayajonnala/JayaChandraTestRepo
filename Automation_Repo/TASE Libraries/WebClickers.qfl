Public Function SelectSAPUIMenu(creationTime,windowText,htmltag,name,index,path,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUIMenu"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Select Item :  "&path& " from SAPUIMenu"
If blnIsItPopup Then
	Set objSAPUIMenu =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUIMenu("name:="&name,"html tag:="&htmltag,"index:="&index)
else
    Set objSAPUIMenu= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUIMenu("name:="&name,"html tag:="&htmltag,"index:="&index)
End If
	If name <> "" or htmltag <> "" Then
    	If  objSAPUIMenu.Exist(gObjectTimeoutLimit)  then 
		  
		   objSAPUIMenu.Select path
		   wait(5)
		   val= objSAPUIMenu.GetROProperty("innertext")
		   
		   
		        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIMenu,False,False,True)
				End If
				
		   	If UCASE(TRIM(val)) =  UCASE(TRIM(path)) Then
		   		strStatus  = "DONE"
                Call ReporterFunction("WebClickers","SelectSAPUIMenu","2",strStepName,strMsg)
		   	else
		   		strMsg = "SAPUIMenu item " & path & " Not found"
		   		strStatus  = "FAIL"
                Call ReporterFunction("WebClickers","SelectSAPUIMenu","1",strStepName,strMsg)
     			wait 5
				blnObjectError = True
		   	End If
           
      	else
      		strMsg = "SAPUIMenu Not found"
     		strStatus  = "FAIL"
     		wait 5
		 Call ReporterFunction("WebClickers","SelectSAPUIMenu","1",strStepName,strMsg)
                   	blnObjectError = True
      	      
       	end if
  	else
  		 strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUIMenu-- Function Call"
         strStatus  = "FAIL"
         Call ReporterFunction("WebClickers","SelectSAPUIMenu","1",strStepName,strMsg)  
	  end if
	  
	  If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
	  If strStatus = "FAIL"  Then
		SelectSAPUIMenu = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIMenu,FALSE,False,TRUE)
	Else
		SelectSAPUIMenu = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If

End Function
'***********************************************************************************************************************************************************************************************************************************************************************************************
Public Function SelectSAPUIMenuFrame(creationTime,frameTitle,htmlTag,htmlID,name,index,path)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUIMenuFrame"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Select Item :  "&path& " from SAPUIMenu"

    Set objSAPUIMenuFrame= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).SAPUIMenu("name:="&name,"html tag:="&htmltag,"html id:="&htmlID,"index:="&index)
	If name <> "" or htmltag <> "" Then
    	If  objSAPUIMenuFrame.Exist(gObjectTimeoutLimit)  then 
		  
		   objSAPUIMenuFrame.Select path
		   val= objSAPUIMenuFrame.WebElement("html id:=" & htmlID & "-label","html tag:=LABEL").GetROProperty("innertext")
		   
		   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIMenuFrame,False,False,True)
				End If
				
		   	If UCASE(TRIM(val))=  UCASE(TRIM(path)) Then
		   	    strMsg = "SAPUIMenu item " & path & "selected successfully"
		   		strStatus  = "DONE"
                Call ReporterFunction("WebClickers","SelectSAPUIMenuFrame","2",strStepName,strMsg)
		   	else
		   		strMsg = "SAPUIMenu item " & path & " Not found"
		   		strStatus  = "FAIL"
                Call ReporterFunction("WebClickers","SelectSAPUIMenuFrame","1",strStepName,strMsg)
     			wait 5
				
		   	End If
           
      	else
      		strMsg = "SAPUIMenu Not found"
     		strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectSAPUIMenuFrame","1",strStepName,strMsg)
     		wait 5
            blnObjectError = True
      	
       	end if
  	else
  		 strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUIMenu-- Function Call"
         strStatus  = "FAIL"
         Call ReporterFunction("WebClickers","SelectSAPUIMenuFrame","1",strStepName,strMsg)

	  end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

If strStatus = "FAIL"  Then
		SelectSAPUIMenuFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIMenuFrame,FALSE,False,TRUE)
	Else
		SelectSAPUIMenuFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If

End Function

