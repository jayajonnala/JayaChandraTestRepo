'updated
Public Function ClickWebElementSAPList(creationTime,SapAttachedText ,SAPListIndex,val)

	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then 
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementSAPList"

		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If

		Dim objWebElementSAPList
		strStepName   = "Select Item :  "&val& " from List"&SapAttachedText

		Set objWebElementSAPList =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPList("sap attached text:="&SapAttachedText,"html tag:=INPUT","index:=" & SAPListIndex)

		If  objWebElementSAPList.Exist(gObjectTimeoutLimit)  then 
			If SapAttachedText <> ""  Then '*** val can be null, so don't check for val parameter
				objWebElementSAPList.WebElement("innertext:="&val,"index:=0").Click
				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebElementSAPList,False,False,True)
				End if
				strStatus = "DONE"
				strMsg= "Web Element in SAP list clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPList","2",strStepName,strMsg)
				
			Else
			    strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebElementSAPList-- Function Call"
				Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPList","1",strStepName,strMsg)
				strStatus = "FAIL"
	
			End if
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "SAPList: " & SapAttachedText & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPList","1",strStepName,strMsg)
		end if
		
		If  blnObjectError  Then
			Environment.Value("blnFatalError")=True
		End If
		
		If strStatus = "FAIL"  Then
			ClickWebElementSAPList = strMsg
			blnMainFailFlag = True
			ImagePath=CaptureScreenshot(strStepName,objWebElementSAPList,False,False,True)
		Else
			ClickWebElementSAPList = True
		End If
		If blnDefault_eSwiftReporting Then  
			Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
		End If
		
		' //////////Word Document //////////////////////////////////////////////////////////
		'If blnCreateTrainingDoc Then 
		'	Check=CheckStatus_Doc(strStatus)
		'	If Check=1 Then
		'		Call storeCoordinates(objWebElementSAPList)
		'		Call StoreSteps(strStepName)
		'	End If
		'End If
			' //////////Word Document ///////////
		'Set objWebElementSAPList=Nothing
   
End If
