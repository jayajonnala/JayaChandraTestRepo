	If objPage.Exist(gObjectTimeoutLimit) Then
		If sapattachedText<> "" Then
			set oDesc=Description.Create()
			oDesc("micclass").value="SAPList"
			Set list=objPage.ChildObjects(oDesc)
			For i=0 to list.count-1
				If list(i).GetROProperty("sap attached text")=sapattachedText Then
					list(i).click
					LinkCondition = 1
			Exit for
				End If 
			Next
			If LinkCondition=1 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objPage,False,False,True)
				End if
				strStatus = "DONE"
