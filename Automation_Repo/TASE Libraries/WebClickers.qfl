	Set objButton=Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPFrame("title:="&frameTitle).SAPButton("class:="& buttonClass,"name:="& buttonName,"html tag:="& buttonhtmlTag,"index:="& buttonIndex) 
	On Error Resume Next
	If buttonName <> "" or buttonClass<> "" or buttonhtmlTag <> "" Then
		
		If objButton.Exist(gObjectTimeoutLimit)  Then
			objButton.highlight
			objButton.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Button :"&ButtonName& " Clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrame","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
		    strMsg = "Button: " & buttonName & " Not found"
		    Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrame","1",strStepName,strMsg)

		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickSAPButtonSAPFrame-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrame","1",strStepName,strMsg)
	end if
	
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickSAPButtonSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
	Else
		ClickSAPButtonSAPFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objButton=Nothing
End If
End function
