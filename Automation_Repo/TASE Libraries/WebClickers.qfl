'******************************************************************************************************************************
Public Function ClickWebElementWebTableSAPPortalByRef(creationTime,tableClass,tableName,columnNum,refCellVal)

If Not (Environment.Value("blnFatalError") or tableName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementWebTableSAPPortalByRef"
	
	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objWebTable
	Dim cellObj
	strStepName = "Click cell in a WebTable"
	Set objWebTable =Browser("CreationTime:="&PopUpCreationtime).SAPPortal("Index:=" &PopUpCreationtime).WebTable("Html tag:=TABLE","Class:="& tableClass,"name:="& tableName)
	
	If  objWebTable.Exist(gObjectTimeoutLimit) then 
		If columnNum <> "" Then
			On Error Resume Next
			rowNo=objWebTable.GetRowWithCellText(refCellVal)
			If rowNo=-1 Then
				blnObjectError=True
				strStatus = "FAIL"    
				strMsg = refCellVal &  " is not found in the table"	
				Call ReporterFunction(strLibraryFileName,"ClickWebElementWebTableSAPPortalByRef","1",strStepName,strMsg)
			else
				Set cellObj =objWebTable.ChildItem(rowNo,columnNum,"WebElement",0)
				cellObj.click
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,cellObj,True,True,True)
				End if
				strStatus = "DONE"
				strMsg= refCellVal & "in the table clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickWebElementWebTableSAPPortalByRef","2",strStepName,strMsg)
			End If
		else 
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebElementWebTableSAPPortalByRef-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementWebTableSAPPortalByRef","1",strStepName,strMsg)
		end if
	else 
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "WebTable "&tableName& " is not Found, Please verify the Screen"
		Call ReporterFunction(strLibraryFileName,"ClickWebElementWebTableSAPPortalByRef","1",strStepName,strMsg)
	end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebElementWebTableSAPPortalByRef = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,cellObj,True,True,True)
	Else
		ClickWebElementWebTableSAPPortalByRef = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,refCellVal,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebTable)
	'		Call StoreSteps(strStepName)
	'	End If
'End If
   ' //////////Word Document ///////////
	Set objWebTable=Nothing
	Set cellObj = Nothing
End If
End function 
