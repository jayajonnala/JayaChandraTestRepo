Public Function  ClickLinkUniversal(creationTime,windowText,linkName,blnIsItPopup)
If Not (Environment.Value("blnFatalError") or linkName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickLinkUniversal"

	LinkCondition = 0

	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	Dim objPage
	strStepName   = "Click Link: "&linkName

	If blnIsItPopup Then
		Set objPage =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime)
	else
		Set objPage= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
	End If

	If objPage.Exist(gObjectTimeoutLimit) then
		If linkName<> "" Then
			set oDesc=Description.Create()
			oDesc("micclass").value="Link"
			Set list=objPage.ChildObjects(oDesc)			
			For i=0 to list.count-1
				If list(i).getroproperty("name")=linkName Then				
					list(i).click
					LinkCondition = 1
			Exit for		
				End If
			Next
			If LinkCondition=1 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
				End if
				strStatus = "DONE"
				strMsg= "Link: "&linkName &"clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickLinkUniversal","2",strStepName,strMsg)
			Else
				blnObjectError=Tru
				strStatus = "FAIL"    
				strMsg = "Link: " & linkName & " Not found"
				Call ReporterFunction(strLibraryFileName,"ClickLinkUniversal","1",strStepName,strMsg)
			End if
		else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickLinkUniversal-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickLinkUniversal","1",strStepName,strMsg)
		end if
	else
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "Page Not found"
		Call ReporterFunction(strLibraryFileName,"ClickLinkUniversal","1",strStepName,strMsg)
	end if
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickLinkUniversal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLink,True,False,True)
	Else
		ClickLinkUniversal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,linkName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objPage)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objPage=Nothing
End If
End function 
