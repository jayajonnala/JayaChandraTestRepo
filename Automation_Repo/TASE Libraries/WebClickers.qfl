Public Function ClickSAPUITile(creationTime,windowText,tilename,tilehtmaltag,tileindex,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickSAPUITile"

Dim ALMvalue
ALMvalue=Environment.Value("ALMFlag")

If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Click "&tilename

If blnIsItPopup Then
	Set objSAPUITile =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUITile("name:="&tilename,"html tag:="&tilehtmaltag,"index:"&tileindex)
else
    Set objSAPUITile= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUITile("name:="&tilename,"html tag:="&tilehtmaltag,"index:="&tileindex)
   
End If

	If name<> "" OR tilehtmaltag<> ""Then
    	'If  objSAPUITile.Exist(gObjectTimeoutLimit)  then 
    	If  objSAPUITile.Exist Then 
		
			objSAPUITile.highlight
            objSAPUITile.Click
            
            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITile,False,False,True)
				End If
			strMsg = "SAPUITile " 	 &tilename& " is set successfully"
            strStatus  = "DONE"
            Call ReporterFunction("WebClickers","ClickSAPUITile","2",strStepName,strMsg)
      	else
      		strMsg = tilename&" SAPUITile Not found"
     		strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","ClickSAPUITile","1",strStepName,strMsg)
	 	     blnObjectError= True
         	
    	end if
  	else
  		  strMsg = "Function Parameter Not Passed Properly. Check the --ClickSAPUITile-- Function Call"
          strStatus  = "FAIL"
          Call ReporterFunction("WebClickers","ClickSAPUITile","1",strStepName,strMsg)
      
  	end if


If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

If strStatus = "FAIL"  Then
		ClickSAPUITile = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITile,FALSE,False,TRUE)
	Else
		ClickSAPUITile = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If

 End Function
