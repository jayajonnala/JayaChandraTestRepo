Function SelectSAPUITree(creationTime,windowText,htmlTag,htmlId,innertext,className,index,title,path,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUITree"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Navigate through : "&path
If  innertext<>"" or path<>"" or className<>"" or blnIsItPopup<>"" Then
 If blnIsItPopup Then
 	Set objSAPUITree =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:=" & PopUpCreationtime).SAPUITree("class:="&className,"html id:="&htmlId,"html tag:="&htmlTag,"innertext:="&innertext,"title:="&title,"index:="&index)
 Else
	Set objSAPUITree=Browser("CreationTime:="& PopUpCreationtime ).Page("Index:="& PopUpCreationtime).SAPUITree("class:="&className,"html id:="&htmlId,"html tag:="&htmlTag,"innertext:="&innertext,"title:="&title,"index:="&index)
 End If
On Error Resume Next
	If  objSAPUITree.Exist(gObjectTimeoutLimit)   then
		objSAPUITree.highlight
		objSAPUITree.Select path
		
		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITree,False,False,True)
				End If
				
		strStatus  = "DONE"
		strMsg ="Naviagted to "&path&" under the SAP Tree :: "&innertext& " selected"
		Call ReporterFunction("WebClickers","SelectSAPUITree","2",strStepName,strMsg)
	Else
     strMsg ="SAP Tree :: "&innertext& "Missing"
     strStatus  = "FAIL"
     blnObjectError=True
     Call ReporterFunction("WebClickers","SelectSAPUITree","1",strStepName,strMsg)
	 End if
Else
strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUITree-- Function Call"
strStatus  = "FAIL"
Call ReporterFunction("WebClickers","SelectSAPUITree","1",strStepName,strMsg)
End If
If strStatus = "FAIL"  Then
		SelectSAPUITree = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITree,FALSE,False,TRUE)
	Else
		SelectSAPUITree = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,path,strMsg,strStatus,"")
	End If
End If
End Function

