Public Function SelectSAPUITabStripFrame(creationTime,frameTitle,htmlTag,htmlId,innertext,className,TitleOrIndex)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUITabStripFrame"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Select Tab"
if innertext<> "" OR className<> "" then 
    Set objSAPUITabStripFrame= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).SAPUITabStrip("class:="& className,"innertext:="&innertext,"html tag:="&htmlTag ,"htmlId:="&htmlId)
    If  objSAPUITabStripFrame.Exist(gObjectTimeoutLimit)  then 
		If TitleOrIndex<>"" Then
		      objSAPUITabStripFrame.Select TitleOrIndex
              strMsg = "Tab selected Successfully"  
              
               If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITabStripFrame,False,False,True)
				End If
				
              strStatus  = "DONE"
           Call ReporterFunction("WebClickers","SelectSAPUITabStripFrame","2",strStepName,strMsg)
        Else
      		strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUITabStripFrame-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectSAPUITabStripFrame","1",strStepName,strMsg) 
          
       End if
    else 
	   strStatus ="FAIL"
       strMsg = "Tab object is not Found, Please verify the Screen"
       blnObjectError=True
       Call ReporterFunction("WebClickers","SelectSAPUITabStripFrame","1",strStepName,strMsg)   
        
 End If
  Else
      		strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUITabStripFrame-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectSAPUITabStripFrame","1",strStepName,strMsg) 
          
       End if


If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SelectSAPUITabStripFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITabStrip,FALSE,False,TRUE)
	Else
		SelectSAPUITabStripFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If
End Function
