Public Function  ClickSAPButtonSAPFrameUniversal(creationTime,frameTitle,buttonName,htmlID)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickSAPButtonSAPFrameUniversal"

	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	LinkCondition = 0
	Dim objFrame
	strStepName = "Click SAPButton:  "& buttonName
	Set objFrame = Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPFrame("title:="&frameTitle)

	If objFrame.Exist(gObjectTimeoutLimit) Then
		If frameTitle<>"" or  buttonName <>"" or htmlID <> ""  Then
			Set oDesc=Description.Create()
			oDesc("micclass").value="SAPButton"
			Set list=objFrame.ChildObjects(oDesc)
			For i=0 to list.count-1
				If list(i).getroproperty("name")=buttonName Then				
					list(i).click
					LinkCondition = 1
					Exit for
				Else
					If list(i).getRoProperty("html id")=htmlID Then			
						list(i).click
						LinkCondition = 1
						Exit for
					End If
			
				End If
			Next
			
			If LinkCondition=1 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objFrame,True,True,True)
				End if
				strStatus = "DONE"
				strMsg= buttonName&" clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrameUniversal","2",strStepName,strStatus)
			End If
		else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickSAPButtonSAPFrameUniversal-- Function Call"
				Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrameUniversal","1",strStepName,strMsg)
		end if
	else
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "Button: " & buttonName & " Not found"
		Call ReporterFunction(strLibraryFileName,"ClickSAPButtonSAPFrameUniversal","1",strStepName,strMsg)
	end if
	
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickSAPButtonSAPFrameUniversal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objFrame,True,True,True)
	Else
		ClickSAPButtonSAPFrameUniversal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objFrame)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objFrame=Nothing
End If
End function 
