Public Function ClickImageByFileName(creationTime,windowText,Propertyfilename,blnIsItPopup)
LinkCondition = 0

If Not (Environment.Value("blnFatalError") or Propertyfilename = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickImageByFileName"
	ALMvalue=Environment.Value("ALMFlag")

	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	Dim objImageByFileName
	strStepName  = "Click Image "
	If blnIsItPopup Then
		Set objImageByFileName =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime)
	Else
		Set objImageByFileName= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
	End If

	If objImageByFileName.Exist(gObjectTimeoutLimit) then
		If Propertyfilename<> "" Then
			Set oDesc=Description.Create()
			oDesc("micclass").value="Image"
			Set list=objImageByFileName.ChildObjects(oDesc)
			For i=0 to list.count-1
				If list(i).getroproperty("file name")=Propertyfilename Then			
					list(i).Click
					LinkCondition = 1
			Exit for				
				End If
			Next
			If LinkCondition=1 Then

				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objImageByFileName,True,False,True)
				End if
				strStatus = "DONE"
				strMsg= "Image clicked successfully"
				Call ReporterFunction(strLibraryFileName,"ClickImageByFileName","1",strStepName,strMsg)
			Else
				blnObjectError=True
				strStatus = "FAIL"    
				strMsg = "Image: " & Propertyfilename & " Not found"
				Call ReporterFunction(strLibraryFileName,"ClickImageByFileName","1",strStepName,strMsg)
			End If
		Else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickImageByFileName-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickImageByFileName","1",strStepName,strMsg)
		End if
	End if

	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickImageByFileName = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objImageByFileName,True,False,True)
	Else
		ClickImageByFileName = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Propertyfilename,strMsg,strStatus,"")
	End If
	
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objImageByFileName)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objImageByFileName=Nothing
End If
End function 
