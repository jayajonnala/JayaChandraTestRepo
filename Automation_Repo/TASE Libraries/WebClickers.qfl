Public Function ClickWebElementSAPPortal(creationTime,htmlTag,innertext,className,indexNumber)

If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then '*** innertext property should be checked here
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementSAPPortal"

	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	Dim objWebElementSAPPortal
	strStepName = "Click web element "& innerText &" in SAP Portal"

	Set objWebElementSAPPortal =Browser("CreationTime:="&PopUpCreationtime).SAPPortal("Index:=" &PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
	If  objWebElementSAPPortal.Exist(gObjectTimeoutLimit)  then 
		If innertext<> "" OR htmltag<> "" OR className<> "" OR indexNumber <> "" Then
			objWebElementSAPPortal.highlight
			objWebElementSAPPortal.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebElementSAPPortal,False,False,True)
			End if
			strStatus = "DONE"
			strMsg = "WebElement: "& innerText &" Clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPPortal","2",strStepName,strMsg)
		Else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the --ClickWebElementSAPPortal-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPPortal","1",strStepName,strMsg)
		End if
	Else
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "WebElement: " & innertext & " Not found"
		Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPPortal","1",strStepName,strMsg)
	End if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebElementSAPPortal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElementSAPPortal,False,False,True)
	Else
		ClickWebElementSAPPortal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If
' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebElementSAPPortal)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
   ' //////////Word Document ///////////
	Set objWebElementSAPPortal=Nothing
End If
End function 

