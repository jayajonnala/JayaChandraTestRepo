Public Function DoubleClickWebElement(creationTime,windowText,htmltag,innertext,className,indexNumber,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then '*** innertext property should be checked here
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : DoubleClickWebElement"

'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If

	Dim objWebElement
	strStepName  = "DoubleClick WebElement: "&innertext


	If blnIsItPopup Then
		Set objWebElement =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
	else
		Set objWebElement= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
	End If
	If innertext<> "" OR htmltag<> "" OR className<> "" OR indexNumber <> "" Then
		If  objWebElement.Exist(gObjectTimeoutLimit)  then 
'			objWebElement.highlight
			wait 2
			objWebElement.DoubleClick
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Web Element : "&innertext& " clicked successfully"
			Call ReporterFunction(strLibraryFileName,"DoubleClickWebElement","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "WebElement: " & innertext & " Not found"
			Call ReporterFunction(strLibraryFileName,"DoubleClickWebElement","1",strStepName,strMsg) 
			
		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --DoubleClickWebElement-- Function Call"
        Call ReporterFunction(strLibraryFileName,"DoubleClickWebElement","1",strStepName,strMsg )
			
        end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		DoubleClickWebElement = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,True)
	Else
		DoubleClickWebElement = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If
' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebElement)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
   ' //////////Word Document ///////////
	Set objWebElement=Nothing
End If
End function
Public Function ClickWebElementSAPFrame(creationTime,frameTitle,htmlID,innertext,className,indexNumber)

If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then '*** innertext property should be checked here
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementSAPFrame"

'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If

	Dim objWebElementSAPFrame
	strStepName =  "Click Web Element: "& innerText 

	Set objWebElementSAPFrame =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPFrame("title:="&frameTitle).WebElement("class:="& className,"innertext:="&innertext,"html id:="& htmlID ,"index:="& indexNumber)
	If  htmlID<> "" OR className<> ""  Then
		If objWebElementSAPFrame.Exist(gObjectTimeoutLimit) Then 
	
			objWebElementSAPFrame.highlight
			objWebElementSAPFrame.Click
			wait 10
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWebElementSAPFrame,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Web Element "&innerText&" in SAP frame clicked successfully"
			
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPFrame","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "WebElement: " & innertext & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPFrame","1",strStepName,strMsg) 

		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ClickWebElementSAPFrame-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickWebElementSAPFrame","1",strStepName,strMsg)
	end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebElementSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElementSAPFrame,False,False,True)
	Else
		ClickWebElementSAPFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If
' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objWebElementSAPFrame)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
   ' //////////Word Document ///////////
	Set objWebElement=Nothing
End If
End function 

