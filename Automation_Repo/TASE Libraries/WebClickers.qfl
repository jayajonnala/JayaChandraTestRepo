Public Function ClickImage(creationTime,windowText,imageClass,imageAlt,imageType,imageIndex,blnIsItPopup)'*** change it to imageIndex

If Not (Environment.Value("blnFatalError") or imageAlt = DS_SKIP) Then 
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickImage"

	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objImage
	strStepName  = "Click Image "&imageAlt
	
	If blnIsItPopup Then
		Set objImage =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).Image("alt:="&imageAlt,"image type:="&imageType,"html tag:=IMG","class:="& imageClass,"index:="&imageIndex)
	else
		Set objImage= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Image("alt:="&imageAlt,"image type:="&imageType,"html tag:=IMG","class:="& imageClass,"index:="&imageIndex)
	End If
	If imageClass <> "" OR imageAlt <>"" OR imageType <>""  Then
		If  objImage.Exist(gObjectTimeoutLimit)  then 
		
			objImage.highlight
			objImage.Click
			wait 10
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objImage,False,False,True)
			End if
			strStatus = "DONE"
			strMsg= "Image clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickImage","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Image: " & imageAlt & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickImage","1",strStepName,strMsg)

		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickImage-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickImage","1",strStepName,strMsg)
	end if
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickImage = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objImage,False,False,True)
	Else
		ClickImage = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,imageAlt,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objImage)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objImage=Nothing
End If
End function 

