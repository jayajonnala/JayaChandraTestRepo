Function OpenSAPUIToolbar(creationTime,windowText,htmlTag,htmlId,innertext,className,index,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : OpenSAPUIToolbar"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
Else
	PopUpCreationtime=Cint(creationTime)
End If    
If htmlId<>"" and htmlTag<>"" and innertext<>"" and className<>""  Then
strStepName = "Open SAPUIToolbar "&innertext
  If blnIsItPopup Then
	Set objToolbar =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUIToolbar("htmlTag:="&htmlTag,"htmlId:="&htmlId,"innertext:="&innertext,"class:="&className,"index:="&index)
  Else
    Set objToolbar= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUIToolbar("htmlTag:="&htmlTag,"htmlId:="&htmlId,"innertext:="&innertext,"class:="&className,"index:="&index)
  End If
  On Error Resume Next
   If objToolbar.Exist(gObjectTimeoutLimit ) Then
   		objToolbar.OpenOverflow
   		
   		 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objToolbar,False,False,True)
				End If
				
   		strStatus  = "DONE"
		strMsg = "SAPUIToolbar:"& innertext &"opened"
		Call ReporterFunction("WebClickers","OpenSAPUIToolbar","2",strStepName,strMsg)
   Else
   		strMsg = "SAPUIToolbar:"& innertext &" not found"
		strStatus  = "FAIL"
		blnObjectError=True
   		Call ReporterFunction("WebClickers","OpenSAPUIToolbar","1",strStepName,strMsg)
   End If
Else
	 strMsg = "Function Parameter Not Passed Properly. Check the -OpenSAPUIToolbar-- Function Call"
	 strStatus  = "FAIL"
	 
     Call ReporterFunction("WebClickers","OpenSAPUIToolbar","1",strStepName,strMsg)	 
End If
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		OpenSAPUIToolbar = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objToolbar,FALSE,False,TRUE)
	Else
		OpenSAPUIToolbar = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If
End Function

