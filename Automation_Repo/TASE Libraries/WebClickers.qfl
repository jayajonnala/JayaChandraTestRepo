				Call ReporterFunction(strLibraryFileName,"ClickSAPListUniversal","2",strStepName,strMsg)
			else
				blnObjectError=True
				strStatus = "FAIL"    
				strMsg = "List: " & sapattachedText & " Not found"
				Call ReporterFunction(strLibraryFileName,"ClickSAPListUniversal","1",strStepName,strMsg)
			end if
		Else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickSAPListUniversal-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickSAPListUniversal","1",strStepName,strMsg)
		end if
	else
		blnObjectError=True
		strStatus = "FAIL"
		strMsg = "Page missing"
		Call ReporterFunction(strLibraryFileName,"ClickSAPListUniversal","1",strStepName,strMsg)
	end if
	
	
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickSAPListUniversal = strMsg
		blnMainFailFlag = True
