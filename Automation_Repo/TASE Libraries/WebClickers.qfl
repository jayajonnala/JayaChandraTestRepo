Public Function SelectCellSAPUITable(creationTime,windowText,htmlTag,htmlId,title,className,index,rowNumber,columnName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellSAPUITable"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Select cell in a WebTable"
if title<> "" OR className<> "" then 
If blnIsItPopup Then

	Set objCellSAPUITable =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUITable("class:="& className,"title:="&title,"html tag:="&htmlTag ,"htmlId:="&htmlId ,"index:="& index)
else
    Set objCellSAPUITable= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUITable("class:="& className,"title:="&title,"html tag:="&htmlTag ,"htmlId:="&htmlId ,"index:="& index)
End If
    If  objCellSAPUITable.Exist(gObjectTimeoutLimit)  then 
		If rowNumber<>"" OR columnName<>"" Then
              objCellSAPUITable.SelectCell rowNumber,columnName
             
                           
              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objCellSAPUITable,False,False,True)
				End If
			   strMsg = "Table cell selected Successfully"     
              strStatus  = "DONE"
              Call ReporterFunction("WebClickers","SelectCellSAPUITable","2",strStepName,strMsg)
        Else
      		strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellSAPUITable-- Function Call"
            strStatus  = "FAIL"
           Call ReporterFunction("WebClickers","SelectCellSAPUITable","1",strStepName,strMsg) 
       End if
    else 
	   strStatus ="FAIL"
       strMsg = "WebTable object is not Found, Please verify the Screen"
       blnObjectError=True
      Call ReporterFunction("WebClickers","SelectCellSAPUITable","1",strStepName,strMsg)   
 End If
  Else
      		strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellSAPUITable-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectCellSAPUITable","1",strStepName,strMsg) 
       End if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectCellSAPUITable = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objCellSAPUITable,FALSE,False,TRUE)
	Else
		SelectCellSAPUITable = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If
End Function
'****************************************************************************************************************************************************************************************************************************************************************************************************
Public Function SelectCellSAPUITableByRefColumn(creationTime,windowText,htmlTag,htmlId,title,className,index,columnName,refColumnName,refCellVa,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellSAPUITableByRefColumn"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Select cell in a WebTable"
if title<> "" OR className<> "" then 
If blnIsItPopup Then

	Set objCellSAPUITable =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUITable("class:="& className,"title:="&title,"html tag:="&htmlTag ,"htmlId:="&htmlId ,"index:="& index)
else
    Set objCellSAPUITable= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUITable("class:="& className,"title:="&title,"html tag:="&htmlTag ,"htmlId:="&htmlId ,"index:="& index)
End If
    If  objCellSAPUITable.Exist(gObjectTimeoutLimit)  then 
		If columnName<>"" OR refColumnName<>"" OR refCellVal<>"" Then
		Dim row
		      row=objCellSAPUITable.FindRowByCellContent(refColumnName,refCellVal)
              objCellSAPUITable.SelectCell row,columnName
                 


				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objCellSAPUITable,False,False,True)
				End If
			  strMsg = "Table cell selected Successfully"	
              strStatus  = "DONE"
           Call ReporterFunction("WebClickers","SelectCellSAPUITableByRefColumn","2",strStepName,strMsg)
        Else
      		strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellSAPUITableByRefColumn-- Function Call"
            strStatus  = "FAIL"
          Call ReporterFunction("WebClickers","SelectCellSAPUITableByRefColumn","1",strStepName,strMsg) 
       End if
    else 
	   strStatus ="FAIL"
       strMsg = "WebTable object is not Found, Please verify the Screen"
       blnObjectError=True
       Call ReporterFunction("WebClickers","SelectCellSAPUITableByRefColumn","1",strStepName,strMsg)   
 End If
  Else
             strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellSAPUITableByRefColumn-- Function Call"
            strStatus  = "FAIL"
            Call ReporterFunction("WebClickers","SelectCellSAPUITableByRefColumn","1",strStepName,strMsg) 
       End if
       


If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SelectCellSAPUITableByRefColumn = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objCellSAPUITable,FALSE,False,TRUE)
	Else
		SelectCellSAPUITableByRefColumn = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,refCellVal,strMsg,strStatus,"")
	End If	
End If

End Function
