Public Function  ClickWebButtonSAPPortalSAPFrame(creationTime,frameTitle,buttonClass,buttonName,buttonHtmlTag,buttonIndex)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebButtonSAPPortalSAPFrame"
	
	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If

	Dim objButton
	strStepName = "Click Button :"&buttonName &"in SAP portal"
	Set objButton=Browser("CreationTime:=" &PopUpCreationtime).SAPPortal("Index:=" &PopUpCreationtime).SAPFrame("title:="&frameTitle).WebButton("class:="&buttonClass,"name:="&buttonName,"html tag:=" &buttonHtmlTag,"index:="& buttonIndex)
	
	If objButton.Exist(gObjectTimeoutLimit)  Then
		If frameTitle<>"" and  buttonName <>"" Then
			objButton.highlight
			objButton.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Button :"&buttonName& " Clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWebButtonSAPPortalSAPFrame","2",strStepName,strMsg)
		else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -ClickWebButtonSAPPortalSAPFrame-- Function Call"
			Call ReporterFunction(strLibraryFileName,"ClickWebButtonSAPPortalSAPFrame","1",strStepName,strMsg)
		end if
	else
		blnObjectError=True
		strStatus = "FAIL"    
		strMsg = "Button: " & buttonName & " Not found"
		Call ReporterFunction(strLibraryFileName,"ClickWebButtonSAPPortalSAPFrame","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWebButtonSAPPortalSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
	Else
		ClickWebButtonSAPPortalSAPFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set objButton=Nothing
End If
End function 
