Function  ClickSAPUIButtonFrame(creationTime,frameTitle,htmlTag,innertext,className,index)

LinkCondition = 0

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickSAPUIButtonFrame"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
 strStepName = "Click Button:  "&innertext
If frameTitle<>"" and  innertext <>"" Then
	Set objSAPUIButtonFrame=Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).Frame("title:="&frameTitle).SAPUIButton("class:="&className,"innertext:="&innertext,"html tag:=" &htmlTag,"index:="& index)
	On Error Resume Next
	If objSAPUIButtonFrame.Exist(gObjectTimeoutLimit)  Then
		objSAPUIButtonFrame.highlight
		objSAPUIButtonFrame.Click
	 	strMsg ="Button :"&innertext& "is Clicked"
	 	
	 	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIButtonFrame,False,False,True)
				End If
				
	 	strStatus  = "DONE"
        Call ReporterFunction("WebClickers","ClickSAPUIButtonFrame","2",strStepName,strMsg)
	Else
		strMsg = "Button :"&innertext& "Object Missing"
		strStatus  = "FAIL"
        Call ReporterFunction("WebClickers","ClickSAPUIButtonFrame","1",strStepName,strMsg)
		blnObjectError =True
	End If
Else
	strMsg = " Function Parameter Not Passed Properly. Check the --ClickSAPUIButtonFrame-- Function Call"
	strStatus  = "FAIL"
	 Call ReporterFunction("WebClickers","ClickSAPUIButtonFrame","1",strStepName,strMsg)
End If

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If


If strStatus = "FAIL"  Then
		ClickSAPUIButtonFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIButtonFrame,FALSE,False,TRUE)
	Else
		ClickSAPUIButtonFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If	
End If

End Function
