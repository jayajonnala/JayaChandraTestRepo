	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickImageUniversal"
	
	ALMvalue=Environment.Value("ALMFlag")
	If  ALMvalue=1 Then
		PopUpCreationtime=Cint(creationTime) + 1
	else
		PopUpCreationtime=Cint(creationTime)
	End If
	
	Dim objImageUniversal
	strStepName   ="Click on the image: " & ImageAlt
	
	If blnIsItPopup Then
		Set objImageUniversal =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).Image("alt:="&ImageAlt,"index:="&iImageIndex)
	else
		Set objImageUniversal= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Image("alt:="&ImageAlt,"index:="&iImageIndex)
	End If
	If ImageAlt<>"" and iImageIndex<>"" Then
		If objImageUniversal.Exist(gObjectTimeoutLimit) Then
		
			objImageUniversal.Highlight
			objImageUniversal.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objImageUniversal,True,True,True)
			End if
			Call ReporterFunction(strLibraryFileName,"ClickImageUniversal","2",strStepName,"Value Used :-"& vbNewLine &"Image Name: "&ImageAlt& vbNewLine &"BlnIsItPopup: " &blnIsItPopup)
			strStatus = "DONE"
			strMsg=  "Image : "&ImageAlt&" Clicked successfully"
		else
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"ClickImageUniversal","1",strStepName,"Image Name: " & ImageAlt & " Not found") 
			strStatus = "FAIL"    
			strMsg = "Image: " & ImageAlt & " Not found"
		

		end if
	else
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ClickImageUniversal-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickImageUniversal","1",strStepName,strMsg)

	end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickImageUniversal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objImageUniversal,True,True,True)
	Else
		ClickImageUniversal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,ImageAlt,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objImageUniversal)
	'		Call StoreSteps(strStepName)
