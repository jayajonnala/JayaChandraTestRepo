		PopUpCreationtime=Cint(creationTime)
'	End If
	
	Dim objLink
	strStepName = "Click Link :"& Replace(LinkText,"\","")&" In Portal"
	
	If blnIsItPopup Then
		Set objLink =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).Link("class:="&linkClass, "name:="&LinkText)
	else
		Set objLink= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Link("class:="&linkClass, "text:="&LinkText)
	End If
	
	If LinkText<>"" Then 
