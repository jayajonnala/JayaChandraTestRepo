Function SetDateSAPUICalendar(creationTime,windowText,htmltag,innertext,className,index,val,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetDateSAPUICalendar"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
Else
	PopUpCreationtime=Cint(creationTime)
End If    
strStepName = "Set Date: " & val & " in calendar"
If innertext <> "" or val <> "" or className <> "" Then
   If blnIsItPopup Then
	Set objDateSAPUICalendar =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:=" & PopUpCreationtime).SAPUICalendar("class:="&className,"html tag:="&htmltag,"index:="&index)
   Else
    Set objDateSAPUICalendar =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUICalendar("class:="&className,"html tag:="&htmltag,"index:="&index)
   End If
   On Error Resume Next
   If  objDateSAPUICalendar.Exist(gObjectTimeoutLimit)   then 
   	 objDateSAPUICalendar.SetDate val
	  wait(8)
	  objDateSAPUICalendar.Click
	  
	  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
			ImagePath=CaptureScreenshot(strStepName,objDateSAPUICalendar,False,False,True)
	  End if
	  			            
      strStatus  = "DONE"
      strMsg ="Calendar "&innertext&" is set to "&val
      Call ReporterFunction("WebSetters","SetDateSAPUICalendar","2",strStepName,strMsg)
   Else
     strMsg ="Calendar Object Missing"
     strStatus  = "FAIL"
     blnObjectError=True
	 Call ReporterFunction("WebSetters","SetDateSAPUICalendar","1",strStepName,strMsg)
   End If
Else
    strMsg = "Function Parameter Not Passed Properly. Check the --SetDateSAPUICalendar -- Function Call"
    strStatus  = "FAIL"
    Call ReporterFunction("WebSetters","SetDateSAPUICalendar","1",strStepName,strMsg)
End If

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

If strStatus = "FAIL"  Then
		SelectSAPUIList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objDateSAPUICalendar,FALSE,False,TRUE)
	Else
		SelectSAPUIList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

End If
End Function
'*****************************************************************************************************************************************************************************************************************************************************************************************************'***************************************************************************************************************************************************************************************************

