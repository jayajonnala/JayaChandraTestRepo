Public Function SetSAPEdit(creationTime,SAPAttachedtext,SAPEditTexttype,SAPEditIndex,val)

	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
     		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPEdit"
	
'		ALMvalue=Environment.Value("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objSAPEdit
		strStepName = "Set text box :"& SAPAttachedtext
		If SAPAttachedtext<> ""  or SAPEditTexttype <> "" or SAPEditIndex <> "" Then
			Set objSAPEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPEdit("sap attached text:="& SAPAttachedtext,"type:="& SAPEditTexttype,"index:="&SAPEditIndex)
 			If  objSAPEdit.Exist(gObjectTimeoutLimit)  then 
				objSAPEdit.Click
				objSAPEdit.Set val
				Wait(1)
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,True)
				End if
				strStatus = "DONE"
				strMsg= "SAPEdit value set successfully"
				Call ReporterFunction(strLibraryFileName,"SetSAPEdit","2",strStepName,strMsg)
			else
				blnObjectError=True
        		strStatus = "FAIL"	
        		strMsg = "SAPEdit: " & SAPAttachedtext & " Not found"
        		Call ReporterFunction(strLibraryFileName,"SetSAPEdit","1",strStepName,strMsg)
        		
    		end if
		else
				strStatus = "FAIL"
				strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPEdit-- Function Call"
				Call ReporterFunction(strLibraryFileName,"SetSAPEdit","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetSAPEdit = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,True)
	Else
		SetSAPEdit = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	Set objSAPEdit=Nothing
	
	End If
End function

