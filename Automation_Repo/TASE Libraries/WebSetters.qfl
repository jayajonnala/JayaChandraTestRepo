Public Function SetCellDataSAPTable(creationTime,tableClass,tableHtmlTag,tableName,tableIndex,rowNum,colNum,cellVal)
	If Not (Environment.Value("blnFatalError") or cellVal = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetCellDataSAPTable"

		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If

		Dim objTableCell
		strStepName ="Set value: " & cellVal & "  in SAP Table"
		If tableClass <> ""  or rowNum <> "" or colNum <>"" Then
			Set objTableCell =Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPTable("class:="& tableClass,"html tag:="& tableHtmlTag,"name:=" & tableName,"Index:=" & tableIndex)
			If  objTableCell.Exist(gObjectTimeoutLimit)  then 
         		If rowNum<> "" and colNum<>"" Then
					rowNum = Cint(rowNum)
             		colNum = Cint(colNum)
             		objTableCell.SetCellData rowNum,colNum,cellVal
             		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,objTableCell,False,False,True)
					End if
					strStatus = "DONE"
					strMsg= "Value set in table successfully"
					Call ReporterFunction(strLibraryFileName,"SetCellDataSAPTable","2",strStepName,strMsg)
				else
               		strStatus = "FAIL"
               		strMsg = "Function Parameter Not Passed Properly. Check the -SetCellDataSAPTable-- Function Call"
               		Call ReporterFunction(strLibraryFileName,"SetCellDataSAPTable","1",strStepName,strMsg)
    			end if
 		else
			blnObjectError=True
            strStatus = "FAIL"
            strMsg = "Table object not found"
            Call ReporterFunction(strLibraryFileName,"SetCellDataSAPTable","1",strStepName,strMsg)
 		end if
	End if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetCellDataSAPTable = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTableCell,False,False,True)
	Else
		SetCellDataSAPTable = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,cellVal,strMsg,strStatus,"")
	End If

	Set objTableCell=Nothing
	
	End If
End function

