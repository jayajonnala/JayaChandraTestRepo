Public Function ClickFrameSAPButton(creationTime,FrameTitle,buttonName,buttonhtmlTag,buttonIndex)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickFrameSAPButton"
	
'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If
	

	Dim objButton
	strStepName = "Click " & " '" & buttonName & "' " & " Button"
	Set objButton=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="& FrameTitle).SAPButton("name:="& buttonName,"html tag:="& buttonhtmlTag,"index:="& buttonIndex)  
	
	If buttonName <>  "" or buttonhtmlTag <> "" or buttonIndex <> "" Then
		If  objButton.Exist(gObjectTimeoutLimit)  then 
			wait(1)
			objButton.Highlight
			objButton.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Button :" &buttonName&" clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickFrameSAPButton","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Button: " & buttonName & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickFrameSAPButton","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickFrameSAPButton-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickFrameSAPButton","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickFrameSAPButton = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
	Else
		ClickFrameSAPButton = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	
	Set objButton=Nothing
End If
End function 


Public Function SelectCellFrameSAPTable(creationTime,FrameTitle,tableHtmlTag,tableName,tableIndex,rowNum,colNum)
If Not (Environment.Value("blnFatalError") or colNum= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellFrameSAPTable"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
strStepName ="Select cell in SAP Table"
Dim objFrameSAPTable
Set objFrameSAPTable =Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).Frame("title:="& FrameTitle).SAPTAble("html tag:="& tableHtmlTag,"name:=" & tableName,"Index:=" & tableIndex)
    If  objFrameSAPTable.Exist(gObjectTimeoutLimit)  then 
         If rowNum<> "" and colNum<>"" Then
             rowNum = Cint(rowNum)
             colNum = Cint(colNum)
             objFrameSAPTable.SelectCell rowNum,colNum
             
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objFrameSAPTable,False,False,True)
			 End if
			 
			 strStatus = "DONE"
			 strMsg = "Cell selected successfully"
			 Call ReporterFunction(strLibraryFileName,"SelectCellFrameSAPTable","2",strStepName,strMsg)
             
        else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SelectCellFrameSAPTable-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SetTextBox","1",strStepName,strMsg)
	    end if
   else
 	    blnObjectError=True
		strStatus = "FAIL"
		strMsg = "Table object not found"
		Call ReporterFunction(strLibraryFileName,"SelectCellFrameSAPTable","1",strStepName,strMsg)
 end if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
		SelectCellFrameSAPTable = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objFrameSAPTable,False,False,True)
Else
		SelectCellFrameSAPTable = True
End If
If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,colNum,strMsg,strStatus,"")
End If
	' //////////Word Document ///////////
		'	If blnCreateTrainingDoc Then
		'		   Check=CheckStatus_Doc(strStatus)
		'		   If Check=1 Then
		'				  Call storeCoordinates(objFrameSAPTable)
		'				  Call StoreSteps(strStepName)
		'		   End If
		'	End If
	 ' //////////Word Document ///////////
	 Set objFrameSAPTable=Nothing
	End if
End Function


