Function SetSAPUICheckBox(creationTime,windowText,checkboxName,checkboxHtmlTag,checkboxIndex,className,state,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPUICheckBox"

'ALMvalue=Environment.Value("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'Else
	PopUpCreationtime=Cint(creationTime)
'End If    
strStepName = "Set SAPUICheckBox "&checkboxName & ":" & state
'state = InputValidation(state)
If checkboxName<>"" or checkboxHtmlTag<>"" or state<>"" or className<>"" or blnIsItPopup<>"" Then
  If blnIsItPopup Then
	Set objSAPUICheckBox =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:=" & PopUpCreationtime).SAPUICheckBox("class:="&className,"htmlTag:="&checkboxHtmlTag,"name:="&checkboxName,"index:="&checkboxIndex)
   Else
    Set objSAPUICheckBox =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).SAPUICheckBox("class:="&className,"htmlTag:="&checkboxHtmlTag,"name:="&checkboxName,"index:="&checkboxIndex)
   End If
  	On Error Resume Next
    If objSAPUICheckBox.Exist(gObjectTimeoutLimit)  Then
     If objSAPUICheckBox.GetROProperty("disabled")=0 Then
                      If  objSAPUICheckBox.GetROProperty("checked")=0 and state="ON" Then
							objSAPUICheckBox.set "ON"
							
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBox,False,False,True)
	  			            End if
							strStatus="DONE"
							strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							Call ReporterFunction("WebSetters","SetSAPUICheckBox","2",strStepName,strMsg)
                      ElseIf objSAPUICheckBox.GetROProperty("checked")=1 and state="ON" Then
							strStatus="DONE"
							
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBox,False,False,True)
	  			            End if
	  			            
							strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							Call ReporterFunction("WebSetters","SetSAPUICheckBox","2",strStepName,strMsg)
                      ElseIf  objSAPUICheckBox.GetROProperty("checked")=1 and state="OFF" Then
							 objSAPUICheckBox.set "OFF"
							 
							 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBox,False,False,True)
	  			            End if
	  			            
							 strStatus="DONE"
							 strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							 Call ReporterFunction("WebSetters","SetSAPUICheckBox","2",strStepName,strMsg)
					  Else
							 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBox,False,False,True)
	  			            End if
							 strStatus="DONE"
							 strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							 Call ReporterFunction("WebSetters","SetSAPUICheckBox","2",strStepName,strMsg)
                      End If     
      Else 
			  strStatus="FAIL"
              strMsg ="Check Box is disabled ."
              Call ReporterFunction("WebSetters","SetSAPUICheckBox","2",strStepName,strMsg)        			
      End If
    Else 
         strStatus="FAIL"
         strMsg = " The Check Box Object is not Found, Please verify the Screen"
         blnObjectError=True
         Call ReporterFunction("WebSetters","SetSAPUICheckBox","1",strStepName,strMsg)         
   End If
 Else 
       strStatus="FAIL"
       strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       Call ReporterFunction("WebSetters","SetSAPUICheckBox","1",strStepName,strMsg)
 End If 
 
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
 
 If strStatus = "FAIL"  Then
		SelectSAPUIList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBox,FALSE,False,TRUE)
	Else
		SelectSAPUIList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,state,strMsg,strStatus,"")
	End If	
End If
End Function
'**************************************************************************************************************************************************************************************************************************************************************************************
Function SetSAPUICheckBoxFrame(creationTime,frameTitle,checkboxName,checkboxHtmlTag,checkboxIndex,className,state)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPUICheckBoxFrame"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
Else
	PopUpCreationtime=Cint(creationTime)
End If    
strStepName = "Set SAPUICheckBox "&checkboxName&" in the frame with title "&frameTitle & ":" & state
'state = InputValidation(state)
If checkboxName<>"" and checkboxHtmlTag<>"" and state<>"" and className<>"" and blnIsItPopup<>"" Then
    Set objSAPUICheckBoxFrame=Browser("CreationTime:="& PopUpCreationtime ).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).SAPUICheckBox("class:="&className,"html tag:="&checkboxHtmlTag,"name:="&checkboxName,"index:="&checkboxIndex)
    On Error Resume Next
    If objSAPUICheckBoxFrame.Exist(gObjectTimeoutLimit)  Then
     If objSAPUICheckBoxFrame.GetROProperty("disabled")=0 Then
                      If  objSAPUICheckBoxFrame.GetROProperty("checked")=0 and state="ON" Then
							objSAPUICheckBoxFrame.set "ON"
							
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBoxFrame,False,False,True)
	  			            End if
	  			            
							strStatus="DONE"
							strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","2",strStepName,strMsg)
                      ElseIf objSAPUICheckBoxFrame.GetROProperty("checked")=1 and state="ON" Then
                      
                            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBoxFrame,False,False,True)
	  			            End if
                      
							strStatus="DONE"
							strMsg = "SAPUICheckBox:"& checkboxName &" Set"&state
							Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","2",strStepName,strMsg)
                      ElseIf  objSAPUICheckBoxFrame.GetROProperty("checked")=1 and state="OFF" Then
							 objSAPUICheckBoxFrame.set "OFF"
							 strStatus="DONE"
							 
							 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBoxFrame,False,False,True)
	  			            End if
	  			            
							 strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							 Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","2",strStepName,strMsg)
					  Else
					         If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBoxFrame,False,False,True)
	  			            End if
							 strStatus="DONE"
							 strMsg = "SAPUICheckBox:"& checkboxName &" Set"
							 Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","2",strStepName,strMsg)
                      End If     
      Else 
			  strStatus="FAIL"
              strMsg ="Check Box is disabled ."
              Call ReporterFunction("2",strStepName,strMsg)        			
      End If
    Else 
         strStatus="FAIL"
         strMsg = " The Check Box Object is not Found, Please verify the Screen"
         blnObjectError=True
         Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","1",strStepName,strMsg)         
   End If
 Else 
       strStatus="FAIL"
       strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       Call ReporterFunction("WebSetters","SetSAPUICheckBoxFrame","1",strStepName,strMsg)
 End If
 
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SelectSAPUIList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUICheckBoxFrame,FALSE,False,TRUE)
	Else
		SelectSAPUIList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,state,strMsg,strStatus,"")
	End If	 
End If
End Function
