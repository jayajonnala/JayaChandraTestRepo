Function SelectSAPUIList(creationTime,windowText,htmltag,className,textOrname,index,itemText,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPUIList"
' SetCellDataSAPTable(creationTime, tableClass, tableHtmlTag, tableName, tableIndex, rowNum, colNum, cellVal)
SetCellDataSAPTable
	
'ALMvalue=Environment.Value("ALMFlag")
'If  ALMvalue=1 Then
'	PopUpCreationtime=Cint(creationTime) + 1
'Else
'	PopUpCreationtime=Cint(creationTime)
'End If    
strStepName = " Select SAPUIList "&innertext

If textOrname<>"" or htmlTag<>"" or itemText<>"" or blnIsItPopup<>"" Then
  If blnIsItPopup Then
	Set objSAPUIList =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:=" & PopUpCreationtime).SAPList("name:="& textOrname,"class:="&className,"html tag:="& htmltag,"index:=" & index)
  Else
    Set objSAPUIList =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).SAPList("name:="& textOrname,"class:="&className,"html tag:="& htmltag,"index:=" & index)
  End If
  On Error Resume Next
	If objSAPUIList.Exist(gObjectTimeoutLimit)  Then
	    objSAPUIList.Select itemText
	    
	     If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIList,False,False,True)
	  			End if
	  			
	    strStatus  = "DONE"
		strMsg = "SAPUIList:"& innertext &" selected"
		Call ReporterFunction("WebSetters","SelectSAPUIList","2",strStepName,strMsg)
   Else
   		strMsg = "SAPUIList:"& innertext &" not found"
		strStatus  = "FAIL"
	     blnObjectError=True
   		Call ReporterFunction("WebSetters","SelectSAPUIList","1",strStepName,strMsg)
   End If
Else
	 strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPUIList-- Function Call"
	 strStatus  = "FAIL"
     Call ReporterFunction("WebSetters","SelectSAPUIList","1",strStepName,strMsg)	 
End If	

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectSAPUIList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIList,FALSE,False,TRUE)
	Else
		SelectSAPUIList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,itemText,strMsg,strStatus,"")
	End If	

End If

End Function
