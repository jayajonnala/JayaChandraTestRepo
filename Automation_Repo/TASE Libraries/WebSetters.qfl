	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetWebEditFrame"

'		ALMvalue=Environment.Value("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objWebEdit
		strStepName = "Set text box : "& webeditName
		If webeditName<> ""  or webeditTexttype <> "" or webeditIndex <> "" Then
		
		Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:=" & frameTitle).Highlight
		
			Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:=" & frameTitle).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
'			objWebEdit.Click
			objWebEdit.Fireevent "ondblclick"
 			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
				Wait 5
				objWebEdit.set val
				Wait(1)
				objWebEdit.Click
				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
				End if
             	strStatus = "DONE"
	          	strMsg= "Web Edit value set successfully"
	          	Call ReporterFunction(strLibraryFileName,"SetWebEditFrame","2",strStepName,strMsg)
  		else
  			blnObjectError=True
            strStatus = "FAIL"
            strMsg = "Object Missing--Check the Screen Properly"
            Call ReporterFunction(strLibraryFileName,"SetWebEditFrame","1",strStepName,strMsg)
		end if
	else
       		
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -SetWebEditFrame-- Function Call"
            Call ReporterFunction(strLibraryFileName,"SetWebEditFrame","1",strStepName,strMsg)
	end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetWebEditFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
	Else
		SetWebEditFrame = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If


	Set objWebEdit=Nothing
	
	End If
End function

Public Function ClickWinObject(creationTime,DialogregexpwndtitleVal,WinObjregexpwndtitle,NativeClassVal)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWinObject"
	
'	ALMvalue=Environment.Value("ALMFlag")
'	If  ALMvalue=1 Then
'		PopUpCreationtime=Cint(creationTime) + 1
'	else
		PopUpCreationtime=Cint(creationTime)
'	End If
	

	Dim objWinButton
	strStepName = "Click " & " '" & buttonName & "' " & " Button"
	Set objWinButton=Browser("CreationTime:="& PopUpCreationtime).Dialog("regexpwndtitle:="& DialogregexpwndtitleVal).WinObject("regexpwndtitle:=" &WinObjregexpwndtitle,"nativeclass:=" &NativeClassVal)
	
	If DialogregexpwndtitleVal <> "" or WinObjregexpwndtitle <> "" Then
		If  objWinButton.Exist(gObjectTimeoutLimit)  then 
			wait(1)
			objWinButton.Highlight
			objWinButton.Click
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objWinButton,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Button :" &buttonName&" clicked successfully"
			Call ReporterFunction(strLibraryFileName,"ClickWinObject","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Button: " & buttonName & " Not found"
			Call ReporterFunction(strLibraryFileName,"ClickWinObject","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -ClickWinObject-- Function Call"
		Call ReporterFunction(strLibraryFileName,"ClickWinObject","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		ClickWinObject = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWinButton,True,True,True)
	Else
		ClickWinObject = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,buttonName,strMsg,strStatus,"")
	End If
	
	Set objWinButton=Nothing
End If
End function 

