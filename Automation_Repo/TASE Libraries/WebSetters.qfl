Public Function SetSAPUIListFrame(creationTime,frameTitle,htmlTag,htmlId,name,index,itemText)


If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPUIListFrame"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName = "Set item in:  "&itemText& " from SAPUIList"
Set objSAPUIListFrame= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).SAPUIList("name:="&name,"html tag:="&htmltag,"html id:="&htmlId,"index:="&index)

If name <> "" or itemText <> "" Then
    If  objSAPUIListFrame.Exist(gObjectTimeoutLimit )  then 
		objSAPUIListFrame.Select itemText
		
		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIListFrame,False,False,True)
	  			End if
	  			
	  		strMsg = "SAPUIList:" &name& " is set"
            strStatus  = "DONE"
            Call ReporterFunction("WebSetters","SetSAPUIListFrame","2",strStepName,strMsg)
    else
         strMsg = "SAPUIList: Not found"
     	strStatus  = "FAIL"
        Call ReporterFunction("WebSetters","SetSAPUIListFrame","1",strStepName,strMsg)
     	blnObjectError=True
	 	
    end if
else
	strMsg = "Function Parameter Not Passed Properly. Check the --SetSAPUIListFrame-- Function Call"
    strStatus  = "FAIL"
    Call ReporterFunction("WebSetters","SetSAPUIListFrame","1",strStepName,strMsg)
end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SetSAPUIListFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIListFrame,FALSE,False,TRUE)
	Else
		SetSAPUIListFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,itemText,strMsg,strStatus,"")
	End If	
End If
End Function
'************************************************************************************************************************************************************************************************************************************************************************************

Public Function SetSAPUIList(creationTime,windowText,htmltag,innerText,className,index,itemText,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPUIList"
	
ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
stepName = "Select Item :  "&itemText& " from SAPUIList"
If blnIsItPopup Then
	Set objSAPUIList =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("index:="& PopUpCreationtime).SAPUIList("class:="&className,"html tag:="&htmltag,"innertext:="&innerText,"index:="&index)
else
    Set objSAPUIList= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUIList("class:="&className,"html tag:="&htmltag,"innertext:="&innerText,"index:="&index)
End If
If className <> "" or itemText <> "" Then
    If  objSAPUIList.Exist(gObjectTimeoutLimit )  then 
		objSAPUIList.Select itemText
		
		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUIList,False,False,True)
	  			End if
	  		strMsg = "SAPUIList: " &name& " is set"	
           strStatus  = "DONE"
          Call ReporterFunction("WebSetters","SetSAPUIList","1",strStepName,strMsg)
    else
        strMsg = "SAPUIList: Not found"
     	strStatus  = "FAIL"
                   Call ReporterFunction("WebSetters","SetSAPUIList","1",strStepName,strMsg)
     	blnObjectError=True
	 
    end if
else
	strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPUIList-- Function Call"
    strStatus  = "FAIL"
    Call ReporterFunction("WebSetters","SetSAPUIList","1",strStepName,strMsg)
end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SetSAPUIList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIList,FALSE,False,TRUE)
	Else
		SetSAPUIList = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,itemText,strMsg,strStatus,"")
	End If	
End If

End Function
