			End If
			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
'     			objWebEdit.Click
   	 			objWebEdit.Set val
	 			Wait(1)
      			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
	  			End if
				
	            strStatus = "DONE"
	            strMsg= "WebEdit value set successfully"
	            Call ReporterFunction(strLibraryFileName,"SetArgosWebEdit","2",strStepName,strMsg)
  			else
  				blnObjectError=True
               	strStatus = "FAIL"
               	strMsg = "Object Missing--Check the Screen Properly"
               	Call ReporterFunction(strLibraryFileName,"SetArgosWebEdit","1",strStepName,strMsg)
  			end if
		else
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SetArgosWebEdit-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SetArgosWebEdit","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetArgosWebEdit = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
	Else
		SetArgosWebEdit = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	Set objWebEdit=Nothing
	
	End If
End function


Public Function SetWebFile(creationTime,frameTitle,WebFileName,WebFileHtmlTag,webfileIndex,InputFilePath)
If Not (Environment.Value("blnFatalError") or listValue= DS_SKIP) Then   
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetWebFile"
strStepName = "Select Item "& listValue
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPWebFile
Set objSAPWebFile =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).SAPFrame("title:=" & frameTitle).WebFile("name:="& WebFileName,"html tag:="& WebFileHtmlTag,"index:="&webfileIndex)
    If  objSAPWebFile.Exist  then 
          If InputFilePath <> "" or WebFileName <> "" Then
             objSAPWebFile.Set InputFilePath
			  strStatus = "DONE"
			  strMsg = "Value selected successfully from list"
			  Call ReporterFunction(strLibraryFileName,"SetWebFile","2",strStepName,strMsg)
			  
              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPWebFile,False,False,True)
			End if
      else
      
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SetWebFile-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SetWebFile","1",strStepName,strMsg)
    end if
  else
   	    blnObjectError=True
		strStatus = "FAIL"
		strMsg = "WebFile: " & WebFileName & " Not found"
		Call ReporterFunction(strLibraryFileName,"SetWebFile","1",strStepName,strMsg)
     end if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
		SetWebFile = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPWebFile,False,False,True)
Else
		SetWebFile = True
End If
If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,listValue,strMsg,strStatus,"")
End If
	' //////////Word Document ///////////
			'If blnCreateTrainingDoc Then
			'	   Check=CheckStatus_Doc(strStatus)
			'	   If Check=1 Then
			'			  Call storeCoordinates(objSAPWebFile)
			'			  Call StoreSteps(strStepName)
			'	   End If
			'End If
	 ' //////////Word Document ///////////
Set objSAPWebFile=nothing
End If
End Function


Public Function GetValueWebEditByLogicalName(creationTime,Webclass,htmltag,WebEditLogicalName,WebEditIndex,ExcelColumnName)
If Not (Environment.Value("blnFatalError") or ExcelColumnName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetValueWebEditByLogicalName"
strStepName = "Get value from the WebEdit"
ALMvalue=getEnvironmentVariable("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
Dim objWebedit
If Webclass<> ""  and WebEditLogicalName <> "" and htmltag<>"" Then
'	columnNumber=Cint(columnNumber)
'	rowNumber=Cint(rowNumber)
On error resume next
Set objWebedit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebEdit("html tag:="&htmltag,"class:="&Webclass,"logical name:=.*"&WebEditLogicalName&".*","index:="&WebEditIndex)
 If  objWebedit.Exist  then 
	 objWebedit.Highlight
   	 val=objWebedit.GetROProperty("value")
	 
      If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objWebedit,False,False,False)
      End if
     
      strStatus = "DONE"
      strMsg="value captured : "& val
      Call ReporterFunction(strLibraryFileName,"GetValueWebEditByLogicalName","2",strStepName,strMsg)
 else
			  blnObjectError=True
              strStatus = "FAIL"    
              strMsg ="Object Missing"
              Call ReporterFunction(strLibraryFileName,"GetValueWebEditByLogicalName","1",strStepName,strMsg)
 end if
else
			 
              strStatus = "FAIL"
              strMsg = "Function Parameter Not Passed Properly. Check the --GetValueWebEditByLogicalName -- Function Call"
              Call ReporterFunction(strLibraryFileName,"GetValueWebEditByLogicalName","1",strStepName,strMsg)
 end if
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       GetValueWebEditByLogicalName = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objWebedit,False,False,False)
Else
       GetValueWebEditByLogicalName = True
End If
If blnWriteDataToOutputSheet Then
	   strStepName = "Retrieve '"&val&"' value in table '"&gstrOutputSheetName&"' sheet under column "&excelColumnName
	   Call WriteRunTimeDataToExcel (excelColumnName,val)
   ELSE
	   strStepName = "Retrieve '"&val&"' value in WebEdit"
	 End If
If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,ExcelColumnName,strMsg,strStatus,"")
End If

   Set objWebedit=Nothing
   End If
End Function
