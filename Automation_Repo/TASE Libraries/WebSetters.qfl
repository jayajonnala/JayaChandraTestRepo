			 	Call ReporterFunction(strLibraryFileName,"SetSAPCalendarSAPPortal","1",strStepName,strMsg)
			end if
		else
				
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPCalendarSAPPortal-- Function Call"
