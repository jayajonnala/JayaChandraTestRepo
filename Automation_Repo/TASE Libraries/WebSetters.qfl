Public Function SetCellDataSAPUITable(creationTime,windowText,htmlTag,htmlId,name,className,index,rowNumber,columnName,cellVal,blnIsItPopup)

If Not (Environment.Value("blnFatalError") or cellVal= DS_SKIP) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetCellDataSAPUITable"

ALMvalue=Environment.Value("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName ="Set value: " & cellVal & "  in SAPUI Table"
If blnIsItPopup Then
	Set objSAPUITable =Browser("CreationTime:=" &PopUpCreationtime).Window("text:="&windowText).Page("Index:=" &PopUpCreationtime).SAPUITable("class:="& className,"html tag:="& htmlTag,"html id:="&htmlId,"name:=" & name,"Index:=" & index)
Else
	Set objSAPUITable =Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPUITable("class:="& className,"html tag:="& htmlTag,"html id:="&htmlId,"name:=" & name,"Index:=" & index)
End If
   
    If  objSAPUITable.Exist(gObjectTimeoutLimit )  then 
         If rowNumber<> "" and columnName<>"" Then
             rowNum = Cint(rowNumber)
             'colNum = Cint(columnNum)
             objSAPUITable.SetCellData rowNum,columnName,cellVal
             
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITable,False,False,True)
	  			End if
	  		 strMsg = 	"Table data is set successfully"
             strStatus  = "DONE"
              Call ReporterFunction("WebSetters","SetCellDataSAPUITable","2",strStepName,strMsg)
      	else
           strMsg = "Function Parameter Not Passed Properly. Check the --SetCellDataSAPUITable-- Function Call"
           strStatus  = "FAIL"
            Call ReporterFunction("WebSetters","SetCellDataSAPUITable","1",strStepName,strMsg)
    	end if
 	else
       strMsg ="Table object not found"
       strStatus  = "FAIL"
        Call ReporterFunction("WebSetters","SetCellDataSAPUITable","1",strStepName,strMsg)
       blnObjectError = True
 end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SetCellDataSAPUITable = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITable,FALSE,False,TRUE)
	Else
		SetCellDataSAPUITable = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,cellVal,strMsg,strStatus,"")
	End If	
End If


End Function
