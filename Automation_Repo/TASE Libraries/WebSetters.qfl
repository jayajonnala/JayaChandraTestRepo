		Dim objWebEdit
		strStepName = "Set text box : "& webeditAttachedText
		If webeditAttachedText<> ""  or webeditTexttype <> "" or webeditIndex <> "" Then
		
		Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPFrame("title:=" & frameTitle).Highlight
		
			Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPFrame("title:=" & frameTitle).WebEdit("sap attached text:="&webeditAttachedText,"type:=" &webeditTexttype,"index:="&webeditIndex)
'			objWebEdit.Click
			objWebEdit.Fireevent "ondblclick"
 			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
				Wait 5
				objWebEdit.set val
				Wait(1)
				objWebEdit.Click
				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
