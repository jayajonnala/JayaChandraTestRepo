
'**************************************************

Public Function SetAttributeSAPList(creationTime,listName,listHtmlTag,listIndex,listValue)

	If Not (Environment.Value("blnFatalError") or listValue = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetAttributeSAPList"

		''ALMvalue=getEnvironmentVariable("ALMFlag")
		''If  ALMvalue=1 Then
		'	'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If

		Dim objSAPList
		strStepName = " Set "  & "'" & listValue & "'" & " in SAPList : " & "'"& listName & "'"   
		If listName <> "" OR listHtmlTag<> "" OR  listIndex <> "" Then
			Set objSAPList =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).SAPList("name:="& listName,"html tag:="& listHtmlTag,"index:=" & listIndex)
			If  objSAPList.Exist(gObjectTimeoutLimit)  then 
				objSAPList.Object.setAttribute "value", listValue
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
			    End if
	            
	            strStatus = "DONE"
	            strMsg= "SAPList value set successfully"
	            Call ReporterFunction(strLibraryFileName,"SetAttributeSAPList","2",strStepName,strMsg)
          	else
          		blnObjectError=True
				strStatus = "FAIL"	
				strMsg = "SAPList: " & listName & " Not found"
				Call ReporterFunction(strLibraryFileName,"SetAttributeSAPList","1",strStepName,strMsg)
			
          end if
		else
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -SetAttributeSAPList-- Function Call"
            Call ReporterFunction(strLibraryFileName,"SetAttributeSAPList","1",strStepName,strMsg)
  		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetAttributeSAPList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
	Else
		SetAttributeSAPList = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,listValue,strMsg,strStatus,"")
	End If

	Set objSAPList=Nothing
	
	End If

End function

'**********************************************************************************************************************

Public Function SetAttributeSAPListSAPPortal(creationTime,listName,listHtmlTag,listIndex,listValue)

	If Not (Environment.Value("blnFatalError") or listValue = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetAttributeSAPListSAPPortal"
	
		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)	
		End If

		Dim objSAPList
		strStepName = " Set "  & "'" & listValue & "'" & " in SAPListSAPPortal : " & "'" & listName & "'"  

		Set objSAPList =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:=" & PopUpCreationtime).SAPList("name:="& listName,"html tag:="& listHtmlTag,"index:=" & listIndex)
		If  objSAPList.Exist(gObjectTimeoutLimit)  then
		     
			If listName <> ""   OR listHtmlTag<> "" OR  listIndex <> "" Then
				objSAPList.Object.setAttribute "value", listValue
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
				End if
				strStatus = "DONE"
				strMsg= "SAPList value set successfully"
				Call ReporterFunction(strLibraryFileName,"SetAttributeSAPListSAPPortal","2",strStepName,strMsg)
			else
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SetAttributeSAPListSAPPortal-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SetAttributeSAPListSAPPortal","1",strStepName,strMsg)
			end if
		else
				blnObjectError=True
        		strStatus = "FAIL"	
        		strMsg = "SAPListSAPPortal: " & listName & " Not found"
        		Call ReporterFunction(strLibraryFileName,"SetAttributeSAPListSAPPortal","1",strStepName,strMsg)
		end if
  
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetAttributeSAPListSAPPortal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
	Else
		SetAttributeSAPListSAPPortal = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,listValue,strMsg,strStatus,"")
	End If

	Set objSAPList=Nothing
	
	End If

End function

'**************************************************************************************************************************

Public Function SetSAPCalendar(creationTime,calendarName,strDate)
	If Not (Environment.Value("blnFatalError") or strDate = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPCalendar"

		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If

		Dim objSAPCal
		strStepName = "Set Date: " & strDate & " in calendar"
		If calendarName <> "" or strDate <> "" Then

			Set objSAPCal =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPCalendar("logical name:="& calendarName,"type:=text","html tag:=INPUT")
			If  objSAPCal.Exist(gObjectTimeoutLimit)  then 
				objSAPCal.SetDate strDate
				wait(8)
				objSAPCal.Click
			   	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPCal,False,False,True)
			  	End if
			  	strStatus = "DONE"
			  	strMsg= "Calender date set successfully"
			  	Call ReporterFunction(strLibraryFileName,"SetSAPCalendar","2",strStepName,strMsg)
			else
				blnObjectError=True	
			 	strStatus = "FAIL"
			 	strMsg = "The Calender: "& calendarName & " is not Found--Check the Screen Properly"
			 	Call ReporterFunction(strLibraryFileName,"SetSAPCalendar","1",strStepName,strMsg)
			end if
		else
			
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPCalendar-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SetSAPCalendar","1",strStepName,strMsg)
              
		end if
 
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetSAPCalendar = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPCal,False,False,True)
	Else
		SetSAPCalendar = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strDate,strMsg,strStatus,"")
	End If

	Set objSAPCal=Nothing
	
	End If
End function

