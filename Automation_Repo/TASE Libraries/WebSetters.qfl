Public Function SetSAPCalendarSAPFrame(creationTime,frameTitle,calendarName,strDate)

	If Not (Environment.Value("blnFatalError") or strDate = DS_SKIP) Then
     		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPCalendarSAPFrame"
	
		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If

		Dim objSAPCal
		strStepName = "Set Date: " & strDate & " in calendar"
		If calendarName <> "" or strDate <> "" or frameTitle <> "" Then

			Set objSAPCal=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPFrame("title:="&frameTitle).SAPCalendar("logical name:="& calendarName,"type:=text","html tag:=INPUT")
 			If  objSAPCal.Exist(gObjectTimeoutLimit)  then 
				objSAPCal.SetDate strDate
				wait(8)
		   		objSAPCal.Click
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPCal,False,False,True)
				End if
	         	strStatus = "DONE"
	         	strMsg= "Calender date set successfully"
	         	Call ReporterFunction(strLibraryFileName,"SetSAPCalendarSAPFrame","2",strStepName,strMsg)
			else
				blnObjectError=True	
	       		strStatus = "FAIL"
	       		strMsg = "The Calender: "& calendarName & " Object Missing--Check the Screen Properly"
	       		Call ReporterFunction(strLibraryFileName,"SetSAPCalendarSAPFrame","1",strStepName,strMsg)
    		end if
		else
		
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPCalendarSAPFrame-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SetSAPCalendarSAPFrame","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
