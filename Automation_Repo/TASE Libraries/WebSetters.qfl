Public Function VerifySAPEditFrame(creationTime,frameTitle,SAPAttachedtext,SAPEditTexttype,SAPEditIndex,val)

	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifySAPEditFrame"

'		ALMvalue=Environment.Value("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objSAPEdit
		strStepName = "Verify text box ::"& SAPAttachedtext

		If SAPAttachedtext<> "" or SAPEditTexttype <> "" or SAPEditIndex <> "" Then
			Set objSAPEdit=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="& frameTitle).SAPEdit("sap attached text:="& SAPAttachedtext,"type:="& SAPEditTexttype,"index:="& SAPEditIndex)
'			objSAPEdit.FireEvent "ondblclick"
 			If  objSAPEdit.Exist(gObjectTimeoutLimit)  then 
				objSAPEditValue=objSAPEdit.getROproperty("value")

			    If objSAPEditValue=val then 
				Wait(1)
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,True)
				End if
				strStatus = "PASS"
				strMsg= "SAP Text  value verified successfully,Expected value is "& val &" is matching with the actual value "& objSAPEditValue &""
				Call ReporterFunction(strLibraryFileName,"VerifySAPEditFrame","2",strStepName,strMsg)
				else
				strStatus = "FAIL"
				strMsg= "SAP Text  value  verification failed,Expected value is "& val &" is not matching with the actual value "& objSAPEditValue &""
				Call ReporterFunction(strLibraryFileName,"VerifySAPEditFrame","1",strStepName,strMsg)
				End if
				
			else
				blnObjectError=True
               	strStatus = "FAIL"
               	strMsg = "Object Missing--Check the Screen Properly"
               	Call ReporterFunction(strLibraryFileName,"VerifySAPEditFrame","1",strStepName,strMsg)
			end if
		else
        	
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -VerifySAPEditFrame-- Function Call"
            Call ReporterFunction(strLibraryFileName,"VerifySAPEditFrame","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifySAPEditFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,True)
	Else
		VerifySAPEditFrame = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	Set objSAPEdit=Nothing
	
	End If

End Function

Public Function  SetSAPEditUniversal(creationTime,SAPAttachedtext,textboxName,val)

	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPEditUniversal"
		
		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If


		LinkCondition=0
		strStepName  = "Set value " & val & " in the textbox "& SAPAttachedtext
		If Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Exist then
			BrowserFound=True
			If SAPAttachedtext <> ""  Then	
				set oDesc=Description.Create()
				oDesc("micclass").value="SAPEdit"
				Set list=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).ChildObjects(oDesc)
				For i=0 to list.count-1
				If list(i).getroproperty("sap attached text")=SAPAttachedtext  Then
					list(i).set val
			   		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime),False,False,True)
			  		End if
            		LinkCondition = 1
				Exit for
				end if 
				Next
			else
 				set oDesc=Description.Create()
				oDesc("micclass").value="SAPEdit"
				Set list=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).ChildObjects(oDesc)
				For i=0 to list.count-1
				If list(i).getroproperty("name")=textboxName then
					list(i).set val
             		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime),False,False,True)
					End if
					LinkCondition = 1
				Exit for
				end if 
				Next
			end if
		else
			
			strStatus = "FAIL"
			strMsg = "Page missing"
			Call ReporterFunction(strLibraryFileName,"SetSAPEditUniversal","1",strStepName,strMsg)
			BrowserFound=False
		end if
	If LinkCondition=1 and BrowserFound Then
		strStatus = "DONE"
		strMsg= "Text value set successfully"
		Call ReporterFunction(strLibraryFileName,"SetSAPEditUniversal","2",strStepName,strMsg)
		
	ElseIf LinkCondition=0 and BrowserFound Then 
		blnObjectError=True
		strStatus = "FAIL"
		strMsg = SAPAttachedtext&" SAPEdit Not found"
		Call ReporterFunction(strLibraryFileName,"SetSAPEditUniversal","1",strStepName,strMsg)
	End If


	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetSAPEditUniversal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime),False,False,True)
	Else
		SetSAPEditUniversal = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	
	End If
End function

'******************************************************************************************************************

Public Function SetSAPEditSAPPortalByName(creationTime,SAPEditName,Val)
	If Not (Environment.Value("blnFatalError") or Val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSAPEditSAPPortalByName"

		ALMvalue=Environment.Value("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
			PopUpCreationtime=Cint(creationTime)
		End If
		Dim objEdit
		strStepName = "Set Value:"& Val &" in SAP Portal"
		If SAPEditName<>"" Then
		
			Set objEdit = Browser("CreationTime:=" & PopUpCreationtime).SAPPortal("Index:=" & PopUpCreationtime).SAPEdit("name:="& SAPEditName)
			If objEdit.Exist(gObjectTimeoutLimit) Then
				objEdit.Set Val
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objEdit,False,False,True)
			    End if
			    
	            strStatus = "DONE"
		        strMsg ="Text is Set Successfully in SAPEdit : "& SAPEditName
		        Call ReporterFunction(strLibraryFileName,"SetSAPEditSAPPortalByName","2",strStepName,strMsg)
			Else
				blnObjectError=True
               	strStatus = "FAIL"
		       	strMsg ="SAPEdit Not Found"
		       	Call ReporterFunction(strLibraryFileName,"SetSAPEditSAPPortalByName","1",strStepName,strMsg)
			End If
		Else
			
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -SetSAPEditSAPPortalByName-- Function Call"
            Call ReporterFunction(strLibraryFileName,"SetSAPEditSAPPortalByName","1",strStepName,strMsg)
		End If

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetSAPEditSAPPortalByName = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objEdit,False,False,True)
	Else
		SetSAPEditSAPPortalByName = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Val,strMsg,strStatus,"")
	End If

	Set objEdit=Nothing
	
	End If
End function

'**************************************************************************************************************************************************************
Public Function SetWebEdit(creationTime,windowText,webeditName,webeditTexttype,webeditIndex,val,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetWebEdit"

'		ALMvalue=getEnvironmentVariable("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objWebEdit
'		strStepName = "Set text box : "& webeditName
		strStepName = " Set "  & "'" & val & "'" & " in Textbox : " & "'"& webeditName & "'"  
		If webeditName<> ""  or webeditTexttype <> "" or webeditIndex <> "" Then

			If blnIsItPopup Then
				Set objWebEdit = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			else
    				Set objWebEdit = Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			End If
			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
     			     If InSTR(1,UCASE(webeditTexttype),"PASSWORD",VBTextCompare) >=1 Then
'     			         objWebEdit.Highlight
   	 		         objWebEdit.SetSecure val
   	 		     Else 
'   	 		    	 objWebEdit.Highlight
   	 		         objWebEdit.Click
   	 		         objWebEdit.Set val
   	 		         
   	 		     End If    
   
	 			Wait(1)
      			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebEdit,True,False,False)
	  			End if
				
	            strStatus = "DONE"
	            strMsg= "WebEdit value set successfully"
	            Call ReporterFunction(strLibraryFileName,"SetWebEdit","2",strStepName,strMsg)
  			else
  				blnObjectError=True
               	strStatus = "FAIL"
               	strMsg = "Object Missing--Check the Screen Properly"
               	Call ReporterFunction(strLibraryFileName,"SetWebEdit","1",strStepName,strMsg)
  			end if
		else
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SetWebEdit-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SetWebEdit","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetWebEdit = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
	Else
		SetWebEdit = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	Set objWebEdit=Nothing
	
	End If
End function


'**************************************************************************************************************************************************

Public Function SetWebEditDeviceReplay(creationTime,windowText,webeditName,webeditTexttype,webeditIndex,val,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetWebEditDeviceReplay"

    			PopUpCreationtime=Cint(creationTime)
		Dim objWebEdit
		strStepName = "Set text box : "& webeditName
		If webeditName<> ""  or webeditTexttype <> "" or webeditIndex <> "" Then

			If blnIsItPopup Then
    				Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			else
    				Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			End If
 			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
				objWebEdit.Click
				Set objDeviceReplay = CreateObject("Mercury.DeviceReplay")
				objDeviceReplay.SendString val
				Set objDeviceReplay = nothing 
				Wait(1)
				objWebEdit.Submit
              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
			 	End if
	          	strStatus = "DONE"
	          	strMsg= "WebEdit value set successfully"
	          	Call ReporterFunction(strLibraryFileName,"SetWebEditDeviceReplay","2",strStepName,strMsg)
  			else
  				blnObjectError=True
               	strStatus = "FAIL"
               	strMsg = "Object Missing--Check the Screen Properly"
               	Call ReporterFunction(strLibraryFileName,"SetWebEditDeviceReplay","1",strStepName,strMsg)
  			end if
		else
                
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SetWebEditDeviceReplay-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SetWebEditDeviceReplay","1",strStepName,strMsg)
		end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetWebEditDeviceReplay = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,True)
	Else
		SetWebEditDeviceReplay = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	Set objWebEdit=Nothing
	
	End If
End function

