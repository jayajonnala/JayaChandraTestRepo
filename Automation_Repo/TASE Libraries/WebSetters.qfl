Public Function SetArgosWebEdit(creationTime,windowText,webeditHtmlId,webeditTexttype,webeditIndex,val,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetArgosWebEdit"

'		ALMvalue=Environment.Value("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If

		Dim objWebEdit
		strStepName = "Set text box : "& webeditHtmlId
		If webeditHtmlId<> ""  or webeditTexttype <> "" or webeditIndex <> "" Then

			If blnIsItPopup Then
				Set objWebEdit = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebEdit("html id:="&webeditHtmlId,"type:=" &webeditTexttype,"index:="&webeditIndex)
			else
