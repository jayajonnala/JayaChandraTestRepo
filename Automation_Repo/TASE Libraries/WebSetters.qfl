Public Function SetWebNumber(creationTime,windowText,WebNoName,WebNoType,WebNoIndex,val,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetWebNumber"
                  PopUpCreationtime=Cint(creationTime)
		Dim objWebNo,objWebBrowser
		strStepName = "Set text box : "& webeditName
		If WebNoName <> ""  or WebNoType <> ""  Then
                   If blnIsItPopup Then
			  Set objWebBrowser = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime)
			else
    			   Set objWebBrowser = Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
			End If
			Set objWebNo =objWebBrowser.WebNumber("name:="&WebNoName,"type:=" &WebNoType,"index:="&WebNoIndex)
 			If  objWebNo.Exist(gObjectTimeoutLimit)  then 
				objWebNo.Click
				objWebNo.Set val
				Wait(1)
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebNo,False,False,True)
				End if
             	        strStatus = "DONE"
	          	strMsg= "Web Number value set successfully"
	          	Call ReporterFunction(strLibraryFileName,"SetWebNumber","2",strStepName,strMsg)
  		else
  			blnObjectError=True
            strStatus = "FAIL"
            strMsg = "Object Missing--Check the Screen Properly"
            Call ReporterFunction(strLibraryFileName,"SetWebNumber","1",strStepName,strMsg)
		end if
	else
       		
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -SetWinEdit-- Function Call"
            Call ReporterFunction(strLibraryFileName,"SetWebNumber","1",strStepName,strMsg)
	end if

	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetWebNumber = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWinEdit,False,False,True)
	Else
		SetWebNumber = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If
	Set SetWebNumber=Nothing
	
	End If
End function

