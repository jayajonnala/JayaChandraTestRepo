	End If
 	If  objSAPUITextEdit.Exist(gObjectTimeoutLimit )  then 
 	     objSAPUITextEdit.HighLight
	     objSAPUITextEdit.Click
	   	 objSAPUITextEdit.Set strValue
		 Wait(1)
		 
		 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPUITextEdit,False,False,True)
	  			End if
	  	 strMsg = "SAPUITextEdit " &name& " is set"		
	     strStatus  = "DONE"
         Call ReporterFunction("WebSetters","SetSAPUITextEdit","2",strStepName,strMsg)
  	else
	     strMsg ="Object Missing"
	     strStatus  = "FAIL"
         Call ReporterFunction("WebSetters","SetSAPUITextEdit","1",strStepName,strMsg)
	     blnObjectError=True
		 
  	end if
else
     strMsg = "Function Parameter Not Passed Properly. Check the --SetSAPUITextEdit -- Function Call"
     strStatus  = "FAIL"
     Call ReporterFunction("WebSetters","SetSAPUITextEdit","1",strStepName,strMsg)
end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	
If strStatus = "FAIL"  Then
		SetSAPUITextEdit = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUITextEdit,FALSE,False,TRUE)
	Else
		SetSAPUITextEdit = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strValue,strMsg,strStatus,"")
	End If	
End If

End Function
