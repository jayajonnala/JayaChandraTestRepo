'******************************************************************************************************************
Function SelectRowWebTableByRef(creationTime,tableClass,columnNum,refVal)
If Not (Environment.Value("blnFatalError") or refVal = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowWebTableByRef"
 strStepName = "Select Row in a WebTable"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objWebTable
Set objWebTable =Browser("CreationTime:="&PopUpCreationtime).Page("Index:="&PopUpCreationtime).WebTable("Html tag:=TABLE","Class:="& tableClass,"index:=1")
   If  objWebTable.Exist(gObjectTimeoutLimit)  then 
	   If tableClass <> "" or columnNum <>"" Then
		   On Error Resume Next
           	rowNo=objWebTable.GetRowWithCellText(refVal)
            If rowNo=-1 Then
            	Call ReporterFunction(strLibraryFileName,"SelectRowWebTableByRef","1",strStepName,"Element  : "& refVal & " is not found in the table")
       			strStatus = "FAIL"
        		strMsg ="Element  : "& refVal & " is not found in the table"							
			 Else
                 Set WebElementObj =objWebTable.ChildItem(rowNo,columnNum,"WebElement",0)
			      WebElementObj.Click
				 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
			                   ImagePath=CaptureScreenshot(strStepName,WebElementObj,False,False,True)
			     End if
			     
			     strStatus = "DONE"
			     strMsg= "Element  : "& refVal & " is selected"		
                 Call ReporterFunction(strLibraryFileName,"SelectRowWebTableByRef","2",strStepName,strMsg)
			End If						
	  Else 
	  	
        strStatus = "FAIL"
        strMsg ="Function Parameter Not Passed Properly. Check the -- SelectRowWebTableByRef-- Function Call"
        Call ReporterFunction(strLibraryFileName,"SelectRowWebTableByRef","1",strStepName,strMsg)
	 End If
  Else 
  	   blnObjectError=True
	   strStatus = "FAIL"    
	   strMsg =" The WebTable Object is not Found, Please verify the Screen"
	   Call ReporterFunction(strLibraryFileName,"SelectRowWebTableByRef","1",strStepName,strMsg)
 End If
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       SelectRowWebTableByRef = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,WebElementObj,False,False,True)
Else
       SelectRowWebTableByRef = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,refVal,strMsg,strStatus,"")
End If

   Set objWebTable=Nothing
   Set WebElementObj=nothing
   End If
End Function

