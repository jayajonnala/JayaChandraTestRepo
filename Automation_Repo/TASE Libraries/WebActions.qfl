Function CloseSAPUIDialog(creationTime,windowText,htmltag,innertext,className,dialogTitle,index,blnIsItPopup)


If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseSAPUIDialog"

ALMvalue=getEnvironmentVariable("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
	strStepName = "Close SAPUI Dialog box"
	If dialogTitle <> "" or className <> "" or innertext <> "" Then
		If blnIsItPopup Then
			Set objSAPUIDialog = Browser("creationtime:=" &PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPUIDialog("html tag:=" &htmltag,"innertext:=" &innertext,"class:="&className,"title:="&dialogTitle,"index:="&index)
		else
			Set objSAPUIDialog = Browser("creationtime:=" &PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPUIDialog("html tag:=" &htmltag,"innertext:=" &innertext,"class:="&className,"title:="&dialogTitle,"index:="&index )
		End If
		If  objSAPUIDialog.Exist(gObjectTimeoutLimit)  then 
			objSAPUIDialog.Close
			
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
			ImagePath=CaptureScreenshot(strStepName,objSAPUIDialog,False,False,True)
			End If
			strStatus  = "DONE"
			strMsg = "SAP UI Dialog closed successfully"
            Call ReporterFunction("WebActions","CloseSAPUIDialog","2",strStepName,strMsg)
		else	
			strMsg = "Object Missing"
			strStatus  = "FAIL"
                                                        Call ReporterFunction("WebActions","CloseSAPUIDialog","1",strStepName,strMsg) 
                                                        blnObjectError = True
        end if
	else
        strMsg = "Function Parameter Not Passed Properly. Check the -CloseSAPUIDialog-- Function Call"
        strStatus  = "FAIL"
        Call ReporterFunction("WebActions","CloseSAPUIDialog","1",strStepName,strMsg) 
        
	end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		CloseSAPUIDialog = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIDialog,FALSE,False,TRUE)
	Else
		CloseSAPUIDialog = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
End If

End Function

'**************************************************************************************************************************************************************************************************************************************************************************************

Function CloseSAPUIDialogFrame(creationTime,frameTitle,htmlTag,innertext,className,dialogTitle,index)

If Not (Environment.Value("blnFatalError")) Then

	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseSAPUIDialogFrame"

ALMvalue=getEnvironmentVariable("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
	strStepName = "Close SAPUI Dialog box"
	If dialogTitle <> "" or className <> "" or innertext <> "" Then
		Set objSAPUIDialogFrame = Browser("creationtime:=" &PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).SAPUIDialog("html tag:=" &htmltag,"innertext:=" &innertext,"class:="&className,"title:="&dialogTitle,"index:="&index )
	
		If  objSAPUIDialogFrame.Exist(gObjectTimeoutLimit)  then 
			objSAPUIDialogFrame.Close
			
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
			ImagePath=CaptureScreenshot(strStepName,objSAPUIDialogFrame,False,False,True)
			End If
			strStatus  = "DONE"
			strMsg = "Dialog closed successfully"
            Call ReporterFunction("WebActions","CloseSAPUIDialogFrame","2",strStepName,strMsg)
		else	
			strMsg = "Object Missing"
			strStatus  = "FAIL"
            Call ReporterFunction("WebActions","CloseSAPUIDialogFrame","1",strStepName,strMsg)
			blnObjectError = True
			
        end if
	else
        strMsg = "Function Parameter Not Passed Properly. Check the -CloseSAPUIDialogFrame-- Function Call"
        strStatus  = "FAIL"
         Call ReporterFunction("WebActions","CloseSAPUIDialogFrame","1",strStepName,strMsg)
	end if

If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		CloseSAPUIDialogFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPUIDialogFrame,FALSE,False,TRUE)
	Else
		CloseSAPUIDialogFrame = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
End If

End Function

