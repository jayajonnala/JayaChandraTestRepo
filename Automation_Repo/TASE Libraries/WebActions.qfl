'*************************************************************************************************************************************************
Public Function GetValueSAPEdit(creationTime,SAPAttachedtext,SAPEditName,columnName)
If Not (Environment.Value("blnFatalError") or columnName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetValueSAPEdit"
strStepName = "Get Content of SAPEdit box :"&SAPAttachedtext
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPEdit
If SAPEditName <> ""  or  SAPAttachedtext <> "" Then
	Set objSAPEdit=Browser("CreationTime:="& PopUpCreationtime ).Page("Index:="& PopUpCreationtime).SAPEdit("name:="&SAPEditName,"sap attached text:="&SAPAttachedtext,"type:=text")
    If  objSAPEdit.Exist  then 
	      valueCaptured = objSAPEdit.GetROProperty("value")
           If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,False)
               End if
           
               strStatus = "DONE"
               strMsg= valueCaptured & " stored in the column " & columnName &  " of excel sheet"
                Call ReporterFunction(strLibraryFileName,"GetValueSAPEdit","2",strStepName,strMsg)
	else
                blnObjectError=True
               strStatus = "FAIL"    
              strMsg = " Object Missing"
              Call ReporterFunction(strLibraryFileName,"GetValueSAPEdit","1",strStepName,strMsg)
    end if
else
              strStatus = "FAIL"
              strMsg =" Parameter not passed properly .Check the function call - GetValueSAPEdit"
              Call ReporterFunction(strLibraryFileName,"GetValueSAPEdit","1",strStepName,strMsg)
 end if 
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       GetValueSAPEdit = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPEdit,False,False,False)
Else
       GetValueSAPEdit = True
End If
If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&valueCaptured&"' value in textbox '"&gstrOutputSheetName&"' sheet under column "&columnName
										call WriteRunTimeDataToExcel (columnName,valueCaptured)
								   ELSE
										strStepName = "Retrieve '"&val&"' value in TextBox"
	 End If
If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,columnName,strMsg,strStatus,"")
End If

' //////////Word Document //////////////////////////////////////////////////////////
           'If blnCreateTrainingDoc Then 
           '       Check=CheckStatus_Doc(strStatus)
            '      If Check=1 Then
            '             Call storeCoordinates(objSAPEdit)
            '             Call StoreSteps(strStepName)
            '      End If
          ' End If
    ' //////////Word Document ///////////
   Set objSAPEdit=Nothing
End If
End Function
