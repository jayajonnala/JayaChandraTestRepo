Public Function CloseAllBrowsers()


If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseAllBrowsers"
Set oDesc1=Description.Create()
oDesc1("micclass").value ="Browser"
Set browserList = Desktop.ChildObjects(oDesc1)
For creationTime = 0 to ( browserList.count - 1)
On error resume next
Browser("CreationTime:="& creationTime).Close
Next
End If


