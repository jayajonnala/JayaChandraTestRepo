'End If
Dim objSAPCheckbox
strStepName= "Set  Check Box :" & OnOffStatus
Set objSAPCheckbox=Browser("CreationTime:="& PopUpCreationtime ).Page("Index:="& PopUpCreationtime).SAPCheckBox("sap attached text:="& checkboxAttachedtext,"name:=" & checkboxName,"index:="&checkboxIndex)
If checkboxAttachedtext <> "" Then
    If objSAPCheckbox.Exist Then
    	If objSAPCheckbox.GetROProperty("disabled")=0 Then
                      If  objSAPCheckbox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objSAPCheckbox.set "ON"
							
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  				 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
            				End if
            				
							
							strStatus = "DONE"
							strMsg= "SAPCheckbox checked successfully "
							Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","2",strStepName,strMsg)
                     ElseIf objSAPCheckbox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
							Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","2",strStepName,strMsg)
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  				 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
            				End if
            				
							strStatus = "DONE"
							strMsg= "SAPCheckbox already checked "
                     ElseIf  objSAPCheckbox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							 objSAPCheckbox.set "OFF"
							Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","2",strStepName,strMsg)
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  				 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
            				End if
            				
							strStatus = "DONE"
							strMsg= "SAPCheckbox un-checked successfully "
					Else
							Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","2",strStepName,strMsg)
							
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  				 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
            				End if
            				
							strStatus="DONE"
							strMsg= "SAPCheckbox already un-checked "
                   End If 
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				   ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
			End if                   
      else 
			
			strStatus = "FAIL"
			strMsg = "Check Box is disabled ."
			Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","1",strStepName,strMsg)
     End If
    else 
	    blnObjectError=True
        strStatus = "FAIL"    
        strMsg =  " The Check Box Object is not Found, Please verify the Screen."
        Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","1",strStepName,strMsg)
  End If
 else 
		blnObjectError=True
		strStatus = "FAIL"
		strMsg = " The Parameter Not Passed Properly. Please verify the Screen. "
		Call ReporterFunction(strLibraryFileName,"SelectSAPCheckbox","1",strStepName,strMsg)
  End If
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       SelectSAPCheckbox = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
Else
       SelectSAPCheckbox = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strStatus,"")
End If

' //////////Word Document //////////////////////////////////////////////////////////
           'If blnCreateTrainingDoc Then 
            '      Check=CheckStatus_Doc(strStatus)
            '      If Check=1 Then
            '             Call storeCoordinates(objSAPCheckbox)
           '              Call StoreSteps(strStepName)
           '       End If
           'End If
    ' //////////Word Document ///////////
   Set objSAPCheckbox=Nothing
End If
End Function

