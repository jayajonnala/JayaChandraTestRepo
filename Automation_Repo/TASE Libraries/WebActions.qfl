			strStepName = "Get WebElement Value"
			Set objWebElement=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="&frameTitle).WebElement("html id:="& htmlId,"html tag:="&htmltagVal,"class:="& webelementClass)
			On error resume next 
 			If  objWebElement.Exist(gObjectTimeoutLimit)  then 
	 			objWebElement.highlight
     			webElementMsg=objWebElement.GetROProperty("outertext")
'     			MyArray=Split(webElementMsg," ","-1","1")
'	 			textPosition=Cint(textPosition)
'	 			val=MyArray(textPosition)
'     			last  = Right(val,1)
'     			If last = "-" Then
'	     			finallast=instr(1,val,"-",1)
'         			finalval=left(val,finallast-1)
         			val=webElementMsg
'     			End If
 		
     			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	          	End if
	 			
     			strMsg="Web Element value captured successfully"
     			strStatus = "DONE"
     			Call ReporterFunction(strLibraryFileName,"GetValueWebElementFrame","2",strStepName,strMsg)
  			else
     		strMsg ="Web Element  object Missing"
     		strStatus = "FAIL"
     		Call ReporterFunction(strLibraryFileName,"GetValueWebElementFrame","1",strStepName,strMsg)
			blnObjectError=True
  			end if
		else
     	strMsg = "Function Parameter Not Passed Properly. Check the --GetValueWebElementFrame -- Function Call"
