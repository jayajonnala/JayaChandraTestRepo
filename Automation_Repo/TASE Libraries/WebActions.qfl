Public Function SelectArgosWebCheckbox(creationTime,windowText,checkboxHtmlID,checkboxHtmlTag,checkboxIndex,OnOffStatus,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectArgosWebCheckbox"
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
strStepName= "Set  Check Box :" & OnOffStatus
		If blnIsItPopup Then
			Set objCheckBox =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebCheckBox("html id:=" & checkboxHtmlID,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
		else
    		Set objCheckBox= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebCheckBox("html id:=" & checkboxHtmlID,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
		End If

		If checkboxHtmlID <> "" or checkboxHtmlTag<> "" or checkboxIndex <>""  Then
    		If objCheckBox.Exist(gObjectTimeoutLimit) Then
     			If objCheckBox.GetROProperty("disabled")=0 Then
                      If  objCheckBox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objCheckBox.set "ON"
							
						    strStatus="DONE"
							strMsg="Web checkbox is selected successfully"
							Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","2",strStepName,strMsg)
                      ElseIf objCheckBox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
                      
                 			strStatus="DONE"
							strMsg="Web checkbox is already selected"
							Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","2",strStepName,strMsg)
                      ElseIf  objCheckBox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							objCheckBox.set "OFF"
							strMsg="Web checkbox is de-selected successfully"
							strStatus="DONE"
							Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","2",strStepName,strMsg)
					  Else
							
									 
							strStatus="DONE"
							strMsg="Web checkbox is already de-selected"
							Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","2",strStepName,strMsg)
                      End If  
					  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	           	      End if                   
      			else 
                strStatus="FAIL"
                strMsg ="Check Box is disabled ."
                Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","1",strStepName,strMsg)
     			End If
    		else 
         	strStatus="FAIL"
         	strMsg = " The Check Box Object is not Found, Please verify the Screen"
        	Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","1",strStepName,strMsg)
        	blnObjectError=True
  			End If
 		else 
      	strStatus="FAIL"
       	strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       	Call ReporterFunction(strLibraryFileName,"SelectArgosWebCheckbox","1",strStepName,strMsg)
  	End If
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		    SelectArgosWebCheckbox = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	Else
		    SelectArgosWebCheckbox = True
	End If
	
	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strStatus,"")
	End If
End if
End Function



Public Function SelectWebRadioButtonSAPPortal(creationTime,radioGroupClass,radioGroupName,radioGroupIndex,itemToBeSelected)
	If Not (Environment.Value("blnFatalError") or itemToBeSelected = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebRadioButtonSAPPortal"
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		If itemToBeSelected<> ""  and radioGroupClass <> ""  Then
			strStepName  = "Select Radio Button: "& itemToBeSelected
			Set objRadioButton =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPRadioGroup("html tag:=INPUT","class:="& radioGroupClass,"name:="& radioGroupName,"index:="& radioGroupIndex)
	 		If  obj.Exist(gObjectTimeoutLimit)  then 
				obj.Select itemToBeSelected
				strstatus = "DONE"
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	       	 	End if
	        	
	        	strMsg="Web radio button in SAP portal is selected suucessfully"
	        	Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","2",strStepName,strMsg)
	 		else
		 	strMsg ="Object Missing"
		 	strstatus = "FAIL"
		 	blnObjectError=True
		 	Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","1",strStepName,strstatus)
	 		end if
 		else
     		strMsg = "Function Parameter Not Passed Properly. Check the --SelectWebRadioButtonSAPPortal -- Function Call"
     		strstatus = "FAIL"
	 		Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","1",strStepName,strMsg)
 		end if
 		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 	End If

	 	If strStatus = "FAIL"  Then
		    SelectWebRadioButtonSAPPortal = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	 	Else
		    SelectWebRadioButtonSAPPortal = True
	 	End If
	
	 	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemToBeSelected,strMsg,status,"")
	 	End If
	End If
End Function
