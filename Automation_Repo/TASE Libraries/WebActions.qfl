Set objSAPEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPEdit("sap attached text:="& SAPAttachedText,"index:="&SAPEditIndex) 
 If  objSAPEdit.exist then
   	 objSAPEdit.Submit
     If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
     End if
               
               strStatus = "DONE"
               strMsg= "Enter Pressed Successfully"
               Call ReporterFunction(strLibraryFileName,"PressEnterSAPEdit","2",strStepName,strMsg)
  else
      blnObjectError=True
	  
      strStatus = "FAIL"    
	  strMsg="Object Missing"
	  Call ReporterFunction(strLibraryFileName,"PressEnterSAPEdit","1",strStepName,strMsg)
  end if
else
              
              strStatus = "FAIL"    
              strMsg = "Function Parameter Not Passed Properly. Check the --PressEnterSAPEdit -- Function Call"
              Call ReporterFunction(strLibraryFileName,"PressEnterSAPEdit","1",strStepName, strMsg)
end if
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       PressEnterSAPEdit = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
Else
       PressEnterSAPEdit = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,SAPAttachedText,strMsg,strStatus,"")
End If

