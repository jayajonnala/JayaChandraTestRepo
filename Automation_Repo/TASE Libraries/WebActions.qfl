Public Function SelectCellSAPTableSAPPortalSAPFrame(creationTime,frameTitle,tableClass,tableHtmlTag,tableName,tableIndex,rowNum,colNum)
	If Not (Environment.Value("blnFatalError") or rowNum = DS_SKIP or colNum = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellSAPTableSAPPortalSAPFrame"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If

		Dim objSAPTable
		strStepName ="Select cell in SAP Table"
		Set objSAPTable = Browser("CreationTime:=" &PopUpCreationtime).SAPPortal("Index:=" &PopUpCreationtime).SAPFrame("title:="&frameTitle).SAPTAble("class:="& tableClass,"html tag:="& tableHtmlTag,"name:=" & tableName,"Index:=" & tableIndex)
   		If  objSAPTable.Exist(gObjectTimeoutLimit)  then 
        	If rowNum<> "" and colNum<>"" Then
             	rowNum = Cint(rowNum)
             	colNum = Cint(colNum)
             	objSAPTable.SelectCell rowNum,colNum
            	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
			    End if
	            
	            strStatus = "DONE"
	            strMsg= "Table cell selected successfully"
