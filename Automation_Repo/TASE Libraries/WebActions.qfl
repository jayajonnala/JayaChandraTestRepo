'******************************************************************************************************************
Public Function PressEnterSAPEditSAPPortal(creationTime,SAPAttachedText)
If Not (Environment.Value("blnFatalError") or SAPAttachedText = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : PressEnterSAPEditSAPPortal"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPEdit
If SAPAttachedText<> "" Then
strStepName = "Press Enter in  "& SAPAttachedText
Set objSAPEdit =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPEdit("sap attached text :="& SAPAttachedText,"index:=0")
On error resume next 
 If  objSAPEdit.Exist  then
   	 objSAPEdit.Submit
               If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
               End if
               
               strStatus = "DONE"
               strMsg="Enter Pressed Successfully"
               Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortal","2",strStepName,strMsg)
  else
	 blnObjectError=True
	 
     strStatus = "FAIL"
     strMsg = "Object Missing"
     Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortal","1",strStepName,strMsg)
  end if
else
              
              strStatus = "FAIL"    
              strMsg = "Function Parameter Not Passed Properly. Check the --PressEnterSAPEditSAPPortal -- Function Call"
              Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortal","1",strStepName, strMsg)
End if

If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       PressEnterSAPEditSAPPortal = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
Else
       PressEnterSAPEditSAPPortal = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,SAPAttachedText,strMsg,strStatus,"")
End If

   Set objSAPEdit=Nothing
End if
End Function
'******************************************************************************************************************
