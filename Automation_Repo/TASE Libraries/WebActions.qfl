 Public Function VerifyFrameWebElement(creationTime,windowText,FrmaeTitle,htmltag,innertext,className,indexNumber,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyFrameWebElement"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		Dim objWebElement
		strStepName = "Verify if WebElement: " & innertext & " exists in the page"

		If innertext<> "" OR htmltag<> "" Then
			If blnIsItPopup Then
				Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			else
    			Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).Frame("title:="& FrmaeTitle).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			End If
    		If  objWebElement.Exist(gObjectTimeoutLimit)  then 
				objWebElement.highlight
             	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
			    End if
	            
	            strStatus = "PASS"
	            strMsg= "Web Element: "&innertext& " found in the page"
	            Call ReporterFunction(strLibraryFileName,"VerifyFrameWebElement","2",strStepName,strMsg)
      		else
			blnObjectError=True
      			
				strStatus = "FAIL"	
				strMsg = innertext&" Web Element Not found in the page"
				Call ReporterFunction(strLibraryFileName,"VerifyFrameWebElement","1",strStepName,strMsg)
                
    		end if
  		else
     		
     		
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -VerifyFrameWebElement-- Function Call"
            Call ReporterFunction(strLibraryFileName,"VerifyFrameWebElement","1",strStepName,strMsg)
			
  		End if
  		
  		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyFrameWebElement = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	Else
		VerifyFrameWebElement = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If

' //////////Word Document //////////////////////////////////////////////////////////
'	If blnCreateTrainingDoc Then
'		Check=CheckStatus_Doc(strStatus)
'		If Check=1 Then
'			Call storeCoordinates(objWebElement)
'			Call StoreSteps(strStepName)
'		End If
'	End If
	 ' //////////Word Document ///////////
	Set objWebElement=Nothing
	
	End If

End function


 Public Function VerifyWebEditValue(creationTime,windowText,webeditName,webeditTexttype,webeditIndex,expectedVal,blnIsItPopup)

	If Not (Environment.Value("blnFatalError") or expectedVal = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyWebEditValue"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		strStepName = "Verify value in textbox : "& webeditName
		Dim objWebEdit
		If webeditName<> "" or webeditIndex <> ""  Then
			
			If blnIsItPopup Then
				Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			else
    			Set objWebEdit =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebEdit("name:="&webeditName,"type:=" &webeditTexttype,"index:="&webeditIndex)
			End If
 			If  objWebEdit.Exist(gObjectTimeoutLimit)  then 
     			actualVal=objWebEdit.GetROProperty("value")
	 			If UCASE(actualVal) = UCASE(expectedVal) Then
	 				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,False)
			    	End if
			    	
	           		strStatus = "DONE"
	           		strMsg = "Actual Value of the TextBox : " & actualVal & " is equal to the Expected Value: "&expectedVal
	           		Call ReporterFunction(strLibraryFileName,"VerifyWebEditValue","2",strStepName,strMsg)
	 		 	Else
        			
	            	strStatus = "FAIL"
       				strMsg = "Actual Value of the TextBox : " & actualVal & " is not equal to the Expected Value: "&expectedVal
       				Call ReporterFunction(strLibraryFileName,"VerifyWebEditValue","2",strStepName,strMsg)
	 		 	End If
			else
				blnObjectError=True
				strStatus = "FAIL"	
				strMsg ="Object Missing"
				Call ReporterFunction(strLibraryFileName,"VerifyWebEditValue","1",strStepName,strMsg)
  			end if
		else
		    	
               	
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -VerifyWebEditValue-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"VerifyWebEditValue","1",strStepName,strMsg)
		End if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyWebEditValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebEdit,False,False,False)
	Else
		VerifyWebEditValue = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedVal,strMsg,strStatus,"")
	End If

	Set objWebEdit=Nothing
	
	End If

End function
 '******************************************************************************************************************
 Public Function GetValueWebElementSAPFrame(creationTime,frameTitle,htmlId,ClassName,excelColumnName)
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetValueWebElementSAPFrame"
 	   'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		If htmlId<> ""  OR  innertext<>"" OR webelementClass<> "" Then
			strStepName = "Get WebElement Value"
			Set objWebElement=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPFrame("title:="&frameTitle).WebElement("html id:="& htmlId,"class:="& ClassName)
			On error resume next 
 			If  objWebElement.Exist(gObjectTimeoutLimit)  then 
	 			objWebElement.highlight
     			webElementMsg=objWebElement.GetROProperty("outertext")
     			
         			val=webElementMsg
     			
 		
     			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	          	End if
	 			
     			strMsg="Web Element value captured successfully"
     			strStatus = "PASS"
     			Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","2",strStepName,strMsg)
  			else
     		strMsg ="Web Element  object Missing"
     		strStatus = "FAIL"
     		Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","1",strStepName,strMsg)
			blnObjectError=True
  			end if
		else
     	strMsg = "Function Parameter Not Passed Properly. Check the --GetValueWebElementSAPFrame -- Function Call"
     	strStatus = "FAIL"
    	Call ReporterFunction(strLibraryFileName,"GetValueWebElementSAPFrame","1",strStepName,strMsg)
     end if
     
     If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&val&"' value in WebElement '"&gstrOutputSheetName&"' sheet under column "&excelColumnName
										call WriteRunTimeDataToExcel (excelColumnName,val)
								   ELSE
										strStepName = "Retrieve '"&val&"' value in WebElement"
	 End If
     If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 End If

	 If strStatus = "FAIL"  Then
		    GetValueWebElementSAPFrame = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	 Else
		    GetValueWebElementSAPFrame = True
	 End If
	
	 If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	 End If
	End if
End Function
'**********************************************************************************************************************************************
Public Function CaptureWebScreen(creationTime,resultstring) 
	If Not (Environment.Value("blnFatalError")) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CaptureWebScreen"
		ALMvalue=getEnvironmentVariable("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If
    	strStepName = "Take ScreenShot "
    	
    	browserType =UCASE(Browser("CreationTime:="& PopUpCreationtime).GetROProperty("application version"))
    	If INSTR(1,browserType,"EDGE",0)>0  Then
    	Browser("CreationTime:="& PopUpCreationtime).Highlight
    		Else
    	browserProperty =Browser("CreationTime:="& PopUpCreationtime).GetROProperty("hwnd")
    	Window("hwnd:="& cstr(browserProperty)).Activate
    	End If
'		browserProperty =Browser("CreationTime:="& PopUpCreationtime).GetROProperty("hwnd")
'    	Window("hwnd:="& cstr(browserProperty)).Activate

'		ImagePath =CaptureSAPObject(Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime))
				blnCaptureFlag = True
     			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		    ImagePath=CaptureScreenshot(strStepName,Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime),False,False,False)
		    End If
'''    	strStatus = "PASS1"
'''    	strMsg = "WebScreen Captured"	
    	If Err.Number = 0 then   
		   strStatus = "DONE"
		   strMsg="Screenshot was captured. "	
		   Call ReporterFunction(strLibraryFileName,"TakeScreenshot","2"," Take Screenshot",strMsg)	
		 Else 
		  strStatus = "FAIL"
		   strMsg="Screenshot was not captured. "	
		   Call ReporterFunction(strLibraryFileName,"TakeScreenshot","2"," Take Screenshot",strMsg)	
		 End If
	
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
	
'''    	Call ReporterFunction(strLibraryFileName,"CaptureWebScreen","2",strStepName,strMsg)
'''    	If blnDefault_eSwiftReporting Then  
'''		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
'''	 End If

	End If
End Function
'**************************************************************************************************************************************************************
Public Function CloseBrowser(creationTime)
	If Not (Environment.Value("blnFatalError")) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseBrowser"
'		ALMvalue=getEnvironmentVariable("ALMFlag")
'		If  ALMvalue=1 Then
'			PopUpCreationtime=Cint(creationTime) + 1
'		else
			PopUpCreationtime=Cint(creationTime)
'		End If
	strStepName = "Close Browser "
		On error resume next
    	Browser("CreationTime:="&PopUpCreationtime).Close
    	If Browser("CreationTime:="&PopUpCreationtime).Dialog("regexpwndtitle:=Windows Internet Explorer").WinButton("regexpwndtitle:=&Leave this page").Exist Then
    		Browser("CreationTime:="&PopUpCreationtime).Dialog("regexpwndtitle:=Windows Internet Explorer").WinButton("regexpwndtitle:=&Leave this page").Click    		
    	End If
		strStatus = "DONE"
		strMsg="Browser closed successfully"
		Call ReporterFunction(strLibraryFileName,"CloseBrowser","2",strStepName,strMsg)
		If err Then
			If err.number=-2147220990 then 
				strMsg="No Browser open"
				strStatus = "FAIL"
				blnObjectError=true
				Call ReporterFunction(strLibraryFileName,"CloseBrowser","1",strStepName,strMsg)
			end  if
     	End If
     	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 	End If

	 	If strStatus = "FAIL"  Then
		    CloseBrowser = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,Browser("CreationTime:="&PopUpCreationtime),False,False,False)
	 	Else
		    CloseBrowser = True
	 	End If
	
	 	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strstatus,"")
	 	End If
	End If
End Function
