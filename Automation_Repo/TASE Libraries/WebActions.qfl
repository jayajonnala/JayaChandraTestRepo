Public Function SelectSAPTab(creationTime,tabStripName ,tabName)
 If Not (Environment.Value("blnFatalError") or tabName=DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPTab"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPTab
strStepName  = "Select Tab:  "& tabName
Set objSAPTab =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPTabStrip("name:="& tabStripName)
    If tabName <>"" or tabStripName <> "" Then
    	If  objSAPTab.Exist(gObjectTimeoutLimit)  then 
             objSAPTab.Select tabName
             strStatus  = "DONE"
             strMsg ="Tab Selected Successfully"
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPTab,False,False,True)
			 End if
			 Call ReporterFunction(strLibraryFileName,"SelectSAPTab","2",strStepName,strMsg)
        else
		   	 blnObjectError=True
		   	 
		     strStatus  = "FAIL"
		     strMsg = "The TabName: "& tabName & " Tab Not found is not Found--Check the Screen Properly"
		     Call ReporterFunction(strLibraryFileName,"SelectSAPTab","1",strStepName,strMsg)
        end if
    else
     strStatus  = "FAIL"
     strMsg  = "Function Parameter Not Passed Properly. Check the -SelectSAPTab-- Function Call"
     Call ReporterFunction(strLibraryFileName,"SelectSAPTab","1",strStepName,strMsg)
    end if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
End If
If strStatus = "FAIL"  Then
		SelectSAPTab = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPTab,False,False,True)
Else
		SelectSAPTab = True
End If
If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,tabName,strMsg,strStatus,"")
End If
	' //////////Word Document ///////////
	'		If blnCreateTrainingDoc Then
	'			   Check=CheckStatus_Doc(strStatus)
	'			   If Check=1 Then
	'					  Call storeCoordinates(objSAPTab)
	'					  Call StoreSteps(strStepName)
	'			   End If
	'		End If
	 ' //////////Word Document ///////////
End if
set objSAPTab=nothing
 End Function
'******************************************************************************************************************'******************************************************************************************************************************
Public Function LogOffPortal()
 If Not (Environment.Value("blnFatalError")) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LogOffPortal"
'ALMvalue=getEnvironmentVariable("ALMFlag")
creationTime=1
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim obj
Call Html_iteration("LogOff")
strStepName = "Logging Off from Portal"
Set obj=Browser("creationtime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
    If  obj.Exist  then 
             'obj.Link("html tag:=A","text:=Carla Grant ‎\(cgrant\).*").Click
             obj.Link("html tag:=A","text:=Logout").Click
			 strStatus = "DONE" 
             strMsg ="Successfully logoff from application"
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
			 End if
			 Call ReporterFunction(strLibraryFileName,"LogOffPortal","2",strStepName,strMsg)
    else
			blnObjectError=True
	        Call ReporterFunction(strLibraryFileName,"LogOffPortal","1",strStepName,strMsg)
			strStatus = "FAIL"
			strMsg = "Unable to logoff from application"
	end if
	If strStatus = "FAIL"  Then
		LogOffPortal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
	Else
		LogOffPortal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	End If
		'Upload Datasheet to ALM resource, if applicable
		If not IsEmpty(gALMResourceObj)Then
			resourcePath = WshDTEnv("inputExcelPath")
			'Retreive the folder path to uplaod the resource from. (Strip the '/' in the end of teh fiel path)
			resourcePath = Left(resourcePath,InstrRev(resourcePath,"\")-1)
			gALMResourceObj.uploadresource resourcePath,True
			Set gALMResourceObj=Nothing
		End If
End if
set obj=nothing
End Function
'************************************************************************************************************************************************************
 Public Function SelectSAPTabSAPPortal(creationTime,tabStripName ,tabName)
If Not (Environment.Value("blnFatalError") or tabName= DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectSAPTabSAPPortal"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPTab
strStepName = "Select Tab:  "& tabName
Set objSAPTab =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPTabStrip("name:="& tabStripName)
    If  objSAPTab.Exist(gObjectTimeoutLimit)  then 
		If tabName <>"" or tabStripName <> "" Then
            objSAPTab.Select tabName
            strStatus = "DONE"
			strMsg = "Tab selected successfully"
			Call ReporterFunction(strLibraryFileName,"SelectSAPTabSAPPortal","2",strStepName,strMsg)
      else
      	 strMsg = "Function Parameter Not Passed Properly. Check the -SelectSAPTabSAPPortal-- Function Call"
         strStatus = "FAIL"
         Call ReporterFunction(strLibraryFileName,"SelectSAPTabSAPPortal","1",strStepName,strMsg)
    end if
   else
     blnObjectError=True
     strMsg = tabName &" Tab Not found"
     strStatus = "FAIL"
     Call ReporterFunction(strLibraryFileName,"SelectSAPTabSAPPortal","1",strStepName,strMsg)
   end if
    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPTab,False,False,True)
	End if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		SelectSAPTabSAPPortal = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPTab,False,False,True)
	Else
		SelectSAPTabSAPPortal = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,tabName,strMsg,strStatus,"")
	End If
	' //////////Word Document ///////////
		'	If blnCreateTrainingDoc Then
		'		   Check=CheckStatus_Doc(strStatus)
		'		   If Check=1 Then
		'				  Call storeCoordinates(objSAPTab)
		'				  Call StoreSteps(strStepName)
		'		   End If
		'	End If
	 ' //////////Word Document ///////////
	 End if
	 Set objSAPTab=nothing
 End Function
