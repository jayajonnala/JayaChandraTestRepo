Public Function SelectWebCheckboxSAPPortal(creationTime,checkboxName,checkboxHtmlTag,checkboxIndex,OnOffStatus)
If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebCheckboxSAPPortal"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
strStepName= "Set  Check Box" & OnOffStatus
Set objCheckBox=Browser("CreationTime:="& PopUpCreationtime ).SAPPortal("Index:="& PopUpCreationtime).WebCheckBox("name:=" & checkboxName,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
If checkboxAttachedtext <> "" Then
    If objCheckBox.Exist(gObjectTimeoutLimit) Then
     If objCheckBox.GetROProperty("disabled")=0 Then
                      If  objCheckBox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objCheckBox.set "ON"
						
							strStatus="DONE"
							strMsg="Web checkbox in portal is selected successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","2",strStepName,strMsg)
                     ElseIf objCheckBox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
							strStatus="DONE"
							
							strMsg="Web checkbox in portal is already selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","2",strStepName,strMsg)
                     ElseIf  objCheckBox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							 objCheckBox.set "OFF"
							strStatus="DONE"
							
							strMsg="Web checkbox in portal is de-selected successfully"
							strStatus="DONE"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","2",strStepName,strMsg)
					Else
							strStatus="DONE"
							strMsg="Web checkbox in portal is already de-selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","2",strStepName,strMsg)
                   	End If  
					If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	        		End if                       
      else 
                    strStatus="FAIL"
                    strMsg ="Check Box in portal is disabled ."
                    Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","1",strStepName,strMsg)
     End If
    else 
         strStatus="FAIL"
         strMsg = " The Check Box Object in portal  is not Found, Please verify the Screen"
        blnObjectError=True
Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","1",strStepName,strMsg)
  End If
 else 
      strStatus="FAIL"
       strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortal","1",strStepName,strMsg)
  End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 End If

	 If strStatus = "FAIL"  Then
		    SelectWebCheckboxSAPPortal = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	 Else
		    SelectWebCheckboxSAPPortal = True
	 End If
	
	 If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,status,"")
	 End If
	 End If
End Function

''******************************************************************************************************************
Public Function SelectWebCheckboxSAPFrame(creationTime,frameTitle,checkboxName,checkboxHtmlTag,checkboxIndex,OnOffStatus)
If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebCheckboxSAPFrame"
ALMvalue=getEnvironmentVariable("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
strStepName= "Set  Check Box" & OnOffStatus
Set objCheckBox =Browser("CreationTime:="& PopUpCreationtime ).Page("Index:="& PopUpCreationtime).SAPFrame("name:="& frameTitle).WebCheckBox("name:=" & checkboxName,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
If checkBoxAttachedText <> "" or checkboxHtmlTag<> "" or checkboxIndex <>"" Then
    If objCheckBox.Exist(gObjectTimeoutLimit) Then
     If objCheckBox.GetROProperty("disabled")=0 Then
                      If  objCheckBox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objCheckBox.set "ON"
							strStatus="DONE"
							strMsg="Web checkbox in frame is selected successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","2",strStepName,strMsg)
                     ElseIf objCheckBox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
							strStatus="DONE"
							strMsg="Web checkbox in frame is already selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","2",strStepName,strMsg)
                     ElseIf  objCheckBox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							 objCheckBox.set "OFF"
							strStatus="DONE"
							strMsg="Web checkbox in frame is de-selected successfully"
						    Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","2",strStepName,strMsg)
					Else
							strStatus="DONE"
							strMsg="Web checkbox in frame is already de-selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","2",strStepName,strMsg)
                   End If     
      else 
                    strStatus="FAIL"
                    strMsg ="Check Box in frame is disabled ."
                    Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","1",strStepName,strMsg)
     End If
    else 
         strStatus="FAIL"
         strMsg = " The Check Box Object is not Found, Please verify the Screen"
       Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","1",strStepName,strMsg)
        blnObjectError=True
  End If
 else 
      strStatus="FAIL"
       strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPFrame","1",strStepName,strMsg)
  End If
  If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 End If

	 If strStatus = "FAIL"  Then
		    SelectWebCheckboxSAPFrame = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	 Else
		    SelectWebCheckboxSAPFrame = True
	 End If
	
	 If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,status,"")
	 End If
End If
End Function
