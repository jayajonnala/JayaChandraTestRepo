Public Function SelectValSAPList(creationTime,listName,listHtmlTag,listIndex,listValue)
If Not (Environment.Value("blnFatalError") or listValue= DS_SKIP) Then   
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectValSAPList"
strStepName = "Select Item : "& listValue
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Set objSAPList =Browser("CreationTime:="& PopUpCreationtime).Page("Index:=" & PopUpCreationtime).SAPList("name:="& listName,"html tag:="& listHtmlTag,"index:=" &listIndex)
 If listName <> ""  or listHtmlTag <>"" Then   
         If  objSAPList.Exist  then 
             objSAPList.Select listValue
             
             strStatus = "DONE"
			 strMsg = "Value selected successfully from list"
			 Call ReporterFunction(strLibraryFileName,"SelectValSAPList","2",strStepName,strMsg)
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
			 End if
      	 else
	    	blnObjectError=True
			strStatus = "FAIL"
			strMsg = "SAPList object not found"
			Call ReporterFunction(strLibraryFileName,"SelectValSAPList","1",strStepName,strMsg)
    	 end if
   else
      	
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -SelectValSAPList-- Function Call"
        Call ReporterFunction(strLibraryFileName,"SelectValSAPList","1",strStepName,strMsg)
  end if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
		SelectValSAPList = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPList,False,False,True)
Else
		SelectValSAPList = True
End If
If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,listValue,strMsg,strStatus,"")
End If
	' //////////Word Document ///////////
		'	If blnCreateTrainingDoc Then
		'		   Check=CheckStatus_Doc(strStatus)
		'		   If Check=1 Then
		'				  Call storeCoordinates(objSAPList)
		'				  Call StoreSteps(strStepName)
		'		   End If
		'	End If
	 ' //////////Word Document ///////////
	 Set objSAPList=Nothing
End if
End Function
