'*****************************************************************************************
Public Function LaunchSAPWebApplication(URL)
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LaunchSAPWebApplication"
'URL=InputValidation(URL)
		Call CloseAllBrowsers()
 		SystemUtil.Run "iexplore.exe", URL, , , 3
 	End If
 End Function
'*****************************************************************************************

Public Function LaunchSAPWebApplicationEdge(URL)
	strStepName  = "Launch WebApplication: "
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LaunchSAPWebApplication"
'URL=InputValidation(URL)
		Call CloseAllBrowsers()
 		SystemUtil.Run "msedge.exe", URL, , , 3
               strStatus = "DONE"
		strMsg= "Web Application with: "&URL& " launched successfully"
		Call ReporterFunction(strLibraryFileName,"LaunchSAPWebApplicationEdge","2",strStepName,strMsg)        		
 	End If
 	LaunchSAPWebApplicationEdge = True
      If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,URL,strMsg,strStatus,"")
	End If 	
 End Function
 '*****************************************************************************************
Public Function SelectWebCheckbox(creationTime,windowText,checkboxName,checkboxHtmlTag,checkboxIndex,OnOffStatus,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebCheckbox"
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
'		strStepName= "Select  Check Box :" & OnOffStatus
		strStepName= " Set "  & "'" & OnOffStatus & "'" & " in CheckBox : " & "'"& checkboxName & "'"
	
		If blnIsItPopup Then
			Set objCheckBox =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebCheckBox("name:=" & checkboxName,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
		else
    		Set objCheckBox= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebCheckBox("name:=" & checkboxName,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
		End If

		If checkboxName <> "" or checkboxHtmlTag<> "" or checkboxIndex <>""  Then
    		If objCheckBox.Exist(gObjectTimeoutLimit) Then
     			If objCheckBox.GetROProperty("disabled")=0 Then
                      If  objCheckBox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objCheckBox.set "ON"
							
						        strStatus="DONE"
							strMsg="Web checkbox is selected successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","2",strStepName,strMsg)
                      ElseIf objCheckBox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
                      
                 			strStatus="DONE"
							strMsg="Web checkbox is already selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","2",strStepName,strMsg)
                      ElseIf  objCheckBox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							objCheckBox.set "OFF"
							strMsg="Web checkbox is de-selected successfully"
							strStatus="DONE"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","2",strStepName,strMsg)
					  Else
							
									 
							strStatus="DONE"
							strMsg="Web checkbox is already de-selected"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","2",strStepName,strMsg)
                      End If  
					  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	           	      End if                   
      			else 
                strStatus="FAIL"
                strMsg ="Check Box is disabled ."
                Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","1",strStepName,strMsg)
     			End If
    		else 
         	strStatus="FAIL"
         	strMsg = " The Check Box Object is not Found, Please verify the Screen"
        	Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","1",strStepName,strMsg)
        	blnObjectError=True
  			End If
 		else 
      	strStatus="FAIL"
       	strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
       	Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox","1",strStepName,strMsg)
  	End If
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		    SelectWebCheckbox = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objCheckBox,False,False,True)
	Else
		    SelectWebCheckbox = True
	End If
	
	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strStatus,"")
	End If
End if
End Function
