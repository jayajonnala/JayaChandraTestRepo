Public Function SelectWebListSpecialCharacter(creationTime,windowText,weblistName,weblistIndex,val,blnIsItPopup)
If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebListSpecialCharacter"
	'ALMvalue=getEnvironmentVariable("ALMFlag")
	'If  ALMvalue=1 Then
		'PopUpCreationtime=Cint(creationTime) + 1
	'else
		PopUpCreationtime=Cint(creationTime)
	'End If
Dim objWebList
strStepName = "Select Item :  "&val& " from "&weblistName
If blnIsItPopup Then
	Set objWebList =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebList("name:="&weblistName,"html tag:=SELECT","index:="&weblistIndex)
else
    Set objWebList= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebList("name:="&weblistName,"html tag:=SELECT","index:="&weblistIndex)
End If
    If  objWebList.Exist(gObjectTimeoutLimit)   then 
	
		If weblistName <> "" Then
		listItems = objWebList.GetROProperty("all items")
			
		   For Each item In listItems
    
				itemText = Left(item, Len(val))
    
					If Left(itemText, Len(val)) = val Then
					objWebList.Select item
					Exit For
					End If
			Next
		   
               If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objWebList,False,False,True)
               End if
               
               strStatus = "DONE"
               strMsg= "SAPList value set successfully"
               Call ReporterFunction(strLibraryFileName,"SelectWebListSpecialCharacter","2",strStepName,strMsg)
      else
               
              strStatus = "FAIL"
              strMsg = "Function Parameter Not Passed Properly. Check the -SelectWebListSpecialCharacter-- Function Call"
              Call ReporterFunction(strLibraryFileName,"SelectWebListSpecialCharacter","1",strStepName,strMsg)
       end if
  else
                blnObjectError=True
                strStatus = "FAIL"    
                strMsg = "WebList: " & weblistName & " Not found"
                Call ReporterFunction(strLibraryFileName,"SetAttributeSAPList","1",strStepName,strMsg)
	  end if
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       SelectWebListSpecialCharacter = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objWebList,False,False,True)
Else
       SelectWebListSpecialCharacter = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
End If

' //////////Word Document //////////////////////////////////////////////////////////
           'If blnCreateTrainingDoc Then 
            '      Check=CheckStatus_Doc(strStatus)
           '       If Check=1 Then
           '              Call storeCoordinates(objWebList)
           '              Call StoreSteps(strStepName)
           '       End If
          ' End If
    ' //////////Word Document ///////////
   Set objWebList=Nothing
End If
End Function

