Public Function ClickWebElementSendKey(creationTime,windowText,htmltag,innertext,className,indexNumber,blnIsItPopup)
If Not (Environment.Value("blnFatalError") or webeditAccName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickWebElementSendKey"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
strStepName = "Press Enter"
Dim objWebEdit
If innertext<> ""  then
On error resume next
Set objWebElement= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
'.WebEdit("acc_name:="& webeditAccName)
 If  objWebElement.Exist  then 
   	objWebElement.Highlight
        objWebElement.Activate   	
   	 objWebElement.SendKey ENTER
   	 'objWebEdit.FireEvent "ondblclick"
     strStatus = "DONE"
     strMsg= "Enter Pressed Successfully"
     Call ReporterFunction(strLibraryFileName,"PressEnterWebEditByAccName","2",strStepName,strMsg)
	 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		 ImagePath=CaptureScreenshot(strStepName,objWebEdit,True,False,True)
     End if
  else
      blnObjectError=True
      strStatus = "FAIL"    
	  strMsg="Object Missing"
	  Call ReporterFunction(strLibraryFileName,"PressEnterWebEditByAccName","1",strStepName,strMsg)
   end if
else
      strStatus = "FAIL"    
	  strMsg= "Function Parameter Not Passed Properly. Check the --PressEnterWebEditByAccName -- Function Call"
	  Call ReporterFunction(strLibraryFileName,"PressEnterWebEditByAccName","1",strStepName,strMsg)
end if
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       PressEnterWebEditByAccName = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objWebEdit,True,False,True)
Else
       PressEnterWebEditByAccName = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,webeditName,strMsg,strStatus,"")
End If

   Set objWebEdit=Nothing
   End If
End Function
'******************************************************************************************************************
  Public Function VerifyWebElementByPosition(creationTime,windowText,htmltag,innertext,className,indexNumber,textPosition,expVal,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyWebElementByPosition"
		   PopUpCreationtime=Cint(creationTime)
		Dim objWebElement
		strStepName = "Verify if WebElement: " & expVal & " exists in the page"

		If innertext<> "" OR htmltag<> "" Then
			If blnIsItPopup Then
				Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			else
    			        Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			End If
    		If  objWebElement.Exist(gObjectTimeoutLimit)  then 
	            objWebElement.highlight
                   webElementMsg=objWebElement.GetROProperty("outertext")
                   MyArray=Split(webElementMsg,"-","-1","1")
	            textPosition=Cint(textPosition)
	            val=MyArray(textPosition)
                    last  = Right(val,1)
                    If last = "-" Then
	                finallast=instr(1,val,"-",1)
                       finalval=left(val,finallast-1)
                       val=finalval
                    End If
                    If Instr(1,val,expVal) >=0 Then
                         blnCaptureFlag =True
                         If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
			        ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
			    End if
	            	    strStatus = "PASS"
	                   strMsg= "Web Element: "&expVal& " found in the page"
	                   Call ReporterFunction(strLibraryFileName,"VerifyWebElementByPosition","2",strStepName,strMsg)
      		   Else
			     blnObjectError=True
      			     strStatus = "FAIL"	
			      strMsg = innertext&" Web Element Not found in the page"
			      Call ReporterFunction(strLibraryFileName,"VerifyWebElementByPosition","1",strStepName,strMsg)
    		   End if
          End If		   
    Else
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -VerifyWebElementByPosition-- Function Call"
            Call ReporterFunction(strLibraryFileName,"VerifyWebElementByPosition","1",strStepName,strMsg)
     End if
  		
  		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyWebElementByPosition = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	Else
		VerifyWebElementByPosition = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If

' //////////Word Document //////////////////////////////////////////////////////////
'	If blnCreateTrainingDoc Then
'		Check=CheckStatus_Doc(strStatus)
'		If Check=1 Then
'			Call storeCoordinates(objWebElement)
'			Call StoreSteps(strStepName)
'		End If
'	End If
	 ' //////////Word Document ///////////
	Set objWebElement=Nothing
	
	End If

End function
 '***********************************Author: Amit****************************************************************** 
Public Function ConvertNewDateMyorder(DtDate)
'  DtDate=Cdate(DtDate)
	If IsDate(DtDate) Then
			If ConvertDoubledigit( Cstr(Month(DtDate))) = 01 Then
			    newMonth = "January"
                      ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 02 Then 
                          newMonth = "February" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 03 Then 
                          newMonth = "March" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 04 Then 
                          newMonth = "April" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 05 Then 
                          newMonth = "May"  
                        ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 06 Then 
                          newMonth = "June" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 07 Then 
                          newMonth = "July" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 08 Then 
                          newMonth = "August" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 09 Then 
                          newMonth = "September" 
                      ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 10 Then 
                          newMonth = "October" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 11 Then 
                          newMonth = "November" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 12 Then 
                          newMonth = "December"   
                      End If
			NewDate= newMonth+" "+ConvertDoubledigit(CSTR(Day(DtDate))) +", "+ Cstr(Year(DtDate))
  			ConvertNewDateMyorder = NewDate
	Else
			DateVal=Cstr(DtDate)
			ConvertNewDateMyorder =Left(DtDate,2) +"."+ Mid(DtDate,4,2)+ "."+Right(DtDate,4)
	End If
  
  End Function
  '************************************************************************************************************
  Public Function ConvertDayWithDateMyorder(DtDate)
'  DtDate=Cdate(DtDate)
	If IsDate(DtDate) Then
			If ConvertDoubledigit( Cstr(Month(DtDate))) = 01 Then
			    newMonth = "January"
                      ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 02 Then 
                          newMonth = "February" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 03 Then 
                          newMonth = "March" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 04 Then 
                          newMonth = "April" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 05 Then 
                          newMonth = "May"  
                        ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 06 Then 
                          newMonth = "June" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 07 Then 
                          newMonth = "July" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 08 Then 
                          newMonth = "August" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 09 Then 
                          newMonth = "September" 
                      ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 10 Then 
                          newMonth = "October" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 11 Then 
                          newMonth = "November" 
                       ElseIf ConvertDoubledigit( Cstr(Month(DtDate))) = 12 Then 
                          newMonth = "December"   
                      End If
                       If WeekDay(DtDate) = 1 Then   
                         newDay= "sunday"         
                       ElseIf WeekDay(DtDate) = 2 Then   
                         newDay= "monday"	
                       ElseIf WeekDay(DtDate) = 3 Then   
                         newDay= "tuesday"	
                       ElseIf WeekDay(DtDate) = 4 Then   
                         newDay= "wednesday"	                         
                        ElseIf WeekDay(DtDate) = 5 Then   
                         newDay= "thursday"
                        ElseIf WeekDay(DtDate) = 6 Then   
                         newDay= "friday"	   
                        ElseIf WeekDay(DtDate) = 7 Then   
                         newDay= "saturday"	                         
                      End If
			NewDate= newDay+" "+ConvertDoubledigit(CSTR(Day(DtDate))) +" "+newMonth+" "+ Cstr(Year(DtDate))
  			ConvertDayWithDateMyorder = NewDate
	Else
			DateVal=Cstr(DtDate)
			ConvertDayWithDateMyorder =Left(DtDate,2) +"."+ Mid(DtDate,4,2)+ "."+Right(DtDate,4)
	End If
  
  End Function
'*************************************************************************************************************
Public Function NavigateWebElement(creationTime,windowText,htmltag,innertext,className,indexNumber,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or innertext = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : NavigateWebElement"

			PopUpCreationtime=Cint(creationTime)
		Dim objWebElement
		strStepName = "Select WebElement: " & innertext & " exists in the page"

		If innertext<> "" OR htmltag<> "" Then
			If blnIsItPopup Then
				Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			else
    			        Set objWebElement = Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("class:="& className,"innertext:="&innertext,"html tag:="& htmlTag ,"index:="& indexNumber)
			End If
    		If  objWebElement.Exist(gObjectTimeoutLimit)  then 
	            objWebElement.highlight
	             objWebElement.FireEvent "OnMouseOver" 
	                 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
			    End if
	            
	            strStatus = "DONE"
	            strMsg= "Web Element: "&innertext& " Select in the page"
	            Call ReporterFunction(strLibraryFileName,"NavigateWebElement","2",strStepName,strMsg)
      		else
			blnObjectError=True
      			
				strStatus = "FAIL"	
				strMsg = innertext&" Web Element Not found in the page"
				Call ReporterFunction(strLibraryFileName,"VerifyWebElement","1",strStepName,strMsg)
                
    		end if
  		else
     		
     		
            strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -NavigateWebElement-- Function Call"
            Call ReporterFunction(strLibraryFileName,"VerifyWebElement","1",strStepName,strMsg)
	     End if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyWebElement = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
	Else
		NavigateWebElement = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,innertext,strMsg,strStatus,"")
	End If

' //////////Word Document //////////////////////////////////////////////////////////
'	If blnCreateTrainingDoc Then
'		Check=CheckStatus_Doc(strStatus)
'		If Check=1 Then
'			Call storeCoordinates(objWebElement)
'			Call StoreSteps(strStepName)
'		End If
'	End If
	 ' //////////Word Document ///////////
	Set objWebElement=Nothing
	
	End If
End function
