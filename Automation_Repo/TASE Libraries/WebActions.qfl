Public Function SelectWebCheckboxSAPPortalSAPFrame(creationTime,frameTitle,checkboxName,checkboxHtmlTag,checkboxIndex,OnOffStatus)
If Not (Environment.Value("blnFatalError") or OnOffStatus = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebCheckboxSAPPortalSAPFrame"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPCheckbox
strStepName= "Set  Check Box" & OnOffStatus
Set objSAPCheckbox=Browser("CreationTime:="& PopUpCreationtime ).SAPPortal("Index:="& PopUpCreationtime).SAPFrame("name:="& frameTitle).WebCheckBox("name:=" & checkboxName,"html tag:=" &checkboxHtmlTag,"index:=" &checkboxIndex)
If checkBoxAttachedText <> "" Then
    If objSAPCheckbox.Exist Then
     If objSAPCheckbox.GetROProperty("disabled")=0 Then
                      If  objSAPCheckbox.GetROProperty("checked")=0 and OnOffStatus="ON" Then
							objSAPCheckbox.set "ON"
                            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
							End if
							
							strStatus = "DONE"
							strMsg= "SAP Checkbox checked successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","2",strStepName,strMsg)
                     ElseIf objSAPCheckbox.GetROProperty("checked")=1 and OnOffStatus="ON" Then
                            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
							End if
							
							strStatus = "DONE"
							strMsg= "SAP Checkbox checked successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","2",strStepName,strMsg)
                     ElseIf  objSAPCheckbox.GetROProperty("checked")=1 and OnOffStatus="OFF" Then
							 objSAPCheckbox.set "OFF"
                            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
							End if
							
							strStatus = "DONE"
							strMsg= "SAP Checkbox un-checked successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","2",strStepName,strMsg)
					Else
					       If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
									 ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
							End if
							
							strStatus = "DONE"
							strMsg= "SAP Checkbox checked successfully"
							Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","2",strStepName,strMsg)
                   End If     
      else 
			 
              strStatus = "FAIL"
              strMsg = "Check Box is disabled ."
              Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","1",strStepName,strMsg)
     End If
    else 
			  blnObjectError=True
              strStatus = "FAIL"    
              strMsg = " The Check Box Object is not Found, Please verify the Screen"
              Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","1",strStepName,strMsg)
  End If
 else 
			 
              strStatus = "FAIL"
              strMsg = " The Parameter Not Passed Properly. Please verify the Screen"
              Call ReporterFunction(strLibraryFileName,"SelectWebCheckboxSAPPortalSAPFrame","1",strStepName,strMsg)
  End If
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       SelectWebCheckboxSAPPortalSAPFrame = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
Else
       SelectWebCheckboxSAPPortalSAPFrame = True
End If

If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strStatus,"")
End If

   Set objSAPCheckbox=Nothing  
End If
End Function
