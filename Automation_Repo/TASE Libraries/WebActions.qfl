Public Function FileUpload(filePath)
	If Not (Environment.Value("blnFatalError") or filePath = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : FileUpload"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If

		Dim objWebFile
		
		strStepName = "UploadFile ::"& filePath
		Set objWebFile =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).WebFile("type:=file")
		If  objWebFile.Exist(gObjectTimeoutLimit)  then 
			objWebFile.Set filePath
     		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebFile,True,False,True)
			End if
	        
	        strStatus = "DONE"
	        strMsg= "File uploaded successfully"
	        Call ReporterFunction(strLibraryFileName,"FileUpload","2",strStepName,strMsg)
 	 	else
 	 		blnObjectError=True
			strStatus = "FAIL"	
			strMsg = "Object Missing"
			Call ReporterFunction(strLibraryFileName,"FileUpload","1",strStepName,strMsg)
 		End if
 		
 	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		FileUpload = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebFile,True,False,True)
	Else
		FileUpload = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,filePath,strMsg,strStatus,"")
	End If
	Set objWebFile=Nothing
	
	End If

End function
'*****************************************************************************************************************
Public Function SendKeyWeb(specialKeys,functionKeys)
	If Not (Environment.Value("blnFatalError") or specialKeys = DS_SKIP or functionKeys = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SendKeyWeb"
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
   		strStepName = "Send Key "
   		If specialKeys = "" Then
			Set WshShell = CreateObject("WScript.Shell")
    		WshShell.SendKeys functionKeys
    		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,WshShell,True,Fasle,False)
			End if
	            
	            strStatus = "DONE"
	            strMsg = "Key "&functionKeys&" Successfully Sent"
				strStepName = "Send Key : "&functionKeys
				val = functionKeys
				Call ReporterFunction(strLibraryFileName,"SendKeyWeb","2",strStepName,strMsg)
		Else
			concatkey = ""&specialKeys&"+"&"{"&functionKeys&"}"
			concatkey = Cstr(concatkey)
			Set WshShell = CreateObject("WScript.Shell")
    		WshShell.SendKeys concatkey
    		strStatus = "DONE"
			strMsg ="Key "& concatkey &" Successfully Sent"
			strStepName = "Send Key : "&concatkey
			val = concatkey
			Call ReporterFunction(strLibraryFileName,"SendKeyWeb","2",strStepName,strMsg)
		End If
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SendKeyWeb = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,WshShell,True,Fasle,False)
	Else
		SendKeyWeb = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

		
	End If

End function
