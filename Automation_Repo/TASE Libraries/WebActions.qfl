       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       SelectSAPCheckboxSAPPortal = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objSAPCheckbox,False,False,True)
Else
