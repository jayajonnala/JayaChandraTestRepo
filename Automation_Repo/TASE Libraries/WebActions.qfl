Public Function SelectCellSAPTableByRef(creationTime,tableClass,tableHtmlTag,tableName,tableIndex,columnNum,refCellVal)
    If Not (Environment.Value("blnFatalError") or refCellVal= DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellSAPTableByRef"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
Dim objSAPTable
strStepName = "Select cell in SAP Table"
Set objSAPTable =Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPTable("class:="& tableClass,"html tag:="& tableHtmlTag,"name:=" & tableName,"Index:=" & tableIndex)
    If  objSAPTable.Exist(gObjectTimeoutLimit)  then 
        If  columnNum <> "" or tableIndex <> "" Then
			columnNum = Cint(columnNum)
			rowNum=objSAPTable.FindRowByCellContent(columnNum,refCellVal)
            rowNum = Cint(rowNum)
            objSAPTable.SelectCell rowNum,columnNum
            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
		   	End if
			strStatus = "DONE"
			strMsg = "Table cell selected successfully"
			Call ReporterFunction(strLibraryFileName,"SelectCellSAPTableByRef","2",strStepName,strMsg)
        else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SelectCellSAPTableByRef-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SelectCellSAPTableByRef","1",strStepName,strMsg)
         end if
  else
  		  blnObjectError=True
		  strStatus = "FAIL"
		  strMsg = tablelName &" Table Not found"
		  Call ReporterFunction(strLibraryFileName,"SelectCellSAPTableByRef","1",strStepName,strMsg)
   End if
   If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectCellSAPTableByRef = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
	Else
		SelectCellSAPTableByRef = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,refCellVal,strMsg,strStatus,"")
	End If
	' //////////Word Document ///////////
		'	If blnCreateTrainingDoc Then
		'		   Check=CheckStatus_Doc(strStatus)
		'		   If Check=1 Then
		'				  Call storeCoordinates(objSAPTable)
		'				  Call StoreSteps(strStepName)
		'		   End If
		'	End If
	 ' //////////Word Document ///////////
	 End if
	 Set objSAPTable=nothing
   End Function
'**************************************************************************************************
Public Function SelectCellSAPTable(creationTime,tableClass,tableHtmlTag,tableName,tableIndex,rowNum,colNum)
If Not (Environment.Value("blnFatalError") or colNum= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellSAPTable"
'ALMvalue=getEnvironmentVariable("ALMFlag")
'If  ALMvalue=1 Then
	'PopUpCreationtime=Cint(creationTime) + 1
'else
	PopUpCreationtime=Cint(creationTime)
'End If
strStepName ="Select cell in SAP Table"
Dim objSAPTable
Set objSAPTable =Browser("CreationTime:=" &PopUpCreationtime).Page("Index:=" &PopUpCreationtime).SAPTAble("class:="& tableClass,"html tag:="& tableHtmlTag,"name:=" & tableName,"Index:=" & tableIndex)
    If  objSAPTable.Exist(gObjectTimeoutLimit)  then 
         If rowNum<> "" and colNum<>"" Then
             rowNum = Cint(rowNum)
             colNum = Cint(colNum)
             objSAPTable.SelectCell rowNum,colNum
             
             If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
			 End if
			 
			 strStatus = "DONE"
			 strMsg = "Cell selected successfully"
			 Call ReporterFunction(strLibraryFileName,"SelectCellSAPTable","2",strStepName,strMsg)
             
        else
			strStatus = "FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the -SelectCellSAPTable-- Function Call"
			Call ReporterFunction(strLibraryFileName,"SetTextBox","1",strStepName,strMsg)
	    end if
   else
 	    blnObjectError=True
		strStatus = "FAIL"
		strMsg = "Table object not found"
		Call ReporterFunction(strLibraryFileName,"SelectCellSAPTable","1",strStepName,strMsg)
 end if
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
		SelectCellSAPTable = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
Else
		SelectCellSAPTable = True
End If
If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,colNum,strMsg,strStatus,"")
End If
	' //////////Word Document ///////////
		'	If blnCreateTrainingDoc Then
		'		   Check=CheckStatus_Doc(strStatus)
		'		   If Check=1 Then
		'				  Call storeCoordinates(objSAPTable)
		'				  Call StoreSteps(strStepName)
		'		   End If
		'	End If
	 ' //////////Word Document ///////////
	 Set objSAPTable=Nothing
	End if
End Function
