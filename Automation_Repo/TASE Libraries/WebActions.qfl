      		else
               	
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SelectCellSAPTableSAPPortalSAPFrame-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SelectCellSAPTableSAPPortalSAPFrame","1",strStepName,strMsg)
    		end if
 		else
			blnObjectError=True
			strStatus = "FAIL"	
			strMsg = "Table object not found"
			Call ReporterFunction(strLibraryFileName,"SelectCellSAPTableSAPPortalSAPFrame","1",strStepName,strMsg)
 		end if
 		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectCellSAPTableSAPPortalSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPTable,False,False,True)
	Else
		SelectCellSAPTableSAPPortalSAPFrame = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,rowNum,strMsg,strStatus,"")
	End If

	Set objSAPTable=Nothing
	
	End If

End function
