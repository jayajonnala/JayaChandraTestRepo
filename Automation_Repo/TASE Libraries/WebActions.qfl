							End if
							
							strStatus="DONE"
							strMsg= "SAPCheckbox checked successfully"
							Call ReporterFunction(strLibraryFileName,"SelectSAPCheckboxSAPPortal","2",strStepName,strMsg)
                   End If     
      else 
					Call ReporterFunction(strLibraryFileName,"SelectSAPCheckboxSAPPortal","1",strStepName,"Check Box is disabled .")
					strStatus = "FAIL"
					strMsg = "Check Box is disabled ."
     End If
    else 
