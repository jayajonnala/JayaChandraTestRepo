                   ImagePath=CaptureScreenshot(strStepName,objSAPTreeView,True,False,True)
         End if
        
         strStatus = "DONE"
         strMsg= "SAP Tree selected successfully"
         Call ReporterFunction(strLibraryFileName,"SelectSAPTreeViewSAPPortal","2",strStepName,strMsg)
	Else
              blnObjectError=True 
