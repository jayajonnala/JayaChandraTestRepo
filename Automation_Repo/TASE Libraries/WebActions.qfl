'Function SelectWebCheckbox(creationTime,windowText,checkboxType,checkboxHtmlTag,checkboxIndex,OnOffStatus,blnIsItPopup)
Public Function SelectWebCheckbox_ChildObjects(creationTime,windowText,checkboxType,checkboxHtmlTag,checkboxIndex,OnOffStatus,blnIsItPopup)
  Dim objBrowser,oDesc,i,strTitle
  If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetField_ChildWinEdit"
       strStepName= "Select  Check Box :" & OnOffStatus
        strStepName= " Set "  & "'" & OnOffStatus & "'" & " in CheckBox : " & "'"& checkboxName & "'"
	 on error resume next
       err.clear
	If blnIsItPopup Then
	   Set objBrowser=Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime)
	else
    	   Set objBrowser=Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime)
	End If			
        If objBrowser.Exist then
           Set oDesc = Description.Create
           oDesc("micclass").value = "WebCheckBox"
           oDesc("type").value = checkboxType
           'Find all the WebCheckBox
           Set objChild = objBrowser.ChildObjects(oDesc)
           For i = 0 to objChild.Count - 1	 
            'get the name of all the CheckBox in the page			    
             If i = p_Index Then
                If  objChild(i).Exist  Then 	
                     objChild(i).highlight
	              objChild(i).set OnOffStatus
			p_Input = p_value
					Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox_ChildObjects","2","Set WebCheckbox Field :","The following WebCheckbox Field was set :  with the value : " &OnOffStatus &" .")	
				    strStatus = "DONE"
				    strMsg = "WebCheckbox Field was set Successfully."
				Else									
				   Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox_ChildObjects","1","Set WebCheckbox Field :","The WebCheckbox Field: was not set with the value: " &OnOffStatus &" .")	
				   strStatus = "FAIL"
				   blndefectFlag =True
				   strMsg = "WebCheckbox Field was not set."
               End If
           Exit for
             End If 
           Next																						
	   Else 
                    Call ReporterFunction(strLibraryFileName,"SelectWebCheckbox_ChildObjects","1","Set WebCheckbox Field :","The WebCheckbox Field is empty.")	
			strStatus = "FAIL"
			blndefectFlag =True
			strMsg = "The WebCheckbox Field is empty."
     End If		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
	    SelectWebCheckbox_ChildObjects = strMsg
	Else
	     SelectWebCheckbox_ChildObjects = True
	End If
	If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,p_Input,strMsg,strStatus,"")
	End If
 End If
End function
