Set objSAPTreeView=Browser("CreationTime:="& PopUpCreationtime ).SAPPortal("Index:="& PopUpCreationtime).SAPTreeView("logical name:="&saptreeLogicalName)
On Error Resume Next
	If  objSAPTreeView.Exist  then
		objSAPTreeView.highlight
