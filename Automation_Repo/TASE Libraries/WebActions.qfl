Public Function LoginSAPEdit(username,password)
	If Not (Environment.Value("blnFatalError") or username=DS_SKIP or password=DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LoginSAPEdit"
		On error resume next
		Set QCConn = QCUtil.QCConnection
  		If Err.Number = CLng(-2147221500) or QCUtil.IsConnected=false Then
  			TestName = Environment.Value("TestName")
  		Else 
	   		TestName = QCUtil.CurrentTest.Name
  		end if

 		Set WshShell = CreateObject("WScript.Shell")
		Set WshDTEnv = WshShell.Environment("USER")
    	WshDTEnv("sheetNameEnv") = loginSheetName
'		If  TestName<>"" Then
'			Call Html_iteration(TestName)
'		Else
'			Call Html_iteration("Login Web Portal")
'		End If
'		Call Importsheets()
		strStepName = "Enter User Name : "&username&" and Password : ********"
		On error resume next
		Set oDesc1=Description.Create()
		oDesc1("micclass").value ="Browser"
		Set browserList = Desktop.ChildObjects(oDesc1)
		creationTime = browserList.count

'Set oDesc2=Description.Create()
'oDesc2("micclass").value ="Window"
'oDesc2("text").value ="HP Application Lifecycle Management.*"
'Set browserList2 = Desktop.ChildObjects(oDesc2)
		flagval=0
'For i=1 to creationTime
'	 If IsNull(InStr(CSTR(browserList(i).getROProperty("name")),CSTR("HP Application Lifecycle Management"),1)) then
'		flagval=0
'	 elseif  Instr(CSTR(browserList(i).getROProperty("name")),CSTR("HP Application Lifecycle Management"),1)>0 then
'		 flagval=1
'		 Exit for
'     elseif browserList2.count>0 then
'         flagval=0
'         Exit For
'	 else
'		flagval=0
'	 End If
'Next
		Set obj=Nothing
		If flagval=1 Then
			WshDTEnv("ALMFlag")=1
			Set obj=Browser("creationtime:=1").Page("Index:=1") ' give a proper name to object here
			
		Else
			WshDTEnv("ALMFlag")=0
			Set obj=Browser("creationtime:=0").Page("Index:=0")
		End If
		Err.clear
   		If  obj.Exist(gObjectTimeoutLimit)  then 
			If username<>"" and password <> ""  Then
'            username = InputValidation(username)
'			password = InputValidation(password)
           		obj.SAPEdit("name:=(.*)?user").Set username
		   		obj.SAPEdit("name:=(.*)?password").SetSecure password
		   		obj.SAPEdit("name:=(.*)?password").Submit
		   		strStatus = "DONE"
		   		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
	          	End if
		   		
		   	     strStatus = "DONE"
		   	   	 strMsg= "Username and Password entered successfully"
		   		 Call ReporterFunction(strLibraryFileName,"LoginSAPEdit","2",strStepName,strMsg)
	    	else 
		  	
	      	strStatus = "FAIL"
           	strMsg = "Function Parameter Not Passed Properly. Check the --Login-- Function Call"
           	Call ReporterFunction(strLibraryFileName,"LoginSAPEdit","1",strStepName,strMsg)
	   	End If
	   	else 
	   		
	   		strStepName  = "UsernameField,PasswordField : No Such Objects Found"
	   		strStatus="FAIL"
         	strMsg = " The Object is not Found, Please verify the Screen"
         	Call ReporterFunction(strLibraryFileName,"LoginSAPEdit","1",strStepName,strMsg)
		 	blnObjectError=True
   		End If
		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 	End If

	 	If strStatus = "FAIL"  Then
		    LoginSAPEdit = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
	 	Else
		    LoginSAPEdit = True
		End If
	
	 	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,username&";"&password,strMsg,strStatus,"")
	 	End If
 		WshDTEnv("sheetNameEnv") =left(TestName,30)
 	End If
End Function
