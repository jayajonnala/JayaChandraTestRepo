Public Function SelectWebRadioButton(creationTime,windowText,radioGroupClass,radioGroupName,radioGroupIndex,itemToBeSelected,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or itemToBeSelected = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebRadioButton"
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		If itemToBeSelected<> ""  OR radioGroupClass <> ""  Then
			strStepName  = "Select Radio Button: "& itemToBeSelected
			If blnIsItPopup Then
				Set objRadioButton =Browser("CreationTime:="& PopUpCreationtime).Window("text:="&windowText).Page("Index:="& PopUpCreationtime).SAPRadioGroup("html tag:=INPUT","class:="& radioGroupClass,"name:="& radioGroupName,"index:="& radioGroupIndex)
			else
    			Set objRadioButton= Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).SAPRadioGroup("html tag:=INPUT","class:="& radioGroupClass,"name:="& radioGroupName,"index:="& radioGroupIndex)
			End If
	 		If  objRadioButton.Exist(gObjectTimeoutLimit)  then 
				objRadioButton.Select itemToBeSelected
				strStatus = "DONE"
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  	ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	        	End if
				
				strMsg="Web Radio button selected successfully"
				Call ReporterFunction(strLibraryFileName,"SelectWebRadioButton","2",strStepName,strMsg)
	 		else
		 		strMsg ="Object Missing"
		 		strStatus = "FAIL"
		 		blnObjectError=True
		 		Call ReporterFunction(strLibraryFileName,"SelectWebRadioButton","1",strStepName,strMsg)
	 		end if
 		else
     		strMsg = "Function Parameter Not Passed Properly. Check the --SelectWebRadioButton -- Function Call"
     		strStatus = "FAIL"
	 		Call ReporterFunction(strLibraryFileName,"SelectWebRadioButton","1",strStepName,strMsg)
 		end if
 		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	 	End If

	 	If strStatus = "FAIL"  Then
		    SelectWebRadioButton = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	 	Else
		    SelectWebRadioButton = True
	 	End If
	
	 	If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemToBeSelected,strMsg,status,"")
	 	End If
	End If
End Function
