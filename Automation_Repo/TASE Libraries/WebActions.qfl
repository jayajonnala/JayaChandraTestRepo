'*****************************************************************************************************************************************************
Public Function SelectWebListSAPPortalSAPFrame(creationTime,frameTitle,weblistName,weblistIndex,val)
	If Not (Environment.Value("blnFatalError") or val = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectWebListSAPPortalSAPFrame"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		
		Dim objWebList
		strStepName = "Select Item :  "&val& " from "&weblistName
		Set objWebList =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPFrame("title:="&frameTitle).WebList("name:="&weblistName,"html tag:=SELECT","index:="&weblistIndex)
    	If  objWebList.Exist(gObjectTimeoutLimit)  then 
			If weblistName <> "" or weblistIndex <> "" Then
		   		objWebList.Select val
          		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objWebList,False,False,True)
				End if
	        	
	        	strStatus = "DONE"
	        	strMsg= "WebList value selected successfully"
	        	Call ReporterFunction(strLibraryFileName,"SelectWebListSAPPortalSAPFrame","2",strStepName,strMsg)
      		else
        		
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SelectWebListSAPPortalSAPFrame-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SelectWebListSAPPortalSAPFrame","1",strStepName,strMsg)
			end if
  		else
     
    		blnObjectError=True
			strStatus = "FAIL"	
			strMsg = "WebList: " & weblistName & " Not found"
			Call ReporterFunction(strLibraryFileName,"SelectWebListSAPPortalSAPFrame","1",strStepName,strMsg)
	  end if
	  
If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectWebListSAPPortalSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebList,False,False,True)
	Else
		SelectWebListSAPPortalSAPFrame = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
	End If

	End If

End function
'*****************************************************************************************************************************************************
Public Function PressEnterSAPEditSAPPortalSAPFrame(creationTime,frameTitle,SAPAttachedText)
	If Not (Environment.Value("blnFatalError") or SAPAttachedText = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : PressEnterSAPEditSAPPortalSAPFrame"
		
		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If
		Dim objSAPEdit
		strStepName = "Press Enter in  "& SAPAttachedText

		If SAPAttachedText<> "" Then

			Set objSAPEdit =Browser("CreationTime:="& PopUpCreationtime).SAPPortal("Index:="& PopUpCreationtime).SAPFrame("title:=" &frameTitle).SAPEdit("sap attached text :="& SAPAttachedText,"index:=0")
			On error resume next 
 			If  objSAPEdit.Exist  then
   	 			objSAPEdit.Submit
    			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
			    End if
			    
	            strStatus = "DONE"
	 			strMsg = "Enter Pressed Successfully"
	 			Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortalSAPFrame","2",strStepName,strMsg)
  			else
  				blnObjectError=True
				strStatus = "FAIL"	
     			strMsg ="Object Missing"
     			Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortalSAPFrame","1",strStepName,strMsg)
    		end if
		else
			strStatus = "FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the -PressEnterSAPEditSAPPortalSAPFrame-- Function Call"
            Call ReporterFunction(strLibraryFileName,"PressEnterSAPEditSAPPortalSAPFrame","1",strStepName,strMsg)
		end if
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		PressEnterSAPEditSAPPortalSAPFrame = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objSAPEdit,True,False,False)
	Else
		PressEnterSAPEditSAPPortalSAPFrame = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,SAPAttachedText,strMsg,strStatus,"")
	End If

	Set objSAPEdit=Nothing
	
	End If

End function
'*****************************************************************************************************************************************************
Public Function SelectRowWebTableSAPPortalSAPFrameByRef(creationTime,frameTitle,tableClass,columnNum,refVal)
	If Not (Environment.Value("blnFatalError") or columnNum = DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowWebTableSAPPortalSAPFrameByRef"
		

		'ALMvalue=getEnvironmentVariable("ALMFlag")
		'If  ALMvalue=1 Then
			'PopUpCreationtime=Cint(creationTime) + 1
		'else
			PopUpCreationtime=Cint(creationTime)
		'End If

		Dim objWebTable
 		strStepName = "Select Row in a WebTable"
 		
		Set objWebTable =Browser("CreationTime:="&PopUpCreationtime).SAPPortal("Index:="&PopUpCreationtime).SAPFrame("title:=" &frameTitle).WebTable("Html tag:=TABLE","Class:="& tableClass,"index:=1")
		If  objWebTable.Exist(gObjectTimeoutLimit)  then 
	   		If refVal <> "" or columnNum <> "" Then
		   		On Error Resume Next
           		rowNo=objWebTable.GetRowWithCellText(refVal)
            	If rowNo=-1 Then'*** test and confirm if rowNo as -1 is returned. I hope it should be err.Number
            		
					strStatus = "FAIL"
					strMsg = "Element  : "& refVal & " is not found in the table"
                    Call ReporterFunction(strLibraryFileName,"SelectRowWebTableSAPPortalSAPFrameByRef","1",strStepName,strMsg)
                Else
                 	Set WebElementObj =objWebTable.ChildItem(rowNo,columnNum,"WebElement",0)
			      	WebElementObj.Click
			      	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,True)
			    	End if
			    	
				   	strStatus = "DONE"
				    strMsg = "Element  : "& refVal & " is selected"	
                    Call ReporterFunction(strLibraryFileName,"SelectRowWebTableSAPPortalSAPFrameByRef","2",strStepName,strMsg)
				End If						
	  		Else 
               	
               	strStatus = "FAIL"
               	strMsg = "Function Parameter Not Passed Properly. Check the -SelectRowWebTableSAPPortalSAPFrameByRef-- Function Call"
               	Call ReporterFunction(strLibraryFileName,"SelectRowWebTableSAPPortalSAPFrameByRef","1",strStepName,strMsg)
			End If
		Else 
			blnObjectError=True
	  		strStatus="FAIL"
       		strMsg = " The WebTable Object is not Found, Please verify the Screen"
       		Call ReporterFunction(strLibraryFileName,"SelectRowWebTableSAPPortalSAPFrameByRef","1",strStepName,strMsg)

 		End If
 		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SelectRowWebTableSAPPortalSAPFrameByRef = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,True)
	Else
		SelectRowWebTableSAPPortalSAPFrameByRef = True
	End If

	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,refVal,strMsg,strStatus,"")
	End If

	Set objWebTable=Nothing
	
	End If

End function
