'******************************************************************************************************
'Name of the Function   : FindRowNumber
'Description		     :Finds Row number of a Gui Table or Grid
'Input Parameters	     :  tableNameOrGridTitle - table name or Grid Title
'		                refColumnName - Name of the reference column which will be used for calculating row
'				        refCellValue- Cell Value in the reference Column corresponding to the row number which is to be fetched
'			           dataTableColumnName- Column name of the data sheet where row number will be stored
'											
'Output Parameters        : Row Number
'******************************************************************************************************
'Function FindRowNumber(tableNameOrGridTitle,refColumnName,refCellValue,dataTableColumnName)
'*****************************************************************************************************

Public Function FindRowNumber(tableNameOrGridTitle,refColumnName,refCellValue,dataTableColumnName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : FindRowNumber"
strStepName= "Get Row Number"
If refColumnName<> "" Then

Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableNameOrGridTitle)
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&tableNameOrGridTitle)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&tableNameOrGridTitle)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 
Set objGuiGridTable=setObj(objTable,objGuiGrid)

 If objGuiGridTable.Exist Then
                   strRowNumber = objGuiGridTable.FindRowByCellContent(refColumnName,refCellValue)
	               'strStatus = StoreExcel(strRowNumber,dataTableColumnName)
	                strCapturedText=strRowNumber
				  strStatus = "DONE"
				  Call ReporterFunction(strLibraryFileName,"FindRowNumber","2","Find Row number","Grid/Table Row Number Fetched Into Datatable")
				  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		ImagePath=CaptureScreenshot(strStepName,objGuiGridTable,False,False,False)
	              End if
						strMsg = "Grid/Table Row Number Fetched Into Datasheet"	
					

	Else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"FindRowNumber","1","Find Row number","Table or Grid does not exist")
        strMsg= "Table or Grid does not exist"
     blnObjectError=True
	End If
	else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"FindRowNumber","1","Find Row number","Function Parameter Not Passed Properly. Check the --FindRowNumberp-- Function Call")
        strMsg= "Function Parameter  Not Passed Properly. Check the --FindRowNumber-- Function Call"
        End If
        
        If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    FindRowNumber = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGuiGridTable,False,False,False)
	   Else
		    FindRowNumber = strMsg
	   End If
	If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve the desired row number from the GUI Grid/Table and store in '"&gstrOutputSheetName&"' sheet under column '"&dataTableColumnName&"'"
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve desired row number from the GUI Grid/Table"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
							End If 
							
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue,strMsg,strStatus,"")
	   End If
	 ' ////////
Set objGuiGrid201= Nothing
Set objGuiGrid80=Nothing
Set objGuiGrid=Nothing
Set objTable=Nothing
End if
End Function
'*******************************************************************************************
'End Function FindRowNumber
'*******************************************************************************************


'******************************************************************************************************
'Name of the Function   : SelectNodeGuiTree
'Description		     : Selects Node in Gui Tree
'Input Parameters	     :  treeIndex - Index of the tree in which the item is present
'		                itemPath - Path to the item which is to be activated
'											
'Output Parameters        : 
'******************************************************************************************************
'Function SelectNodeGuiTree(treeIndex,itemPath,itemText)
'******************************************************************************************************
Public Function SelectNodeGuiTree(treeIndex,itemPath)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectNodeGuiTree"
strStepName = "Select Node: " & "'" &  itemPath & "'" & " in GuiTree"
If treeIndex <>"" or itemPath<>"" Then
Set objTree=SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
objTree.SelectNode itemPath
			  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
Call ReporterFunction(strLibraryFileName,"SelectNodeGuiTree","2"," Select Node in GuiTree","Node Selected:- "&itemPath)
strStatus = "DONE"
strMsg="Node in the tree is selected successfully" 
else
		Call ReporterFunction(strLibraryFileName,"SelectNodeGuiTree","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		blnObjectError=True
End If
Else
		Call ReporterFunction(strLibraryFileName,"SelectNodeGuiTree","1","Select Node Gui Tree ","Function Parameter Not Passed Properly. Check the --SelectNodeGuiTree-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter to select the node in the GUITree is Not Passed Properly. Check the --SelectNodeGuiTree-- Function Call-"	
End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectNodeGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    SelectNodeGuiTree = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set  objTree =nothing
End if
End Function
'*****************************************************************************************************
'End Function - SelectNodeGuiTree
'*****************************************************************************************************************

''***********************************************************************************
'Name of the Function   : SelectCheckboxGuiTree
'Description		     : Sets the state of a check box item for the specified node in a SAP column tree or list tree.
'Input Parameters	     : treePath,checkboxItem,treeIndex,OnOffStatus              
'											 itemPath - Path to the item where checkbox is to be selected
 '										     :  treeIndex - Index of the tree in which the item is present
'											checkboxItem - The checkbox item to be selected     
'											OnOffStatus- "ON"-for selecting and "OFF" for uncheking the check box
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Example :              Call SelectCheckboxGuiTree(1,"Relationships;End date of relationship","#2","ON","")
'Output Parameters        :Null
'***********************************************************************************
'Function  SelectCheckboxGuiTree(treeIndex,treePath,checkboxItem,OnOffStatus,blnIsItPopup)
'************************************************************************************
Public Function SelectCheckboxGuiTree(treeIndex,treePath,checkboxItem,OnOffStatus,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckboxGuiTree"
strStepName = "Set the state of check box item " &checkboxItem & "  for the node: " &treePath
 Set objWindow= SetSAPwindowObj(blnIsItPopup)
 Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(objWindow).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
   If objTree.Exist Then
        If VerifyObjectStatus(objTree) Then
        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
            objTree.Set treePath,checkboxItem,OnOffStatus
            Call ReporterFunction(strLibraryFileName,"SelectCheckboxGuiTree","2","Select Checkbox ","CheckBox Selected for the node:- "&treePath)
             strStatus = "DONE"
             strMsg="Checkbox in tree is selected successfully"
       else
	        Call ReporterFunction(strLibraryFileName,"SelectCheckboxGuiTree","1","Tree Node Disabled","Check Box in the Tree Path is disabled. It cannot be clicked")
		    strStatus="FAIL"
		     strMsg ="Check Box in the Tree Path is disabled. It cannot be clicked."
		     blnObjectError=True
	   End If
	Else
			Call ReporterFunction(strLibraryFileName,"SelectCheckboxGuiTree","1","Select Checkbox Gui Tree","Tree Object Missing")
			strStatus = "FAIL"
			strMsg = " The Tree Object is not Found, Please verify the Screen"
			blnObjectError=True
  End If
  If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckboxGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    SelectCheckboxGuiTree = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus&";"&treePath,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
				'If blnCreateTrainingDoc= 1 Then
					'Check=CheckStatus_Doc(strStatus)
					'If Check=1 Then
					'	Call storeCoordinates(objectCheckbox)
					'	Call StoreSteps(strStepName)
					'End If
				'End If
 ' //////////Word Document ///////////
Set  objTree =nothing
Set objWindow=Nothing
End If
End Function
'**************************************************************************************************************
'End Function - SelectCheckboxGuiTree
'**************************************************************************************************************


Function SelectRadioButtonIfPopupExists(radiobuttonName,radiobuttonAttachedtext)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRadioButtonIfPopupExists"
strStepName ="Select Radio Button in a popup"
If radiobuttonName <>"" OR radiobuttonAttachedtext<>"" Then
Set objWindow= SetSAPwindowObj(True)

'	radiobuttonName=InputValidation(radiobuttonName)
'	radiobuttonAttachedtext=InputValidation(radiobuttonAttachedtext)
	  Set objPopupRadioButton= SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiRadioButton("guicomponenttype:=41","name:="&radiobuttonName,"attachedtext:="&radiobuttonAttachedtext)
          If objPopupRadioButton.Exist Then
                      If VerifyObjectStatus(objPopupRadioButton)=True Then
									If VerifyRadioButton(objPopupRadioButton)=False Then
											  objPopupRadioButton.Set
											  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		   						 ImagePath=CaptureScreenshot(strStepName,objPopupRadioButton,False,False,True)
	          							      End if
											  Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfPopupExists","2","RadioButton","Value Used :-"& vbNewLine &"RadioButtonName: " &radiobuttonName& "RadioButton AttachedText:"&radiobuttonAttachedtext)
											   strStatus = "DONE"
											   strMsg="Radiobutton in the pop-up is selected successfully"
									Else
											   Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfPopupExists","2","RadioButton","Radio button is already selected")
											   strStatus = "DONE"
											   strMsg="Radiobutton in the pop-up is already selected"
									End If
						Else
								Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfPopupExists","1","RadioButton","Radio Button  with "& vbNewLine &"RadioButtonName: " &radiobuttonName& "and RadioButton AttachedText: "&radiobuttonAttachedtext&" is not enabled.So cannot be set.")
								strStatus = "FAIL"
								strMsg = " The RadioButton Object is not enabled, Please verify the Screen"
								 
								 blnObjectError=True
						End If
         
Else
	   Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfPopupExists","1","RadioButton","Function Parameter Not Passed Properly. Check the --SelectRadioButtonPopup-- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --SelectRadioButtonPopup-- Function Call"
End If
End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRadioButtonIfPopupExists = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objPopupRadioButton,False,False,True)
	   Else
		    SelectRadioButtonIfPopupExists = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objPopupRadioButton)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objPopupRadioButton=nothing
End if
End Function



'******************************************************************************************************
'Name of the Function   : ActivateNodeGuiTree
'Description		     : Activates Node in Gui Tree
'Input Parameters	     :  treeIndex - Index of the tree in which the item is present
'											 itemPath - Path to the item which is to be activated
'											itemText - Text of the SAP item which is to be activated
'Output Parameters        : 
'******************************************************************************************************
'Function ActivateINodeGuiTree(treeIndex,itemPath,itemText)
'******************************************************************************************************
Public Function ActivateNodeGuiTree(treeIndex,itemPath)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ActivateNodeGuiTree"
strStepName = "Activate Node: " & "'" &  itemPath & "'" & " in GuiTree"
If treeIndex <>"" or itemPath<>"" Then
Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If  objTree.Exist Then
objTree.ActivateNode itemPath
If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
Call ReporterFunction(strLibraryFileName,"ActivateNodeGuiTree","2"," Activate Node in GuiTree","Item Activated:- "&itemText)
strStatus = "DONE"
strMsg="Node in the tree activated successfully"
else
		Call ReporterFunction(strLibraryFileName,"ActivateNodeGuiTree","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		blnObjectError=True
End If
Else
		Call ReporterFunction(strLibraryFileName,"ActivateNodeGuiTree","1","Activate Node Gui Tree ","Function Parameter Not Passed Properly. Check the --ActivateINodeGuiTree-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ActivateINodeGuiTree-- Function Call-"	
End If

If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    ActivateNodeGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    ActivateNodeGuiTree = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath,strMsg,strStatus,"")
	   End If
  ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set  objTree =nothing
End If
End Function
'*****************************************************************************************************
'End Function - ActivateNodeGuiTree
'*****************************************************************************************************************

'**********************************************************************************
'Name of the Function   :  ActivateCellGuiGridByRefVal
'Description		     : Activate a Cell in a SAP Gui Grid (both normal or pop-up )      
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'                gridIndex : Index property of the grid     
'				columnName :- Name Property of the column having unique value 
'				refValue :- Value in the column  for the given columnName for the particular row to be activated                                          
'              Output Parameters        :Null
'               Usage : User can activate a particular cell of a grid, to do so user have to pass the cell content and corresponding column name of the cell
'***********************************************************************************
'Function ActivateCellGuiGridByRefVal(gridTitle,columnName,refValue)
'***********************************************************************************
Public Function ActivateCellGuiGridByRefVal(gridTitle,gridIndex,refColumn,refFieldVal,columnName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ActivateCellGuiGridByRefVal"
   Dim objGridGuiComp80,objGridGuiComp201,objGrid

strStepName = "Activate the desired cell in the column '" &columnName & "' of the grid" 
Set objWindow= SetSAPwindowObj(blnIsItPopup)
If columnName<> ""  then
'Set objGridGuiPopupComp80 = sapguisession(sessionObject).sapguiwindow(windowObject1).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
'Set objGridGuiPopupComp201= sapguisession(sessionObject).sapguiwindow(popupwindowObject).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
'Set objGrid=SetObj(objGridGuiPopupComp80,objGridGuiPopupComp201)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					strRowNo=objGrid.FindRowByCellContent(refColumn,refFieldVal)
            		If Err.Number=0 and strRowNo <> "" Then
						objGrid.ActivateCell strRowNo,columnName
'						objGrid.ActivateRow strRowNo
					If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          		End if
						Call ReporterFunction(strLibraryFileName,"ActivateCellGuiGridByRefVal","2"," Cell field","Cell Activated:-"& vbNewLine &" Cell No : "&strRowNo)
						strStatus = "DONE"
						strMsg="Cell in the grid is activated successfully"
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"ActivateCellGuiGridByRefVal","1","Cell field","The Column:  "&columnName& " Not Found Within The GuiGrid")
						 strStatus = "FAIL"
						 strMsg = "The Column "&columnName& " Not Found Within The GuiGrid"
						 blnObjectError=True
					Else 
						Call ReporterFunction(strLibraryFileName,"ActivateCellGuiGridByRefVal","1","Cell field","Value "&refValue&" Not Found Within The Column :"&columnName& " of GuiGrid")
						 strStatus = "FAIL"
						strMsg ="Value '"&refValue&"' Not Found Within The Column '"&columnName& "' of GuiGrid"
						
					End If		
		Else 
			Call ReporterFunction(strLibraryFileName,"ActivateCellGuiGridByRefVal","1","Cell field","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			blnObjectError=True
		End If

Else
	Call ReporterFunction(strLibraryFileName,"ActivateCellGuiGridByRefVal","1","Cell field","Function Parameter Not Passed Properly. Check the --ActivateCellGuiGridByRefVal-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --ActivateCellGuiGridByRefVal-- Function Call"
End if				
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    ActivateCellGuiGridByRefVal = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    ActivateCellGuiGridByRefVal = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
Set objGrid=Nothing
Set objGrid1=Nothing
Set objGridGuiPopupComp80=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiPopupComp201=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - ActivateCellGuiGridByRefVal
'************************************************************************************



'**********************************************************************************
'Name of the Function   : GetLabelContentByRefLabel
'Description		     : To Fetch the value of a label with respect to another Label(reference lebel)                  
'Input Parameters: refLabelContent : Content of the label which is taken as reference
 '                                    yDifferenceValue: (ycordinate of reference lebel) - (ycordinate of target lebel)
 '                                    xDifferenceValue: (xcordinate of reference lebel) - (xcordinate of target lebel)
 '                                   dataTableColumnName : column name in the data sheet where the Label Content  will be stored	
 '					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window	        
'Output Parameters     : Label Content
'***********************************************************************************
'Function GetLabelContentByRefLabel(refLabelContent,xDifferenceValue,yDifferenceValue,dataTableColumnName,blnIsItPopup)
'***********************************************************************************
Public Function GetLabelContentByRefLabel(refLabelContent,xDifferenceValue,yDifferenceValue,dataTableColumnName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetLabelContentByRefLabel"
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Get Label Content"
'PgdwnCntr=0
Set refObjGuiLabel = SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel("guicomponenttype:=30","content:="&refLabelContent)
If refLabelContent<> "" OR  xDifferenceValue<>""  OR yDifferenceValue<>"" Then
		'Do
			If refObjGuiLabel.Exist Then 
						 xRefLabelValue=refObjGuiLabel.GetROProperty("x")
						 yRefLabelValue =refObjGuiLabel.GetROProperty("y")
						 On Error Resume Next
						 xLabelValue= xRefLabelValue-CInt(xDifferenceValue)
						 yLabelValue= yRefLabelValue-CInt(yDifferenceValue)
						 GetLabelContentByRefLabel=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel("guicomponenttype:=30","x:="&xLabelValue,"y:="&yLabelValue).GetROProperty("content")
						 'msgbox err.number
						  If Err.Number=13 or Err.Number=-2147220990 Then
							    Call ReporterFunction(strLibraryFileName,"GetLabelContentByRefLabel","1","GuiLabel","Please check the xDifferenceValue and yDifferenceValue parameter of the GetLabelContentByRefLabel Function")
							    strStatus = "FAIL"
							    strMsg = "Passed Function Parameter is Not an Integer. Please check the xDifferenceValue and yDifferenceValue parameter of the GetLabelContentByRefLabel Function"
							    blnObjectError=True
						  ElseIf Err.Number=0 Then
								'GetLabelContentByRefLabel=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel("guicomponenttype:=30","x:="&xLabelValue,"y:="&yLabelValue).GetROProperty("content")
								strCapturedText=GetLabelContentByRefLabel
								strStatus = "DONE"
'                                If dataTableColumnName<>""  Then
'                                   call StoreExcel(GetLabelContentByRefLabel,dataTableColumnName)
'                                End If
                                strMsg = "Fetched label content: " & strCapturedText
                                If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   							ImagePath=CaptureScreenshot(strStepName,refObjGuiLabel,False,False,False)
	   							End if
								Call ReporterFunction(strLibraryFileName,"GetLabelContentByRefLabel","2","GuiLabel ","Retreived Label Content is " &GetLabelContentByRefLabel)
						 End If
						'Exit do
             Else
'             		Call SendKey("{PGDN}")
'					PgdwnCntr=PgdwnCntr+1
'			End IF
'		Loop while PgdwnCntr<=5
'			If  PgdwnCntr=5 Then
	               Call ReporterFunction(strLibraryFileName,"GetLabelContentByRefLabel","1","GuiLabel","Reference Gui Label is missing")
                   strStatus = "FAIL"
                   strMsg = " Reference Gui Label is not Found, Please verify the Screen"
                   blnObjectError=True
             End If

   Else
                   Call ReporterFunction(strLibraryFileName,"GetLabelContentByRefLabel","1","Label","Function Parameter Not Passed Properly. Check the --GetLabelContentByRefLabel-function")
                   strStatus="FAIL"
                   strMsg = "Function Parameter Not Passed Properly. Check the --GetLabelContentByRefLabel-- Function Call-"
   End If
   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetLabelContentByRefLabel = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,refObjGuiLabel,False,False,False)
	   Else
		    GetLabelContentByRefLabel = strMsg
	   End If
	  If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value of the label taking reference label '"&refLabelContent&"' and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value of the label taking reference label '"&refLabelContent&"'"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refLabelContent,strMsg,strStatus,"")
	   End If
Set objWindow=nothing
End If
End Function
'***********************************************************************************
' End Function GetLabelContentByRefLabel
'***********************************************************************************



''**********************************************************************************
'Name of the Function   :  SelectRowGuiGridByRefTwoCloumns
'Description		     : Selects a row in a SAP Gui Grid  which has it values matching with two refrence columns      
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'                                             gridIndex:
'				columnNameFirst :- Name Property of the column having unique value 
'				columnNameSecond
'				refValueFirst :- Value in the column  for the given columnName for the particular row to be selected  
'				refValueSecond										
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRowGuiGridByRefTwoCloumns(gridTitle,gridIndex,columnNameFirst,refValueFirst,columnNameSecond,refValueSecond)
'***********************************************************************************
Public Function SelectRowGuiGridByRefTwoColumns(gridTitle,gridIndex,columnNameFirst,refValueFirst,columnNameSecond,refValueSecond)
 If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGridByRefTwoCloumns"
   Dim objGridGuiComp80,objGridGuiComp201,objGrid

strStepName = "Select " & refValueFirst & " and  " & refValueSecond & " rows"
If columnNameFirst<> "" and columnNameSecond <> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					set strRowNoFirst=objGrid.FindAllRowsByCellContent(columnNameFirst,refValueFirst)
					set strRowNoSecond=objGrid.FindAllRowsByCellContent(columnNameSecond,refValueSecond)
            		If Err.Number=0 or strRowNoFirst <> "" or strRowNoSecond <> "" Then  'or strRowNoFirst <> "" or strRowNoSecond <> ""
						For each num1 in strRowNoFirst
							For each num2 in strRowNoSecond
								If num1=num2 Then
									objGrid.SelectRow num1
								End If
							Next
						Next
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          End if
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridByRefTwoColumns","2"," Row field","Row Selected:-"& vbNewLine &" Row No : "&num1)
						strStatus = "DONE"
						strMsg="The row in the grid is selected successfully"
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridByRefTwoColumns","1","Row field","The Column:  "&columnNameFirst &"or"& columnNameSecond& "Not Found Within The GuiGrid" )
						 strStatus = "FAIL"
						 strMsg = "The Column "&columnName& "or" &columnNameSecond& "Not Found Within The GuiGrid"
						 blnObjectError=True
					Else 
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridByRefTwoColumns","1","Row field","Value "&refValueFirst&" Not Found Within The Column :"&columnNameFirst& " of GuiGrid")
						 strStatus = "FAIL"
						strMsg ="Value "&refValueFirst&" Not Found Within The Column :"&columnNameFirst& " of GuiGrid"
						blnObjectError=True
					End If
		Else 
			Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridByRefTwoColumns","1","Row field","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			blnObjectError=True
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridByRefTwoColumns","1","Row field","Function Parameter Not Passed Properly. Check the --SelectRowGuiGridByRefTwoCloumns-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectRowGuiGridByRefTwoColumns-- Function Call"
End if				
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiGridByRefTwoColumns = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    SelectRowGuiGridByRefTwoColumns = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValueFirst&";"&refValueSecond,strMsg,strStatus,"")
	   End If
Set objGrid=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectRowGuiGridByRefTwoCloumns
'************************************************************************************

'

''**********************************************************************************
'Name of the Function   :  GetCellDataGuiGridPopupByRefTwoCloumns

'Description		     : Selects a row in a SAP Gui Grid  which has it values matching with two refrence columns      
'Input Parameters	     : gridTitle : Title property of the GuiGridPopup 
'                 gridIndex : 
'				columnNameFirst :- Name Property of the column having unique value 
'				columnNameSecond
'				refValueFirst :- Value in the column  for the given columnName for the particular row to be selected  
'				refValueSecond										
'Output Parameters        :Null
'***********************************************************************************
'Function GetCellDataGuiGridPopupByRefTwoCloumns(gridTitle,gridIndex,columnName,columnNameFirst,refValueFirst,columnNameSecond,refValueSecond,dataTableColumnName)
'***********************************************************************************
Public Function GetCellDataGuiGridPopupByRefTwoColumns(gridTitle,gridIndex,columnName,columnNameFirst,refValueFirst,columnNameSecond,refValueSecond,dataTableColumnName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetCellDataGuiGridPopupByRefTwoCloumns"
   Dim objGridGuiComp80,objGridGuiComp201,objGrid
Set objWindow= SetSAPwindowObj(True)
strStepName = "Select " & refValueFirst & " and  " & refValueSecond & " rows"
If columnNameFirst<> "" and columnNameSecond <> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					set strRowNoFirst=objGrid.FindAllRowsByCellContent(columnNameFirst,refValueFirst)
					set strRowNoSecond=objGrid.FindAllRowsByCellContent(columnNameSecond,refValueSecond)
            		If Err.Number=0 AND IsEmpty(strRowNoFirst)=False  AND IsEmpty(strRowNoSecond)=False Then 
            		   If strRowNoFirst.Count >0 AND strRowNoSecond.Count > 0 Then            		
						For each num1 in strRowNoFirst
							For each num2 in strRowNoSecond
								If num1=num2 Then
								On Error Resume Next
								strCapturedText=objGrid.GetCellData(num2,columnName)
								If Err.Number=0 Then
					               GetCellDataGuiGridPopupByRefTwoColumns=strCapturedText
					               strStatus = "DONE"
						           Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","2","Gui Grid","Grid Content Fetched Into Datatable")
						           If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  					  ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          			           End if
						           strMsg = "Grid Content fetched and stored in Datatable"
										
				                ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					               Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					               strStatus="FAIL"
					               strMsg =  "Column Not Found Within Gui Grid . Please Verify Screen"
					               Err.Clear			
								End If
								End If
				
				         Next
                        Next
                        Else 
							Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","1","Row field","Value "&refValueFirst&" Not Found Within The Column :"&columnNameFirst& " of GuiGrid")
							 strStatus = "FAIL"
							strMsg ="Any of the given reference values Not Found Within the grid"
							blnObjectError=True
					End If
			
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","1","Row field","The Column:  "&columnNameFirst &"or"& columnNameSecond& "Not Found Within The GuiGrid" )
						 strStatus = "FAIL"
						 strMsg = "The Column "&columnName& "or "&columnNameSecond& "Not Found Within The GuiGrid"
						 blnObjectError=True
					End If
		Else 
			Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","1","Row field","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			blnObjectError=True
		End If
Else
	Call ReporterFunction(strLibraryFileName,"GetCellDataGuiGridPopupByRefTwoColumns","1","Row field","Function Parameter Not Passed Properly. Check the --GetCellDataGuiGridPopupByRefTwoCloumns-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --GetCellDataGuiGridPopupByRefTwoCloumns-- Function Call"
End if				
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetCellDataGuiGridPopupByRefTwoColumns = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetCellDataGuiGridPopupByRefTwoColumns = strMsg
	   End If
	   
	   
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the cell of a grid by taking two columns as reference and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
	   Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the cell of a grid by taking two columns as reference"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValueFirst&";"&refValueSecond,strMsg,strStatus,strCapturedText)
	   End If
Set objGrid=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End if
End Function
'************************************************************************************
'End Function - GetCellDataGuiGridPopupByRefTwoCloumns
'************************************************************************************

'

'**********************************************************************************
'Name of the Function   : SelectCheckBoxTableByRefColumn
'Description		     : Check or Uncheck a checkbox in a table cell by using reference column and reference value to calculate the desired row number.    
'Input Parameters	     :  tableName - name property of the table  where data is to be set
'										columnName - Name of the column in which data has to be set
'										refColumnName - Name of the reference column which will be used for calculating row number
'										refCellValue - value within the reference column corrosponding to desired row
'										OnOffStatus - Desired status of checkbox .Pass ON(to Check) or OFF(to uncheck)
'Output Parameters        : Null
'***********************************************************************************
'Function SelectCheckBoxTableByRefColumn(tableName,columnName,refColumnName,refCellValue,OnOffStatus)
'***********************************************************************************
Public Function SelectCheckBoxTableByRefColumn(tableName,columnName,refColumnName,refCellValue,OnOffStatus)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckBoxTableByRefColumn"
   Dim objTable
	'OnOffStatus=UCase(InputValidation(OnOffStatus))
	strStepName = "Select CheckBox With In The Table Cell"
	If tableName<> "" and columnName<>""and refColumnName<>"" and (UCase(OnOffStatus)="ON"  or Ucase(OnOffStatus)="OFF" )Then
		If OnOffStatus="OFF" Then
			strStepName="Deselect CheckBox With In The Table Cell"
		End If
		'OnOffStatus=InputValidation(OnOffStatus)
		Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
		If objTable.Exist Then
			On Error Resume Next
			strRowNumber = objTable.FindRowByCellContent(refColumnName,refCellValue)
			'msgbox err.number
			If Err.Number = 0 Then
				Err.Clear
				On Error Resume Next
				objTable.SetCellData strRowNumber,columnName,OnOffStatus
				If Err.Number=0  Then
				    IF objTable.IsCellEditable(strRowNumber,columnName)=False Then
						Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","1","Table Data Field"," Table Cell Not Editable. Check the --SelectCheckBoxTableByRefColumn-- Function Call")
						strMsg = "Table Cell Not Editable. Check the --SelectCheckBoxTableByRefColumn-- Function Call"
						strStatus = "FAIL"
						blnObjectError=True
					Else	
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						   ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
					    End if
						Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","2","Table Data Field","Value Used :-" & vbNewLine &" Table Name:  '"& tableName&"'"&vbNewLine&"  Column Field:   '"& columnName & "'"&vbNewLine &"   Row Field:  '"&strRowNumber&"'"& vbNewLine &"    ValueField: '"&OnOffStatus&"'")
						 strStatus = "DONE"
						 strMsg="Checkbox from the table with column as reference is selected successfully"
					End If 					 
			    ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","1","Table Data Field","Column Not Found. Check the --columnName--Parameter of--SelectCheckBoxTableByRefColumn-- Function Call")
						strMsg = "Column Not Found. Check the --columnName--Parameter of --SelectCheckBoxTableByRefColumn-- Function Call"
						strStatus = "FAIL"
						blnObjectError=True
				ElseIF Err.Number = 13 Then
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
					strMsg = "refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of --SelectCheckBoxTableByRefColumn-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True	
			    End If
			ElseIf Err.Number=-2147220983 Then
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","1","Table Data Field","Column Not Found. Check the --columnName--Parameter of--SelectCheckBoxTableByRefColumn-- Function Call")
					strMsg = "refColumn Not Found. Check the --refColumnName--Parameter of --SelectCheckBoxTableByRefColumn-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True   
            				
			End If 
			
		Else
			Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","1","Table Data Field","Table Object Not Found .Please Verify The Screen")
			strMsg = "Table Not Found- Please Check the Screen"
			strStatus = "FAIL"
			blnObjectError=True
		End If
	Else
		Call ReporterFunction(strLibraryFileName,"SelectCheckBoxTableByRefColumn","1","Table Data Field","Paramaters Not Passed Properly.Check the--SelectCheckBoxTableByRefColumn--Function Call")
		strMsg = "Parameters Not Passed Properly.Check the--SelectCheckBoxTableByRefColumn--Function Call"
		strStatus = "FAIL"
	End If
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckBoxTableByRefColumn = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	   Else
		    SelectCheckBoxTableByRefColumn = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue&";"&OnOffStatus,strMsg,strStatus,"")
	   End If
	   ' //////////Word Document ///////////
				If blnCreateTrainingDoc Then
					Check=CheckStatus_Doc(strStatus)
					If Check=1 Then
						Call storeCoordinates(objTable)
						Call StoreSteps(strStepName)
					End If
				End If
 ' //////////Word Document ///////////
	Set objTable=Nothing
	End if
End Function 
'************************************************************************************
'End Function - SelectCheckBoxTableByRefColumn
'************************************************************************************  

'**********************************************************************************
'Name of the Function   : SelectCheckBoxGridByRefColumn
'Description		     : Check or Uncheck a checkbox in a grid cell by using reference column and reference value to calculate the desired row number.    
'Input Parameters	     :  gridName - name property of the grid  where data is to be set
'										columnName - Name of the column in which data has to be set
'										refColumnName - Name of the reference column which will be used for calculating row number
'										refCellValue - value within the reference column corrosponding to desired row
'										OnOffStatus - Desired status of checkbox .Pass ON(to Check) or OFF(to uncheck)
'Output Parameters        : Null
'***********************************************************************************
'Function SelectCheckBoxGridByRefColumn(gridName,columnName,refColumnName,refCellValue,OnOffStatus)
'***********************************************************************************
Public Function SelectCheckBoxGridByRefColumn(gridName,columnName,refColumnName,refCellValue,OnOffStatus)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckBoxGridByRefColumn"
   Dim objGrid
	'OnOffStatus=UCase(InputValidation(OnOffStatus))
	strStepName = "Select CheckBox With In The Grid Cell"
	If gridName<> "" and columnName<>""and refColumnName<>"" and (OnOffStatus="ON"  or OnOffStatus="OFF" )Then
		If OnOffStatus="OFF" Then
			strStepName="Deselect CheckBox With In The Grid Cell"
		End If
		'OnOffStatus=InputValidation(OnOffStatus)
    	Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
		Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
		Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
        If objGrid.Exist Then
			On Error Resume Next
			strRowNumber = objGrid.FindRowByCellContent(refColumnName,refCellValue)
			If Err.Number = 0 Then
				Err.Clear
				On Error Resume Next
				objGrid.SetCheckbox strRowNumber,columnName,OnOffStatus
				If Err.Number=0 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				   ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
			    End if
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","2","Grid Data Field","Value Used :-" & vbNewLine &" Grid Name:  '"& gridName&"'"&vbNewLine&"  Column Field:   '"& columnName & "'"&vbNewLine &"   Row Field:  '"&strRowNumber&"'"& vbNewLine &"    ValueField: '"&OnOffStatus&"'")
					 strStatus = "DONE"
					 strMsg="Checkbox in the grid by taking column as a reference is selected successfully"
				ElseIf Err.Number=-2147220983 Then
					Call ReporterFunction("1","Grid Data Field","Column Not Found. Check the --columnName--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
					strMsg = "Column Not Found. Check the --columnName--Parameter of --SelectCheckBoxGridByRefColumn-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
				ElseIF Err.Number = 13 Then
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
					strMsg = "refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of --SelectCheckBoxGridByRefColumn-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
				ElseIf objGrid.IsCellEditable(strRowNumber,columnName)=False Then
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field"," Grid Cell Not Editable. Check the --SelectCheckBoxGridByRefColumn-- Function Call")
					strMsg = "Grid Cell Not Editable. Check the --SelectCheckBoxGridByRefColumn-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
				End If
			ElseIf Err.Number=-2147220983 Then
				Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","refColumn Not Found. Check the --refColumnName--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
				strMsg = "refColumn Not Found. Check the --refColumnName--Parameter of --SelectCheckBoxGridByRefColumn-- Function Call"
				strStatus = "FAIL"
				blnObjectError=True
			End If
		Else
			Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","Grid Object Not Found .Please Verify The Screen")
			strMsg = "Grid Not Found- Please Check the Screen"
			strStatus = "FAIL"
			blnObjectError=True
		End If
	Else
		Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","Paramaters Not Passed Properly.Check the--SelectCheckBoxGridByRefColumn--Function Call")
		strMsg = "Paramaters Not Passed Properly.Check the--SelectCheckBoxGridByRefColumn--Function Call"
		strStatus = "FAIL"
	End If
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckBoxGridByRefColumn = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    SelectCheckBoxGridByRefColumn = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue&";"&OnOffStatus,strMsg,strStatus,"")
	   End If
	Set objGrid=Nothing
	End If
End Function 
'************************************************************************************
'End Function - SelectCheckBoxGridByRefColumn
'************************************************************************************ 


'**********************************************************************************
'Name of the Function   : ClearTextBox
'Description		     : Clears the content of text box   
'Input Parameters	     :  textboxName - name property of the text box  where data is to be cleared
' Output Parameters        : Null
'***********************************************************************************
'Function ClearTextBox(textboxName)
'***********************************************************************************
Public Function ClearTextBox(textboxName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClearTextBox"
 If textboxName <> "" Then
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=32","name:="&textboxName)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=31","name:="&textboxName)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If objTextbox.Exist  then
		 textBoxAttachedText = objTextbox.getROProperty("attachedtext")
		 If textBoxAttachedText= "" Then
            textBoxAttachedText = textboxName
		 End If
	      If VerifyObjectStatus(objTextbox) Then
			 strStepName = " Clear Textbox : " &textBoxAttachedText
             objTextbox.set ""
              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,True)
	          End if
             Call ReporterFunction(strLibraryFileName,"ClearTextBox","2","Text Box","Clear Textbox: "&textBoxAttachedText)
	         strStatus = "DONE"
	         strMsg="Textbox cleared successfully"
		else 
		     strStepName = " Clear Textbox : " &textBoxAttachedText
		     Call ReporterFunction(strLibraryFileName,"ClearTextBox","1","Text Box","TextBox : " &textboxName & "is not enabled for editing" )
             strStatus = "FAIL" 
	         strMsg = "TextBox : " &textBoxAttachedText & " is not enabled for editing"
			 blnObjectError=True
   End If
   else 
	   strStepName = " Clear Textbox : " &textboxName
       Call ReporterFunction(strLibraryFileName,"ClearTextBox","1","Text Box","Object Missing")
	   strStatus = "FAIL"
	   strMsg =  textBoxAttachedText & " Textbox is not found"
	   blnObjectError=True
End If
else
strStepName = " Clear Textbox : " &textboxName
Call ReporterFunction(strLibraryFileName,"ClearTextBox","1","Text Box","Function Parameter Not Passed Properly. Check the --ClearTextbox-- Function Call")
strStatus = "FAIL" 
strMsg = "Function Parameter Not Passed Properly. Check the --ClearTextbox-- Function Call"
End If
 ' //////////Word Document ///////////
				If blnCreateTrainingDoc= 1 Then
					Check=CheckStatus_Doc(strStatus)
					If Check=1 Then
						Call storeCoordinates(objTextbox)
						Call StoreSteps(strStepName)
					End If
				End If
				If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    ClearTextBox = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,True)
	   Else
		    ClearTextBox = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
End If
End function

'************************************************************************************
'End Function - ClearTextbox
'************************************************************************************

'**********************************************************************************
'Name of the Function   : LaunchTextboxEntries
'Description		     : Launches a new window displaying list of possible entries for a text box 
'Input Parameters	     :  textboxName - name property of the text box  for which possible entries are to be listed
' Output Parameters        : Null
'***********************************************************************************
'Function LaunchTextboxEntries(textboxName)
'***********************************************************************************
Public Function LaunchTextboxEntries(textboxName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LaunchTextboxEntries"
Dim objTextboxGuiComp32,objTextboxGuiComp31,objTextbox

strStepName=" Launch Possible Entries Window on TextField " &textboxName
If  textboxName<> "" Then
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=32","name:="&textboxName)
	Set objTextboxGuiComp31 = SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=31","name:="&textboxName)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuiComp31)
	If objTextbox.Exist Then
		  strAttachedText=objTextbox.GetROProperty("attachedtext")
	      	  If strAttachedText<>""  then
				strStepName=" Launch possible entries on the TextField " &strAttachedText    
				else      
				strStepName="  Launch possible entries on the TextField " &textboxName   			  
		  End If
		  
    	objTextbox.OpenPossibleEntries
    	 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	          End if
	          Call ReporterFunction(strLibraryFileName,"LaunchTextboxEntries","2","Text Box field","Possible Entries launched successfully")
			strStatus="DONE"
			strMsg = "Possible Entries launched successfully"
           		  
	Else
			Call ReporterFunction(strLibraryFileName,"LaunchTextboxEntries","1","Text Box field","Object Missing. Textbox Not Found")
			strStatus="FAIL"
			strMsg = "Object Missing. Textbox Not Found"
			blnObjectError=True
	End if
Else
		Call ReporterFunction(strLibraryFileName,"LaunchTextboxEntries","1","Text Box field","Function Pramaters Not Passed Properly. Check the --LaunchTextboxEntries-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameters Not Passed Properly. Check the --LaunchTextboxEntries-- Function Call"
			
End if				
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    LaunchTextboxEntries = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    LaunchTextboxEntries = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
Set objTextboxGuiComp32=Nothing
Set objTextbox=Nothing
Set objTextboxGuiComp31=Nothing
End If
End Function
'************************************************************************************
'End Function - LaunchTextboxEntries
'************************************************************************************

