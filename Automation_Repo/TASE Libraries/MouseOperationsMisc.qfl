'******************************************************************************************************
'Name of the Function   : GetTableCellData
'Description		     : Get Cell Content from the Table
'Input Parameters	     :  tableName :Name property of the Table as observed in object spy
'											rowNumber :Corresponding Row number of table whose cell  value is to be retrieved
'											columnName :Corresponding Column name of table whose cell  value is to be retrieved
'										refColumnName - Name of the reference column which will be used for calculating row number
'										refCellValue - value within the reference column corrosponding to desired row
'                                         dataTableColumnName :column name of the data sheet where output value will be stored
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window
'Output Parameters        : Value of the cell
'******************************************************************************************************
'Function GetTableCellData(tableName,columnName,rowNumber,refColumnName,refCellValue,dataTableColumnName,blnIsItPopup)
'******************************************************************************************************

Public Function GetTableCellData(tableName,columnName,rowNumber,refColumnName,refCellValue,dataTableColumnName,blnIsItPopup)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetTableCellData"
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName = "Get Cell Content from GUi table"
	If tableName <> ""  Then
	Set objTable= SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguitable(guiTable,"name:="&tableName)
	
	If  objTable.Exist Then
				On Error Resume Next
				
				If  rowNumber=""Then
					strRowNum=objTable.FindRowByCellContent(refColumnName,refCellValue)
				Else 
					strRowNum=rowNumber
				End If
				strCellVal=objTable.GetCellData(strRowNum,columnName)
				If Err.Number = 0 Then
				strCapturedText=strCellVal
					strStatus="DONE"
					
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				         ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	                    End if
						strMsg = "Table Cell Value: " & strCellVal & " Fetched and stored in Datatable"
						Call ReporterFunction(strLibraryFileName,"GetTableCellData","2","Gui Table","Table Cell Value: " & strCellVal & " Fetched and stored in Datatable")
				ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Table
					Call ReporterFunction(strLibraryFileName,"GetTableCellData","1","Gui Table","Column Not Found Within Gui Table. Please Verify The Screen")
					strStatus="FAIL"
					strMsg =  "Column Not Found Within Gui Table . Please Verify Screen"
					blnObjectError=True
					Err.Clear
				ElseIf not objTable.ValidRow(strRowNum)  Then
					Call ReporterFunction(strLibraryFileName,"GetTableCellData","1","Table Data Field"," Row Not Found. Check the --rowNumber--Parameter of --GetTableCellData-- Function Call")
					strMsg = "Row Not Found. Check the --rowNumber--Parameter of --GetTableCellData-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
					Err.Clear			
				End If
			Else
			Call ReporterFunction(strLibraryFileName,"GetTableCellData","1","Gui Table","Table Object Not Found. Check the --GetTableCellData-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Table Object Not Found. Check the --GetTableCellData-- Function Call"
				blnObjectError=True	
								
			End If
			else
				Call ReporterFunction(strLibraryFileName,"GetTableCellData","1","Gui Table","Function Parameter Not Passed Properly. Check the --SendKey()-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Function Parameter Not Passed Properly. Check the --GetTableCellData()-- Function Call"
			End If
		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetTableCellData = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTable,False,False,False)
	   Else
		    GetTableCellData = strMsg
	   End If
	   If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the cell of GUI table and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the cell of GUI table "
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
		
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue,strMsg,strStatus,"")
		End If
	Set objWindow=Nothing
	End If
End Function
'******************************************************************************************
'End Function - GetTableCellData
'******************************************************************************************


'******************************************************************************************************
'Name of the Function   : GetGridContent
'Description		     : Get Cell Content from the Grid
'Input Parameters	     :  gridTitle :Title property of the grid as observed in object spy
'											gridIndex :index of the grid
'											rowNumber :Corresponding Row number of grid whose cell  value is to be retrieved
'											columnName :Corresponding Column name of grid whose cell  value is to be retrieved
'												refColumn - Name of the reference column in the grid which will be used for getting the row number if row number is unknown
'												refCellValue - value within the reference column corrosponding to desired row if the row number is unknown
'                                         dataTableColumnName :column name of the data sheet where output value will be stored
'Output Parameters        : Value of the cell
'******************************************************************************************************
'Function GetGridContent(gridTitle,gridIndex,columnName,rowNumber,refColumn,refFieldVal,dataTableColumnName)
'******************************************************************************************************
Public Function GetGridContent(gridTitle,gridIndex,columnName,rowNumber,refColumn,refFieldVal,dataTableColumnName)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetGridContent"
	strStepName = "Get Grid Content"
	
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
		Set objGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
		If refColumn<>"" Then
			If objGrid.Exist  Then
                On Error Resume Next
					If  rowNumber="" Then
				        strRowNumber = objGrid.FindRowByCellContent(refColumn,refFieldVal)
			        Else 
				        strRowNumber=rowNumber
			        End If
			        strRowVal=objGrid.GetCellData(strRowNumber,columnName)
					
				If Err.Number = 0 Then
					'strRowVal=objGrid.GetCellData(strRowNumber,columnName)
					strCapturedText=strRowVal
					strStatus="DONE"
					'StoreExcel(strRowVal,dataTableColumnName)
					
					'If strStatus = "DONE" then
					If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          		End if
	          		Call ReporterFunction(strLibraryFileName,"GetGridContent","2","Gui Grid","Grid Content Fetched Into Datatable")
					strMsg = "Grid Content Fetched Into Datatable"
'					Else
'						blnObjectError=True
'						strMsg = "Grid Content Not Fetched Into Datatable"
'					End if
				ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"GetGridContent","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					strStatus="FAIL"
					strMsg =  "Column Not Found Within Gui Grid . Please Verify Screen"
					'blnObjectError=True
					Err.Clear			
				End If
			Else
				Call ReporterFunction(strLibraryFileName,"GetGridContent","1","Gui Grid","Grid Object Not Found. Check the --GetGridContent-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Grid Object Not Found. Check the --GetGridContent-- Function Call"
				blnObjectError=True						
			End If
			
			else
			Call ReporterFunction(strLibraryFileName,"GetGridContent","1","Gui Grid","Parameters Not Passed Properly.Check the--GetGridContent--Function Call")
				strStatus = "FAIL" 
				strMsg = "Parameters Not Passed Properly.Check the--GetGridContent--Function Call"
		End If	
			If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	        End If

	   If strStatus = "FAIL"  Then
		    GetGridContent = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetGridContent = strMsg
	   End If
	   If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the grid and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the grid"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refFieldVal,strMsg,strStatus,"")
	   End If
	End If
End Function
'************************************************************************************
'End Function - GetGridContent
'************************************************************************************   
'
