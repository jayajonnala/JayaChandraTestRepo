Public Function GetNumberOfRows(gridName,gridIndex,dataTableColumnName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetNumberOfRows"
strStepName= "Get Number Of Rows"
If  gridName <> "" then
		Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableNameOrGridTitle)
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGuiGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
		Set objGuiGridTable=setObj(objTable,objGuiGrid)


 If objGuiGridTable.Exist Then
                   NumOfRows = objGuiGridTable.getroproperty("rowcount")
	               'strStatus = StoreExcel(NumOfRows,dataTableColumnName)
	                strCapturedText=NumOfRows
				  strStatus = "DONE"
				  strStepInDoc="Get Number Of Rows: '"&NumOfRows&"'"
				  Call ReporterFunction(strLibraryFileName,"GetNumberOfRows","2","Find Row number","Grid/Table Row Number Fetched Into Datatable")
				  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		''ImagePath=CaptureScreenshot(strStepName,objGuiGridTable,False,False,False)
				  		ImagePath=CaptureScreenshot(strStepInDoc,objGuiGridTable,False,False,False)
	              End if
						strMsg = "Grid/Table Row Number Fetched Into Datasheet"	
					

	Else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"GetNumberOfRows","1","Find Row number","Table or Grid does not exist")
        strMsg= "Table or Grid does not exist"
     blnObjectError=True
	End If
	else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"GetNumberOfRows","1","Find Row number","Function Parameter Not Passed Properly. Check the --GetNumberOfRowsp-- Function Call")
        strMsg= "Function Parameter  Not Passed Properly. Check the --GetNumberOfRows-- Function Call"
        End If
        
        If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetNumberOfRows = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGuiGridTable,False,False,False)
	   Else
		    GetNumberOfRows = strMsg
	   End If
	If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve the desired row number from the GUI Grid/Table and store in '"&gstrOutputSheetName&"' sheet under column '"&dataTableColumnName&"'"
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve desired row number from the GUI Grid/Table"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
							End If 
							
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue,strMsg,strStatus,strCapturedText)
	   End If
	 ' ////////
Set objGuiGrid201= Nothing
Set objGuiGrid80=Nothing
Set objGuiGridTable=Nothing
Set objTable=Nothing
End if
End Function

Public Function ValidateNodeTextGuiTree(treeIndex,itemText)
If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ValdateNodeTextGuiTree"
       strStepName="Verify the item: "  & itemText &  " in Gui Tree"
If treeIndex <>"" or  itemText<>"" Then

 

Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
        'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
        Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
'First you need to get all values under this tree
        Set AllValues = TreeObj.GetAllNodeKeys
'Get count
        Count = AllValues.Count
        Found = 0
    For i = 0 to Count-1
        NodeText = TreeObj.GetNodeTextByKey(AllValues(i))
    if INSTR(1,NodeText,itemText,1) Then
'        If left(NodeText,2) = itemText Then
            Found = 1
            Exit For
        End if
    Next
    If Found=1 Then
        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  'ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
              End if
         Call ReporterFunction(strLibraryFileName,"ValidateNodeTextGuiTree","2"," Verify Item in GuiTree","Item Verified:- "&itemText)
                strStatus = "PASS"
        strMsg="Item in the tree is verified successfully"
    else
        Call ReporterFunction(strLibraryFileName,"ValidateNodeTextGuiTree","2","Item in GuiTree","Gui Tree Missing")
        strStatus = "DONE"
        'blnObjectError=True
        strMsg = " The entered item is not Found in the SAP GUI Tree, Please verify the Screen"

    End If
Else
        Call ReporterFunction(strLibraryFileName,"ValidateNodeTextGuiTree","2","Item in GuiTree","Gui Tree Missing")
        strStatus = "DONE"
       ' blnObjectError=True
        strMsg = " The SAP GUI Tree is not displayed on the screen. Please check the screen"

End  If
Else
        Call ReporterFunction(strLibraryFileName,"ValidateNodeTextGuiTree","2","Verifies the presence of an item in the tree ","Function Parameter Not Passed Properly. Check the --ActivateItemGuiTree-- Function Call")
        strStatus="DONE"
        strMsg = "Function Parameter Not Passed Properly. Check the --ValdateNodeTextGuiTree-- Function Call-"    
End If

 

Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If

 

       If strStatus = "DONE"  Then
            ValidateNodeTextGuiTree = strMsg
'            blnMainFailFlag = True
'            ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
       Else
            ValidateNodeTextGuiTree = True
       End If

       If blnDefault_eSwiftReporting Then  
           'Call UpdateResultHtml(strStepName,itemText,strMsg,strStatus,"")
       End If
End If
End Function

Public Function GetExcelColumnNumber(InputExcelFilePath,InputSheetName,columnName,rowNumber,dataTableColumnName)
Dim StrExcel,StrSheet,Numofrows,Numofcolumns,ColumnNumber
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetExcelColumnNumber"
	strStepName = "Get Excel Column Number"
	               Set StrExcel=createobject("excel.application")
			 StrExcel.Visible=False

			Set StrWorkBook = StrExcel.Workbooks.Open(InputExcelFilePath)
			Set StrSheet = StrExcel.Worksheets.Item(InputSheetName&" ")

				Numofrows = StrSheet.UsedRange.Rows.Count
				Numofcolumns = StrSheet.UsedRange.Columns.Count

				For ColumnNumber = 1 To Numofcolumns
				If StrSheet.cells(rowNumber,ColumnNumber).value = columnName Then
					ContractStatusColumnNumber = ColumnNumber
					strStatus = "DONE"
					Call ReporterFunction(strLibraryFileName,"GetExcelColumnNumber","2","Gui Grid","Excel Column number Fetched Into Datatable")
					strMsg = "Excel Column number of "&columnName&" Fetched Into Datatable"
				Exit for
		End If
	Next
	          
			If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	        End if

	   If strStatus = "FAIL"  Then
		    GetExcelColumnNumber = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetExcelColumnNumber = strMsg
	   End If
	   If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&ContractStatusColumnNumber&"' Column number value from the excel sheet of "&columnName&" and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,ContractStatusColumnNumber)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&ContractStatusColumnNumber&"' value from the grid"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,strMsg,True,False,False)
			End if
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,columnName,strMsg,strStatus,"")
	   End If
	End If
	
	StrExcel.Quit
Set StrSheet=Nothing
Set StrWorkBook=Nothing
Set StrExcel=Nothing

End Function
'*******************************************************************************************
Public Function GetRunTimeNumberOfRows(gridName,gridIndex)

If  gridName <> "" then
		Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&gridName)
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGuiGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
		Set objGuiGridTable=setObj(objTable,objGuiGrid)


 If objGuiGridTable.Exist Then
                   NumOfRows = objGuiGridTable.getroproperty("rowcount")
		    GetRunTimeNumberOfRows = NumOfRows
 End If
							
Set objGuiGrid201= Nothing
Set objGuiGrid80=Nothing
Set objGuiGridTable=Nothing
Set objTable=Nothing
End if
End Function



Function SAPSendKey(StrKeyVal)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SAPSendKey"
If StrKeyVal <> "" Then
   strStepName ="Select Send Key : " & StrKeyVal
else
   strStepName ="Select Send Key : " & StrKeyVal
End If
If StrKeyVal <> "" and StrKeyVal <> "" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
Set ObjSAPSendKey= SAPGuiSession(sessionObject).SAPGuiWindow(objWindow)
          If ObjSAPSendKey.Exist Then
          'blnObjectFound=True
						If VerifyObjectStatus(ObjSAPSendKey)=True Then
									If VerifyRadioButton(ObjSAPSendKey)=False Then
											  ObjSAPSendKey.SendKey(StrKeyVal)
											  Call ReporterFunction(strLibraryFileName,"SAPSendKey","2","SendKey","Value Used :-"& vbNewLine &"SendKey: " &StrKeyVal& "SendKey")
											   strStatus = "DONE"
											   strMsg="Radiobutton selected successfully"
									Else
											   Call ReporterFunction(strLibraryFileName,"SAPSendKey","2","SendKey","Send button is already selected")
											   strStatus = "DONE"
											   strMsg = "Send button is already selected"
											   
									End If
									If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  						ImagePath=CaptureScreenshot(strStepName,ObjSAPSendKey,False,False,True)
	          						End if
						Else
									blnObjectError=True
									Call ReporterFunction(strLibraryFileName,"SAPSendKey","1","SendKey","Send   with "& vbNewLine &"SendKey: " &StrKeyVal& "")
									strStatus = "FAIL"
									strMsg = " The SendKey Object is not enabled, Please verify the Screen"
									
						End If
	      else 
	      				blnObjectError=True
				        Call ReporterFunction(strLibraryFileName,"SAPSendKey","1","SendKey","SendKey Object Missing")
						strStatus="FAIL"
						strMsg = " The SendKey Object is not Found, Please verify the Screen"

		  End if
		  else
		  Call ReporterFunction(strLibraryFileName,"SAPSendKey","1","SendKey","Function Parameter Not Passed Properly. Check the --SAPSendKey-- Function Call-")
						strStatus="FAIL"
						strMsg = " Function Parameter Not Passed Properly. Check the --SAPSendKey-- Function Call-"
						End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SAPSendKey = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,ObjSAPSendKey,False,False,True)
	   Else
		    SAPSendKey = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(ObjSAPSendKey)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set ObjSAPSendKey=nothing
Set objWindow=Nothing
End If
End Function
