'**********************************************************************************
'Name of the Function   :   SelectRowGuiTable(tableName,columnName,cellVal)
'Description		     : Selects row in a SAP Gui Table  
'Input Parameters	     :  tableName - Name of the table
'                                             columnName - Name of the reference column having unique value in the SAP GuiTable.   
'                                             cellVal- Value in the column  for the given columnName for the particular row to be selected
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        :
'***********************************************************************************
'Function  SelectRowGuiTable(tableName,columnName,cellVal,blnIsItPopup)
'***********************************************************************************
Function SelectRowGuiTable(tableName,columnName,cellVal,blnIsItPopup)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiTable"
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName= "Select Row in a Gui Table"
	
If columnName <> "" and tableName <> "" Then
		Set objTable = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTable(guiTable,"name:="&tableName)
		If  objTable.Exist  Then
		    On error resume next
			intRowNo=objTable.FindRowByCellContent (columnName,cellVal)
			'msgbox Err.Number
			If Err.Number=0 Then
				objTable.SelectRow intRowNo
				If Err.Number=0 Then	
				    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				        ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
	                End if			
					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","2"," Select Row Gui Table ","Row Selected:-"& vbNewLine &" Row No : "&intRowNo)
					strStatus = "DONE"
					
					strMsg="Row in the table is selected successfully." 'tested
				'End If
'				ElseIf Err.Number = -2147220975 Then
'					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
'					strStatus = "FAIL"
'					strMsg ="The Row:  "&intRowNo& " is Not Accessible "
'                    blnObjectError=True
'				ElseIf Err.Number=-2147220983 Then
'				
'				
'				Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1","Select Row Gui Table in Popup","The Value in the Datatablecolumn" &cellVal& "was not found in the SAP GUI Table")
'			    strStatus = "FAIL"
'				strMsg = "The Value in the Datatablecolumn " &cellVal& " was not found in the SAP GUI Table " 	
            Else 
				   Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1","Select Row Gui Table","Value Not Found Within The Column :"&columnName& " of Gui Table")
				   strStatus = "FAIL"
				   strMsg ="Value Not Found Within The Column : " &columnName& " of Gui Table"  'tested
		     End If
		     ElseIf Err.Number=-2147220983 Then
		           Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1"," Select Row Gui Table","The Column:  "&columnName& " Not Found Within The GuiTable ")
				   strStatus = "FAIL"  
				   blnObjectError=True
				   strMsg = "The Column "&columnName& " Not Found Within The Gui Table"
		     	  'tested
			  ElseIf Err.Number = -2147024809 Then
					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
					strStatus = "FAIL"
					strMsg ="The Value " &cellVal& "in datatablecolumn is empty"
					
					ElseIf Err.Number = -2147220975 Then
					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
					strStatus = "FAIL"
					strMsg ="The Row:  "&intRowNo& " is Not Accessible "
                    blnObjectError=True
                 
		End If
		Else
			Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1","Select Row Gui Table","GuiTable Object Not Found,Please Verify The Screen")
		    strStatus = "FAIL"
		    blnObjectError=True
			strMsg = "GuiTable Object Not Found,Please Verify The Screen"  'tested
			
		End If
	Else   'tested
		Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1","Select Row Gui Table in Popup","Function Parameter Not Passed Properly. Check the --SelectRowGuiTable-- Function Call")
		strStatus = "FAIL"
		strMsg = "Function Parameters Not Passed Properly. Check the --SelectRowGuiTable-- Function Call"
	End if				
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiTable = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
	   Else
		    SelectRowGuiTable = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,cellVal,strMsg,strStatus,"")
	   End If
	 '' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objTable)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
	Set objTable=Nothing
	Set objWindow=Nothing
  End If
End Function
'************************************************************************************
'End Function -  SelectRowGuiTable
'************************************************************************************

'**********************************************************************************
'Name of the Function   : SelectCheckBoxByGuiLabel
'Description		     : Searchs object(checkbox) from a list(SAPGuiLabel) and checks or unchecks it.
'Input Parameters	     :  labelContent:Content property of the Gui Label
'                                             xDifferenceValue:the difference between the x co-ordinate property of GuiLabel and  x property of  Object(checkbox) to be checked.    
'                                             yDifferenceValue:the difference between the y co-ordinate property of GuiLabel and  y property of  Object(checkbox) to be checked. 
'											NOTE: Provide either the   xDifferenceValue  OR  yDifferenceValue  ( yDifferenceValue is used in 'PPOME' tcode.  )           
'Output Parameters        :Null
'***********************************************************************************
'Function SelectCheckBoxByGuiLabel(refLabelContent,xDifferenceValue,yDifferenceValue,OnOffStatus)
'************************************************************************************
Public Function SelectCheckBoxByGuiLabel(refLabelContent,xDifferenceValue,yDifferenceValue,OnOffStatus)  'not handled for popup
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckBoxByGuiLabel"
Dim objChkBox
strStepName = "Select CheckBox with reference to a Gui Label"

Set refObjGuiLabel = SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiLabel("guicomponenttype:=30", "content:="&refLabelContent)
If refLabelContent<> ""  Then
			If refObjGuiLabel.Exist Then 
				If  xDifferenceValue<>"" Then
            			 xRefLabelValue=refObjGuiLabel.GetROProperty("x")
						 yRefLabelValue =refObjGuiLabel.GetROProperty("y")
						 On Error Resume Next
						 xCheckBoxValue= xRefLabelValue-CInt(xDifferenceValue)
						 yCheckBoxValue = yRefLabelValue - 1
						 If CInt(xRefLabelValue)<0 Then
							xCheckBoxValue= xRefLabelValue+CInt(xDifferenceValue)
                    	 End If
				Else if yDifferenceValue<>"" then
						 xRefLabelValue=refObjGuiLabel.GetROProperty("x")
						 yRefLabelValue =refObjGuiLabel.GetROProperty("y")
						 On Error Resume Next
						 yCheckboxValue=yRefLabelValue-CInt(yDifferenceValue)
						 xCheckBoxValue=xRefLabelValue
				End If
				End if
				'msgbox err.number
						  If Err.Number=13 Then
									   Call ReporterFunction(strLibraryFileName,"SelectCheckBoxByGuiLabel","1","Select Checkbox","Please check the xDifferenceValue parameter of the SelectCheckBoxByGuiLabel Function")
									   strStatus = "FAIL"
									   strMsg = "Passed Function Parameter xDifferenceValue is Not an Integer. Please check the xDifferenceValue parameter of the SelectCheckBoxByGuiLabel Function"
						  ElseIf Err.Number=0 Then
						            Set objChkBox=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiCheckBox("guicomponenttype:=42", "x:="&xCheckBoxValue,"y:="&yCheckBoxValue)
								    objChkBox.Set OnOffStatus
								    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  						ImagePath=CaptureScreenshot(strStepName,refObjGuiLabel,False,False,True)
	          						End if
								    Call ReporterFunction(strLibraryFileName,"SelectCheckBoxByGuiLabel","2","Select Checkbox","Checkbox is selected")
								    strStatus = "DONE"
								    strMsg="Checkbox selected successfully"
						  End If
            else
			      Call ReporterFunction(strLibraryFileName,"SelectCheckBoxByGuiLabel","1","labelContent","Object Missing")
				  strStatus = "FAIL"
			      strMsg = " The Object is not Found, Please verify the Screen"
				  blnObjectError=True       
           end if
else 
          Call ReporterFunction(strLibraryFileName,"SelectCheckBoxByGuiLabel","1","  Select Checkbox","Function Parameter Not Passed Properly. Check the --SelectCheckBoxByGuiLabel-- Function Call-")
	      strStatus = "FAIL"
          strMsg = "Function Parameter Not Passed Properly. Check the --SelectCheckBoxByGuiLabel-- Function Call-"       
end if        
 	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckBoxByGuiLabel = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,refObjGuiLabel,False,False,True)
	   Else
		    SelectCheckBoxByGuiLabel = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refLabelContent&";"&OnOffStatus,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objChkBox)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGuiLabel=Nothing
Set objChkBox=Nothing
End If
End Function
'******************************************************************************************
'End Function - SelectCheckBoxByGuiLabel
'******************************************************************************************




'**********************************************************************************
'Name of the Function   : GetGridContentByRefColumn		     :
'Description		     : Get Cell Content from the Grid
'Input Parameters	     :  ReferenceRow
'											ColumnName
'											TableName	
'Output Parameters        :RowValue for the Grid
'***********************************************************************************
'Function GetGridContentByRefColumn(gridTitle,refColumn,refFieldVal,columnName,dataTableColumnName)
'***********************************************************************************

Public Function GetGridContentByRefColumn(gridTitle,gridIndex,refColumn,refFieldVal,columnName,dataTableColumnName)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetGridContentByRefColumn"
	strStepName = "Get Grid Content"
	If refColumn <>  "" and columnName <> ""  Then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
		Set objGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGrid.Exist  Then
				On Error Resume Next
				strRowNum=objGrid.FindRowByCellContent(refColumn,refFieldVal)
				GetGridContentByRefColumn=objGrid.GetCellData(strRowNum,columnName)
				If Err.Number = 0 Then
					'GetGridContentByRefColumn=objGrid.GetCellData(strRowNum,columnName)
					strStatus="DONE"
					strCapturedText=GetGridContentByRefColumn
					'If strStatus = "DONE" then
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          			End if
						strMsg = "Grid Content Fetched Into Datatable"
'					Else
'						blnObjectError=True
'						strMsg = "Grid Content Not Fetched Into Datatable"
'					End if
				ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					strStatus="FAIL"
					strMsg =  "Column Not Found Within Gui Grid . Please Verify Screen"
					blnObjectError=True
					Err.Clear
				Else
					Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Invalid Parameter Passed .Check--refFieldVal--Parameter Of --GetGridContentByRefColumn--Function Call")
					strStatus = "FAIL" 
					strMsg = "Invalid Parameter Passed .Check--refFieldVal--Parameter Of --GetGridContentByRefColumn--Function Call"
					
					Err.Clear			
				End If
			Else
				Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Grid Object Not Found. Check the --GetGridContentByRefColumn-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Grid Object Not Found. Check the --GetGridContentByRefColumn-- Function Call"
				blnObjectError=True				
			End If
	Else
		Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Function Parameter Not Passed Properly. Check the --GetGridContentByRefColumn-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --GetGridContentByRefColumn-- Function Call"
	End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetGridContentByRefColumn = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetGridContentByRefColumn = strMsg
	   End If
	  If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&refColumn&"' as reference column and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&refColumn&"' as reference column"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refFieldVal,strMsg,strStatus,"")
	   End If
	   
	End If

End Function
'******************************************************************************************
'End Function - GetGridContentByRefColumn
'******************************************************************************************




''**********************************************************************************
'Name of the Function   : SelectMenuItemToolBar
'Description		     : Selects a menuitem  on the SAP ToolBar       
'Input Parameters	     :  menuItem,toolbarIndex
'Output Parameters        : Null
'Example:   Call SelectMenuItemToolBar("Financing","1")
'***********************************************************************************
 'Function SelectMenuItemToolBar(menuItem,toolbarIndex)
'***********************************************************************************

Public Function SelectMenuItemToolBar(menuItem,toolbarIndex)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectMenuItemToolBar"
strStepName = "Select Menu Item " & menuItem & "   in Toolbar"
 If menuItem <> "" Then
Set objMenuToolbar = SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiToolbar("guicomponenttype:=202","name:=shel.*","index:="&toolbarIndex)
			 If  objMenuToolbar.Exist  Then
			 On error resume next
			 
						objMenuToolbar.SelectMenuItem menuItem
						If err.number=0 Then
							If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objMenuToolbar,True,False,True)
	          			    End if
						Call ReporterFunction(strLibraryFileName,"SelectMenuItemToolBar","2","Select MenuItem in a Toolbar","Menu Item "&menuItem&" Selected ")
						strStatus = "DONE"
						strMsg="Menubar item selected successfully"
						else
						Call ReporterFunction(strLibraryFileName,"SelectMenuItemToolBar","1","Select MenuItem in a Toolbar",strMsg)
						strStatus = "FAIL"
			    		strMsg = err.description
						blnObjectError=True
				End If	
			 else 
				Call ReporterFunction(strLibraryFileName,"SelectMenuItemToolBar","1","Select MenuItem in a Toolbar","Object Missing")
				strStatus = "FAIL"
			    strMsg = " The Object is not Found, Please verify the Screen"
				blnObjectError=True
		     End If
 else 
		Call ReporterFunction(strLibraryFileName,"SelectMenuItemToolBar","1"," Select MenuItem in a Toolbar","Menu  "&menuItem&"  Not Selected  ")
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --SelectMenuItemToolBar-- Function Call-"						
 End If
				If  blnObjectError  Then
		    		Environment.Value("blnFatalError")=True
	   			End If

	   If strStatus = "FAIL"  Then
		    SelectMenuItemToolBar = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objMenuToolbar,True,False,True)
	   Else
		    SelectMenuItemToolBar = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,menuItem,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'			If blnCreateTrainingDoc Then
'				Check=CheckStatus_Doc(strStatus)
'				If Check=1 Then
'				    imageDocPath=CaptureSAPObject_Doc(objSAPwindow)
'					Call StoreSteps(strStepName)
'					Call storeCoordinates(objMenuToolbar)
'					call drawShapeImage(imageDocPath)
'                    Call InsertImage(imageDocPath)
'					Call InsertStepsDoc()
'					oDicSteps.RemoveAll
'				End If
'			End If
' //////////Word Document ///////////
		 Set objMenuToolbar=nothing				
End If
End Function
'************************************************************************************
'End Function - SelectMenuItemToolBar
'************************************************************************************


'**********************************************************************************
'Name of the Function   :  SetFocusGuiLabel
'Description		     : Focus on a content of GuiLabel using either the Labelcontent or the x & y coordinates
'Input Parameters	     : labelContent : Content property of GUI Label as observed in Object Spy
'											xCord,yCord: x and y co-ordinates of GuiLabel
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        :Null
'***********************************************************************************
'Function SetFocusGuiLabel(labelContent,xCord,yCord,blnIsItPopup)
'**********************************************************************************
Public Function SetFocusGuiLabel(labelContent,xCord,yCord,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetFocusGuiLabel"
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName = "Set Focus On GuiLabel " &labelContent
	If labelContent <> "" Then
	'msgbox 1
	   Set objGuiLabel = SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel( "guicomponenttype:=30", "content:="&labelContent)
	   blnobjectFound= true
	Elseif  xCord<>"" or yCord<> "" Then
	       If  SAPGuisession(sessionObject).sapguiwindow(objWindow).Exist Then 
	           Set objGuiLabel = SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel( "guicomponenttype:=30", "x:="&xCord, "y:="&yCord)
	           
	           labelContent =objGuiLabel.GetROProperty("content")
	           blnobjectFound= true
	       End If
	Else 
		Call ReporterFunction(strLibraryFileName,"SetFocusGuiLabel","1","Set Focus GuiLabel","Function Parameter Not Passed Properly. Check the --SetFocusGuiLabel-- Function Call")
		strStatus="FAIL"
		strMsg =  "Function Parameter Not Passed Properly. Check the --SetFocusGuiLabel-- Function Call"
   	End If
   	If blnobjectFound=true Then
	If objGuiLabel.Exist   Then
			objGuiLabel.SetFocus
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objGuiLabel,False,False,True)
	      	End if
			Call ReporterFunction(strLibraryFileName,"SetFocusGuiLabel","2"," SetFocusGuiLabel", "'"&labelContent & "' is focussed")
			strStatus="DONE"
			strMsg="Label focused successfully"
	else 
			Call ReporterFunction(strLibraryFileName,"SetFocusGuiLabel","1","Gui Label :'"&labelContent&"'","Label Object Not Found.Please Verify The Screen.")
			strStatus="FAIL"
			strMsg = "Label Object Not Found.Please Verify The Screen."
			blnObjectError=True
	End If
   
   End If
  	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SetFocusGuiLabel = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGuiLabel,False,False,True)
	   Else
		    SetFocusGuiLabel = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,labelContent,strMsg,strStatus,"")
	   End If
			' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objGuiLabel)
'						Call StoreSteps(strStepName)
'					End If
'				End If
		
' //////////Word Document ///////////
Set objWindow=Nothing
End If
End Function
'************************************************************************************
'End SetFocusGuiLabel
'************************************************************************************


'******************************************************************************************************
'Name of the Function   : ActivateItemGuiTree
'Description		     : Activates Item in Gui Tree
'Input Parameters	     :  treeIndex - Index of the tree in which the item is present
'											 itemPath - Path to the item which is to be activated
'											itemText - Text of the SAP item which is to be activated
'Output Parameters        : 
'******************************************************************************************************
'Function ActivateItemGuiTree(treeIndex,itemPath,itemText)
'******************************************************************************************************
Public Function ActivateItemGuiTree(treeIndex,itemPath,itemText)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ActivateItemGuiTree"
	   strStepName="Activate the item: "  & itemText &  " in Gui Tree"
If treeIndex <>"" or itemPath<>"" or itemText<>"" Then

Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
objTree.ActivateItem itemPath,itemText
			  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	                 End if
Call ReporterFunction(strLibraryFileName,"ActivateItemGuiTree","2"," Activate Item in GuiTree","Item Activated:- "&itemText)
strStatus = "DONE"
strMsg="Item in the tree activated successfully"
else
		Call ReporterFunction(strLibraryFileName,"ActivateItemGuiTree","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		blnObjectError=True
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		
End If
Else
		Call ReporterFunction(strLibraryFileName,"ActivateItemGuiTree","1","Activate Item Gui Tree ","Function Parameter Not Passed Properly. Check the --ActivateItemGuiTree-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ActivateItemGuiTree-- Function Call-"	
End If
Set  objTree =nothing
Set normalObj=nothing
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    ActivateItemGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    ActivateItemGuiTree = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath&";"&itemText,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
 End If
End Function
'*****************************************************************************************************
'End Function - ActivateItemGuiTree
'*****************************************************************************************************************


'******************************************************************************************************
'Name of the Function   : SelectItemGuiTree
'Description		     : Selects Item in Gui Tree
'Input Parameters	     :   treeIndex - Index of the tree in which the item is present
'											 itemPath - Path to the item which is to be selected
'											itemText - Text of the SAP item which is to be selected
'Output Parameters        : 
'******************************************************************************************************
'Function SelectItemGuiTree(treeIndex,itemPath,itemText)
'******************************************************************************************************
Public Function SelectItemGuiTree(treeIndex,itemPath,itemText)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectItemGuiTree"
strStepName = "Select item: " & "'" &  itemText & "'" & " in GuiTree"
If treeIndex <>"" or itemPath<>"" or itemText<>""Then
Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
On Error Resume Next
objTree.SelectItem itemPath,itemText
If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
Call ReporterFunction(strLibraryFileName,"SelectItemGuiTree","2"," Select Item in GuiTree","Item Selected:- "&itemText)
strStatus = "DONE"
strMsg="Item selected successfully"
else
		Call ReporterFunction(strLibraryFileName,"SelectItemGuiTree","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		blnObjectError=True
End If
Else
		Call ReporterFunction(strLibraryFileName,"SelectItemGuiTree","1","Activate Item Gui Tree ","Function Parameter Not Passed Properly. Check the --SelectItemGuiTree-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --SelectItemGuiTree-- Function Call-"	
End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectItemGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    SelectItemGuiTree = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath&";"&itemText,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set  objTree =nothing
Set normalObj=nothing
End If
End Function

'*****************************************************************************************************
'End Function - SelectItemGuiTree
