'**********************************************************************************
'Name of the Function   : PressEnter
'Description		     : Presses the enter key

'Input Parameters	     : Null
'Output Parameters        :Null
'***********************************************************************************
'Function PressEnter()
'**********************************************************************************
Public Function PressEnter()
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : PressEnter"
       ' //////////Word Document ///////////
'	   
      ' //////////Word Document ///////////
       strStepName = "Press Enter "
       val= "Enter key"
	   set objPopupWindow=sapguisession("guicomponenttype:=12").sapguiwindow("guicomponenttype:=22")
	   set objNormalWindow=sapguisession("guicomponenttype:=12").sapguiwindow("guicomponenttype:=21")
	   set objPress=SetObj(objPopupWindow,objNormalWindow)
       If objPress.Exist Then
		   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objPress,True,False,False)
	          End if
			objPress.SendKey ENTER
		   Call ReporterFunction(strLibraryFileName,"PressEnter","2"," Press Enter Key","Enter Key Pressed ")
              strStatus = "DONE"
              strMsg= "Enter key Pressed"

       else 
		  blnObjectError=True
       	  Call ReporterFunction(strLibraryFileName,"PressEnter","1","Press Enter Key","Object Missing")
		  strStatus = "FAIL"
		  strMsg = " The desired window to press enter is not displayed, Please verify the Screen"
       End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    PressEnter = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objPress,True,False,False)
	   Else
		    PressEnter = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
	 ' //////////Word Document ///////////
'	   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'			Check=CheckStatus_Doc(strStatus)
'			If Check=1 Then
'					Call StoreSteps(strStepName)
'					call drawShapeImage(ImagePath)
'					Call InsertImage(ImagePath)
'					Call InsertStepsDoc()
'					oDicSteps.RemoveAll
'			End If
'		End If
	 ' //////////Word Document ///////////
	'Call ValidateStatusBarMsg()
	'Call VerifyErrorInfoPopup()
End If
End Function
'**********************************************************************************
'End Function - PressEnter
'***********************************************************************************



'**********************************************************************************
'Name of the Function   :  SelectMenuBar
'Description		     : clicks on  menu bar and  selects a particular  tab
'Input Parameters	     : pathName
'Output Parameters        :Null
'***********************************************************************************
'Function SelectMenuBar(pathName)
'**********************************************************************************

Public Function SelectMenuBar(pathName)
     If Not (Environment.Value("blnFatalError")) Then
	 If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectMenuBar"
     strStepName = "Click Menu bar and Choose "&  pathName  
     If pathName <> "" Then
Set obj = sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiMenubar(guiMenuBar)
  If  obj.Exist   Then
	  
        On Error Resume Next
		  obj.Select pathName
		  	If Err.Number = 0 Then
		  	   Call ReporterFunction(strLibraryFileName,"SelectMenuBar","2","Menu Bar",pathName & " clicked")
               strStatus = "DONE"
               strMsg=" Menubar clicked"
               If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
	  		   End if
			ElseIf Err.Number = -2147417851 Then
              Call ReporterFunction(strLibraryFileName,"SelectMenuBar","1","Menu Bar","Given Path in the MenuBar is not enabled for editing")
					strStatus="FAIL"
					strMsg = " Given Path in the MenuBar is not enabled for editing"	
			  	
            ElseIf Err.Number = -2147220983 Then    
		      Call ReporterFunction(strLibraryFileName,"SelectMenuBar","1","Menu Bar","Item is not included in the all items list of Menu Bar")
		      strStatus="FAIL"
			  strMsg = " Item is not included in the all items list of Menu Bar"	
            End If 
	Else 
	 Call ReporterFunction(strLibraryFileName,"SelectMenuBar","1","Menu Bar","MenuBar Object Missing")
      strMsg =  " MenuBar Object not found, Please check the Screen and the Menu"
      strStatus = "FAIL"
      blnObjectError=True 
	        End If
	    
  Else
   Call ReporterFunction(strLibraryFileName,"SelectMenuBar","2","Menu Bar","Function Parameter Not Passed Properly. Check the --SelectMenuBar-- Function Call")
              strStatus = "FAIL"
		      strMsg = "Function Parameter Not Passed Properly. Check the --SelectMenuBar-- Function Call"  
End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectMenuBar = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,obj,True,False,True)
	   Else
		    SelectMenuBar = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,pathName,strMsg,strStatus,"")
	   End If
	 ' //////////Word Document ///////////
'	   If blnCaptureFlag  or  blnCreateImageEachStep Then
'			Check=CheckStatus_Doc(strStatus)
'			If Check=1 Then
'					Call StoreSteps(strStepName)
'					call drawShapeImage(ImagePath)
'					Call InsertImage(ImagePath)
'					Call InsertStepsDoc()
'					oDicSteps.RemoveAll
'			End If
'		End If
'		 ' //////////Word Document ///////////
'		If blnCreateTrainingDoc Then
'			Check=CheckStatus_Doc(strStatus)
'			If Check=1 Then
'					Call StoreSteps(strStepName)
'					Call storeCoordinates(obj)
'					call drawShapeImage(ImagePath)
'					Call InsertImage(ImagePath)
'					Call InsertStepsDoc()
'					oDicSteps.RemoveAll
'			End If
'		End If
	 ' //////////Word Document ///////////
End If
End Function

'************************************************************************************
'End Function -  SelectMenuBar
'************************************************************************************



''**********************************************************************************
'Name of the Function   :  SelectRowGuiGrid
'Description		     : Selects a row in a SAP Gui Grid        
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'				columnName :- Name Property of the column having unique value 
'				refValue :- Value in the column  for the given columnName for the particular row to be selected    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRowGuiGrid(gridTitle,columnName,refValue)
'***********************************************************************************
Public Function SelectRowGuiGrid(gridTitle,gridIndex,columnName,refValue,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGrid"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

'----------------------- Sandbox execution added nest 3 lines---------------------------------------
''If Environment.Value("SAPSYSTEM")= "RGB - SAP RETAIL Sandbox GLOBAL" and refValue= "/ZMDIV_MIRO"then 
''	refValue="ZMDIV_MIRO"
''End If 


'----------------------------------------------------------------

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select Row in GuiGrid" 
If columnName<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					strRowNumber=objGrid.FindRowByCellContent(columnName,refValue)
            		If Err.Number=0 and strRowNumber <> "" Then
						objGrid.SelectRow strRowNumber
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			End if
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","2","SelectRowGuiGrid","Row Selected:-"& vbNewLine &" Row No : "&strRowNumber)
						strMsg="Row number [" & strRowNumber & "] selected in GuiGrid."
						strStatus = "DONE"
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","1","SelectRowGuiGrid","The Column:  "&columnName& " Not Found Within The GuiGrid")
						 strStatus = "FAIL"
						 strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
						 blnObjectError=True
					Else 
						blnObjectError=True
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","1","SelectRowGuiGrid","Value "&refValue&" Not Found Within The Column :"&columnName& " of GuiGrid")
						strStatus = "FAIL"
						strMsg ="Value ["&refValue& "] Not Found Within The Column [" & columnName & "] of GuiGrid"
						
					End If
		Else 
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","1","SelectRowGuiGrid","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","1","SelectRowGuiGrid","Function Parameter Not Passed Properly. Check the --SelectRowGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectRowGuiGrid-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiGrid = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectRowGuiGrid = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objGrid)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectRowGuiGrid
'************************************************************************************


''**********************************************************************************
'Name of the Function   :  GetStatusBar
'Description		     : Obtains the output value generated in Status bar
'			        dataTableColumnName :-  column name of the data sheet where output value will be stored
'			        itemNo :- property of status bar that holds output value
'			        
'Input Parameters	     :  itemNo,dataTableColumnName
'Output Parameters        :StatusBar Content
'***********************************************************************************
'Function GetStatusBar(itemNo,dataTableColumnName)
'***********************************************************************************
Public Function GetStatusBar(itemNo,dataTableColumnName)

If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetStatusBar"
Dim strOuputValue
Set objStatusBar = SAPGuiSession(sessionObject).SAPGuiStatusBar(guiStatusBar)
strOuputValue=Right(dataTableColumnName,(len(dataTableColumnName)-3)) ' omitting the ID_ from the dataTableColumnName so as to mention in the step
strStepName= "Retrieve the '"&strOuputValue&"' value generated in status bar message and store in '"& dataTableColumnName& "'"


		If objStatusBar.Exist Then
				If itemNo<>"" Then				
				GetStatusBar=objStatusBar.GetROProperty(itemNo)
				strMsg = "Value retrieved from the status bar successfully"
				strCapturedText=GetStatusBar
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	          End if
				Call ReporterFunction(strLibraryFileName,"GetStatusBar","2","Status Bar","Item Value:="&itemNo)
				strStatus = "DONE"
				strStepName = "Retrieve '"&GetStatusBar&"' value generated in status bar message and store in '"&dataTableColumnName&"'"
				else
				Call ReporterFunction(strLibraryFileName,"GetStatusBar","1","Status Bar","Function Parameter Not Passed Properly. Check the --guicomponent type number for window and item property of status bar")
				strStatus="FAIL"
				strMsg ="Function Parameter to retrieve the output value is Not Passed Properly. Check the --GetStatusBar-- Function Call-"
				end if
		else
		Call ReporterFunction(strLibraryFileName,"GetStatusBar","1","Status Bar","Object Missing")
		strStatus = "FAIL"
		strMsg = " The status bar Object is not Found, Please verify the Screen"
		blnObjectError=True
		end if
		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	    End If

	    If strStatus = "FAIL"  Then
		    GetStatusBar = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	    Else
		    GetStatusBar = strMsg
	    End If
	    
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	    
End If
End Function

'************************************************************************************
'End Function - GetStatusBar
'************************************************************************************


'''**********************************************************************************
'Name of the Function   :  GetTextboxValue
'Description		     : Obtains the runtime value generated in TextBox
'			                          textboxName :- name of the textbox 
 '                                    textboxIndex : textbox Index
 '                                   dataTableColumnName : column name in the data sheet where the textbox value will be stored		
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window        
'Input Parameters	     :  textboxName,daTatableColumnName
'Output Parameters        :textboxValue
'***********************************************************************************
'Function GetTextboxValue(textboxName,textboxIndex,dataTableColumnName,blnIsItPopup)
'***********************************************************************************

Public Function GetTextboxValue(textboxName,textboxIndex,dataTableColumnName,blnIsItPopup)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetTextboxValue"
   Dim objTextbox32,objTextbox31,objTextbox,objWindow
   Set objWindow= SetSAPwindowObj(blnIsItPopup)
   strStepName="Get value from the textbox: " & "["& textboxName & "]"
   If textboxName<>"" Then
       Set objTextbox32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"index:="&textboxIndex)
       Set objTextbox31  = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"index:="&textboxIndex)
       Set objTextbox = SetObj(objTextbox32,objTextbox31)
             If objTextbox.Exist Then
                 GetTextboxValue=objTextbox.GetROProperty("value")
                 strCapturedText=GetTextboxValue
	              strStatus = "DONE"
				  	  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	          			End if
					  Call ReporterFunction(strLibraryFileName,"GetTextboxValue","2","Text box","Values Used :-"& vbNewLine &" Text Value : "&GetTextboxValue)
					  strMsg="Text box value captured"
             Else
	               Call ReporterFunction(strLibraryFileName,"GetTextboxValue","1","Text box","Text box Object Missing")
                   strStatus = "FAIL"
                   strMsg = " The Text box Object is not Found, Please verify the Screen"
                   blnObjectError=True
             End If
   Else
                   Call ReporterFunction(strLibraryFileName,"GetTextboxValue","1","Text box","Function Parameter Not Passed Properly. Check the --GetTextboxValue-function")
                   strStatus="FAIL"
                   strMsg = "Function Parameter Not Passed Properly. Check the --GetTextboxValue-- Function Call-"
   End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetTextboxValue = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    GetTextboxValue = strMsg
	   End If
	   
	    
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from textbox and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"								
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from textbox"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	  
              
               Set objTextbox32 =Nothing
               Set objTextbox31=Nothing
               Set objTextbox = Nothing
			   Set objWindow=Nothing
   End If
  End Function
'************************************************************************************
'End Function - GetTextboxValue
'************************************************************************************

''************************************************************************************
'Name of the Function   :  SelectTab
'Description		     : 	Selects a particular Tab in SAPgui
'			        					tabStripName : - Name of the Tab Strip as seen in object repository after recording 
'			        					tabName :- Name of the tab to be selected
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window    
'Input Parameters	     :  tabStripName,tabName
'Output Parameters        :Null
'***********************************************************************************
' Function SelectTab(tabStripName,tabName,blnIsItPopup)
'***********************************************************************************
Public Function SelectTab(tabStripName,tabName,blnIsItPopup)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectTab"
	Dim objTabStrip,objWindow
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName = "Select Tab: " & tabName 
	If tabStripName <> "" and tabName <> "" Then
     	Set objTabStrip1 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTabStrip(guiTab,"name:="&tabStripName)
		Set objTabStrip2 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTabStrip("name:="&tabStripName) 'to identify child tabstrips
		Set objTabStrip = SetObj(objTabStrip1,objTabStrip2)
		If  objTabStrip.Exist   Then
			strAllItems = objTabStrip.GetROProperty("allitems")
			strAllItems = ";"&strAllItems
			strTabNameAppended =";"&tabName&";" 
			If instr(1,strAllItems,strTabNameAppended,1) Then
				objTabStrip.Select tabName
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTabStrip,False,False,True)
	          End if
				Call ReporterFunction(strLibraryFileName,"SelectTab","2","Tab Field","Tab Selected :-"& vbNewLine &" Tab Name : "&tabName)
				strStatus="DONE"
				strMsg="Tab selected succesfully"
			Else
				Call ReporterFunction(strLibraryFileName,"SelectTab","1","Tab Field","Tab Not Found Within The Tab Strip . Please Verify --SelectTab-- Function Call")
				strStatus = "FAIL"
				strMsg = " Tab Not Found Within The Tab Strip. Please Verify --SelectTab-- Function Call"
				'blnObjectError=True	
			End If
		Else 
			Call ReporterFunction(strLibraryFileName,"SelectTab","1","Tab Field","Tab Strip Not Found. Please Verify --SelectTab-- Function Call")
			 strStatus = "FAIL"
			 strMsg = " Tab Strip Not Found. Please Verify --SelectTab-- Function Call"
			 blnObjectError=True
		End If
	Else 
		Call ReporterFunction(strLibraryFileName,"SelectTab","1","Tab Field","Function Parameter Not Passed Properly. Check the --SelectTab-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --SelectTab-- Function Call"
	End If	
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectTab = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTabStrip,False,False,True)
	   Else
		    SelectTab = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
	Set objTabStrip = nothing
 '//////////Word Document ///////////
'			If blnCreateTrainingDoc Then
'				Check=CheckStatus_Doc(strStatus)
'				If Check=1 Then
'					imageDocPath=CaptureSAPObject_Doc(objSAPwindow)
'					Call StoreSteps(strStepName)
'					Call storeCoordinates(objTabStrip)
'					call drawShapeImage(imageDocPath)
'                    Call InsertImage(imageDocPath)
'					Call InsertStepsDoc()
'					oDicSteps.RemoveAll
'				End If
'			End If
			
' //////////Word Document ///////////
Set objTabStrip=Nothing
Set objWindow=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectTab
'************************************************************************************


'**********************************************************************************
'Name of the Function   :  FocusTextBox
'Description		     : To Set Focus on a  Text Box        	        
'Input Parameters	     :  textboxName :- name of text box to be focussed
'			       						   attachedText :- attachedtext property of the textbox/text attached with the textbox
 '										   blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window    
'Output Parameters        :Null
'***********************************************************************************
'Function FocusTextBox(attachedText,textboxName,blnIsItPopup)
'***********************************************************************************
Public Function FocusTextBox(attachedText,textboxName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : FocusTextBox"
Dim objTextboxGuiComp32,objTextboxGuiComp31,objTextbox,objWindow
strStepName=" Set Focus on the TextField " &textboxName
If attachedText<>"" and textboxName<>"" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","attachedtext:="&attachedText,"name:="&textboxName)
	Set objTextboxGuiComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","attachedtext:="&attachedText,"name:="&textboxName)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuiComp31)
	
	If objTextbox.Exist Then
				
	      	  If attachedText<>""  then
				strStepName=" Set Focus on the TextField " &attachedText    
				else      
				strStepName=" Set Focus on the TextField " &textboxName   			  
		      End If
    				objTextbox.SetFocus
    				strStatus = "DONE"
    				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	          		End if
           		  strMsg=" Textbox Focused successfully"
           		  Call ReporterFunction(strLibraryFileName,"FocusTextBox","2","Text Box field","Textbox Focused successfully")
           		  
           		  
	Else
			Call ReporterFunction(strLibraryFileName,"FocusTextBox","1","Text Box field","Object Missing. Textbox Not Found")
			strStatus="FAIL"
			strMsg = "Object Missing. Textbox Not Found"
			blnObjectError=True
	End if	
else	
Call ReporterFunction(strLibraryFileName,"FocusTextBox","1","Text Box field","Function Parameter Not Passed Properly. Check the --FocusTextBox-- Function Call")
			strStatus="FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the --FocusTextBox-- Function Call"
		End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    FocusTextBox = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    FocusTextBox = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
Set objTextboxGuiComp32=Nothing
Set objTextbox=Nothing
Set objTextboxGuiComp31=Nothing
Set objWindow=Nothing
End If
End Function
'************************************************************************************
'End Function - FocusTextBox
'************************************************************************************

'**********************************************************************************
'Name of the Function   :  SelectCheckbox
'Description		     : Selects Check Box
'			                           checkboxName :- name property of the checkbox to be selected	   
 '			                     checkBoxIndex :- ordinal identifier(index) of the textbox    
'                                     OnOffStatus - On or Off Status of  the checkbox to be selected	 
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Input Parameters	     : checkboxName,OnOffStatus
'Example :          Call SelectCheckbox("HRVPV6A-KATGX","ON")
'Output Parameters        :Null
'***********************************************************************************
'Function SelectCheckbox(checkboxName,checkBoxIndex,OnOffStatus,blnIsItPopup
'***********************************************************************************
Public Function SelectCheckbox(checkboxName,checkBoxIndex,OnOffStatus,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckbox"
Set objWindow= SetSAPwindowObj(blnIsItPopup)
Set objChkBox=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiCheckBox("guicomponenttype:=42","name:="&checkboxName,"index:="&checkBoxIndex)
strStepName= "Set  CheckBox: " & checkboxName & " " &  OnOffStatus
If checkboxName <> "" and checkBoxIndex <> "" and OnOffStatus<> "" Then

If objChkBox.Exist  then
		 CheckBoxAttachedText = objChkBox.getROProperty("attachedtext")
		 If CheckBoxAttachedText= "" Then
            CheckBoxAttachedText = textboxName
		 End If
End  If


	 If objChkBox.Exist Then
	 blnObjectFound=True
     If VerifyObjectStatus(objChkBox) Then
	      If  objChkBox.GetROProperty("selected")="False" and OnOffStatus="ON" Then
             objChkBox.set "ON"
            
			 Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is selected")
            strStatus="DONE"
            strMsg= "Checkbox is selected successfully"
	     ElseIf objChkBox.GetROProperty("selected")="True" and OnOffStatus="ON" Then
	          Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is already selected")
              strStatus="DONE"
              strMsg= "Checkbox is already selected"
	     ElseIf  objChkBox.GetROProperty("selected")="True" and OnOffStatus="OFF" Then
             objChkBox.set "OFF"
             
			 Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is unchecked")
             strStatus="DONE"
             strMsg= "Checkbox is unchecked successfully"
        Else
	          Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is already  unchecked")
              strStatus="DONE"
              strMsg= "Checkbox is already unchecked"
	   End If 
	          If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objChkBox,False,False,True)
	          End if	   
        else 
        	blnObjectError=True
		   Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Check Box is disabled. It cannot be clicked")
		   strStatus="FAIL"
		   strMsg ="Check Box is disabled ."
		End If
      else 
      blnObjectError=True
	    Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Check Box Object Missing")
	   strStatus="FAIL"
	   strMsg = " The Check Box Object is not Found, Please verify the Screen"
       
  End If
  else
  Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call")
	   strStatus="FAIL"
	   strMsg = " Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call"

  End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckbox = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objChkBox,False,False,True)
	   Else
		    SelectCheckbox = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strstatus,"")
	   End If
   ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objChkBox)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////

Set objWindow=Nothing
Set objSAPwindow=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectCheckbox
'************************************************************************************


'*********************************************************************
'Name of the Function   :  SelectCellGuiTable
'Description		     : Clicks on a particular cell of the table 
'			                           tableName :-  name property of the table as seen in object spy
'			                           columnName :- Column name of table where value is to be entered
'                                      refColumnName :- The reference column name with respect to which the row number is derived.
'                                      refColumnVal - The value in the reference column w.r.t which we find the value in the original column name.
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window
' Example :                 Call SelectCellGuiTable("SAPMV45ATCTRL_U_ERF_AUFTRAG","Material","Description","BULK Goods")
'Input Parameters	     :  tableName,columnName,columnNameRef,tableVal
'Output Parameters        :Null
'***********************************************************************************
'Function SelectCellGuiTable(tableName,columnName,columnNameRef,tableVal)
'***********************************************************************************

Public Function SelectCellGuiTable(tableName,columnName,refColumnName,refColumnVal,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellGuiTable"
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select cell in a GuiTable "
Set objTable = SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiTable(guiTable,"name:="  &tableName)
If  objTable.Exist   Then
    If columnName <> "" and refColumnName <> "" and tableName <> "" Then
       On Error Resume Next
       Dim strRowNumber
       strRowNumber= objTable.FindRowByCellContent (refColumnName,refColumnVal)
       objTable.SelectCell strRowNumber,columnName
		If Err.Number = 0 then   
		   strStatus = "DONE"
		   strMsg="Table cell selected successfully"	
		   If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
	       End if		   
           Call ReporterFunction(strLibraryFileName,"SelectCellGuiTable","2"," Name","Cell Selected :-"& vbNewLine &" Field : "&tableVal& vbNewLine &"ColumnName : "&columnName& vbNewLine &"Reference Column Name : " &columnNameRef)
        elseIf Err.Number = -2147220983 Then																																																																							
		   Call ReporterFunction(strLibraryFileName,"SelectCellGuiTable","1","Select Cell Gui Table","Columns Not Found .Please Check the --columnName--Parameter of --SelectCellGuiTable-- Function Call")
		   strStatus="FAIL"
		   strMsg = " Column Not Found.Please Check the --columnName--Parameter of --SelectCellGuiTable-- Function Call"
		    blnObjectError=True	    
	    End If
   Else 
		Call ReporterFunction(strLibraryFileName,"SelectCellGuiTable","1","Cell not Selected","Function Parameter Not Passed Properly. Check the --SelectCellGuiTable-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellGuiTable-- Function Call-"
   End If  
Else 
 blnObjectError=True
		Call ReporterFunction(strLibraryFileName,"SelectCellGuiTable","1","Cell Name","Table Cell  Object Missing")
		strStatus="FAIL"
		strMsg = " The Cell Object is not Found, Please verify the Screen"
		
End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCellGuiTable = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
	   Else
		    SelectCellGuiTable = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refColumnVal,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'If blnCreateTrainingDoc Then
'		Check=CheckStatus_Doc(strStatus)
'		If Check=1 Then
'				Call storeTableorGridCoordinates(objTable)
'				Call StoreSteps(strStepName)
'		End If
'End if
 ' //////////Word Document ///////////
Set objTable = nothing
Set objWindow=Nothing
End If
End Function

'************************************************************************************
'End Function - Function SelectCellGuiTable
'************************************************************************************


'*****************************************************************************************
'Name of the Function   : SelectRadioButton
'Description		     : Selects Radio Button on a normal window with guicomponent=21
'Input Parameters	     :  radiobuttonName:Name property of the radio button
'                                            :radiobuttonAttachedtext:AttachedText property of the radio button
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRadioButton(radiobuttonName,radiobuttonAttachedtext,blnIsItPopup)
'************************************************************************************
Function SelectRadioButton(radiobuttonName,radiobuttonAttachedtext,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRadioButton"
If radiobuttonAttachedtext <> "" Then
   strStepName ="Select Radio Button: " & radiobuttonAttachedtext
else
   strStepName ="Select Radio Button: " & radiobuttonName
End If
If radiobuttonAttachedtext <> "" and radiobuttonAttachedtext <> "" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
Set objRadioButton= SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiRadioButton("guicomponenttype:=41","name:="&radiobuttonName,"attachedtext:="&radiobuttonAttachedtext)
          If objRadioButton.Exist Then
          'blnObjectFound=True
						If VerifyObjectStatus(objRadioButton)=True Then
									If VerifyRadioButton(objRadioButton)=False Then
											  objRadioButton.Set
											  Call ReporterFunction(strLibraryFileName,"SelectRadioButton","2","RadioButton","Value Used :-"& vbNewLine &"RadioButtonName: " &radiobuttonName& "RadioButton AttachedText:"&radiobuttonAttachedtext)
											   strStatus = "DONE"
											   strMsg="Radiobutton selected successfully"
									Else
											   Call ReporterFunction(strLibraryFileName,"SelectRadioButton","2","RadioButton","Radio button is already selected")
											   strStatus = "DONE"
											   strMsg = "Radio button is already selected"
											   
									End If
									If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  						ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	          						End if
						Else
									blnObjectError=True
									Call ReporterFunction(strLibraryFileName,"SelectRadioButton","1","RadioButton","Radio Button  with "& vbNewLine &"RadioButtonName: " &radiobuttonName& "and RadioButton AttachedText: "&radiobuttonAttachedtext&" is not enabled.So cannot be set.")
									strStatus = "FAIL"
									strMsg = " The RadioButton Object is not enabled, Please verify the Screen"
									
						End If
	      else 
	      				blnObjectError=True
				        Call ReporterFunction(strLibraryFileName,"SelectRadioButton","1","RadioButton","RadioButton Object Missing")
						strStatus="FAIL"
						strMsg = " The RadioButton Object is not Found, Please verify the Screen"

		  End if
		  else
		  Call ReporterFunction(strLibraryFileName,"SelectRadioButton","1","RadioButton","Function Parameter Not Passed Properly. Check the --SelectRadioButton-- Function Call-")
						strStatus="FAIL"
						strMsg = " Function Parameter Not Passed Properly. Check the --SelectRadioButton-- Function Call-"
						End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRadioButton = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	   Else
		    SelectRadioButton = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objRadioButton)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objRadioButton=nothing
Set objWindow=Nothing
End If
End Function
'*****************************************************************************************
'EndFunction - SelectRadioButton
'******************************************************************************************


