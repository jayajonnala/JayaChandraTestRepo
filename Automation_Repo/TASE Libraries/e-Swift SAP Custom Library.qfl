''**********************************************************************************
'Name of the Function   :  GetAllitemStatusBar
'Description		     : Obtains the output value generated in Status bar using text property
'			        dataTableColumnName :-  column name of the data sheet where output value will be stored
'			      
'			        
'Input Parameters	     :  dataTableColumnName
'Output Parameters        :StatusBar Content
'***********************************************************************************
'Function GetTextStatusBar(dataTableColumnName)
'***********************************************************************************
Public Function GetTextStatusBar(dataTableColumnName)

If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetTextStatusBar"
Dim strOuputValue
Set objStatusBar = SAPGuiSession(sessionObject).SAPGuiStatusBar(guiStatusBar)
strOuputValue="text" 
strStepName= "Retrieve the '"&strOuputValue&"' value generated in status bar message and store in '"& dataTableColumnName& "'"


		If objStatusBar.Exist Then
				If dataTableColumnName<>"" Then				
				GetTextStatusBar=objStatusBar.GetROProperty("text")
				strMsg = "Value retrieved from the status bar successfully"
				strCapturedText=GetTextStatusBar
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	          End if
				Call ReporterFunction(strLibraryFileName,"GetTextStatusBar","2","Status Bar","Item Value:="&itemNo)
				strStatus = "DONE"
				strStepName = "Retrieve '"&GetTextStatusBar&"' value generated in status bar message and store in '"&dataTableColumnName&"'"
				else
				Call ReporterFunction(strLibraryFileName,"GetTextStatusBar","1","Status Bar","Function Parameter Not Passed Properly. Check the --guicomponent type number for window and item property of status bar")
				strStatus="FAIL"
				strMsg ="Function Parameter to retrieve the output value is Not Passed Properly. Check the --GetTextStatusBar-- Function Call-"
				end if
		else
		Call ReporterFunction(strLibraryFileName,"GetTextStatusBar","1","Status Bar","Object Missing")
		strStatus = "FAIL"
		strMsg = " The status bar Object is not Found, Please verify the Screen"
		blnObjectError=True
		end if
		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	    End If

	    If strStatus = "FAIL"  Then
		    GetTextStatusBar = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	    Else
		    GetTextStatusBar = strMsg
	    End If
	  
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	    
End If
End Function

'************************************************************************************
'End Function - GetTextStatusBar
'************************************************************************************

'**********************************************************************************
'Name of the Function   :  VerifyPopUpWindowValue
'Author		     :  
'Description		     : Verifies Text in a  SAP pop up window 
'                                     expectedValue:- Value to be verified   
'Input Parameters	     :  expectedValue
'Output Parameters        :

'***********************************************************************************
'Function VerifyWindowValue(expectedValue)
'***********************************************************************************
Public Function VerifyPopUpWindowValue(expectedValue)

 If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyPopUpWindowValue"
	strStepName = " Verify " & "'" & expectedValue & "'" & " in SAP Window"
	
  Set objSApwindow = SAPGuisession(sessionObject).sapguiwindow(windowObject1)
   If objSApwindow.Exist then
		     	 
             
	         strWindowText =objSApwindow.GetROProperty("text")
               If UCASE(expectedValue)=UCASE(strWindowText) Then
							 Call ReporterFunction(strLibraryFileName,"VerifyPopUpWindowValue","2","Window","Expected Value :-"&expectedValue&"   Matched With Contents of SAP window")
							  strStatus = "PASS"
							  strMsg = "Actual Value of the Window: "&strTextAreaText&" matches with the Expected Value: "&expectedValue&""
							  blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
		            	  End If
							   
					 Else
						     Call ReporterFunction(strLibraryFileName,"VerifyPopUpWindowValue","1","Window","Expected Value :-"&expectedValue &"   did not Match  With Contents of SAP window" )
						      strMsg="Actual Value of the SAP Window: "&strWindowText&" does not match with the Expected Value: "&expectedValue& "	"
						      strStatus = "FAIL"
						      
					End If
			Else 
			   Call ReporterFunction(strLibraryFileName,"VerifyPopUpWindowValue","1","Window","SAP Window Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Window Object Missing"
			   blnObjectError=True
			End If

If strStatus = "FAIL"  Then
		VerifyPopUpWindowValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
	Else
		VerifyPopUpWindowValue = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
			
			
			
 Set objSApwindow=Nothing
 
End If
End function
'************************************************************************************
'End Function - VerifyWindowValue
'***************************************************************************************


'**********************************************************************************
'Name of the Function   :  ClickLabel_NolabelContent
'Author		     :  
'Description		     : Click a label jhaving no content
'                                     
'Input Parameters	     :  labelIndex,blnIsItPopup
'Output Parameters        :

'***********************************************************************************
'Function ClickLabel_NolabelContent(labelIndex,blnIsItPopup)
Function ClickLabel_NolabelContent(labelIndex,blnIsItPopup)

If Not Environment.Value("blnFatalError") Then
            If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickLabel_NolabelContent"
            strFuncName = "ClickLabel_NolabelContent"
            Val = "<b>Label  Content :</b>"
            strStepName = "Click Label : " & "'"
                
            Dim objLabel,objWindow
            Set objWindow= SetSAPwindowObj(blnIsItPopup)
                      
                                        
                                        Set objLabel=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiLabel ("guicomponenttype:=30","content:=","index:="&labelIndex)
                                            If objLabel.Exist then
                                                    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                                                        ImagePath=CaptureScreenshot(strStepName,objLabel,False,True,True)
                                                    End If
                                                                objLabel.SetFocus
                                                                SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SendKey F2
                                                                'objLabel.SendKey F2
                                                                strStatus = "DONE"
                                                                strMsg = "Label : with  index:" &labelIndex&" Label clicked  successfully"
                                                                Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)
                                                                
                                                
                        Else
                                strStatus = "FAIL"
                                strMsg = "Function Parameter Not Passed Properly. Check the --ClickLabel_NolabelContent-- Function Call--"
                                Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
                        End If
                                             
                                            If  blnObjectError  Then
                                                Environment.Value("blnFatalError")=True
                                            End If
                
                                            If strStatus = "FAIL"  Then
                                                ClickLabel_NolabelContent = strMsg
                                                blnMainFailFlag = True
                                                ImagePath=CaptureScreenshot(strStepName,objLabel,False,True,True)
                                            Else
                                                ClickLabel_NolabelContent = True
                                            End If
                
                                            If blnDefault_eSwiftReporting Then  
                                                    Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")
                                            End If
                                            Set objLabel=Nothing
                                            Set objWindow=Nothing
                                
End If
                
   
End function

Function CreateTxtFile(file_path, file_name, input_text)
	Dim fso,new_file
	Set fso = CreateObject("Scripting.FileSystemObject")
	
	'Create file object
	Set new_file=fso.CreateTextFile(file_path &"\"&file_name,true)
	 
	'Check if object is created
	If Not new_file is Nothing Then
		new_file.writeline(input_text)
		new_file.close
		''ReportLog "INFO", "Create&WriteTOFile", "File created at " &file_path &" having the name: " &file_name 
		Call ReporterFunction("XML Edit","Create&WriteTOFile","2",file_name,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "DONE"
   strMsg = "Updated successfully"
  Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	Else
		Call ReporterFunction("XML Edit","Create&WriteTOFile","2",file_name,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "FAILED"
   strMsg = "Not Updated"
   Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	End If

End Function

Function CreateCSVFile(file_path, file_name, row_text)
    Dim fso, new_file, strStatus, strMsg
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Create / Overwrite file
    Set new_file = fso.CreateTextFile(file_path & "\" & file_name, True)
    
    ' Check if file object was created successfully
    If Not new_file Is Nothing Then
        new_file.WriteLine row_text
        new_file.Close
        
        ' Optional logging/reporting
        Call ReporterFunction("CSV Creator", "CreateCSVFile", "2", file_name, _
             "Value Used :-" & vbNewLine & "Row Text:" & row_text)
             
        strStatus = "DONE"
        strMsg = "CSV created successfully"
        Call UpdateResultHtml(file_name, row_text, strMsg, strStatus, "")
    Else
        ' Reporting failure
        Call ReporterFunction("CSV Creator", "CreateCSVFile", "2", file_name, _
             "Value Used :-" & vbNewLine & "Row Text:" & row_text)
             
        strStatus = "FAILED"
        strMsg = "CSV not created"
        Call UpdateResultHtml(file_name, row_text, strMsg, strStatus, "")
    End If
End Function 


Function AppendTxtFile(file_path, file_name, input_text)
	Dim fso,new_file
	Set fso = CreateObject("Scripting.FileSystemObject")
	
	'Create file object
	Set new_file=fso.OpenTextFile(file_path &"\"&file_name,8,true)
	 
	'Check if object is created
	If Not new_file is Nothing Then
		new_file.writeline(input_text)
		new_file.close
		
		Call ReporterFunction("AppendTOFile","AppendTOFile","2",file_name,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "DONE"
   strMsg = "Updated successfully"
   Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	Else
		Call ReporterFunction("AppendTOFile","AppendTOFile","2",file_name,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "FAILED"
   strMsg = "Not Updated"
   Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	End If

End Function


'**********************************************************************************
'Name of the Function   :TransferData
'Created by : Kumar
'Description		     : Automatic transfer of data sheet from one file to another file
'Input Parameters	     :  TargetFilePath,sheetName,TargetField,SrcFieldValue,TargetRow
'Output Parameters        : Null
'***********************************************************************************
 'Function TransferData()
'***********************************************************************************

Public Function TransferData(SrcFilePath,SrcsheetName,SrcField,TargetFilePath,TargetsheetName,TargetField,excelRow)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: WriteCapturedValue" 
	Dim oConn, oRS, arrData, x,SrcFieldValue
    CONST adLockOptimistic = 3
    CONST adOpenKeySet     = 1
    CONST adCmdTableDirect = 512

	
	
	Set oConn = CreateObject("ADODB.Connection")
	Set objRecSet= CreateObject("ADODB.RecordSet")
	strStepName = " Set "  & "'" & SrcField & "'" & " in Target File Field : " & "'"& TargetField & "'"                   
	'Open Connection - Source Field
	oConn.Open "Provider=Microsoft.ACE.OLEDB.12.0;" &_
			    "Data Source=" & SrcFilePath & ";" & _
				"Extended Properties=""Excel 8.0; HDR=YES;"";"
	
	 objRecSet.Open SrcsheetName &"$", oConn,adOpenKeySet,adLockOptimistic,adCmdTableDirect
	
	 For x = 2 to excelRow - 1
				objRecSet.MoveNext
	 Next

	For x = 0 to objRecSet.Fields.Count - 1
	
				DataItemName = trim(objRecSet(x).Name)
				If  DataItemName = SrcField Then
						SrcFieldValue = objRecSet(x).Value
				End If
	Next
	set oConn = Nothing
	set objRecSet = Nothing
	
	'Ópen Conection  - Target Field
				oConn.Open "Provider=Microsoft.ACE.OLEDB.12.0;" &_
			    "Data Source=" & TargetFilePath & ";" & _
				"Extended Properties=""Excel 8.0; HDR=YES;"";"
	
	 objRecSet.Open TargetsheetName &"$", oConn,adOpenKeySet,adLockOptimistic,adCmdTableDirect
	
	 For x = 2 to excelRow - 1
				objRecSet.MoveNext
	 Next

	For x = 0 to objRecSet.Fields.Count - 1
	
				DataItemName = trim(objRecSet(x).Name)
				If  DataItemName = TargetField Then
						objRecSet(x).Value = SrcFieldValue
				End If
	Next
	
   objRecSet.Update	' updating the Excel Database

   Call ReporterFunction(strLibraryFileName,"TransferData","2",strStepName,"Value Used :-"& vbNewLine & "SourceField:"&SrcFieldValue & vbNewLine & "TargetColumn: " &TargetField)		
   strStatus = "DONE"
   strMsg = "Data Transferred successfully"
   Call UpdateResultHtml(strStepName,SrcFieldValue,strMsg,strStatus,"")
	set oConn = Nothing
	set objRecSet = Nothing

	
End Function

Public Function TransferDataExcel (SourceFilePath,SourceTableRow,SrcField,TargetFilePath,TargetsheetName,TargetField,TargetexcelRow)
On error resume next
'Call GetInputFromExcel(SourceFilePath,"Global",SourceTableRow)


Set InputAppExcel = CreateObject("Excel.Application")
Set objInputWorkBook = InputAppExcel.Workbooks.Open(SourceFilePath) ' objInputWorkBook variable contains/opens the excel workbook for the input file
Set objInputSheet = InputAppExcel.Sheets(TargetsheetName)
Do
iRunTimeDataRowCounter = iRunTimeDataRowCounter +1
Loop Until (objInputSheet.cells(1,iRunTimeDataRowCounter).value = "") or (objInputSheet.cells(1,iRunTimeDataRowCounter).value = SrcField)
If iRunTimeDataRowCounter<> 0 Then
'msgbox iRunTimeDataRowCounter
iRunTimeDataRowCounter = iRunTimeDataRowCounter -1
End If
''objInputSheet.cells(1,iRunTimeDataRowCounter+1).value = strVariableName
SrcField=objInputSheet.cells(SourceTableRow,iRunTimeDataRowCounter+1).value
''msgbox SrcField
objInputWorkBook.Save
objInputWorkBook.Close
InputAppExcel.Quit
Set InputAppExcel = Nothing
Set objInputWorkBook =Nothing
Set objInputSheet =Nothing

'================================================
Dim strFileName,strFolderPathToCreate,iRunTimeDataRowCounter
Execute SrcField & " = strVariableValue"
' If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Writing RunTime Scenario Data in Local File"
iRunTimeDataRowCounter = 0
Set InputAppExcel = CreateObject("Excel.Application")
Set objInputWorkBook = InputAppExcel.Workbooks.Open(TargetFilePath) ' objInputWorkBook variable contains/opens the excel workbook for the input file
Set objInputSheet = InputAppExcel.Sheets(TargetsheetName)
Do
iRunTimeDataRowCounter = iRunTimeDataRowCounter +1
Loop Until (objInputSheet.cells(1,iRunTimeDataRowCounter).value = "") or (objInputSheet.cells(1,iRunTimeDataRowCounter).value = TargetField)
If iRunTimeDataRowCounter<> 0 Then
''msgbox iRunTimeDataRowCounter
''msgbox TargetField
iRunTimeDataRowCounter = iRunTimeDataRowCounter -1
End If
''objInputSheet.cells(1,iRunTimeDataRowCounter+1).value = strVariableName
objInputSheet.cells(TargetexcelRow,iRunTimeDataRowCounter+1).value = SrcField
objInputWorkBook.Save
objInputWorkBook.Close
InputAppExcel.Quit
Set InputAppExcel = Nothing
Set objInputWorkBook =Nothing
Set objInputSheet =Nothing
Call ReporterFunction("","TransferData","2","","Value Used :-"& vbNewLine & "SourceField:"&SrcField & vbNewLine & "TargetColumn: " &TargetField)		
'strStatus = "DONE"
strStatus = "Pass"
strMsg = "Data Transferred successfully"
Call UpdateResultHtml("Data Transfer Function",SrcField,strMsg,strStatus,TargetField)
	
End Function


