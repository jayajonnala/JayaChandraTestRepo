'**********************************************************************************
'Name of the Function   :  VerifyWindowValue
'Author		     :  
'Description		     : Verifies Text in a  SAP window
'                                     expectedValue:- Value to be verified   
'Input Parameters	     :  expectedValue
'Output Parameters        :

'***********************************************************************************
'Function VerifyWindowValue(expectedValue)
'***********************************************************************************
Public Function VerifyWindowValue(expectedValue)

 If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyWindowValue"
	strStepName = " Verify " & "'" & expectedValue & "'" & " in SAP Window"
	
  Set objSApwindow = SAPGuisession(sessionObject).sapguiwindow(windowObject)
   If objSApwindow.Exist then
		     	 
             
	         strWindowText =objSApwindow.GetROProperty("text")
               If UCASE(expectedValue)=UCASE(strWindowText) Then
							 Call ReporterFunction(strLibraryFileName,"VerifyWindowValue","2","Window","Expected Value :-"&expectedValue&"   Matched With Contents of SAP window")
							  strStatus = "PASS"
							  strMsg = "Actual Value of the Window: "&strTextAreaText&" matches with the Expected Value: "&expectedValue&""
							  blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
		            	  End If
							   
					 Else
						     Call ReporterFunction(strLibraryFileName,"VerifyWindowValue","1","Window","Expected Value :-"&expectedValue &"   did not Match  With Contents of SAP window" )
						      strMsg="Actual Value of the SAP Window: "&strWindowText&" does not match with the Expected Value: "&expectedValue& "	"
						      strStatus = "FAIL"
						      
					End If
			Else 
			   Call ReporterFunction(strLibraryFileName,"VerifyWindowValue","1","Window","SAP Window Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Window Object Missing"
			   blnObjectError=True
			End If

If strStatus = "FAIL"  Then
		VerifyWindowValue = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextArea,False,False,False)
	Else
		VerifyWindowValue = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
			
			
			
 Set objSApwindow=Nothing
 
End If
End function
'************************************************************************************
'End Function - VerifyWindowValue
'***************************************************************************************

Public Function Convert4digitNumber(DtNumber)
	If len(DtNumber)<4 Then
		DtNewNumber = DtNumber+ "0"
		Else
		DtNewNumber=Mid(DtNumber,1,4)
	End If
	Convert4digitNumber =DtNewNumber
End Function

''**********************************************************************************
'Name of the Function   :  SelectCellGuiGrid
'Description		     : Selects a cell in a SAP Gui Grid        
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'				columnName :- Name Property of the column having unique value 
'				columnName :- columnName for the particular row to be selected    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectCellGuiGrid(gridTitle,gridIndex,Rowno,columnName,blnIsItPopup)
'***********************************************************************************
Public Function SelectCellGuiGrid(gridTitle,gridIndex,Rowno,columnName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCellGuiGrid"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select a cell in GuiGrid" 
If columnName<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					strRowNumber=Rowno
            		If Err.Number=0 and strRowNumber <> "" Then
						objGrid.SelectCell strRowNumber,columnName
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			End if
						Call ReporterFunction(strLibraryFileName,"SelectCellGuiGrid","2","SelectCellGuiGrid","Cell Selected:-"& vbNewLine &" Row No : "&strRowNumber &" Column : "&columnName)
						strMsg="Cell of  Row [" & strRowNumber & "] and column [" & columnName & "] selected in GuiGrid."
						strStatus = "DONE"
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"SelectCellGuiGrid","1","SelectCellGuiGrid","The Column:  "&columnName& " Not Found Within The GuiGrid")
						 strStatus = "FAIL"
						 strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
						 blnObjectError=True
'					Else 
'						blnObjectError=True
'						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGrid","1","SelectRowGuiGrid","Value "&refValue&" Not Found Within The Column :"&columnName& " of GuiGrid")
'						strStatus = "FAIL"
'						strMsg ="Value ["&refValue& "] Not Found Within The Column [" & columnName & "] of GuiGrid"
						
					End If
		Else 
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"SelectCellGuiGrid","1","SelectCellGuiGrid","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectCellGuiGrid","1","SelectCellGuiGrid","Function Parameter Not Passed Properly. Check the --SelectCellGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectCellGuiGrid-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCellGuiGrid = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectCellGuiGrid = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objGrid)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectCellGuiGrid
'************************************************************************************


Public Function FormatBlank(StrData)
	If UCASE(StrData)= UCASE("%blank%") then
		FormatBlank=""
		Else
		FormatBlank=StrData
	End If
End Function



'**********************************************************************************
'Name of the Function   : GetGridContentByTitle
'Description		     : Get the Grid Content by providing the column name and row number and grid title as parameters
'Input Parameters	     :  gridTitle - Title of the SAP GUI grid
'							gridIndex - Index of the GUI grid
'							columnName - Name of the column from  which data has to be fetched
'							rownumber - Name of the row from which data has to be fetched							
'Output Parameters        : dataTableColumnName -Name of the Column name in output excel sheet where data should be stored
'***********************************************************************************
'Function GetGridContentByTitle(gridTitle,gridIndex,columnName,rownumber,dataTableColumnName)
Public Function GetGridContentByTitle(gridTitle,gridIndex,columnName,rownumber,dataTableColumnName)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetGridContentByRefColumn"
	strStepName = "Get Grid Content"
	If rownumber <>  "" and columnName <> ""  Then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:=.*"&gridTitle&".*","index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:=.*"&gridTitle&".*","index:="&gridIndex)
		Set objGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGrid.Exist  Then
				On Error Resume Next
'				strRowNum=objGrid.FindRowByCellContent(refColumn,refFieldVal)
				GetGridContentByTitle=objGrid.GetCellData(rownumber,columnName)
				If Err.Number = 0 Then
					'GetGridContentByRefColumn=objGrid.GetCellData(strRowNum,columnName)
					strStatus="DONE"
					strCapturedText=GetGridContentByTitle
					'If strStatus = "DONE" then
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          			End if
						strMsg = "Grid Content Fetched Into Datatable"
'					Else
'						blnObjectError=True
'						strMsg = "Grid Content Not Fetched Into Datatable"
'					End if
				ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					strStatus="FAIL"
					strMsg =  "Column Not Found Within Gui Grid . Please Verify Screen"
					blnObjectError=True
					Err.Clear
				Else
					Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Invalid Parameter Passed .Check--Column Name--Parameter Of --GetGridContentByTitle--Function Call")
					strStatus = "FAIL" 
					strMsg = "Invalid Parameter Passed .Check--Column name--Parameter Of --GetGridContentByTitle--Function Call"
					
					Err.Clear			
				End If
			Else
				Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Grid Object Not Found. Check the --GetGridContentByTitle-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Grid Object Not Found. Check the --GetGridContentByTitle-- Function Call"
				blnObjectError=True				
			End If
	Else
		Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Function Parameter Not Passed Properly.")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --GetGridContentByTitle-- Function Call"
	End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetGridContentByTitle = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetGridContentByTitle = strMsg
	   End If
	  If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&columnName&"' as column name and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&columnName&"' as column name"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refFieldVal,strMsg,strStatus,"")
	   End If
	   
	End If

End Function


'**********************************************************************************
'Name of the Function   : SetTableDataNoRef
'Description		     : Set the Value in GUI Table when No Ref Column is available
'Input Parameters	     :  tableName - Name of the GUI Table
'							columnName - Name of the GUI Column in which data needs to be inserted
'							rowNumber - Name of the GUI row in which data needs to be inserted
'							cellValue - Value to be inserted in the table							
'Output Parameters        : N/A
'***********************************************************************************
'Function SetTableDataNoRef(tableName,columnName,rowNumber,cellValue,blnIsItPopup)


Public Function SetTableDataNoRef(tableName,columnName,rowNumber,cellValue,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or cellValue= DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetTableData"


		Dim objTable,objWindow

		strStepName ="Set " & "'" & cellValue & "'"& " in Table '"&tableName&"'"
    	Set objWindow= SetSAPwindowObj(blnIsItPopup)
		Set objTable= SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguitable(guiTable,"name:="&tableName)
		If  objTable.Exist Then

				On Error Resume Next
					If  rowNumber<>"" Then
						strRowNumber=rowNumber
					End If

					IF Err.Number = 13 Then
							Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field","ref row Not Found Within Ref Column. Check the --ref column name and row number")
							strMsg = "'" & strRowNumber & "'" & " Not Found Within: '" & columnName & "' .Check the --ref column name and row number"
							strStatus = "FAIL"
							
					ElseIf Err.Number=-2147220983 Then
							Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field","ref row Not Found Within Ref Column. Check the --ref column name and row number")
							strMsg = "'" & strRowNumber & "'" & " Not Found. Check the ref column name and row number"
							strStatus = "FAIL"
							blnObjectError=True

                    End If 
					If Err.Number = 0 Then
						Err.Clear	
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
					       ImagePath=CaptureScreenshot(strStepName,objTable,FALSE,False,TRUE)
					    End if	

					    strStepName ="Set " & "'" & cellValue & "'"& " in Row Number: "& "'" & rowNumber & "'" & " and in Column Name: "& "'" & columnName& "'" & " in Table"
					    On Error Resume Next
						If cellValue=DS_BLANK Then
							objTable.SetCellData strRowNumber,columnName,""
						Else
							objTable.SetCellData strRowNumber,columnName,cellValue 
						End If

					If Err.Number = 0 Then
						    Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","2","Table Data Field","Value Used :-" & vbNewLine &"Table Name:" & tableName &vbNewLine&"Column Field: "& columnName & vbNewLine &"Row Field: "&strRowNumber & vbNewLine &" ValueField: "&strcellValue)
						    strStatus = "DONE"
						    strMsg = "Table Data set successfully"
						    
					ElseIf Err.Number=-2147220983  Then
                            Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field","Column Not Found. Check the --columnName--Parameter of--SetTableDataNoRef-- Function Call")
							strMsg = "Column Not Found. Check the --columnName--Parameter of --SetTableDataNoRef-- Function Call"
							strStatus = "FAIL"
							blnObjectError=True
					ElseIf Err.Number=-2147220975  Then
						If not rowNumber="" Then
						Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field"," Row Not Found. Check the --rowNumber--Parameter of --SetTableDataNoRef-- Function Call")
							strMsg = "Row Not Found. Check the --rowNumber--Parameter of --SetTableDataNoRef-- Function Call"
							strStatus = "FAIL"
						End If
					ElseIf objTable.IsCellEditable(strRowNumber,columnName)=False Then
								Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field"," Table Cell Not Editable. Check the --SetTableDataNoRef-- Function Call")
								strMsg = "Table Cell Not Editable. Check the --SetTableDataNoRef-- Function Call"
								strStatus = "FAIL"
								
						ElseIf Err.Number=-2147220476 Then
								Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field","Value Not Valid. Check the--cellValue-- Paramater  of --SetTableDataNoRef-- Function Call")
								strMsg = "Value Not Valid. Check the--cellValue-- Paramater  of --SetTableDataNoRef-- Function Call"
								strStatus = "FAIL"
						End If	
				 End If 
					

					Else 
							Call ReporterFunction(strLibraryFileName,"SetTableDataNoRef","1","Table Data Field","Table Object Missing")
							strMsg = "Table Not Found- Please Check the Screen"
							strStatus = "FAIL"
							blnObjectError=True
				End If


	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetTableData = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTable,FALSE,False,TRUE)
	Else
		SetTableData = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,cellValue,strMsg,strStatus,"")
	End If
End If

 ' //////////Word Document ///////////
'If blnCreateTrainingDoc Then
'			Check=CheckStatus_Doc(strStatus)
'			If Check=1 Then
'				Call storeTableorGridCoordinates(objTable)
'				Call StoreSteps(strStepName)
'			End If 
'End if
 ' //////////Word Document ///////////

Set objTable=Nothing
Set objWindow=Nothing
End Function  


'**********************************************************************************
'Name of the Function   : WinScpTransferFile
'Description		     : This Function transfers file from the local machine to a server through WinSCP 
'Input Parameters	     :  ServerName - Name of the Server to which file will be transferred
'							ServerPort - Port Number to connect the server
'							Username - User name having access to Remote server
'							Password - Password 
'							SourceFile -File lovation which would be transferred
'							DestinationFile - Destination path where file will be transferred
'					
'Output Parameters        : N/A
''Updates done: For training document purpose, few lines of code added 
'***********************************************************************************
'Function WinScpTransferFile(ServerName,ServerPort,Username,Password,SourceFile,DestinationFile)

Public Function WinScpTransferFile(ServerName,ServerPort,Username,Password,SourceFile,DestinationFile)
	dim str, strCommandWithoutPassword, CredentArr
	 If Not Environment.Value("blnFatalError") Then
					
				
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : WinScpTransferFile"
		strFuncName = "WinScpTransferFile"
		Val = ServerName
		strStepName="Transfers file from the local machine to a server through WinSCP"
		'this variable is to determine the test step in training document
		strStepInDoc="Transfers file '"&SourceFile&"' from the local machine to a server '"&DestinationFile&"' through WinSCP"				
		If ServerName <> ""  Then											
'			CredentArr = PasswordFromDefaultFileWinSCP ()
'			Username = CredentArr(0)
'			Password = CredentArr(1)
'			Username = "kkann"
'			Password = "Automation$3333"
'			Username = "jjonn"
'			Password = "Chakshith@2922"
			Username = "pbe00g9m"
			Password = "When+100"
		
		
			
			For i = 1 To Len(Password)
			If Instr("+",Mid(Password,i,1)) Then
				Password = Replace(Password,"+","%2B")
			End If
			Next
			
			
			
			str = "/command "& chr(34) &"open sftp://"&Username&":"&Password&"@"&ServerName&":"&ServerPort&""& chr(34) &" "& chr(34) &"option confirm off"& chr(34) &" "& chr(34) &"put -permissions=777 -resume "&SourceFile&" "&DestinationFile&""& chr(34) & " "& chr(34) &"exit"& chr(34) &""
			strCommandWithoutPassword = "/command "& chr(34) &"open sftp://"&Username&":<password> @"&ServerName&":"&ServerPort&""& chr(34) &" "& chr(34) &"option confirm off"& chr(34) &" "& chr(34) &"put -permissions=777 -resume "&SourceFile&" "&DestinationFile&""& chr(34) & " "& chr(34) &"exit"& chr(34) &""
	
				SystemUtil.Run "C:\WinSCP\WinSCP\winscp.com", str

				wait 15	
					strStatus = "DONE"
					strMsg = "Transfer Initiated, command used: "& strCommandWithoutPassword   
					If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						If strStepName <> "<SKIPSTEP>" Then ' used to skip final status function(used as navigator function for uncaptured actions) step description in training document
							Call StoreSteps(strStepInDoc)
							Call InsertImage_MultipleSteps("")
        						Call InsertStepsDoc_MultipleSteps()
	        					oDicSteps.RemoveAll	
					End If
					End If					
					Call ReporterFunction(strLibraryFileName,"WinScpTransferFile","2","TransferFile through WinScp", strMsg)
				
		Else
											strStatus = "FAIL"
											strMsg = "Function Parameter Not Passed Properly. Check the --WinScpTransferFile-- Function Call"                                         				
											Call ReporterFunction(strLibraryFileName,"WinScpTransferFile","1","TransferFile through WinScp",strMsg)

								End If	
						
										
															
										
																	If blnDefault_eSwiftReporting Then  
																			Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")																	
																	End If
																
					
     End If
	
	

End Function


''**********************************************************************************
'Name of the Function   :  SelectRowGuiGridbyRowNo
'Description		     : Selects a row in a SAP Gui Grid        
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'				columnName :- Name Property of the column having unique value 
'				refValue :- Value in the column  for the given columnName for the particular row to be selected    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRowGuiGridbyRowNo(gridTitle,gridIndex,rowno,blnIsItPopup)
'***********************************************************************************
Public Function SelectRowGuiGridbyRowNo(gridTitle,gridIndex,rowno,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGridbyRowNo"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select Row in GuiGrid" 
If rowno<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					strRowNumber=rowno
            		If Err.Number=0 and strRowNumber <> "" Then
						objGrid.SelectRow strRowNumber
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			End if
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","2","SelectRowGuiGrid","Row Selected:-"& vbNewLine &" Row No : "&strRowNumber)
						strMsg="Row number [" & strRowNumber & "] selected in GuiGrid."
						strStatus = "DONE"
'					ElseIf Err.Number=-2147220983 Then
'						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNo","The Column:  "&columnName& " Not Found Within The GuiGrid")
'						 strStatus = "FAIL"
'						 strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
'						 blnObjectError=True
					Else 
						blnObjectError=True
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNo","Row no is not present in GuiGrid")
						strStatus = "FAIL"
						strMsg ="Row no is not present in GuiGrid"
						
					End If
		Else 
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNo","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNo","Function Parameter Not Passed Properly. Check the --SelectRowGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectRowGuiGrid-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiGridbyRowNo = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectRowGuiGridbyRowNo = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objGrid)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectRowGuiGridbyRowNo
'************************************************************************************

''**********************************************************************************
'Name of the Function   :  SelectRowGuiGridbyRowNoIfExist
'Description		     : Selects a row in a SAP Gui Grid  If Exist     
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'				columnName :- Name Property of the column having unique value 
'				refValue :- Value in the column  for the given columnName for the particular row to be selected    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRowGuiGridbyRowNoIfExist(gridTitle,gridIndex,rowno,blnIsItPopup)
'***********************************************************************************
Public Function SelectRowGuiGridbyRowNoIfExist(gridTitle,gridIndex,rowno,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGridbyRowNoIfExist"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select Row in GuiGrid" 
If rowno<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					strRowNumber=rowno
            		If Err.Number=0 and strRowNumber <> "" Then
						objGrid.SelectRow strRowNumber
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		     ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			        End if
						Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","2","SelectRowGuiGridbyRowNoIfExist","Row Selected:-"& vbNewLine &" Row No : "&strRowNumber)
						strMsg="Row number [" & strRowNumber & "] selected in GuiGrid."
						strStatus = "DONE"						
					End If
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNoIfExist","Function Parameter Not Passed Properly. Check the --SelectRowGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectRowGuiGridbyRowNoIfExist-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiGridbyRowNoIfExist = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectRowGuiGridbyRowNoIfExist = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectRowGuiGridbyRowNoIfExist
'************************************************************************************

Public Function GetNodeTextGuiTree(treeIndex,itemText,counterDifference,dataTableColumnName)
Dim Found,i,StrNodeText
If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetNodeTextGuiTree"
       strStepName="Retreive the item in reference to "  & itemText &  " in Gui Tree"
If treeIndex <>"" or  itemText<>"" Then
    Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
    If objTree.Exist Then
        'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
        Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
        'First you need to get all values under this tree
        Set AllValues = TreeObj.GetAllNodeKeys
        'Get count
        Count = AllValues.Count
        Found = 0
        For i = 0 to Count-1
            StrNodeText = TreeObj.GetNodeTextByKey(AllValues(i))
            If StrNodeText = itemText Then
                Found = 1
                Exit For
            End if
        Next
        If Found=1 Then
            strCapturedText=TreeObj.GetNodeTextByKey(AllValues(i+counterDifference))'Taking the reference text to come before the actual node value to be retreived.
            strStatus = "DONE"
            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
            End if
            Call ReporterFunction(strLibraryFileName,"GetNodeTextGuiTree","2"," Retreive Item in GuiTree","Item in the tree is retreived successfully")
            strMsg="Item in the tree is retreived successfully"
        else
            strStatus = "FAIL"
            blnObjectError=True
            Call ReporterFunction(strLibraryFileName,"GetNodeTextGuiTree","1","Reference Item in GuiTree","Reference Item in Gui Tree is Missing")
            strMsg = " The reference item is not Found in the SAP GUI Tree, Please verify the Screen"
        End If
    Else
        Call ReporterFunction(strLibraryFileName,"GetNodeTextGuiTree","1","Item in GuiTree","Gui Tree Missing")
        strStatus = "FAIL"
        blnObjectError=True
        strMsg = " The SAP GUI Tree is not displayed on the screen. Please check the screen"
    End  If
Else
        Call ReporterFunction(strLibraryFileName,"GetNodeTextGuiTree","1","Verifies the presence of an item in the tree ","Function Parameter Not Passed Properly. Check the --ActivateItemGuiTree-- Function Call")
        strStatus="FAIL"
        strMsg = "Function Parameter Not Passed Properly. Check the --GetNodeTextGuiTree-- Function Call-"    
End If
        If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If

       If strStatus = "FAIL"  Then
            GetNodeTextGuiTree = strMsg
            blnMainFailFlag = True
            ImagePath=CaptureScreenshot(strStepName,objTree,False,False,False)
       Else
            GetNodeTextGuiTree = strMsg
       End If
       
       If blnWriteDataToOutputSheet Then
            strStepName = "Retrieve '"&strCapturedText&"' value from the GUI Tree and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
            call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
        Else
            strStepName = "Retrieve '"&strCapturedText&"' value from the GUI Tree "
        End If 
       If blnDefault_eSwiftReporting Then  
           Call UpdateResultHtml(strStepName,refCellValue,strMsg,strStatus,"")
        End If

Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
End  If
End Function
'*****************************************************************************************************
'End Function - GetNodeTextGuiTree
'*****************************************************************************************************************
Public Function VerifyNodeTextGuiTree(treeIndex,itemText)
If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyNodeTextGuiTree"
       strStepName="Verify the item: "  & itemText &  " in Gui Tree"
If treeIndex <>"" or  itemText<>"" Then

Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
        'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
        Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
'First you need to get all values under this tree
        Set AllValues = TreeObj.GetAllNodeKeys
'Get count
        Count = AllValues.Count
        Found = 0
    For i = 0 to Count-1
        NodeText = TreeObj.GetNodeTextByKey(AllValues(i))
        If NodeText = itemText Then
            Found = 1
            Exit For
        End if
    Next
    If Found=1 Then
        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
              End if
         Call ReporterFunction(strLibraryFileName,"VerifyNodeTextGuiTree","2"," Verify Item in GuiTree","Item Verified:- "&itemText)
                strStatus = "PASS"
        strMsg="Item in the tree is verified successfully"
    else
        Call ReporterFunction(strLibraryFileName,"VerifyNodeTextGuiTree","1","Item in GuiTree","Gui Tree Missing")
        strStatus = "FAIL"
        blnObjectError=True
        strMsg = " The entered item is not Found in the SAP GUI Tree, Please verify the Screen"
        
    End If
Else
        Call ReporterFunction(strLibraryFileName,"VerifyNodeTextGuiTree","1","Item in GuiTree","Gui Tree Missing")
        strStatus = "FAIL"
        blnObjectError=True
        strMsg = " The SAP GUI Tree is not displayed on the screen. Please check the screen"
        
End  If
Else
        Call ReporterFunction(strLibraryFileName,"VerifyNodeTextGuiTree","1","Verifies the presence of an item in the tree ","Function Parameter Not Passed Properly. Check the --ActivateItemGuiTree-- Function Call")
        strStatus="FAIL"
        strMsg = "Function Parameter Not Passed Properly. Check the --VerifyNodeTextGuiTree-- Function Call-"    
End If

Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If

       If strStatus = "FAIL"  Then
            VerifyNodeTextGuiTree = strMsg
            blnMainFailFlag = True
            ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
       Else
            VerifyNodeTextGuiTree = strMsg
       End If
    
       If blnDefault_eSwiftReporting Then  
           Call UpdateResultHtml(strStepName,itemText,strMsg,strStatus,"")
       End If
 End If
End Function
'*****************************************************************************************************
'End Function - VerifyNodeTextGuiTree
'*****************************************************************************************************************

''*********************************************************************
'Name of the Function   :  ClickCellTableByRowNo
'Description		     :    Clicks a button inside a table cell.
'										tableName : - Name of table whose cell has to be clicked
'			                           rowNumber :- Row number of table where value is to be entered
'			                          columnName :- Column name of table where value is to be entered
'										blnIsItPopup-Parameter which  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window
'Input Parameters	     :  tableName,columnName,rowNumber,columnNameRef,tableValRef,blnIsItPopup
'Output Parameters        :Null
'***********************************************************************************
'Function ClickCellTableByRowNo(tableName,columnName,rowNumber,blnIsItPopup)
'***********************************************************************************

Function ClickCellTableByRowNo(tableName,columnName,rowNumber,blnIsItPopup)
   If Not Environment.Value("blnFatalError") Then
					Dim objWindow, objTable
					If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickCellTableByRowNo"
					strFuncName = "ClickCellTableByRowNo"
'					Val = "<b>Table Name :</b>" & tableName &"<br><b>Column Name : </b>"& columnName&"<br><b> Row Number: </b>"&rowNumber&"<br><b>Column Name Ref: </b>"&columnNameRef&" Table Value Ref:"&tableValRef
					Val=""
					strStepName = "Click Cell  In Table with Column Name: " & columnName & " and row number: " & rowNumber
					Set objWindow= SetSAPwindowObj(blnIsItPopup)

			If  tableName <>"" And columnName <>"" And rowNumber <>"" Then

					Set objTable = SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiTable(guiTable,"name:="&tableName)
							   If objTable.Exist Then
								    
									On Error Resume Next
											 
													strRowNumber=rowNumber
												
														 If blnCaptureFlag = True  or  blnCreateImageEachStep = True or blnCreateTrainingDoc = True  Then
																							ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
														End If
														objTable.ClickCell strRowNumber,columnName
'														msgbox err.number
'														msgbox(strRowNumber)
'														msgbox(objTable.ValidRow(strRowNumber))
																If Err.Number = -2147220983 Then															' Verifies whether column is present in the table
																					strStatus="FAIL"
																					strMsg =  "Column Not Found Within Gui Table . Please Verify Screen"
																					blnObjectError = True
																					Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																					Err.Clear	
																ElseIf Not objTable.ValidRow(strRowNumber) Then
																					strStatus="FAIL"
																					strMsg = " Row Not Valid.Please Check the --rowNumber--Parameter of --ClickCellTable-- Function Call"
																					blnObjectError = True
																					Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																					Err.Clear
																ElseIf Err.Number = -2147220986 or Err.Number = -2147220975 Then								'Verifies whether Button is present within the cell
																					strStatus="FAIL"
																					strMsg = "Button Not Found Within Cell .Check the--ClickCellTable-- Function Call"	
																					blnObjectError = True															
																					Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																					Err.Clear
																ElseIf Err.Number = 0 or Err.Number = 424 Then	'Error 424 Object Required.Object losing visibility intermittently				
																					strStatus = "DONE"																
																					strMsg = "Table Cell Clicked"
																					Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)
                                                                                   
																	
																End If
								Else
												strStatus="FAIL"
												blnObjectError = True
												strMsg = "Table Object Not Found . Please Check the--ClickCellTable-- Function Call"
												Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
												
								End If
		      Else
						strStatus="FAIL"
						strMsg =  "Parameters not passed properly, Please Verify --Parameter Of--ClickCellTableByRowNo--Function Call"
						Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)

			   End If
																	If  blnObjectError  Then
																		Environment.Value("blnFatalError")=True
																	End If
										
																	If strStatus = "FAIL"  Then
																		ClickCellTableByRowNo = strMsg
																		blnMainFailFlag = True
																		ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
																	Else
																		ClickCellTableByRowNo = True
																	End If
										
																	If blnDefault_eSwiftReporting Then  
																			Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")																	
																	End If
			

										Set objTable=nothing
										Set objWindow=nothing

End If
End Function

'************************************************************************************
'End Function - ClickCellTable
'***********************************************************************************

Function SetSpecialTextbox(textboxAttachedText,textboxName,textboxIndex,textboxValue,blnIsItPopup)
    If Not (Environment.Value("blnFatalError") or textboxValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetSpecialTextbox"
	
    	Dim objTextboxGuiComp32,objTextboxGuicomp31,objTextbox,objWindow
	
	
	strStepName = " Set "  & "'" & textboxValue & "'" & " in Textbox : " & "'"& textBoxAttachedText & "'"                   
        Set objWindow= SetSAPwindowObj(blnIsItPopup)
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","attachedtext:="&textboxAttachedText,"name:="&textboxName,"Index:="&textboxIndex)
	Set objTextboxGuicomp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","attachedtext:="&textboxAttachedText,"name:="&textboxName,"Index:="&textboxIndex)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuicomp31)  
	If objTextbox.Exist then
			
	     	If VerifyObjectStatus(objTextbox) Then  
			If textboxValue= DS_BLANK Then
			      objTextbox.set ""
			Else
			      objTextbox.set textboxValue
			End If
        	        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
			End if
			Call ReporterFunction(strLibraryFileName,"SetSpecialTextbox","2",strStepName,"Value Used :-"& vbNewLine & "AttachedText:"&textboxAttachedText & vbNewLine & "Text BoxName: " &textboxName & vbnewline &"ValueField:" &textboxValue)
			strStatus = "DONE"
			strMsg = "Text box set successfully"
		Else
			Call ReporterFunction(strLibraryFileName,"SetSpecialTextbox","1",strStepName,"The Textfield: "& textboxAttachedText & "is not enabled")
			strStatus = "FAIL"
			strMsg = "The Textfield '"& textboxAttachedText & "' is not enabled"
                   	blnObjectError=True
		End if		
	Else 
	        
	        Call ReporterFunction(strLibraryFileName,"SetSpecialTextbox","1",strStepName,"Object Missing--Check the Screen Properly")
		strStatus = "FAIL"
		strMsg = "The Textfield '"& textboxAttachedText & "'  is not Found--Check the Screen Properly"
		blnObjectError=True
	End If		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetSpecialTextbox = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
	Else
		SetSpecialTextbox = True
	End If
	If blnDefault_eSwiftReporting Then 
	strStepName = " Set "  & "'" & "special charcter Value" & "'" & " in Textbox : " & "'"& textBoxAttachedText & "'"                   
	textboxValue=""
		Call UpdateResultHtml(strStepName,textboxValue,strMsg,strStatus,"")
	End If
'	' //////////Word Document ///////////
'			If blnCreateTrainingDoc Then
'				   Check=CheckStatus_Doc(strStatus)
'				   If Check=1 Then
'						  Call storeCoordinates(objTextbox)
'						  Call StoreSteps(strStepName)
'				   End If
'			End If
'	 ' //////////Word Document ///////////
	Set objTextbox=Nothing
	Set objTextboxGuiComp32=Nothing
	Set objTextboxGuicomp31=Nothing
	Set objWindow=Nothing
    End If
End function

'**********************************************************************************
'Name of the Function   :   SelectRowGuiTable(tableName,columnName,cellVal)
'Description		     : Selects row in a SAP Gui Table  
'Input Parameters	     :  tableName - Name of the table
'                                             columnName - Name of the reference column having unique value in the SAP GuiTable.   
'                                             cellVal- Value in the column  for the given columnName for the particular row to be selected
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        :
'***********************************************************************************
'Function  SelectRowGuiTable(tableName,columnName,cellVal,blnIsItPopup)
'***********************************************************************************
Function SelectRowGuiTableByRow(tableName,intRowNo,blnIsItPopup)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiTableByRow"
	Set objWindow= SetSAPwindowObj(blnIsItPopup)
	strStepName= "Select Row in a Gui Table"
	
If  tableName <> "" Then
		Set objTable = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiTable(guiTable,"name:="&tableName)
		If  objTable.Exist  Then
		    On error resume next
'			intRowNo=objTable.FindRowByCellContent (columnName,cellVal)
			'msgbox Err.Number
			If Err.Number=0 Then
				objTable.SelectRow intRowNo
'				If Err.Number=0 Then	
				    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				        ImagePath=CaptureScreenshot(strStepName,objTable,False,False,True)
	                End if			
					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","2"," Select Row Gui Table ","Row Selected:-"& vbNewLine &" Row No : "&intRowNo)
					strStatus = "DONE"
					
					strMsg="Row in the table is selected successfully." 'tested
				'End If
'				ElseIf Err.Number = -2147220975 Then
'					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
'					strStatus = "FAIL"
'					strMsg ="The Row:  "&intRowNo& " is Not Accessible "
'                    blnObjectError=True
'				ElseIf Err.Number=-2147220983 Then
'				
'				
'				Call ReporterFunction(strLibraryFileName,"SelectRowGuiTable","1","Select Row Gui Table in Popup","The Value in the Datatablecolumn" &cellVal& "was not found in the SAP GUI Table")
'			    strStatus = "FAIL"
'				strMsg = "The Value in the Datatablecolumn " &cellVal& " was not found in the SAP GUI Table " 	
'            Else 
'				   Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1","Select Row Gui Table","Value Not Found Within The Column :"&columnName& " of Gui Table")
'				   strStatus = "FAIL"
'				   strMsg ="Value Not Found Within The Column : " &columnName& " of Gui Table"  'tested
'		     End If
'		     ElseIf Err.Number=-2147220983 Then
'		           Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1"," Select Row Gui Table","The Column:  "&columnName& " Not Found Within The GuiTable ")
'				   strStatus = "FAIL"  
'				   blnObjectError=True
'				   strMsg = "The Column "&columnName& " Not Found Within The Gui Table"
		     	  'tested
'			  ElseIf Err.Number = -2147024809 Then
'					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
'					strStatus = "FAIL"
'					strMsg ="The Value in datatablecolumn is empty"
					
					ElseIf Err.Number = -2147220975 Then
					Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1"," Select Row Gui Table ","The Row:  "&intRowNo& " is Not Accessible ")
					strStatus = "FAIL"
					strMsg ="The Row:  "&intRowNo& " is Not Accessible "
                    blnObjectError=True
                 
		End If
		Else
			Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1","Select Row Gui Table","GuiTable Object Not Found,Please Verify The Screen")
		    strStatus = "FAIL"
		    blnObjectError=True
			strMsg = "GuiTable Object Not Found,Please Verify The Screen"  'tested
			
		End If
	Else   'tested
		Call ReporterFunction(strLibraryFileName,"SelectRowGuiTableByRow","1","Select Row Gui Table in Popup","Function Parameter Not Passed Properly. Check the --SelectRowGuiTableByRow-- Function Call")
