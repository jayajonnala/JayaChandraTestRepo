''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : GetspecialTextboxValue
'Author		     :Subhrajyoti S
'Description		     : Captures text from a text box containing special characters and stores in output sheet   
'Input Parameters	     :  textboxName,textboxIndex,dataTableColumnName,blnIsItPopup
'Output Parameters        : Null
'Creation Date : 05:10:2020
'***********************************************************************************
'Function GetspecialTextboxValue
'***********************************************************************************

Public Function GetspecialTextboxValue(textboxName,textboxIndex,dataTableColumnName,blnIsItPopup)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetspecialTextboxValue"
   Dim objTextbox32,objTextbox31,objTextbox,objWindow
   Set objWindow= SetSAPwindowObj(blnIsItPopup)
   strStepName="Get value from the textbox: " & "["& textboxName & "]"
   If textboxName<>"" Then
       Set objTextbox32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"index:="&textboxIndex)
       Set objTextbox31  = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"index:="&textboxIndex)
       Set objTextbox = SetObj(objTextbox32,objTextbox31)
             If objTextbox.Exist Then
                 GetspecialTextboxValue=CSTR(objTextbox.GetROProperty("value")) '---- Added
                 strCapturedText=GetspecialTextboxValue
	              strStatus = "DONE"
				  	  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	          			End if
					  Call ReporterFunction(strLibraryFileName,"GetspecialTextboxValue","2","Text box","Values Used :-"& vbNewLine &" Text Value : "&GetspecialTextboxValue)
					  strMsg="Text box value captured"
             Else
	               Call ReporterFunction(strLibraryFileName,"GetspecialTextboxValue","1","Text box","Text box Object Missing")
                   strStatus = "FAIL"
                   strMsg = " The Text box Object is not Found, Please verify the Screen"
                   blnObjectError=True
             End If
   Else
                   Call ReporterFunction(strLibraryFileName,"GetTextboxValue","1","Text box","Function Parameter Not Passed Properly. Check the --GetTextboxValue-function")
                   strStatus="FAIL"
                   strMsg = "Function Parameter Not Passed Properly. Check the --GetTextboxValue-- Function Call-"
   End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetspecialTextboxValue = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    GetspecialTextboxValue = strMsg
	   End If
	   
	    
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from textbox and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"								
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from textbox"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then 
'	    strStepName= "Retrive value from textbox and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"
	    strStepName= "Retrived value from textbox and store in '"  &gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"	
	    strCapturedText=" "

		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	  
              
               Set objTextbox32 =Nothing
               Set objTextbox31=Nothing
               Set objTextbox = Nothing
			   Set objWindow=Nothing
   End If
  End Function
  
  ''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : ConvertDate
'Author		     :Subhrajyoti S
'Description		     : Converts date into proper format that is accepted by system
'Input Parameters	     :  DtDate
'Output Parameters        : Null
'Creation Date : 05:10:2020
'***********************************************************************************
'Function ConvertDate
'**********************************************************************************
  Public Function ConvertDate(DtDate)
'  DtDate=Cdate(DtDate)
	If IsDate(DtDate) Then
			NewDate= ConvertDoubledigit(CSTR(Day(DtDate))) +"."+ConvertDoubledigit( Cstr(Month(DtDate))) + "."+ Cstr(Year(DtDate))
  			ConvertDate = NewDate
	Else
			DateVal=Cstr(DtDate)
			ConvertDate =Left(DtDate,2) +"."+ Mid(DtDate,4,2)+ "."+Right(DtDate,4)
	End If
  
  End Function
'******************************************************************************
Public Function GetNodeDatePosition(strItemPath)
 	strItemPath = Split(strItemPath,";")
 	For iNumeric = 0 To 4
              If InStr(1,strItemPath(iNumeric),ConvertDate(Date)) > 0 Then 
                 GetNodeDatePosition=iNumeric
        Exit For
              End If
        Next
 End Function
'******************************************************************************  
 Public Function ConvertDateYY(DtDate)
DD = Day(DtDate)
If Len(DD) = 1 then
DD = "0" & DD
End If



MM = Month(DtDate)
If Len(MM) = 1 then
MM = "0" & MM
End If



YY = Year(DtDate)
YY = right(YY,2)

ConvertDateYY= DD & "." & MM & "." & YY
End Function
  
Public Function ConvertArgosDate(DtDate)
	DD = Day(DtDate)
If Len(DD) = 1 then
DD = "0" & DD
End If

MM = Month(DtDate)
If Len(MM) = 1 then
MM = "0" & MM
End If

YY = Year(DtDate)
YY = right(YY,2)
  
  ConvertArgosDate = DD & "/" & MM & "/" & YY
  End Function
  
  'Functions Definition
'**********************************************************************************
'Name of the Function   : ConvertNegativePosetive
'Author		     :Subhrajyoti S
'Description		     : Converts negative value to posetive. Foer example while entering amount value
'Input Parameters	     :  DtDate
'Output Parameters        : Null
'Creation Date : 05:10:2020
'***********************************************************************************
'Function ConvertNegativePosetive
'**********************************************************************************
Public Function ConvertNegativePosetive(DTInput)
	If Right(DTInput,1) ="-" Then
		ConvertNegativePosetive=Left(DTInput,Len(DTInput)-1)
	Else
	 ConvertNegativePosetive = DTInput
	End If
End Function

