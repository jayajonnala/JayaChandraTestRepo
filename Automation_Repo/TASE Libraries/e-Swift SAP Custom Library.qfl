Public Function FocusTextBoxByIndex(attachedText,textboxName,textboxIndex,blnIsItPopup)

If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : FocusTextBoxByIndex"
Dim objTextboxGuiComp32,objTextboxGuiComp31,objTextbox,objWindow
strStepName=" Set Focus on the TextField " &textboxName
If attachedText<>"" and textboxName<>"" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","attachedtext:="&attachedText,"name:="&textboxName,"index:="&textboxIndex)
	Set objTextboxGuiComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","attachedtext:="&attachedText,"name:="&textboxName,"index:="&textboxIndex)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuiComp31)
	
	If objTextbox.Exist Then
				
	      	  If attachedText<>""  then
				strStepName=" Set Focus on the TextField " &attachedText    
				else      
				strStepName=" Set Focus on the TextField " &textboxName   			  
		      End If
    				objTextbox.SetFocus
    				strStatus = "DONE"
    				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	          		End if
           		  strMsg=" Textbox Focused successfully"
           		  Call ReporterFunction(strLibraryFileName,"FocusTextBoxByIndex","2","Text Box field","Textbox Focused successfully")
           		  
           		  
	Else
			Call ReporterFunction(strLibraryFileName,"FocusTextBoxByIndex","1","Text Box field","Object Missing. Textbox Not Found")
			strStatus="FAIL"
			strMsg = "Object Missing. Textbox Not Found"
			blnObjectError=True
	End if	
else	
Call ReporterFunction(strLibraryFileName,"FocusTextBoxByIndex","1","Text Box field","Function Parameter Not Passed Properly. Check the --FocusTextBoxByIndex-- Function Call")
			strStatus="FAIL"
			strMsg = "Function Parameter Not Passed Properly. Check the --FocusTextBoxByIndex-- Function Call"
		End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    FocusTextBoxByIndex= strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    FocusTextBoxByIndex = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
Set objTextboxGuiComp32=Nothing
Set objTextbox=Nothing
Set objTextboxGuiComp31=Nothing
Set objWindow=Nothing
End If
End Function



'******************************************************************************************************
'Name of the Function   : ClickButtonGuiTree
'Description		     : Click button in Gui Tree
'Input Parameters	     :   treeIndex - Index of the tree in which the item is present
'											 itemPath - Path to the item which is to be selected
'											itemText - Text of the SAP item which is to be selected
'Output Parameters        : 
'******************************************************************************************************
'Function ClickButtonGuiTree(treeIndex,itemPath,itemText)
'******************************************************************************************************
Public Function ClickButtonGuiTree(treeIndex,itemPath,itemText)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectItemGuiTree"
strStepName = "Select item: " & "'" &  itemText & "'" & " in GuiTree"
If treeIndex <>"" or itemPath<>"" or itemText<>""Then
Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
If objTree.Exist Then
On Error Resume Next
objTree.ClickButton itemPath,itemText
If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	          End if
Call ReporterFunction(strLibraryFileName,"ClickButtonGuiTree","2","Click Item in GuiTree","Item Clicked:- "&itemText)
strStatus = "DONE"
strMsg="Item clicked successfully"
else
		Call ReporterFunction(strLibraryFileName,"ClickButtonGuiTree","1","Item in GuiTree","Gui Tree Missing")
		strStatus = "FAIL"
		strMsg = " The Tree Object is not Found, Please verify the Screen"
		blnObjectError=True
End If
Else
		Call ReporterFunction(strLibraryFileName,"ClickButtonGuiTree","1","Click Item Gui Tree ","Function Parameter Not Passed Properly. Check the --ClickButtonGuiTree-- Function Call")
		strStatus="FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the --ClickButtonGuiTree-- Function Call-"	
End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectItemGuiTree = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
	   Else
		    SelectItemGuiTree = True
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,itemPath&";"&itemText,strMsg,strStatus,"")
	   End If
' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objTree)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set  objTree =nothing
Set normalObj=nothing
End If
End Function

'*****************************************************************************************************
'End Function - ClickButtonGuiTree
'*****************************************************************************************************


''**********************************************************************************
'Name of the Function   :  VerifyAnyGridCellContent
'Author		     : Ritu
'Description		     : Verifies the contents of cell of a Gui Grid which is present in a normal window .
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 08/05/2012
'***********************************************************************************
'Function  VerifyGridCellContent(gridRowNumber,gridColumnName,gridTitle,expectedValue)
'***********************************************************************************
Public Function VerifyAnyGridCellContent(gridTitle,gridTotalRowNumber,gridColumnName,gridIndex,expectedValue)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyAnyGridCellContent"
	strStepName = " Verify  Content " & "'" & expectedValue & "'"  & " in GuiGrid"

If gridRowNumber<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
					  
					   For Iterator = 1 To Cint(gridTotalRowNumber) Step 1
						 strCellValueFetched = objGuiGrid.GetCellData(Iterator,gridColumnName)
					   	
					   
						 
						 		
						
						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 Call ReporterFunction(strLibraryFileName,"VerifyAnyGridCellContent","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & Iterator &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							   blnCaptureFlag = True
							   Exit For  
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
                              End If
                              
                            
           	
							
						 Else
'							  Call ReporterFunction(strLibraryFileName,"VerifyAnyGridCellContent","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & Iterator &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
							  strMsg =  " Actual value in the Grid cell  :  "  & strCellValueFetched &   "  does not match with the expected value:    "   &  expectedValue & ""
							  
							  End If
							  Next
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyAnyGridCellContent","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						 End If
			
							 
			Else 	   Call ReporterFunction(strLibraryFileName,"VerifyAnyGridCellContent","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyAnyGridCellContent","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContent-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyAnyGridCellContent-- Function Call"
End If

If strStatus = "FAIL"  Then
		VerifyAnyGridCellContent = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		VerifyAnyGridCellContent = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   VerifyGridCellContent
'************************************************************************************


Public Function VerifyWebTableValue(creationTime,tableClass,TableName,columnNumber,rowNumber,expectedVal)
If Not (Environment.Value("blnFatalError") or ExcelColumnName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyWebTableValue"
		strStepName = "Verify  value from the Table:  "&TableName
		ALMvalue=getEnvironmentVariable("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
		PopUpCreationtime=Cint(creationTime)
		End If
		Dim objWebTable
		If tableClass<> ""  or columnNumber <> "" or rowNumber<>""  Then
			'	columnNumber=Cint(columnNumber)
			rowNumber=Cint(rowNumber)
			On error resume next
			Set objWebTable =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebTable("html tag:=TABLE","class:="&tableClass,"name:="&TableName)
			If  objWebTable.Exist  then 
				objWebTable.highlight
   	 			val=objWebTable.GetCellData(rowNumber,columnNumber)
   	 
   				If UCASE(val) = UCASE(expectedVal) Then
	 				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,False)
			    	End if
				    strStatus = "DONE"
				    strMsg= "Actual Value of the WebTable : " & val & " is equal to the Expected Value: "&expectedVal
				    Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","2",strStepName,strMsg)
 				Else
 					blnObjectError=True
   					strStatus = "FAIL"    
   					strMsg ="Actual Value of the WebTable : " & val & " is not equal to the Expected Value: "&expectedVal
   					Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","1",strStepName,strMsg)
 				End if
			Else
		
        		strStatus = "FAIL"
        		strMsg ="Function Parameter Not Passed Properly. Check the --VerifyWebTableValue -- Function Call"
        		Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","1",strStepName,strMsg)
 			End if
 			
			If  blnObjectError  Then
			       Environment.Value("blnFatalError")=True
			End If

			If strStatus = "FAIL"  Then
			       VerifyWebTableValue = strMsg
			       blnMainFailFlag = True
			       ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,False)
			Else
			       VerifyWebTableValue = True
			End If
			'If blnWriteDataToOutputSheet Then
			'	                                    strStepName = "Retrieve '"&val&"' value in table '"&gstrOutputSheetName&"' sheet under column "&excelColumnName
			'										call WriteRunTimeDataToExcel (excelColumnName,val)
			'								   ELSE
			'										strStepName = "Retrieve '"&val&"' value in table"
			'	 End If
			If blnDefault_eSwiftReporting Then  
			       Call UpdateResultHtml(strStepName,expectedVal,strMsg,strStatus,"")
			End If

   Set objWebTable=Nothing
   End If
 End If 
End Function




Public Function ReplaceTxtFromFile(file_path_and_name,text_to_find,replace_text)
	Dim fso,old_content,existing_file
	

	Set fso = CreateObject("Scripting.FileSystemObject")
	
	On Error Resume Next
	
	'Open existing_file  object for reading
	Set existing_file = fso.OpenTextFile(file_path_and_name,1,false)
	
	If Err Then
'		ReportLog "ERROR","ReplaceTxtFromFile","Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
		strMsg = "Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile",replace_text,strMsg,"FAIL","")
         
        Err.Clear
        On Error Goto 0
        Exit Function
	End If
	
	
	'Check if the file path and name are correct
	If Not existing_file is Nothing Then
	
			'Store file content in old_content
			old_content = existing_file.readAll
	
			'Close file after storing content in old_content
			existing_file.close
	
			'Check if text is in file
			If InStr(old_content,text_to_find) >0 then ''usually previous project
	
				'Replace in file the searched object
				newContent = Replace(old_content,text_to_find,replace_text,1,-1,1)

			Else
			
'				ReportLog "FAILED", "ReplaceTxtFromFile","The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
		strMsg = "The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile",replace_text,strMsg,"FAIL","")
			Exit  Function
			
			End if

			'Open file for writing 
			Set objFile=fso.OpenTextFile(file_path_and_name,2,false)
	
			'Write/replace new content
			objFile.Write newContent
			objFile.Close
	
'	 ReportLog "PASSED", "ReplaceTxtFromFile","The existing text: "&text_to_find &" was successfully replaced with " &replace_text& " in file: "&file_path_and_name
		strMsg = "The existing text: "&text_to_find &" was successfully replaced with " &replace_text& " in file: "&file_path_and_name
		 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then		
		If strMsg <> "<SKIPSTEP>" Then ' used to skip final status function(used as navigator function for uncaptured actions) step description in training document
			Call StoreSteps(strMsg)
			Call InsertImage_MultipleSteps("")
        	Call InsertStepsDoc_MultipleSteps()
	        oDicSteps.RemoveAll	
End If	
End If
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",2,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile",replace_text,strMsg,"DONE","")
	Else
'	 ReportLog "FAILED", "ReplaceTxtFromFile","The file "&file_path_and_name&" could not be found" 
	 	strMsg = "The file "&file_path_and_name&" could not be found" 
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile",replace_text,strMsg,"FAIL","")
	End If
	

End Function


''====================================================================================
' Component Implementation: File Operations -
' Function will check if a folder or file exists and return boolean result.
' For checking file exists: complete both parameters.
' For checking folder exists: leave fileName blank
'==================================================================================== 


Function checkIfFolderOrFileExists (strTargetDirectory, strFileName)
	
	Dim objFSO,objFolder
	
	'If target directory is null -> throw an error
	If  IsNull (strTargetDirectory) Then
'		ReportLog "ERROR","checkIfFolderOrFileExists","Folder path can not be null"
		strMsg = "Folder path can not be null" 
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",1,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists",strFileName,strMsg,"FAIL","")
		Exit Function
	End If
	
	' Make sure the path ends with a backslash
	If Right( strTargetDirectory, 1 ) <> "\" Then
		strTargetDirectory = strTargetDirectory & "\"
	End If
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
		
	
	' If file name is null then -> check the folder exists and return true
	If  IsNull(strFileName) or strFileName ="" or strFileName = "%blank%" Then
	
		' if folder exists -> return true
		If objFSO.FolderExists(strTargetDirectory) Then
			objFSO.GetFolder strTargetDirectory
			checkIfFolderOrFileExists = true
'			ReportLog "INFO","checkIfFolderOrFileExists","Folder: <"&strTargetDirectory&"> exists at specified location."
					strMsg = "Folder: <"&strTargetDirectory&"> exists at specified location."
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			
		' otherwise (folder does not exists) -> return false
		Else
			checkIfFolderOrFileExists = false
'			ReportLog "INFO","checkIfFolderOrFileExists","Folder path was not found at the destination: >"&strTargetDirectory&">"
		 strMsg = "Folder path was not found at the destination: >"&strTargetDirectory&">"
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			Exit Function	
		End If
	
	' if the file name is present -> check that file also exists in folder and return true.
	Else
		
		' If file exists -> return true
		If objFSO.FileExists(strTargetDirectory&strFileName) Then
			checkIfFolderOrFileExists = true
'			ReportLog "INFO","checkIfFolderOrFileExists","File: <"&strTargetDirectory&strFileName&"> exists at specified location."
			strMsg = "File: <"&strTargetDirectory&strFileName&"> exists at specified location."
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			
		' otherwise (file not found) -> return false
		Else
'			ReportLog "INFO","checkIfFolderOrFileExists","File path was not found at location: <"&strTargetDirectory&strFileName&">"
		 strMsg = "File path was not found at location: <"&strTargetDirectory&strFileName&">"
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			checkIfFolderOrFileExists = false
			Exit Function
		End If
	End If
	
End Function

'====================================================================================
' Component Implementation: File Operations - 
' Creates a new folder as per full path supplied. if a new folder called "test" needs to be created on C: drive
' targetDirectoryPath would be: C:\test
'==================================================================================== 

Public Function createFolder (targetDirectoryPath)
	Dim objFSO,objFolder
	
	If  Right(filePath,1) = "\"  then
		filePath = Left(filePath, Len(filePath)-1)
	End If
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
	
	'check if folder already exists -> do nothing.
	If objFSO.FolderExists(targetDirectoryPath) Then
		objFSO.GetFolder targetDirectoryPath
'		ReportLog "WARNING","createFolder","Folder already exists at location: "&targetDirectoryPath&" .No other action taken."
		strMsg = "Folder already exists at location: "&targetDirectoryPath&" .No other action taken."
		 Call ReporterFunction(strLibraryFileName,"createFolder",2,"createFolder",strMsg)
         Call UpdateResultHtml("createFolder","createFolder",strMsg,"DONE","")
	
	'if folder does not exist with the name specified -> create new folder
	Else
		objFSO.CreateFolder targetDirectoryPath
'		ReportLog "PASSED","createFolder","Folder successfully created with the following location: "&targetDirectoryPath
			strMsg = "Folder successfully created with the following location: "&targetDirectoryPath
		 Call ReporterFunction(strLibraryFileName,"createFolder",2,"createFolder",strMsg)
         Call UpdateResultHtml("createFolder","createFolder",strMsg,"DONE","")
	End If
	
End Function

'====================================================================================
' Component Implementation: File Operations - 
' function to copy a file to another directory
'==================================================================================== 


Function CopyTxtFile(filePath,fileName,destFolder)
	Dim fso, filePathAndName 
	Set fso = CreateObject("Scripting.FileSystemObject") 
	
	
	'make sure that the destination path has the backslash 
	If  Right(destFolder,1) <>"\"  then
		destFolder = destFolder & "\"
	End If
	
	If  Right(filePath,1) <>"\"  then
		filePath = filePath & "\"
	End If
		
	filePathAndName = filePath & fileName
	destFilePathAndName = destFolder & fileName
	
	' if the file exists in the source path then -> additional checks
	If fso.FileExists(filePathAndName) Then 
		
		' If file exists in destination folder -> throw error.
		If fso.FileExists(destFilePathAndName) Then
'				ReportLog "FAILED","CopyTxtFile","Can not overwrite the file "&filePathAndName&" in destination folder:  "&destFolder& " . File with the same name already exists"
			strMsg = "Can not overwrite the file "&filePathAndName&" in destination folder:  "&destFolder& " . File with the same name already exists"
		 Call ReporterFunction(strLibraryFileName,"CopyTxtFile",1,"CopyTxtFile",strMsg)
         Call UpdateResultHtml("CopyTxtFile","CopyTxtFile",strMsg,"FAIL","")
		'if file does not exist in target folder -> copy file	
		Else
			'Copy the file from source to specified destination 
			
			fso.CopyFile filePathAndName, destFolder,true  
'			ReportLog "INFO","CopyTxtFile","File "&filePathAndName&" has been copied to destination "&destFolder
			strMsg = "File "&filePathAndName&" has been copied to destination "&destFolder
		 Call ReporterFunction(strLibraryFileName,"CopyTxtFile",2,"CopyTxtFile",strMsg)
         Call UpdateResultHtml("CopyTxtFile","CopyTxtFile",strMsg,"DONE","")
		End If
	' If file does not exist in source folder -> throw error.
	Else
'			ReportLog "FAILED","CopyTxtFile","File could not be found "&filePathAndName
					strMsg = "File could not be found "&filePathAndName
		 Call ReporterFunction(strLibraryFileName,"CopyTxtFile",1,"CopyTxtFile",strMsg)
         Call UpdateResultHtml("CopyTxtFile","CopyTxtFile",strMsg,"FAIL","")
	End If

End Function

'====================================================================================
' Component Implementation: File Operations - 
'==================================================================================== 


Function ReplaceTxtFromFile(file_path_and_name,text_to_find,replace_text)
	Dim fso,old_content,existing_file
	

	Set fso = CreateObject("Scripting.FileSystemObject")
	
	On Error Resume Next
	
	'Open existing_file  object for reading
	Set existing_file = fso.OpenTextFile(file_path_and_name,1,false)
	
	If Err Then
'		ReportLog "ERROR","ReplaceTxtFromFile","Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
			strMsg = "Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
        Err.Clear
        On Error Goto 0
        Exit Function
	End If
	
	
	'Check if the file path and name are correct
	If Not existing_file is Nothing Then
	
			'Store file content in old_content
			old_content = existing_file.readAll
	
			'Close file after storing content in old_content
			existing_file.close
	
			'Check if text is in file
			If InStr(old_content,text_to_find) >0 then ''usually previous project
	
				'Replace in file the searched object
				newContent = Replace(old_content,text_to_find,replace_text,1,-1,1)

			Else
			
'				ReportLog "FAILED", "ReplaceTxtFromFile","The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
			strMsg = "The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
				
			Exit  Function
			
			End if

			'Open file for writing 
			Set objFile=fso.OpenTextFile(file_path_and_name,2,false)
	
			'Write/replace new content
			objFile.Write newContent
			objFile.Close
	
'	 ReportLog "PASSED", "ReplaceTxtFromFile","The existing text: "&text_to_find &" was successfully replaced with " &replace_text& " in file: "&file_path_and_name
				strMsg = "The existing text: "&text_to_find &" was successfully replaced with " &replace_text& " in file: "&file_path_and_name
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",2,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"DONE","")
	Else
'	 ReportLog "FAILED", "ReplaceTxtFromFile","The file "&file_path_and_name&" could not be found" 
	 			strMsg = "The file "&file_path_and_name&" could not be found" 
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
	End If
	

End Function

'====================================================================================
' Component Implementation: File Operations -
' Uses existing folder to create an archive with it's contents blank sub folders will be skipped. 
' Example of inputs
' strmyFolderPath = S:\folder\toBeZipped
' strZipFilePath = S:\folder\myZippedFolder.zip

'==================================================================================== 


Public Function createZipFolder( strmyFolderPath, strZipFilePath )
    Dim intSkipped, intSrcItems
    Dim objApp, objFolder, objFSO, objItem, objTxt
    Dim strSkipped

    Const ForWriting = 2

    intSkipped = 0

    ' Make sure the path ends with a backslash
    If Right( strmyFolderPath, 1 ) <> "\" Then
        strmyFolderPath = strmyFolderPath & "\"
    End If

    ' Use custom error handling
    On Error Resume Next

    ' Create an empty ZIP file
    Set objFSO = CreateObject( "Scripting.FileSystemObject" )
    Set objTxt = objFSO.OpenTextFile( strZipFilePath, ForWriting, True )
    objTxt.Write "PK" & Chr(5) & Chr(6) & String( 18, Chr(0) )
    objTxt.Close
    Set objTxt = Nothing

    ' Abort on errors
    If Err Then
'		ReportLog "FAILED","createZipFolder","1.Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
		 strMsg = "Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"createZipFolder",1,"createZipFolder",strMsg)
         Call UpdateResultHtml("createZipFolder","createZipFolder",strMsg,"FAIL","")
		Err.Clear
		On Error Goto 0
		Exit Function
    End If
  
    ' Create a Shell object
    Set objApp = CreateObject( "Shell.Application" )

    ' Copy the files to the compressed folder
    For Each objItem in objApp.NameSpace( strmyFolderPath ).Items
        If objItem.IsFolder Then
            ' Check if the subfolder is empty, and if
            ' so, skip it to prevent an error message
            Set objFolder = objFSO.GetFolder( objItem.Path )
            If objFolder.Files.Count + objFolder.SubFolders.Count = 0 Then
                intSkipped = intSkipped + 1
            Else
                objApp.NameSpace( strZipFilePath ).CopyHere objItem
            End If
        Else
            objApp.NameSpace( strZipFilePath ).CopyHere objItem
        End If
    Next

    Set objFolder = Nothing
    Set objFSO    = Nothing

    'Abort on errors
    If Err Then
'			ReportLog "FAILED","createZipFolder","2.Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
			 strMsg = "2.Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"createZipFolder",1,"createZipFolder",strMsg)
         Call UpdateResultHtml("createZipFolder","createZipFolder",strMsg,"FAIL","")
			Set objApp = Nothing
			Err.Clear
			On Error Goto 0
			Exit Function
    End If

	'wait till the file is archived
	intSrcItems = objApp.NameSpace( strmyFolderPath  ).Items.Count
	Do Until objApp.NameSpace( strZipFilePath ).Items.Count + intSkipped = intSrcItems
        wait 1
	Loop
	Set objApp = Nothing
	
    
    ' Abort on errors
    If Err Then
'			ReportLog "FAILED","createZipFolder","3.Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
			strMsg = "3.Folder : <"&strZipFilePath&"> . was not archived. Error number: " & Err.Number & ", Source: " & Err.Source & ", Description: " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"createZipFolder",1,"createZipFolder",strMsg)
         Call UpdateResultHtml("createZipFolder","createZipFolder",strMsg,"FAIL","")
			Set objApp = Nothing
			Err.Clear
			On Error Goto 0
			Exit Function
    End If

    ' Restore default error handling
    On Error Goto 0

    ' Return message if empty subfolders were skipped
    If intSkipped = 0 Then
        strSkipped = ""
    Else
        strSkipped = "Skipped empty sub-folders"
    End If


'    ReportLog "PASSED","createZipFolder","Folder : <"&strZipFilePath&"> was archived successfully. "&strSkipped
    	strMsg = "Folder : <"&strZipFilePath&"> was archived successfully. "&strSkipped
		 Call ReporterFunction(strLibraryFileName,"createZipFolder",2,"createZipFolder",strMsg)
         Call UpdateResultHtml("createZipFolder","createZipFolder",strMsg,"PASS","")
	
End Function


Public Function moveAndRenameFile( strFilePathAndName,strNewFilePathAndName)
	Dim fso
	Set fso = CreateObject("Scripting.FileSystemObject") 
	
	'Check if the file exists in the path
	If fso.FileExists(strFilePathAndName) Then 
		
		'Copy the file from source to specified destination 
		fso.MoveFile strFilePathAndName, strNewFilePathAndName
		
'		ReportLog "INFO","MoveTxtFile","File "&strFilePathAndName&" has been moved to new destination "&strNewFilePathAndName
			strMsg = "File "&strFilePathAndName&" has been moved to new destination "&strNewFilePathAndName
		 Call ReporterFunction(strLibraryFileName,"moveAndRenameFile",2,"MoveTxtFile",strMsg)
         Call UpdateResultHtml("moveAndRenameFile","MoveTxtFile",strMsg,"DONE","")
	Else
'		ReportLog "FAILED","MoveTxtFile","File could not be found "&strFilePathAndName
				strMsg = "File could not be found "&strFilePathAndName
		 Call ReporterFunction(strLibraryFileName,"moveAndRenameFile",1,"MoveTxtFile",strMsg)
         Call UpdateResultHtml("moveAndRenameFile","MoveTxtFile",strMsg,"FAIL","")
	End If

End Function


Function deleteSpecificFile(strFilePath)
	Dim objFSO,objFile
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
	
	'check if folder already exists -> delete it.
	If objFSO.FileExists(strFilePath) Then
		objFSO.DeleteFile strFilePath
'		ReportLog "INFO","deleteFolder","File: <"&strFilePath&"> . was deleted successfully."
					strMsg = "File: <"&strFilePath&"> . was deleted successfully."
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",2,"deleteSpecificFile",strMsg)
         Call UpdateResultHtml("deleteSpecificFile","deleteFolder",strMsg,"DONE","")
	
	'if folder does not exist with the name specified -> throw error
	Else
'		ReportLog "FAILED","deleteFolder","File : <"&strFilePath&"> . was not found. Unable to delete"
				strMsg = "File : <"&strFilePath&"> . was not found. Unable to delete"
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",1,"deleteSpecificFile",strMsg)
         Call UpdateResultHtml("deleteSpecificFile","deleteFolder",strMsg,"FAIL","")
	End If
	
End Function


Public Function deleteFolder (targetDirectoryPath)
	Dim objFSO,objFolder
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
	
	'check if folder already exists -> delete it.
	If objFSO.FolderExists(targetDirectoryPath) Then
		objFSO.DeleteFolder targetDirectoryPath
'		ReportLog "INFO","deleteFolder","Folder: <"&targetDirectoryPath&"> . was deleted successfully."
		strMsg = "Folder: <"&targetDirectoryPath&"> . was deleted successfully."
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",2,"deleteFolder",strMsg)
         Call UpdateResultHtml("deleteFolder","deleteFolder",strMsg,"DONE","")
	
	'if folder does not exist with the name specified -> throw error
	Else
'		ReportLog "FAILED","deleteFolder","Folder : <"&targetDirectoryPath&"> . was not found. Unable to delete"
			strMsg = "Folder : <"&targetDirectoryPath&"> . was not found. Unable to delete"
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",1,"deleteFolder",strMsg)
         Call UpdateResultHtml("deleteFolder","deleteFolder",strMsg,"FAIL","")
	End If
	
End Function


Public Function ReplaceTxtFromFile(file_path_and_name,text_to_find,replace_text)
	Dim fso,old_content,existing_file
	

	Set fso = CreateObject("Scripting.FileSystemObject")
	
	On Error Resume Next
	
	'Open existing_file  object for reading
	Set existing_file = fso.OpenTextFile(file_path_and_name,1,false)
	
	If Err Then
'		ReportLog "ERROR","ReplaceTxtFromFile","Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
        strMsg = "Replace failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
        Err.Clear
        On Error Goto 0
        Exit Function
	End If
	
	
	'Check if the file path and name are correct
	If Not existing_file is Nothing Then
	
			'Store file content in old_content
			old_content = existing_file.readAll
	
			'Close file after storing content in old_content
			existing_file.close
	
			'Check if text is in file
			If InStr(old_content,text_to_find) >0 then ''usually previous project
	
				'Replace in file the searched object
				newContent = Replace(old_content,text_to_find,replace_text,1,-1,1)

			Else
			
'				ReportLog "FAILED", "ReplaceTxtFromFile","The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
			strMsg = "The text "&text_to_find &" was not found, please check the file: "&file_path_and_name
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
			Exit  Function
			
			End if

			'Open file for writing 
			Set objFile=fso.OpenTextFile(file_path_and_name,2,false)
	
			'Write/replace new content
			objFile.Write newContent
			objFile.Close
'	
'	 ReportLog "PASSED", "ReplaceTxtFromFile","The existing text: "&text_to_find &" was successfully replaced with " &replace_text& " in file: "&file_path_and_name
			strMsg = "The existing text: '"&text_to_find &"' was successfully replaced with '" &replace_text& "' in file: '"&file_path_and_name&"'"
		 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then		
		If strMsg <> "<SKIPSTEP>" Then ' used to skip final status function(used as navigator function for uncaptured actions) step description in training document
			Call StoreSteps(strMsg)
			Call InsertImage_MultipleSteps("")
        	Call InsertStepsDoc_MultipleSteps()
	        oDicSteps.RemoveAll	
End If	
End If
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",2,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"DONE","")
	Else
'	 ReportLog "FAILED", "ReplaceTxtFromFile","The file "&file_path_and_name&" could not be found" 
	 			strMsg = "The file "&file_path_and_name&" could not be found"
		 Call ReporterFunction(strLibraryFileName,"ReplaceTxtFromFile",1,"ReplaceTxtFromFile",strMsg)
         Call UpdateResultHtml("ReplaceTxtFromFile","ReplaceTxtFromFile",strMsg,"FAIL","")
	End If
	

End Function

''**********************************************************************************
'Name of the Function   :  VerifyGridCellContentIfExist
'Author		     : 
'Description		     : Verifies the contents of cell of a Gui Grid If it is  present in a normal window .
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function  VerifyGridCellContent(gridRowNumber,gridColumnName,gridTitle,expectedValue)
'***********************************************************************************
Public Function VerifyGridCellContentIfExist(gridTitle,gridRowNumber,gridColumnName,gridIndex,expectedValue)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyGridCellContentIfExist"
	strStepName = " Verify  Content " & "'" & expectedValue & "'"  & " in GuiGrid"

If gridRowNumber<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
						 strCellValueFetched = objGuiGrid.GetCellData(gridRowNumber,gridColumnName)
						 
						 		
						
						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
                              End If
                              
                            
           	
							
						 Else
							  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
							  strMsg =  " Actual value in the Grid cell  :  "  & strCellValueFetched &   "  does not match with the expected value:    "   &  expectedValue & ""
							  
							  End If
							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						 End If
							 
'			Else 	   Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Gui Grid","Gui Grid Object Missing")
'					   strStatus = "FAIL"
'					   strMsg = " Gui Grid Object Missing"
'					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContentIfExist-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyGridCellContentIfExist-- Function Call"
End If

If strStatus = "FAIL"  Then
		VerifyGridCellContentIfExist = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
ElseIf strStatus = "" Then 
	VerifyGridCellContentIfExist = False
	Else 
	VerifyGridCellContentIfExist = True
	
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   VerifyGridCellContentIfExist
'************************************************************************************


''**********************************************************************************
'Name of the Function   :  VerifyTextBoxEnabled
'Description		     : Verifies the if Textbox is enabled in a normal window .
'                                                                    textboxName:- name property of the text box 
'			                           textboxAttachedText :- attachedtext property of the textbox
'			                      textboxIndex :- ordinal identifier(index) of the textbox    
'                                      expectedValue :- Value to be checked    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Input Parameters	     :  textboxName,textboxAttachedText,textboxIndex,expectedValue
'Output Parameters        : Null
'***********************************************************************************
'Function VerifyTextBoxContent(textboxName,textboxAttachedText,textboxIndex,expectedValue)
'***********************************************************************************
Public Function VerifyTextBoxEnabled(textboxAttachedText,textboxName,textboxIndex,blnIsItPopup)

  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextBoxEnabled"
	
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = " Verify TextBox is enabled"
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If textboxName<> "" OR textboxAttachedText<>"" OR textboxIndex<>"" Then
		 If objTextbox.Exist then
					  If VerifyObjectStatus(objTextbox)=True Then
'					  If expectedValue=UCASE(textboxValue) or expectedValue=LCASE(textboxValue) or INSTR(1,textboxValue,expectedValue,1)<>null  Then
'						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxEnabled","2","TextBox","Text Box is enabled")
						  strStatus = "DONE"
						  strMsg = "Text Box: " &textboxAttachedText & " is enabled. "
						    blnCaptureFlag = True
'			              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'		            	  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
'		            	  End If
						VerifyTextBoxEnabled = true
						 
					  Else
'						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxEnabled","1","TextBox","Supplied Value :-"&expectedValue &"  "& vbNewLine&"     didnot Match  with Contents of Text Box" )
						  strStatus = "DONE"
						  strMsg = "Text Box: " &textboxAttachedText & " is not enabled. "
			              VerifyTextBoxEnabled= False
					 End If
		 else 
			   'strStepName = "TextBox: " &textboxAttachedText& "  -No Such Object Found"
			   Call ReporterFunction(strLibraryFileName,"VerifyTextBoxEnabled","1","Text Box","Text Box Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Text Box Object Missing"
			   blnObjectError=True
		 End If
 else
    	Call ReporterFunction(strLibraryFileName,"VerifyTextBoxEnabled","1","TextBox","Function Parameter Not Passed Properly. Check the --VerifyTextBoxEnabled-- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --VerifyTextBoxEnabled-- Function Call"
 End If
 	
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyTextBoxEnabled = strMsg
		blnMainFailFlag = True
	    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	Else
		VerifyTextBoxEnabled = VerifyTextBoxEnabled
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
Set objWindow=Nothing
End If
End function
'************************************************************************************
'End Function -  VerifyTextBoxEnabled
'************************************************************************************


''***********************************************************************************'***********************************************************************************
'Name of the Function -> StartExecution
'Author				  -> Sai Satvik
'Date				  -> 21/10/2015
'Description  	   	  -> Entry point of execution for any test case, all types of initializations will take place here.
'Input Parameters	  -> Input excel path, excel sheet name to fetch the data, row number of excel,result folder path
'Output Parameters    -> None
'update comments: strResultFolderPath to retrieve customise result folder path in runtime
'***********************************************************************************'***********************************************************************************

Public Function StartExecution1(excelPath,strTestCaseName,iterationIndex,strResultFolderPath)

Call RefreshExcelSheet(excelPath)

Set objShell = CreateObject("WScript.Shell")
Environment.Value("blnFatalError") = objShell.Environment("USER").Item("blnFatalError")
If Not Environment.Value("blnFatalError") Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Intiating automation execution"  End if
	Dim xmlDoc
	If gstrTestCaseName = "" Then
    	gstrTestCaseName  = strTestCaseName
    End If
    giHTMLRowNumber = 1
    giTestCaseNumber = giTestCaseNumber + 1
	Set objXml = CreateObject("Microsoft.XMLDOM")
	rootNodeName = "execution-summary"
	If gblnScenarioMode Then
	    objXml.load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	    'excelPath = get scenarioDataExcelPath from XML 
	    Set objReport = objXml.SelectSingleNode("//Summary-Report")
	    Set objExcelScenarioPath = objReport.SelectSingleNode("ScenarioDataExcelPathandName")
	    excelPath = objExcelScenarioPath.Text
	    If excelPath = "" Then
	        Msgbox "Please provide DataFolderPath in Settings tab of TASE UI"
			Environment("blnFatalError") = True
			Exit Function
	    End If
		If Not objFso.FileExists(excelPath) Then
	        Msgbox "Please provide valid DataFolderPath in Settings tab of TASE UI-failed to fetch scenario excel sheet"
			Environment("blnFatalError") = True
			Exit Function
	    End If
	    Set objCurrentIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
	    Set objExcelRow = objCurrentIteration.SelectSingleNode("excelRowNumber")
	    iterationIndex = objExcelRow.Text
	    'Create Testcase tag with id of test case name
	    Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Summary-Report")
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Detailed-Report")
        'Create default tags like status, executiontime
        Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Status","","Summary-Report")
		Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"ExecutionTime","","Summary-Report")
        Set objExcelRow = Nothing
        Set objReport = Nothing
	    Set objCurrentIteration = Nothing
	    Set objExcelScenarioPath = Nothing
	    Set objXml = Nothing
	Else
		Environment.Value("blnFatalError") = False
		Set xmlDoc = CreateObject("Microsoft.XMLDOM")
       	xmlDoc.Load(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
'		Set resultFolderPath = xmlDoc.SelectSingleNode("//ResultFolderPath")
'		If resultFolderPath.Text <> "" Then
'			gstrMainResultFolder = resultFolderPath.Text
		
		'set report folder path in runtime
		If strResultFolderPath <> "" Then
		gstrMainResultFolder = strResultFolderPath
		'msgbox resultFolderPath
		Else
			Msgbox "Please provide resultFolderPath in Test Parameter"
			Environment("blnFatalError") = True
			Exit Function
		End If
		Set dataFolderPath = xmlDoc.SelectSingleNode("//DataFolderPath")
		dataPath = dataFolderPath.Text
		Set trainingDoCFlag = xmlDoc.SelectSingleNode("//Creation")
		'msgbox trainingDoCFlag.Text
		If trainingDoCFlag.Text = "Yes" Then
			blnCreateTrainingDoc=True
			Set trainingDoCFormat = xmlDoc.SelectSingleNode("//Format")
			If instr(trainingDoCFormat.Text,"WORD")>0 Then
				blnCreateWordTrainingDoc=True
			else
				blnCreateWordTrainingDoc=False
			End If
			If instr(trainingDoCFormat.Text,"PDF")>0 Then
				blnCreatePDFTrainingDoc=True
			Else
				blnCreatePDFTrainingDoc=False
			End If
		End If
		Set reportFormat = xmlDoc.SelectSingleNode("//ReportFormat")
		'msgbox reportFormat.text
		If instr(reportFormat.Text,"WORD")>0 Then
				gblnCreateDetailedAndSummaryReportDoc=True
			else
				gblnCreateDetailedAndSummaryReportDoc=False
			End If
			If instr(reportFormat.Text,"PDF")>0 Then
				gblnCreatePDFDetailedAndSummaryReportDoc=True
			Else
				gblnCreatePDFDetailedAndSummaryReportDoc=False
			End If
	
		xmlDoc.Save(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
		Set xmlDoc = Nothing
		'if Xml present delete it and create new in installation folder
       	'add xml header for created XML
       	If objFso.FileExists(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName) Then
    		objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
		End If
		Set objRoot = objXml.CreateElement("execution-summary")
		objXml.appendChild objRoot
		rootNodeName = objRoot.nodeName
		'Create tags scenarioDataExcelPath, ResultFolderPath, TotalNumberOfIterations to store input excel path, result folder path and scenarioTotalIterations
		If dataPath <> "" Then
			scenarioDataExcelName = objFso.GetFileName(excelPath)
			dataPath = dataPath & "\" & scenarioDataExcelName
		Else
			'Msgbox "Please provide dataFolderPath in Settings tab of TASE UI"	
			'Environment("blnFatalError") = True
			'Exit Function
		End If
		Set objIntro = objXml.createProcessingInstruction("xml","version='1.0'")  
		objXml.insertBefore objIntro,objXml.childNodes(0)
		objXml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
		Set objXml = Nothing
		If objFso.FileExists(dataPath) and dataPath <> "" Then
    		excelPath = datapath
		ElseIf gblnDownloadInputExcelFromQC Then
        	strExcelPath = DataSheetAutoDownload(dataPath)
            If strExcelPath <> "ERROR" Then  
            	excelPath = strExcelPath
            End If            
		End If
		Call CreateTagInSummaryXML(rootNodeName,"","Summary-Report","","Summary-Report")    		
		Call CreateTagInSummaryXML(rootNodeName,"","Detailed-Report","","Detailed-Report")
		'Create tags scenarioDataExcelPath, ResultFolderPath, TotalNumberOfIterations to store input excel path, result folder path and scenarioTotalIterations in summary-Report
		Call CreateTagInSummaryXML("Summary-Report","","ScenarioDataExcelPathandName",excelPath,"Summary-Report")    		
		Call CreateTagInSummaryXML("Summary-Report","","TotalNumberofIterations",scenarioTotalIterations,"Summary-Report")
		Call CreateTagInSummaryXML("Summary-Report","","ResultFolderPath",gstrMainResultFolder,"Summary-Report")
		'need to create the iteration tag with id = 1 in both Summary and Detailed Report tags
		Call CreateIterationTaginXML("Summary-Report",1,iterationIndex,"Summary-Report")
		Call CreateIterationTaginXML("Detailed-Report",1,iterationIndex,"Detailed-Report")
		'Create Testcase tag with id of test case name
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Summary-Report")
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Detailed-Report")
        'Create default tags like status, executiontime
        Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Status","","Summary-Report")
		Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"ExecutionTime","","Summary-Report")
		Set objIntro = Nothing
		Set objRoot = Nothing
	End If
	blnSkipSteps= False
	Call GetInputFromExcel(excelPath,strTestCaseName,iterationIndex)
	InputFilePath =excelPath
	Call GetInputFromExcel(excelPath,"COMMON",2)
	If giCurrentIteration = 1 Then
		Call CreateTagInSummaryXML("Summary-Report","","ScenarioName",ScenarioName,"Summary-Report")    				   			
	End If
	If gblnScenarioMode Then
		Call CreateResultFolder(ScenarioName)
	Else
		Call CreateResultFolder(gstrTestCaseName)	
	End If
	If blnSetReporterFlag and blnSetLogFileFlag Then
		Call CreateLogFile()
	End If						
	errorCount=1  
	Reporter.Filter = rfDisableAll 
	giTestCaseStartTime=Timer()	

	If gstrGeneralTestCase = "" Then
		Call Html_iteration(gstrTestCaseName)
	else
		Call Html_iteration(gstrGeneralTestCase)
	End if 

	If blnCreateTrainingDoc = True Then
		Call CreateTrainingDoc(strTestCaseName)
	End if
	giLastUpdatedTime = Timer()
End If
Set objShell= Nothing

'SAPGuiUtil.CloseConnections '---- Closing any open SAp window before execution
End Function



'**********************************************************************************
'Name of the Function    :  LoginNRT
'Description		              : Login to NRT Application
'Input Parameters	     :  creationTime,UserName,Password,Domain,Site
'Output Parameters        :Null
'Created by: Jaya
'***********************************************************************************
'Function LoginNRT(creationTime,UserName,Password,Domain,Site)
'***********************************************************************************

Public Function LoginArgos(creationTime,UserName,Password,Domain,Site)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LoginArgos"
		PopUpCreationtime=Cint(creationTime)
	Dim objButton
	strStepName = "Enter User Name : "&UserName&" and Password : ******** and Domain: "&Domain&", Site: "&Site&""
	strInputValue= UserName&" ********"
	Set obj=Browser("creationtime:="&creationTime).Page("creationtime:="&creationTime)
	 If  obj.Exist  then 
	 	If UserName<>"" and Password <> "" and Domain <> ""  and Site <> "" Then
	 		Set objUser=obj.WebEdit("html id:=loginUserName")
			objUser.Set UserName
		  	obj.WebEdit("html id:=loginPassword").Set Password
		  	obj.WebList("html id:=domain").Select Domain
			obj.WebEdit("html id:=","type:=text").Set Site
			Wait 5
			obj.WebButton("html id:=DOMButton_loginButton").ClicK
			wait(5)
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Login to Argos application successfull"
			Call ReporterFunction(strLibraryFileName,"LoginArgos","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Argos application Login Page Not Found"
			Call ReporterFunction(strLibraryFileName,"LoginArgos","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -LoginArgos-- Function Call"
		Call ReporterFunction(strLibraryFileName,"LoginArgos","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		LoginArgos = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
	Else
		LoginArgos = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set obj=Nothing
End If
End function






Public Function LogoffArgos(creationTime)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LogoffArgos"
		PopUpCreationtime=Cint(creationTime)
	Dim objButton
	strStepName = "Log Off from Argos Application"
	strInputValue= ""
	Set obj=Browser("creationtime:="&creationTime).Page("creationtime:="&creationTime)
	 If  obj.Exist  then
		If  obj.WebButton("html tag:=BUTTON","html id:=logoutButton","title:=Log off\.\.\.").Exist Then
	 		 obj.WebButton("html tag:=BUTTON","html id:=logoutButton","title:=Log off\.\.\.").Click
             Wait(5)
            obj.WebButton("html tag:=BUTTON","html id:=validatePopup","name:=Yes").Click
             Wait(3)
         
			 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
			 End if
			strStatus = "DONE"
			strMsg= "Log Off from Argos application successfull"
			Call ReporterFunction(strLibraryFileName,"LogoffArgos","2",strStepName,strMsg)
			
			
	    else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Argos application Log Off button Not Found"
			Call ReporterFunction(strLibraryFileName,"LogoffArgos","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -LogoffArgos-- Function Call"
		Call ReporterFunction(strLibraryFileName,"LogoffArgos","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		LogoffArgos = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,obj,True,True,True)
	Else
		LogoffArgos = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set obj=Nothing
End If
End function 


'******************************************************************************************************
'Name of the Function   : StartDateof445PeriodByDate
'Description		     :Calculates the starting date of the 445 period for the given input date based on the 445 calendar
'Input Parameters	     :  stDate - Input date for which the starting date has to be found
'			           		dataTableColumnName- Column name of the data sheet where row number will be stored
'											
'Output Parameters        : Starting date of the 445 period for the input date
'******************************************************************************************************
'Function StartDateof445PeriodByDate(stDate,dataTableColumnName)
'*****************************************************************************************************



Public Function StartDateof445PeriodByDate(stDate,dataTableColumnName)
''On Error resume next
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : StartDateof445PeriodByDate"

If stDate<>"" Then
Dim stdate2,strMonth
	
	strMonth=Cstr(MONTH(stDate))
	strYear=Cstr(YEAR(stDate))
	tempStrMonth=strMonth
	tempStrYear=strYear
	stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
	If CDate(stDate) <stdate2 Then
		inpMonth=CInt(strMonth)-1
		inpYear=CInt(strYear)
		If inpMonth<1 Then
			inpMonth="12"
			inpYear=Cstr(CInt(strYear)-1)
		Else
			inpMonth=cstr(inpMonth)
			inpYear=Cstr(strYear)
		End If
		tempStrMonth=inpMonth
		tempStrYear=inpYear
		stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
	ElseIf CDate(stDate) > stdate2 Then

		If CInt(strMonth)=12 Then
			strMonth="1"
			strYear=Cstr(Cint(strYear)+1)
		Else
			strMonth=Cstr(strMonth+1)
		End If
		tempStrMonth=strMonth
		tempStrYear=strYear
		tempDate=StartDateOf445Month(strMonth,strYear)
		If  CDate(stDate)>=tempDate Then
			stdate2=tempDate
		End If
		
	End If

	strStartDate = stdate2
	strCapturedText=strStartDate
 	If blnWriteDataToOutputSheet Then
	                                    strStepName = "Calculating the starting date of 445 period for the given date and storing it in '"&gstrOutputSheetName&"' sheet under column '"&dataTableColumnName&"'"
									
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										
							Else
										strStepName = "Calculate the desired starting date for the given input date"
										
							End If 
		strStatus = "DONE"
		Call ReporterFunction(strLibraryFileName,"StartDateof445PeriodByDate","2","Starting Date of 445 Period","Starting Date of 445 period for given date is stored in datasheet")
        strMsg= "Starting Date of 445 period for given date is stored in datasheet"
else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"StartDateof445PeriodByDate","1","Starting Date of 445 Period","Function Parameter Not Passed Properly. Check the --StartDateof445PeriodByDate-- Function Call")
        strMsg= "Function Parameter  Not Passed Properly. Check the --StartDateof445PeriodByDate-- Function Call"
End If				
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strStartDate)
	   End If

End if

Set stDate=Nothing
Set dataTableColumnName=Nothing
Set stdate2=Nothing
Set inpMonth=Nothing
Set inpYear=Nothing
Set strMonth=Nothing
Set strYear=Nothing
Set strStartDate=Nothing
Set tempStrMonth=Nothing
Set tempStrYear=Nothing
End Function

'******************************************************************************************************
'Name of the Function   : EndDateof445PeriodByDate
'Description		     :Calculates the ending date of the 445 period for the given input date based on the 445 calendar
'Input Parameters	     :  stDate - Input date for which the ending date has to be found
'			           		dataTableColumnName- Column name of the data sheet where row number will be stored
'											
'Output Parameters        : Ending date of the 445 period for the input date
'******************************************************************************************************
'Function EndDateof445PeriodByDate(stDate,dataTableColumnName)
'*****************************************************************************************************
Function EndDateof445PeriodByDate(stDate,dataTableColumnName)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : EndDateof445PeriodByDate"

If stDate<>"" Then
	Dim stdate2,inpMonth,inpYear
	
	strMonth=Cstr(MONTH(stDate))
	strYear=Cstr(YEAR(stDate))
	inpMonth=CInt(strMonth)
	inpYear=CInt(strYear)
	tempStrMonth=strMonth
	tempStrYear=strYear
	stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
	If CDate(stDate) >stdate2 Then
		inpMonth=CInt(strMonth)+1
		inpYear=CInt(strYear)
		If inpMonth>12 Then
			inpMonth="1"
			inpYear=Cstr(CInt(strYear)+1)
		Else
			inpMonth=cstr(inpMonth)
			inpYear=Cstr(strYear)
		End If
		tempStrMonth=inpMonth
		tempStrYear=inpYear
		stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
	
	End If
	If CDate(stDate) >= stdate2 Then
		inpMonth=Cstr(CInt(inpMonth)+1)
		inpYear=Cstr(CInt(inpYear))
		If inpMonth>12 Then
			inpMonth="1"
			inpYear=Cstr(CInt(strYear)+1)
		Else
			inpMonth=cstr(inpMonth)
			inpYear=Cstr(strYear)
		End If
		tempStrMonth=inpMonth
		tempStrYear=inpYear
		stdate2=StartDateOf445Month(inpMonth,inpYear)
	End If
	reqDate=DateAdd("d",-1,stdate2)
	''EndDateof445PeriodForGivenDate=reqDate
	strStartDate = reqDate
	strCapturedText=strStartDate
 	If blnWriteDataToOutputSheet Then
	                                    strStepName = "Calculating the ending date of 445 period for the given date and storing it in '"&gstrOutputSheetName&"' sheet under column '"&dataTableColumnName&"'"
									
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										
							Else
										strStepName = "Calculate the desired ending date for the given input date"
										
							End If 
		strStatus = "DONE"
		Call ReporterFunction(strLibraryFileName,"EndDateof445PeriodByDate","2","Ending Date of 445 Period","Ending Date of 445 period for given date is stored in datasheet")
        strMsg= "Ending Date of 445 period for given date is stored in datasheet"
else
        strStatus="FAIL"
        Call ReporterFunction(strLibraryFileName,"EndDateof445PeriodByDate","1","Ending Date of 445 Period","Function Parameter Not Passed Properly. Check the --EndDateof445PeriodByDate-- Function Call")
        strMsg= "Function Parameter  Not Passed Properly. Check the --EndDateof445PeriodByDate-- Function Call"
End If				
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strStartDate)
	   End If

End If
Set stDate=Nothing
Set dataTableColumnName=Nothing
Set stdate2=Nothing
Set inpMonth=Nothing
Set inpYear=Nothing
Set strMonth=Nothing
Set strYear=Nothing
Set reqDate=Nothing
Set strStartDate=Nothing
Set tempStrMonth=Nothing
Set tempStrYear=Nothing
End Function

'******************************************************************************************************
'Name of the Function   : Find445CurrentPeriod
'Description		     :Calculates the current 445 period for the given input month and year based on the 445 calendar
'Input Parameters	     :  stDate - Input month for which the period has to be found
'			           		dataTableColumnName- column name to store the output period
'											
'Output Parameters        : Current 445 period for the input date
'******************************************************************************************************
'Function StartDateOf445Month(requiredMonth,requiredYear)
'*****************************************************************************************************

Public Function Find445CurrentPeriod(stDate,dataTableColumnName)
	''On Error resume next
	If Not (Environment.Value("blnFatalError")) Then
		   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Find445CurrentPeriod"
	
	If stDate<>"" Then
	Dim stdate2,strMonth
		
		strMonth=Cstr(MONTH(stDate))
		strYear=Cstr(YEAR(stDate))
		tempStrMonth=strMonth
		tempStrYear=strYear
		currentMonth=tempStrMonth
		stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
		If CDate(stDate) <stdate2 Then
			inpMonth=CInt(strMonth)-1
			inpYear=CInt(strYear)
			If inpMonth<1 Then
				inpMonth="12"
				inpYear=Cstr(CInt(strYear)-1)
			Else
				inpMonth=cstr(inpMonth)
				inpYear=Cstr(strYear)
			End If
			tempStrMonth=inpMonth
			tempStrYear=inpYear
			currentMonth=tempStrMonth
			stdate2=StartDateOf445Month(tempStrMonth,tempStrYear)
		ElseIf CDate(stDate) > stdate2 Then
	
			If CInt(strMonth)=12 Then
				strMonth="1"
				strYear=Cstr(Cint(strYear)+1)
			Else
				strMonth=Cstr(strMonth+1)
			End If
			tempStrMonth=strMonth
			tempStrYear=strYear
			
			tempDate=StartDateOf445Month(strMonth,strYear)
			If  CDate(stDate)>=tempDate Then
				currentMonth=tempStrMonth
				stdate2=tempDate
			End If
			
		End If
	
		strStartDate = stdate2
		strCapturedText=Cstr(currentMonth)
	 	If blnWriteDataToOutputSheet Then
		                                    strStepName = "Calculating the current 445 period for the given date and storing it in '"&gstrOutputSheetName&"' sheet under column '"&dataTableColumnName&"'"
										
											call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
											
								Else
											strStepName = "Calculate the desired period for the given input date"
											
								End If 
			strStatus = "DONE"
			Call ReporterFunction(strLibraryFileName,"Find445CurrentPeriod","2","Current 445 Period","Current 445 period for given date is stored in datasheet")
	        strMsg= "Current 445 period for given date is stored in datasheet"
	else
	        strStatus="FAIL"
	        Call ReporterFunction(strLibraryFileName,"Find445CurrentPeriod","1","Current 445 Period","Function Parameter Not Passed Properly. Check the --Find445CurrentPeriod-- Function Call")
	        strMsg= "Function Parameter  Not Passed Properly. Check the --Find445CurrentPeriod-- Function Call"
	End If				
		   If blnDefault_eSwiftReporting Then  
			   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
		   End If
	
	End if
	
	Set stDate=Nothing
	Set dataTableColumnName=Nothing
	Set stdate2=Nothing
	Set inpMonth=Nothing
	Set inpYear=Nothing
	Set strMonth=Nothing
	Set strYear=Nothing
	Set strStartDate=Nothing
	Set tempStrMonth=Nothing
	Set tempStrYear=Nothing
	Set currentMonth=Nothing
End Function

'******************************************************************************************************
'Name of the Function   : StartDateOf445Month
'Description		     :Calculates the starting date of the 445 period for the given input month and year based on the 445 calendar
'Input Parameters	     :  requiredMonth - Input month for which the starting date has to be found
'			           		requiredYear- Input year for which the starting date has to be found
'											
'Output Parameters        : Starting date of the 445 period for the input month and year
'******************************************************************************************************
'Function StartDateOf445Month(requiredMonth,requiredYear)
'*****************************************************************************************************

Function StartDateOf445Month(requiredMonth,requiredYear)
Dim YearArr,PeriodArr,sum,temp

YearArr=Array(Array("2022",30,"01/01/2022"),Array("2023",29,"01/01/2023"),Array("2024",28,"01/01/2024"),_
			    Array("2025",28,"30/12/2024"),Array("2026",28,"29/12/2025"),Array("2027",28,"04/01/2027"))

PeriodArr=Array(Array("P2",28),Array("P3",35),Array("P4",28),Array("P5",28),Array("P6",35),_
				Array("P7",28),Array("P8",28),Array("P9",35),Array("P10",28),Array("P11",28))
				
sum=0
 If CInt(requiredMonth)<=9 Then
 	stMonth=right(cstr(requiredMonth),1)
 Else
 stMonth=right(cstr(requiredMonth),2)
 End If
 reqMonth="P"& stMonth
 If  reqMonth <> "P1" Then
 For item =0 to UBound(YearArr)
 
 If YearArr(item)(0)=requiredYear Then
 	sum=sum+YearArr(item)(1)
 	temp=item
 	Exit For
 End If
 
 Next


 	
  For item =0 to UBound(PeriodArr)
 
If  reqMonth=PeriodArr(item)(0) Then
Exit For
Else
sum=sum+PeriodArr(item)(1)
End If

Next
Else
 For item =0 to UBound(YearArr)
 
 If YearArr(item)(0)=requiredYear Then
 	temp=item
 	Exit For
 End If
 
 Next
  End If
 startDate= DateAdd("d",sum,YearArr(temp)(2))
 
StartDateOf445Month= startDate

Set requiredMonth=Nothing
Set requiredYear=Nothing
Set YearArr=Nothing
Set PeriodArr=Nothing
Set sum=Nothing
Set temp=Nothing
Set stMonth=Nothing
Set  reqMonth=Nothing

End Function

Function checkIfFolderOrFileExists1 (strTargetDirectory, strFileName)
	
	Dim objFSO,objFolder
	
	'If target directory is null -> throw an error
	If  IsNull (strTargetDirectory) Then
'		ReportLog "ERROR","checkIfFolderOrFileExists","Folder path can not be null"
		strMsg = "Folder path can not be null" 
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",1,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists",strFileName,strMsg,"FAIL","")
		Exit Function
	End If
	
	' Make sure the path ends with a backslash
	If Right( strTargetDirectory, 1 ) <> "\" Then
		strTargetDirectory = strTargetDirectory & "\"
	End If
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
		
	
	' If file name is null then -> check the folder exists and return true
	If  IsNull(strFileName) or strFileName ="" or strFileName = "%blank%" Then
	
		' if folder exists -> return true
		If objFSO.FileExists(strTargetDirectory) Then
			objFSO.GetFile strTargetDirectory
			'objFSO.GetSpecialFolder strTargetDirectory
			
			checkIfFolderOrFileExists1 = true
			
'			ReportLog "INFO","checkIfFolderOrFileExists","Folder: <"&strTargetDirectory&"> exists at specified location."
					strMsg = "Folder: <"&strTargetDirectory&"> exists at specified location."
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			
		' otherwise (folder does not exists) -> return false
		Else
		
			checkIfFolderOrFileExists1 = false
'			ReportLog "INFO","checkIfFolderOrFileExists","Folder path was not found at the destination: >"&strTargetDirectory&">"
		 strMsg = "Folder path was not found at the destination: >"&strTargetDirectory&">"
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			Exit Function	
		End If
	
	' if the file name is present -> check that file also exists in folder and return true.
	Else
		
		' If file exists -> return true
		If objFSO.FileExists(strTargetDirectory&strFileName) Then
			checkIfFolderOrFileExists1 = true
'			ReportLog "INFO","checkIfFolderOrFileExists","File: <"&strTargetDirectory&strFileName&"> exists at specified location."
			strMsg = "File: <"&strTargetDirectory&strFileName&"> exists at specified location."
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			
		' otherwise (file not found) -> return false
		Else
'			ReportLog "INFO","checkIfFolderOrFileExists","File path was not found at location: <"&strTargetDirectory&strFileName&">"
		 strMsg = "File path was not found at location: <"&strTargetDirectory&strFileName&">"
		 Call ReporterFunction(strLibraryFileName,"checkIfFolderOrFileExists",2,"checkIfFolderOrFileExists",strMsg)
         Call UpdateResultHtml("checkIfFolderOrFileExists","checkIfFolderOrFileExists",strMsg,"DONE","")
			checkIfFolderOrFileExists1 = false
			Exit Function
		End If
	End If
	
End Function

Public Function deleteFolder1 (targetDirectoryPath)
	Dim objFSO,objFolder
	
	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
	
	'check if folder already exists -> delete it.
	If objFSO.FileExists(targetDirectoryPath) Then
		objFSO.DeleteFile targetDirectoryPath
		
'		ReportLog "INFO","deleteFolder","Folder: <"&targetDirectoryPath&"> . was deleted successfully."
		strMsg = "Folder: <"&targetDirectoryPath&"> . was deleted successfully."
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",2,"deleteFolder",strMsg)
         Call UpdateResultHtml("deleteFolder","deleteFolder",strMsg,"DONE","")
	
	'if folder does not exist with the name specified -> throw error
	Else
'		ReportLog "FAILED","deleteFolder","Folder : <"&targetDirectoryPath&"> . was not found. Unable to delete"
			strMsg = "Folder : <"&targetDirectoryPath&"> . was not found. Unable to delete"
		 Call ReporterFunction(strLibraryFileName,"deleteFolder",1,"deleteFolder",strMsg)
         Call UpdateResultHtml("deleteFolder","deleteFolder",strMsg,"FAIL","")
	End If
	
End Function

'**********************************************************************************
'Name of the Function    :  LoginMAWM
'Description		              : Login to Manhattan Active Application
'Input Parameters	     :  creationTime,UserName,Password,Domain,Site
'Output Parameters        :Null
'Created by: Kumar
'***********************************************************************************
'Function LoginNRT(creationTime,UserName,Password,Domain,Site)
'***********************************************************************************

Public Function LoginMAWM(creationTime,UserName,Password)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Login Manhattan Active"
		PopUpCreationtime=Cint(creationTime)
	Dim objButton
	strStepName = "Enter User Name : "&UserName&" and Password : ********"
	strInputValue= UserName&" ********"
	Set obj=Browser("creationtime:="&creationTime).Page("creationtime:="&creationTime)
	 If  obj.Exist  then 
	 	If UserName<>"" and Password <> "" Then
	 		Set objUser=obj.WebEdit("html id:=loginUserName")
			objUser.Set UserName
		  	obj.WebEdit("html id:=loginPassword").Set Password	
			Wait 5
			obj.WebButton("html id:=DOMButton_loginButton").ClicK
			wait(5)
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
			End if
			strStatus = "DONE"
			strMsg= "Login to Manhattan Active application successfull"
			Call ReporterFunction(strLibraryFileName,"Login Manhattan Active","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "Manhattan Active application Login Page Not Found"
			Call ReporterFunction(strLibraryFileName,"Login Manhattan Active","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -Login Manhattan Active-- Function Call"
		Call ReporterFunction(strLibraryFileName,"Login Manhattan Active","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		LoginArgos = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
	Else
		LoginArgos = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set obj=Nothing
End If
End function



