Set objPopupRadioButton=nothing
End if
End Function


Public Function CreateFolderCurrentDateAndTime(gstrCurrentFolderPath)
	CurrentDate_Res = Replace(Date, "/", "")
       CurrentTime_Res = Replace(Time, ":", "")
gstrresultFolderPath = gstrCurrentFolderPath& CurrentDate_Res & "_" & CurrentTime_Res
CreateFolderCurrentDateAndTime = CreateFolder(gstrresultFolderPath)

End Function




Public Function createFolderDateandTimeandUpdateinTextFile (targetDirectoryPath,InputTextFilepath)
	Dim objFSO,objFolder
	
	If  Right(targetDirectoryPath,1) = "\"  then
		targetDirectoryPath = Left(targetDirectoryPath, Len(targetDirectoryPath)-1)
	End If
	
		CurrentDate_Res = Replace(Date, "/", "")
		CurrentTime_Res = Replace(Time, ":", "")
		gstrresultFolderPath = targetDirectoryPath&"_"&CurrentDate_Res & "_"&CurrentTime_Res

	'set file system object 
	Set objFSO = CreateObject("Scripting.FileSystemObject")
	
	'check if folder already exists -> do nothing.
	If objFSO.FolderExists(gstrresultFolderPath) Then
		objFSO.GetFolder gstrresultFolderPath
'		ReportLog "WARNING","createFolderDateandTime","Folder already exists at location: "&gstrresultFolderPath&" .No other action taken."
		strMsg = "Folder already exists at location: "&gstrresultFolderPath&" .No other action taken."
		 Call ReporterFunction(strLibraryFileName,"createFolderDateandTimeandUpdateinTextFile",2,"createFolderDateandTime",strMsg)
'		 MsgBox strMsg
         'Call UpdateResultHtml("createFolderDateandTime","createFolderDateandTime",strMsg,"DONE","")
	
	'if folder does not exist with the name specified -> create new folder
	Else
		objFSO.CreateFolder gstrresultFolderPath
'		ReportLog "PASSED","createFolderDateandTime","Folder successfully created with the following location: "&gstrresultFolderPath
			strMsg = "Folder successfully created with the following location: "&gstrresultFolderPath
		 Call ReporterFunction(strLibraryFileName,"createFolderDateandTimeandUpdateinTextFile",2,"createFolderDateandTime",strMsg)
'		  MsgBox strMsg
         'Call UpdateResultHtml("createFolderDateandTime","createFolderDateandTime",strMsg,"DONE","")
        		Call UpdateTxtFileResultPath(InputTextFilepath, gstrresultFolderPath)
     			Environment.Value("TCExecutionStatus") = "Pass"
     			Environment.Value("HtmlResultReportpath") = gstrresultFolderPath 
        End  if
	
End Function

Function UpdateTxtFileResultPath(FilePath, input_text)
	Dim fso
	Set fso = CreateObject("Scripting.FileSystemObject")

	'Check if object is created
	If fso.FileExists(FilePath) Then
		
'	Set ObjFile = fso.OpenTextFile(FilePath)
		Set ObjFile = fso.OpenTextFile(FilePath,2,False)
		ObjFile.Write input_text 
		ObjFile.close
		''ReportLog "INFO", "Create&WriteTOFile", "File created at " &file_path &" having the name: " &file_name 
		Call ReporterFunction("XML Edit","Create&WriteTOFile","2",FilePath,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "DONE"
 strMsg = "Updated successfully"
'   MsgBox strMsg
'  Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	Else
		Call ReporterFunction("XML Edit","Create&WriteTOFile","2",FilePath,"Value Used :-"& vbNewLine & "Input Text:"&input_text)
   		strStatus = "FAILED"
   strMsg = "Not Updated"
   MsgBox strMsg
'   Call UpdateResultHtml(file_name,input_text,strMsg,strStatus,"")
	End If

End Function


Function ReadTxtFileResult(FilePath)
	
Dim fso,old_content,existing_file
Set fso = CreateObject("Scripting.FileSystemObject")
On Error Resume Next
Set existing_file = fso.OpenTextFile(FilePath,1,false)
If not  existing_file is nothing Then
	old_content = existing_file.ReadAll
	existing_file.Close
		Call ReporterFunction("Text file","Create&WriteTOFile","2",FilePath,"Value Used :-"& vbNewLine & "Input Text:"&old_content)
   		strStatus = "DONE"
  		 strMsg = "Read successfully"
  		 ReadTxtFileResult = old_content
Else
		Call ReporterFunction("Text file","Create&WriteTOFile","2",FilePath,"Value Used :-"& vbNewLine & "Input Text:"&old_content)
   		strStatus = "Failed"
  		 strMsg = "File not available"
  		 msgbox strMsg
End If
End  Function



Public Function MergeWordDocumentSubfolder(DocumentFolderPath,DocumentPathandName)
Dim ObjWord,ObjFileSystemObject,ObjFolder,ObjMergedDoc,ObjSubFolder,Objdoc

Set ObjWord = CreateObject("Word.Application")

ObjWord.Visible = False
StrStepName = "Executing Merging of the word documents in subfolders"

Set ObjFileSystemObject = CreateObject("Scripting.FileSystemObject")
Set ObjMergedDoc = ObjWord.Documents.Add()
ObjMergedDoc.saveas DocumentPathandName
ObjMergedDoc.Close
Set ObjMergedDoc = ObjWord.Documents.Add(DocumentPathandName)
Set ObjFolder = ObjFileSystemObject.GetFolder(DocumentFolderPath)

For each ObjSubFolder in ObjFolder.SubFolders
	For Each objFile In ObjSubFolder.Files
	
		If LCase(ObjFileSystemObject.GetExtensionName(objFile.Name)) = "doc" Or LCase(ObjFileSystemObject.GetExtensionName(objFile.Name)) = "docx" Then
		Set Objdoc = objWord.Documents.Open(objFile.Path)
		Objdoc.Content.WholeStory
		Objdoc.Content.Copy

		 ObjMergedDoc.Activate
            ObjWord.Selection.EndKey 6 ' Go to end of document
            ObjWord.Selection.Paste

		Objdoc.Close False
		
			StrStepName = "Executing Merging of the word documents in subfolders"
			strStatus = "DONE"
			strMsg = "Merging of the documents completed successfully to Document """&DocumentPathandName&""""
			Call ReporterFunction(strLibraryFileName,StrStepName,"2",strMsg,"")
			If blnDefault_eSwiftReporting Then  
				Call UpdateResultHtml(strStepName,objFile.Path,strMsg,strStatus,"")
			End If
		End If
	Next
Next
			
ObjMergedDoc.saveas DocumentPathandName
ObjMergedDoc.Close


ObjWord.Quit
Set ObjWord = Nothing
Set ObjFileSystemObject = Nothing

End  Function

Public Function MergeWordDocumentSubfolder1(DocumentFolderPath,DocumentPathandName)

Dim objWordApp, objDoc, objFSO, objFolder, objSubFolder, objFile

Set objWordApp = CreateObject("Word.Application")
objWordApp.Visible = False
 
Set objFSO = CreateObject("Scripting.FileSystemObject")
 
Set objDoc = objWordApp.Documents.Add(DocumentPathandName)
 
' Loop through each subfolder in the directory
Set objFolder = objFSO.GetFolder(DocumentFolderPath)
For Each objSubFolder In objFolder.SubFolders
    ' Loop through each Word document in the subfolder
    For Each objFile In objSubFolder.Files
        If LCase(objFSO.GetExtensionName(objFile.Name)) = "doc" Or LCase(objFSO.GetExtensionName(objFile.Name)) = "docx" Then
            ' Open the Word document
            Dim tempDoc
            Set tempDoc = objWordApp.Documents.Open(objFile.Path)
            
            ' Select and copy content from the document
            tempDoc.Content.WholeStory
            tempDoc.Content.Copy
            
            ' Switch to the destination document and paste content
           objDoc.Activate
            objWordApp.Selection.EndKey 6 ' Go to end of document
            objWordApp.Selection.Paste
            
            ' Close the temporary document
            tempDoc.Close False
            
            StrStepName = "Executing Merging of the word documents in subfolders"
			strStatus = "DONE"
			strMsg = "Merging of the documents completed successfully to Document """&DocumentPathandName&""""
			Call ReporterFunction(strLibraryFileName,StrStepName,"2",strMsg,"")
			If blnDefault_eSwiftReporting Then  
				Call UpdateResultHtml(strStepName,objFile.Path,strMsg,strStatus,"")
			End If
			
        End If
    Next
Next
 
' Save the final document
objDoc.SaveAs DocumentPathandName
' Close the final document
objDoc.Close True
 
' Quit Word application
objWordApp.Quit
 
' Release objects from memory
Set objDoc = Nothing
Set objWordApp = Nothing
Set objFSO = Nothing
End  Function

'*********************************************MyOrder Application*******************************************************
Public Function LoginMyOrder(creationTime,UserName,Password)

If Not (Environment.Value("blnFatalError") or buttonName = DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LoginMyOrder"
		PopUpCreationtime=Cint(creationTime)
	Dim objButton
	strStepName = "Enter User Name : "&UserName&" and Password : ********"
	strInputValue= UserName&" ********"
	Set obj=Browser("creationtime:="&creationTime).Page("creationtime:="&creationTime)
	 If  obj.Exist  then 
	 	If UserName<>"" and Password <> ""  Then
	 		Set objUser=obj.SAPEdit("name:=j_username")
			objUser.Set UserName
		  	obj.SAPEdit("name:=j_password").Setsecure Password
		  	wait 2
		  	obj.SAPButton("name:=Log On").Click
		  	'obj.SAPEdit("name:=j_password").Submit
			wait(5)
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objUser,True,False,False)
			End if
			strStatus = "DONE"
			strMsg= "Login to MyOrder application successfull"
			Call ReporterFunction(strLibraryFileName,"LoginMyOrder","2",strStepName,strMsg)
		else
			blnObjectError=True
			strStatus = "FAIL"    
			strMsg = "MyOrder application Login Page Not Found"
			Call ReporterFunction(strLibraryFileName,"LoginMyOrder","1",strStepName,strMsg)
		end if
	else
		
		strStatus = "FAIL"
		strMsg = "Function Parameter Not Passed Properly. Check the -LoginMyOrder-- Function Call"
		Call ReporterFunction(strLibraryFileName,"LoginMyOrder","1",strStepName,strMsg)
	end if
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If
	If strStatus = "FAIL"  Then
		LoginMyOrder = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objUser,True,True,True)
	Else
		LoginMyOrder = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
	End If
	' //////////Word Document //////////////////////////////////////////////////////////
	'If blnCreateTrainingDoc Then 
	'	Check=CheckStatus_Doc(strStatus)
	'	If Check=1 Then
	'		Call storeCoordinates(objButton)
	'		Call StoreSteps(strStepName)
	'	End If
	'End If
	   ' //////////Word Document ///////////
	Set obj=Nothing
End If
End function 


Public Function RefreshExcelSheet(excelPath)
Dim StrExcelApp,StrInputExcelFile
On Error Resume Next
Set StrExcelApp = CreateObject("Excel.Application")
Set StrInputExcelFile = StrExcelApp.Workbooks.open(excelPath)
StrExcelApp.visible = False
StrInputExcelFile.RefreshAll
StrExcelApp.wait(10)
StrInputExcelFile.Save 
Wait 10
StrInputExcelFile.Close False
StrExcelApp.Quit
Set StrExcelApp = Nothing
Set StrInputExcelFile = Nothing
End  Function



