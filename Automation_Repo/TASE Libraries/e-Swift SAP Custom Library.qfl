''**********************************************************************************
'Name of the Function   :  VerifyGridCellContentByRefColumn
'Author		     : Ritu
'Description		     : Verifies the contents of cell of a Gui Grid which is present in a normal window .
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 08/05/2012
'***********************************************************************************
'Function  VerifyGridCellContentByRefColumn(gridRowNumber,gridColumnName,gridTitle,expectedValue)
'***********************************************************************************
Public Function VerifyGridCellContentByRefColumn(gridTitle,gridRowNumber,refColumnName,refCellValue,gridColumnName,gridIndex,expectedValue)
  
  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyGridCellContentByRefColumn"
	strStepName = " Verify  Content " & "'" & expectedValue & "'"  & " in GuiGrid"

If gridRowNumber<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
					   If gridRowNumber<> "" Then
					   	gridRowNumber= gridRowNumber
					   	Else 
					   		gridRowNumber = objGuiGrid.FindRowByCellContent(refColumnName,refCellValue)					   		
					   End If
						 strCellValueFetched = objGuiGrid.GetCellData(gridRowNumber,gridColumnName)
						 
						 		
						
						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentByRefColumn","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
                              End If
                              
                            
           	
							
						 Else
							  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentByRefColumn","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
							  strMsg =  " Actual value in the Grid cell  :  "  & strCellValueFetched &   "  does not match with the expected value:    "   &  expectedValue & ""
							  
							  End If
							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentByRefColumn","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
						 End If
							 
			Else 	   Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentByRefColumn","1","Gui Grid","Gui Grid Object Missing")
					   strStatus = "FAIL"
					   strMsg = " Gui Grid Object Missing"
					   blnObjectError=True
					   
			End If
Else
      Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentByRefColumn","1","Cell in Gui Grid","Function Parameter Not Passed Properly. Check the -- VerifyGridCellContentByRefColumn-- Function Call")
	  strStatus="FAIL"
	  strMsg = "Function Parameter Not Passed Properly. Check the - VerifyGridCellContentByRefColumn-- Function Call"
End If

If strStatus = "FAIL"  Then
		VerifyGridCellContentByRefColumn = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,False)
	Else
		VerifyGridCellContentByRefColumn = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objGuiGrid=Nothing
End If

End function

'************************************************************************************
'End Function -   VerifyGridCellContent
'************************************************************************************
'GlobalVariables
node = null
nodes = null
Set GlobalConfig_ObjXML = CreateObject("Microsoft.XMLDOM")

Public Function SetNodeValue(nodeIndent,nodeIndex,nodeName,NewValue)

	'Function call to search for node
	Call FindNode(nodeIndent,nodeIndex,nodeName)
	
	If nodes.length<1 Then
'        ReportLog "FAILED", "Find Node", "XML node cannot be found."
        strMsg="XML node cannot be found."
        Call ReporterFunction(strLibraryFileName,"SetNodeValue",1,"SetNodeValue",strMsg)
         Call UpdateResultHtml("SetNodeValue",NewValue,strMsg,"FAIL","")
		Exit Function
	End If

	Node.Text = NewValue
    
    strMsg= "Node "&nodeName&" on index "&nodeIndex&" updated value to "&NewValue&""
    Call ReporterFunction(strLibraryFileName,"SetNodeValue",2,"SetNodeValue",strMsg)
     Call UpdateResultHtml("SetNodeValue",NewValue,strMsg,"PASS","")
'	ReportLog "Passed", "SetNodeValue", "Node "&nodeName&" on index "&nodeIndex&" updated value to "&NewValue&""

End Function

Public Function LoadXMLFile(XMLPath)

	'Loading the XML file
	GlobalConfig_ObjXML.Load(XMLPath)
	
	If GlobalConfig_ObjXML.ChildNodes.Length<1 Then
'		ReportLog "FAILED", "Load XML File", "XML file at location "&XMLPath&" has 0 child nodes"
		strMsg = "XML file at location "& XMLPath &" has 0 child nodes"
		 Call ReporterFunction(strLibraryFileName,"LoadXMLFile",1,"LoadXMLFile",strMsg)
         Call UpdateResultHtml("LoadXMLFile",XMLPath,strMsg,"FAIL","")
		Exit Function
	End If
'
'	ReportLog "INFO", "Load XML File", "XML file at location "&XMLPath&" loaded"
	  strMsg= "XML file at location "&XMLPath&" loaded"
    Call ReporterFunction(strLibraryFileName,"LoadXMLFile",2,"LoadXMLFile",strMsg)
     Call UpdateResultHtml("LoadXMLFile",NewValue,strMsg,"DONE","")

End Function

Public Function SaveXMLFile(XMLPath)

	'Saving the XML file
	GlobalConfig_ObjXML.Save(XMLPath)

'	ReportLog "INFO", "Save XML File", "XML file saved on  "&XMLPath&""
	  strMsg=  "XML file saved on  "&XMLPath&""
    Call ReporterFunction(strLibraryFileName,"SaveXMLFile",2,"SaveXMLFile",strMsg)
     Call UpdateResultHtml("SaveXMLFile",NewValue,strMsg,"DONE","")

End Function

Public Function FindNode(nodeIndent,nodeIndex,nodeName)

	str = "/"
	
	'Creating XPath string to look for node
	For x = 1 to nodeIndent
		str = str & "/*"
	Next

	'Finding collection of nodes in XML using node name
	Set nodes = GlobalConfig_ObjXML.documentElement.SelectNodes(str & "/" & nodeName)
	
	If nodes.length<1 Then
'        ReportLog "FAILED", "Find Node", "XML node cannot be found."
        strMsg = "XML node cannot be found."
		 Call ReporterFunction(strLibraryFileName,"FindNode",1,"FindNode",strMsg)
         Call UpdateResultHtml("FindNode",XMLPath,strMsg,"FAIL","")
		Exit Function
	End If

	'Identifying node in collection of nodes using index 
	Set node = nodes.item(nodeIndex)
    
End Function



 ''**********************************************************************************
'Name of the Function   : Click204ButtonToolBar
'Description		     : Clicks a specified button on the SAP ToolBar having component type as 204. 
'							This is to be used when a screen has multiple toolbar with different component type.
'Input Parameters	     :  buttonName,toolbarIndex
'Example :                Call ClickButtonToolBar("CREATE_RELATION","3")
'Output Parameters        :Null
'***********************************************************************************
 'Function  ClickButtonToolBar(buttonName,toolbarIndex)
'***********************************************************************************

Function Click204ButtonToolBar(buttonName,toolbarIndex)

     If Not Environment.Value("blnFatalError") Then
					
				
					If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Click204ButtonToolBar"
					strFuncName = "Click204ButtonToolBar"
					Val = "<b>Button Name  :</b>" & buttonName 
					strStepName="Click Button " & "'" &buttonName&"'" &"in Tool bar"
					Set objWindow= SetSAPwindowObj(blnIsItPopup)
							  If buttonName <> ""  Then
'											Set objToolbar202=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiToolbar("guicomponenttype:=202","name:=shel.*","index:="&toolbarIndex)
											Set objToolbar=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiToolbar("guicomponenttype:=204","name:=shel.*","index:="&toolbarIndex)
'											Set objToolbar=SetObj(objToolbar202,objToolbar204)
															If objToolbar.Exist Then
																objToolbar.highlight			
																		   On Error Resume Next
																							  If VerifyObjectStatus(objToolbar) Then
																												Call storeCoordinates(objToolbar)
																												If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
																																ImagePath=CaptureScreenshot(strStepName,objToolbar,True,True,True)
																												End If
'																												msgbox Err.Number
																												If Err.Number =0 Then
																													
																											
																												objToolbar.PressButton buttonName
																												strStatus = "DONE"
																												strMsg = "Button Name "&buttonName&" Pressed "
																												Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)
																												
																							  ElseIf Err.Number = 424 Then
																							  					strStatus = "FAIL"
																												strMsg = "The Button "&buttonName&" in the toolbar  is not Found."
																												blnObjectError=True
																												Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																							  
																							  Else
																												strStatus = "FAIL"
																												strMsg = "Toolbar is Disabled, So Button can't be clicked"
																												blnObjectError=True
																												Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																							  End If
																							  	End If
																Else
																			strStatus = "FAIL"
																			strMsg = " The  toolbar is not Found, Please verify the Screen"
																			blnObjectError=True
																			Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																			
																 End If
								Else
											strStatus = "FAIL"
											strMsg = "Function Parameter Not Passed Properly. Check the --Click204ButtonToolBar-- Function Call"                                         				
											Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)

								End If	
								If  blnObjectError  Then
																		Environment.Value("blnFatalError")=True
																	End If
										
																	If strStatus = "FAIL"  Then
																		Click204ButtonToolBar = strMsg
																		blnMainFailFlag = True
																		ImagePath=CaptureScreenshot(strStepName,objToolbar,True,True,True)
																	Else
																		Click204ButtonToolBar = True
																	End If
										
																	If blnDefault_eSwiftReporting Then  
																			Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")																	
																	End If
																	Set objToolbar=nothing
'																	Set objToolbar204=nothing
'																	Set objToolbar202=nothing
					
     End If
		

End Function
'************************************************************************************
'End Function - Click204ButtonToolBar
'************************************************************************************

'**********************************************************************************
'Name of the Function   : SelectCheckBoxGridByRowNo
'Description		     : Check or Uncheck a checkbox in a grid cell by using row number.This function also enable to use title and index as properties.  
'Input Parameters	     :  gridName - name property of the grid  where data is to be set
'										columnName - Name of the column in which data has to be set
'										refColumnName - Name of the reference column which will be used for calculating row number
'										refCellValue - value within the reference column corrosponding to desired row
'										OnOffStatus - Desired status of checkbox .Pass ON(to Check) or OFF(to uncheck)
'Output Parameters        : Null
'***********************************************************************************
'Function SelectCheckBoxGridByRowNo(gridTitle,columnName,RowNumber,gridIndex,OnOffStatus)
'***********************************************************************************
'Name of the Function   : SelectCheckBoxGridByRowNo
Public Function SelectCheckBoxGridByRowNo(gridTitle,columnName,RowNumber,gridIndex,OnOffStatus)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckBoxGridByRowNo"
   Dim objGrid
	'OnOffStatus=UCase(InputValidation(OnOffStatus))
	strStepName = "Select CheckBox With In The Grid Cell"
	If gridTitle<> "" OR columnName<>"" Or (OnOffStatus="ON"  or OnOffStatus="OFF" )Then
		If OnOffStatus="OFF" Then
			strStepName="Deselect CheckBox With In The Grid Cell"
		End If
		'OnOffStatus=InputValidation(OnOffStatus)
    	Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
		Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
		Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
        If objGrid.Exist Then
			On Error Resume Next
'			strRowNumber = objGrid.FindRowByCellContent(refColumnName,refCellValue)
			strRowNumber=RowNumber
			If Err.Number = 0 Then
				Err.Clear
				On Error Resume Next
				objGrid.SetCheckbox strRowNumber,columnName,OnOffStatus
				If Err.Number=0 Then
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				   ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
			    End if
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRowNo","2","Grid Data Field","Value Used :-" & vbNewLine &" Grid Name:  '"& gridTitle&"'"&vbNewLine&"  Column Field:   '"& columnName & "'"&vbNewLine &"   Row Field:  '"&strRowNumber&"'"& vbNewLine &"    ValueField: '"&OnOffStatus&"'")
					 strStatus = "DONE"
					 strMsg="Checkbox in the grid by taking column as a reference is selected successfully"
				ElseIf Err.Number=-2147220983 Then
					Call ReporterFunction("1","Grid Data Field","Column Not Found. Check the --columnName--Parameter of--SelectCheckBoxGridByRowNo-- Function Call")
					strMsg = "Column Not Found. Check the --columnName--Parameter of --SelectCheckBoxGridByRowNo-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
'				ElseIF Err.Number = 13 Then
'					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRefColumn","1","Grid Data Field","refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
'					strMsg = "refCellValue Not Found Within RefColumn. Check the --refCellValue--Parameter of --SelectCheckBoxGridByRefColumn-- Function Call"
'					strStatus = "FAIL"
'					blnObjectError=True
				ElseIf objGrid.IsCellEditable(strRowNumber,columnName)=False Then
					Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRowNo","1","Grid Data Field"," Grid Cell Not Editable. Check the --SelectCheckBoxGridByRefColumn-- Function Call")
					strMsg = "Grid Cell Not Editable. Check the --SelectCheckBoxGridByRowNo-- Function Call"
					strStatus = "FAIL"
					blnObjectError=True
				End If
'			ElseIf Err.Number=-2147220983 Then
'				Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRowNo","1","Grid Data Field","refColumn Not Found. Check the --refColumnName--Parameter of--SelectCheckBoxGridByRefColumn-- Function Call")
'				strMsg = "refColumn Not Found. Check the --refColumnName--Parameter of --SelectCheckBoxGridByRowNo-- Function Call"
'				strStatus = "FAIL"
'				blnObjectError=True
			End If
		Else
			Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRowNo","1","Grid Data Field","Grid Object Not Found .Please Verify The Screen")
			strMsg = "Grid Not Found- Please Check the Screen"
			strStatus = "FAIL"
			blnObjectError=True
		End If
	Else
		Call ReporterFunction(strLibraryFileName,"SelectCheckBoxGridByRowNo","1","Grid Data Field","Paramaters Not Passed Properly.Check the--SelectCheckBoxGridByRefColumn--Function Call")
		strMsg = "Paramaters Not Passed Properly.Check the--SelectCheckBoxGridByRowNo--Function Call"
		strStatus = "FAIL"
	End If
	If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckBoxGridByRowNo = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    SelectCheckBoxGridByRowNo = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refCellValue&";"&OnOffStatus,strMsg,strStatus,"")
	   End If
	Set objGrid=Nothing
	End If
End Function 
'************************************************************************************
'End Function - SelectCheckBoxGridByRowNo
'************************************************************************************ 

'*********************************************End Of Script*********************************************************************

Public Function GetValueWebElement(creationTime,htmlId,innertext,htmltag,textPosition,Index,excelColumnName)
If Not (Environment.Value("blnFatalError") or excelColumnName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetValueWebElement"
ALMvalue=getEnvironmentVariable("ALMFlag")
If  ALMvalue=1 Then
	PopUpCreationtime=Cint(creationTime) + 1
else
	PopUpCreationtime=Cint(creationTime)
End If
Dim objWebElement
If htmlId<> ""  and innertext<>""Then
strStepName = "Get WebElement Content "
Set objWebElement =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebElement("html id:="& htmlId,"innertext:="&innertext,"html tag:="&htmltag,"index:="&Index)
On error resume next 
 If  objWebElement.Exist  then 
	 objWebElement.highlight
     webElementMsg=objWebElement.GetROProperty("outertext")
     MyArray=Split(webElementMsg," ","-1","1")
	 textPosition=Cint(textPosition)
	 val=MyArray(textPosition)
     last  = Right(val,1)
     If last = "-" Then
	     finallast=instr(1,val,"-",1)
         finalval=left(val,finallast-1)
         val=finalval
     End If
	 
               If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                   ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
               End if
               
               strStatus = "DONE"
               strMsg= "value captured : "& val
               Call ReporterFunction(strLibraryFileName,"GetValueWebElement","2",strStepName,strMsg)
  else
                blnObjectError=True
              
              strStatus = "FAIL"    
              strMsg = "Web Element  object Missing"
              Call ReporterFunction(strLibraryFileName,"GetValueWebElement","1",strStepName,strMsg)
  end if
else
			  
              strStatus = "FAIL"
              strMsg = "Function Parameter Not Passed Properly. Check the --GetValueWebElement -- Function Call"
              Call ReporterFunction(strLibraryFileName,"GetValueWebElement","1",strStepName,strMsg)
     end if
If  blnObjectError  Then
       Environment.Value("blnFatalError")=True
End If

If strStatus = "FAIL"  Then
       GetValueWebElement = strMsg
       blnMainFailFlag = True
       ImagePath=CaptureScreenshot(strStepName,objWebElement,False,False,False)
Else
       GetValueWebElement = True
End If
If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&val&"' value in table '"&gstrOutputSheetName&"' sheet under column "&excelColumnName
										call WriteRunTimeDataToExcel (excelColumnName,val)
								   ELSE
										strStepName = "Retrieve '"&val&"' value in table"
	 End If
If blnDefault_eSwiftReporting Then  
       Call UpdateResultHtml(strStepName,val,strMsg,strStatus,"")
End If

   Set objWebElement=Nothing
   End If
End Function


