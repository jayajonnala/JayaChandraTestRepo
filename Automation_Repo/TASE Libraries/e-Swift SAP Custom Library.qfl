'''**********************************************************************************
'Name of the Function  	   :  ReadTextByLineNumber
'Description		     			: Read text from file based on the input line number
'                                                          
'Input Parameters	    	 :  file_path_and_name,InputLineNumber

'					file_path_and_name:- Text file path and name 
'			       '	InputLineNumber :- The line number from which the content has to be retrieved in the text file
'                                  
'					 
'Output Parameters        : dataTableColumnName-The datasheet column name where the output has to be updated

'************************************************************************************
Public Function ReadTextByLineNumber(file_path_and_name,InputLineNumber,dataTableColumnName)
	Dim fso,old_content,existing_file,line_content
	Set fso = CreateObject("Scripting.FileSystemObject")	
	On Error Resume Next
	
	'Open existing_file  object for reading
	Set existing_file = fso.OpenTextFile(file_path_and_name,1,false)
	
	If Err Then
        strMsg = "Read failed due to error: " & Err.Number & " - " & Err.Source & " - " &  Err.Description
		 Call ReporterFunction(strLibraryFileName,"ReadTextByLineNumber",1,"ReadTextByLineNumber",strMsg)
         Call UpdateResultHtml("ReadTextByLineNumber","ReadTextByLineNumber",strMsg,"FAIL","")
        Err.Clear
        On Error Goto 0
        Exit Function
	End If
	
	'Check if the file path and name are correct
	If Not existing_file is Nothing Then
			'check if file is empty
			If existing_file.Size > 0 Then
			'Read required line content from the file
        		Do Until existing_file.AtEndOfStream
        		linenumber = existing_file.Line
        		If Cstr(linenumber) = InputLineNumber Then
      			line_content = existing_file.ReadLine
				Exit Do
				End If
    			Loop
			'Close file after storing content in old_content
			existing_file.close
	
			strStatus="DONE"
			strMsg = "File Content '"&Left(line_content,15)&"......' of line number "&InputLineNumber&" fetched Into Datatable"
			If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&line_content&"' from the file and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									
										call WriteRunTimeDataToExcel (dataTableColumnName,line_content)
										
							Else
										strStepName = "Retrieve '"&line_content&"' from the file"
										
		End If 
		If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		If strStepName <> "<SKIPSTEP>" Then ' used to skip final status function(used as navigator function for uncaptured actions) step description in training document
			Call StoreSteps(strStepName)
			Call InsertImage_MultipleSteps("")
        	Call InsertStepsDoc_MultipleSteps()
	        oDicSteps.RemoveAll	
End If	
End If
			Call ReporterFunction(strLibraryFileName,"ReadTextByLineNumber",2,"ReadTextByLineNumber",strMsg)	
			''Call UpdateResultHtml("ReadTextByLineNumber","ReadTextByLineNumber",strMsg,strStatus,line_content)	
			Call UpdateResultHtml("ReadTextByLineNumber","ReadTextByLineNumber",strMsg,strStatus,"")			
		Else
			strMsg = "The text file is empty"
			strStatus="FAIL"
			Call ReporterFunction(strLibraryFileName,"ReadTextByLineNumber",1,"ReadTextByLineNumber",strMsg)
			Call UpdateResultHtml("ReadTextByLineNumber","ReadTextByLineNumber",strMsg,strStatus,"")
			Exit Function
		End If
	Else
	 			strMsg = "The file "&file_path_and_name&" could not be found"
	 			strStatus="FAIL"
		 Call ReporterFunction(strLibraryFileName,"ReadTextByLineNumber",1,"ReadTextByLineNumber",strMsg)
         Call UpdateResultHtml("ReadTextByLineNumber","ReadTextByLineNumber",strMsg,"FAIL","")

         Exit Function
	End If

	   
End Function


'''**********************************************************************************
'Name of the Function  	   :  PublishTestResults_PY
'Description		     			: To publish the results of the test cases to zephyr scale in jira.
'                                                          
'Input Parameters	    	 :  TestSetName,TestCaseName,TCExecutionStatus,OpCoName,TargetCycle,HtmlResultReportpath

'					file_path_and_name:- Text file path and name 
'			       '	InputLineNumber :- The line number from which the content has to be retrieved in the text file
'                                  
'					 
'Output Parameters        : dataTableColumnName-The datasheet column name where the output has to be updated

'''**********************************************************************************
Public Function PublishTestResults_PY(TestSetName,TestCaseName,TCExecutionStatus,OpCoName,TargetCycle,HtmlResultReportpath,RunTimeId,Priority)
Set WshShell = CreateObject("WScript.Shell")
pycmd="cmd.exe /c python ""S:\14_Jira_Migration\Python_Integration_files\scripts\Publish_test_results.py"" --arg1 """&TestSetName&""" --arg2 """&TestCaseName&""" --arg3 """&TCExecutionStatus&""" --arg4 """&OpCoName&""" --arg5 """&TargetCycle&""" --arg6 """&HtmlResultReportpath&""" --arg7 """&RunTimeId&""" --arg8 """&Priority&""""
Call WshShell.Run (pycmd,0,False)
wait 75
Call CloseExcelFromTaskManager()
Set WshShell= Nothing
End Function

Public Function CloseExcelFromTaskManager()
Dim objWMI, colProcesses, objProcess, WScript
 
' Connect to Windows Management Instrumentation (WMI)
Set objWMI = GetObject("winmgmts:\\.\root\cimv2")
 
' Check if WMI object is created
If Not objWMI Is Nothing Then
    Set colProcesses = objWMI.ExecQuery("Select * from Win32_Process Where Name='EXCEL.EXE'")
 
    ' Loop through each process and terminate it
    For Each objProcess In colProcesses
        objProcess.Terminate
    Next
End If
 
' Clean up objects
Set objProcess = Nothing
Set colProcesses = Nothing
Set objWMI = Nothing 
End Function

'''**********************************************************************************
'Name of the Function  	   :  StrValueOfPath
'Description		     			: To split the path to get the values.
'                                                          
'Input Parameters	    	 :  TestPath,PartValue

'					file_path_and_name:- Text file path and name 
'			       '	InputLineNumber :- The line number from which the content has to be retrieved in the text file
'                                  
'					 
'Output Parameters        : dataTableColumnName-The datasheet column name where the output has to be updated

'''**********************************************************************************

Public Function StrValueOfPath(TestPath,PartValue,StrSeperator)
	StrParts = split(TestPath,StrSeperator)
	StrValueOfPath = StrParts(PartValue)
End Function

Public Function StrValueOfPathFromEnd(TestPath,PartValue,StrSeperator)
	StrParts = split(TestPath,StrSeperator)
	StrPartsVal = Ubound(StrParts)
	StrValueOfPathFromEnd = StrParts(StrPartsVal - PartValue)
End Function


Public Function StrValueOfLastElement(TestPath,StrSeperator)
	StrParts = split(TestPath,StrSeperator)
	StrValueOfLastElement = StrParts(UBound(StrParts))
End Function

Public Function ReporterEventRunTimeID(ItemValue)
	Reporter.Filter = rfEnableAll
	If ItemValue <> Empty Then
		Reporter.ReportEvent micDone, "Runtime ID is Generated", " The value of RunTimeID is: " & Chr(34) &ItemValue&  Chr(34) & ""
		Else
		Reporter.ReportEvent MicFail , "Runtime ID is not Generated", " The value of RunTimeID is: " & Chr(34) &ItemValue&  Chr(34) & ""
	End If
	
 	Reporter.Filter = rfDisableAll
End Function


Public Function GenerateRunTimeID()
	GenerateRunTimeID = (Left(Environment.Value("TestName"),5)&"_"&Left(Environment.Value("ActionName"),5)&"_"&Replace(Date,"/","")&"_"&Replace(Time,":",""))
End Function

Public Function UpdateTestPath(TC_Path)
Dim xmlDoc
Set xmlDoc = CreateObject("Microsoft.XMLDOM")
       	xmlDoc.Load(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
	Set objEnvironment = xmlDoc.SelectSingleNode("//Fav2") '----- updated for sandbox
		envValue = objEnvironment.Text

	If envValue = "" or envValue = "SHARED" Then
	
		    	TC_Path = "S:\14_Jira_Migration\"&TC_Path
		    	
		    	ElseIf envValue <> "" and envValue = "GIT_SHARED" Then
		    	TC_Path = "S:\14_Jira_Migration\becse-it-sap-releasetestmgmt\"&TC_Path
		    	
		    	ElseIf envValue <> "" and envValue = "GIT"  Then
		    	
		    	TC_Path = "C:\GitHub_Local\becse-it-sap-releasetestmgmt\"&TC_Path
		    	
		    End If
		
		
End Function


Public Function GetStatusBarMessageType(dataTableColumnName)

If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetStatusBarMessageType"
Dim strOuputValue
Set objStatusBar = SAPGuiSession(sessionObject).SAPGuiStatusBar(guiStatusBar)
strOuputValue=Right(dataTableColumnName,(len(dataTableColumnName)-3)) ' omitting the ID_ from the dataTableColumnName so as to mention in the step
strStepName= "Retrieve the '"&strOuputValue&"' value generated in status bar message and store in '"& dataTableColumnName& "'"


		If objStatusBar.Exist Then
			GetStatusBarMessageType = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar).GetROProperty("messagetype")
				If GetStatusBarMessageType<>"" Then				
				strMsg = "Value retrieved from the status bar successfully"
				strCapturedText=GetStatusBarMessageType
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	          End if
				Call ReporterFunction(strLibraryFileName,"GetStatusBarMessageType","2","Status Bar","Item Value:="&GetStatusBarMessageType)
				strStatus = "DONE"
				strStepName = "Retrieve '"&GetStatusBarMessageType&"' value generated in status bar message and store in '"&dataTableColumnName&"'"
				else
				Call ReporterFunction(strLibraryFileName,"GetStatusBarMessageType","1","Status Bar","Function Parameter Not Passed Properly. Check the --guicomponent type number for window and item property of status bar")
				strStatus="FAIL"
				strMsg ="Function Parameter to retrieve the output value is Not Passed Properly. Check the --GetStatusBarMessageType-- Function Call-"
				end if
		else
		Call ReporterFunction(strLibraryFileName,"GetStatusBarMessageType","1","Status Bar","Object Missing")
		strStatus = "Pass"
		strMsg = " The status bar Object is not Found, Please verify the Screen"
		blnObjectError=False
		end if
		If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	    End If

	    If strStatus = "FAIL"  Then
		    GetStatusBarMessageType = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,False,True)
	    Else
		    GetStatusBarMessageType = strMsg
	    End If
	    
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value generated in status bar"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	    
End If
End Function
'**********************************************************************************
Public Function GetNoOfNodeGuiTree(treeIndex)
Dim i,StrNodeText,StrNodeText_First
    
	 If treeIndex <>"" or  itemText<>"" Then
        Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
        If objTree.Exist Then
           'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
           Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
           'First you need to get all values under this tree
           Set AllValues = TreeObj.GetAllNodeKeys
          'Get count
          GetNoOfNodeGuiTree = AllValues.Count
     End If
   End If
Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
 End  Function         
'**********************************************************************************
'Name of the Function   :  GetDynamicPathGuiTree
'Description		     : Get Path Details of the  Dynamic GuiTree
'Input Parameters	     : treeIndex,itemText,itemStartNode,itemPathCount
'				itemStartNode :- Position of the first Item in the Item Path
'				itemPathCount :- Count from first position of the Item to the last Item in the Item Path
'												              
'Output Parameters        :Null
'***********************************************************************************'**********
Public Function GetDynamicPathGuiTree(treeIndex,itemText,itemStartNode,itemPathCount,dataTableColumnName)
Dim i,StrNodeText,StrNodeText_First,iNode
If Not (Environment.Value("blnFatalError")) Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetDynamicPathGuiTree"
	 strStepName="Get the Path of Item during RunTime in Gui Tree"
	 If treeIndex <>"" or  itemText<>"" Then
        Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
        If objTree.Exist Then
           'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
           Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
           'First you need to get all values under this tree
           Set AllValues = TreeObj.GetAllNodeKeys
          'Get count
          Count = AllValues.Count
          If Count < itemPathCount Then
             Call ReporterFunction(strLibraryFileName,"GetDynamicPathGuiTree","1","Item in GuiTree","Gui Tree Missing")
             strStatus = "FAIL"
	     blnObjectError=True
	     strMsg = " The Tree Object is not Found, Please verify the Screen"
         Else 
            StrNodeText =""
            iNode = itemStartNode+itemPathCount
        For i = itemStartNode to itemStartNode+2
               StrNodeText = TreeObj.GetNodeTextByKey(AllValues(i))
               GetDynamicPathGuiTree = GetDynamicPathGuiTree+StrNodeText&";"
         If Count < itemStartNode+ItemTextCount Then
       Exit For	
         End If    
       Next
       StrNodeText_First = TreeObj.GetNodeTextByKey(AllValues(0))
       StrNodeText_Last =  TreeObj.GetNodeTextByKey(AllValues(iNode-1))
       GetDynamicPathGuiTree = StrNodeText_First&";"+GetDynamicPathGuiTree+StrNodeText_Last 
       GetDynamicPathGuiTree= Left(GetDynamicPathGuiTree,Len(GetDynamicPathGuiTree))
End If
Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
End  If
End If
If strStatus = "FAIL"  Then
		    strStepName = "Activate the item in Gui Tree"
		    GetDynamicPathGuiTree = strMsg
		    blnMainFailFlag = True
		    blnObjectError=True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
                  Call UpdateResultHtml(strStepName,Dyamic_Item,strMsg,strStatus,"")
 Else
                 strStatus ="DONE"
                 strMsg="Get the path for Item in the Gui tree  successfully" 
                 strCapturedText=GetDynamicPathGuiTree
                 strStepName = "Retrieve '"&strCapturedText&"' value from the Tree captured as Item Path name and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
	          Call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
	          'ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
                 Call UpdateResultHtml(strStepName,Dyamic_Item,strMsg,strStatus,"")
 End If
 If  blnObjectError  Then
     Environment.Value("blnFatalError")=True
End If
End If
End Function
'*****************************************************************************************************
'End Function - GetDynamicPathGuiTree
'**********************************************************************************
'Name of the Function   :  GetDynamicPathGuiTreeWithFixedNode
'Description		     : Get Path Details of the  Dynamic GuiTree
'Input Parameters	     : treeIndex,itemText,itemStartNode,itemPathCount,FixednodeRange
'				itemStartNode :- Position of the first Item in the Item Path
'				itemPathCount :- Count from first position of the Item to the last Item in the Item Path
'												              
'Output Parameters        :Null
'***********************************************************************************'**********
Public Function GetDynamicPathGuiTreeWithFixedNode(treeIndex,itemText,itemStartNode,iFixedNodeRange,itemPathCount,dataTableColumnName)
Dim i,StrNodeText,StrNodeText_First,iNode
If Not (Environment.Value("blnFatalError")) Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetDynamicPathGuiTreeWithFixedNode"
	 strStepName="Get the Path of Item during RunTime in Gui Tree"
	 If treeIndex <>"" or  itemText<>"" Then
        Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
        If objTree.Exist Then
           'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
           Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
           'First you need to get all values under this tree
           Set AllValues = TreeObj.GetAllNodeKeys
          'Get count
          Count = AllValues.Count
          If Count < itemPathCount Then
             Call ReporterFunction(strLibraryFileName,"GetDynamicPathGuiTree","1","Item in GuiTree","Gui Tree Missing")
             strStatus = "FAIL"
	     blnObjectError=True
	     strMsg = " The Tree Object is not Found, Please verify the Screen"
         Else 
            StrNodeText =""
            iNode = itemStartNode+itemPathCount
        For i = itemStartNode to itemStartNode+1
               StrNodeText = TreeObj.GetNodeTextByKey(AllValues(i))
               GetDynamicPathGuiTreeWithFixedNode = GetDynamicPathGuiTreeWithFixedNode+StrNodeText&";"
         If Count < itemStartNode+ItemTextCount Then
       Exit For	
         End If    
       Next
       For Iterator = 0 to iFixedNodeRange
              strStartNode = TreeObj.GetNodeTextByKey(AllValues(Iterator))
              StrNodeText_First = StrNodeText_First+strStartNode&";"
        Next   
       StrNodeText_Last =  TreeObj.GetNodeTextByKey(AllValues(iNode-1))
       GetDynamicPathGuiTreeWithFixedNode = StrNodeText_First+GetDynamicPathGuiTreeWithFixedNode+StrNodeText_Last 
       GetDynamicPathGuiTreeWithFixedNode= Left(GetDynamicPathGuiTreeWithFixedNode,Len(GetDynamicPathGuiTreeWithFixedNode))
End If
Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
End  If
End If
If strStatus = "FAIL"  Then
		    strStepName = "Activate the item in Gui Tree"
		    GetDynamicPathGuiTreeWithFixedNode = strMsg
		    blnMainFailFlag = True
		    blnObjectError=True
		    ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
                  Call UpdateResultHtml(strStepName,Dyamic_Item,strMsg,strStatus,"")
 Else
                 strStatus ="DONE"
                 strMsg="Get the path for Item in the Gui tree  successfully" 
                 strCapturedText=GetDynamicPathGuiTreeWithFixedNode
                 strStepName = "Retrieve '"&strCapturedText&"' value from the Tree captured as Item Path name and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
	          Call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
	          'ImagePath=CaptureScreenshot(strStepName,objTree,False,False,True)
                 Call UpdateResultHtml(strStepName,Dyamic_Item,strMsg,strStatus,"")
 End If
 If  blnObjectError  Then
     Environment.Value("blnFatalError")=True
End If
End If
End Function
'*****************************************************************************************************
'End Function - GetDynamicPathGuiTreeWithFixedNode
'**********************************************************************************
'Name of the Function   :  GetDynamicItemGuiTree
'Description		     : Get Item Details of the  Dynamic GuiTree
'Input Parameters	     : treeIndex,itemText,itemStartNode,itemPathCount
'				itemStartNode :- Position of the first Item in the Item Path
'				itemPathCount :- Count from first position of the Item to the last Item in the Item Path
'												              
'Output Parameters        :Null
'***********************************************************************************'*****************************************************************************************************************
Public Function GetDynamicItemGuiTree(treeIndex,itemText,itemStartNode,itemPathCount)
If Not (Environment.Value("blnFatalError")) Then
    Dim i,StrNodeText,StrNodeText_First
    If treeIndex <>"" or  itemText<>"" Then
       Set objTree =  SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex)
       If objTree.Exist Then
        'Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:=0").Object
        Set TreeObj = SAPGuiSession(sessionObject).sapguiwindow(windowObject).SAPGuiTree("guicomponenttype:=200","name:=shel.*","index:="&treeIndex).Object
        'First you need to get all values under this tree
        Set AllValues = TreeObj.GetAllNodeKeys
        'Get count
        Count = AllValues.Count    
       If Count < itemPathCount Then
           Call ReporterFunction(strLibraryFileName,"ActivateItemGuiTree","1","Item in GuiTree","Gui Tree Missing")
           strStatus = "FAIL"
	    blnObjectError=True
	    strMsg = " The Tree Object is not Found, Please verify the Screen"
        Else 
         GetDynamicItemGuiTree = TreeObj.GetNodeTextByKey(AllValues((itemStartNode+itemPathCount)-1))
        End If
If  blnObjectError  Then
     Environment.Value("blnFatalError")=True
End If	  
Set  objTree =nothing
Set TreeObj=nothing
Set AllValues =nothing
End  If
End If
End If
End Function
'*****************************************************************************************************
'End Function - GetDynamicNodeTextGuiTree

'Author		     : 
'Description		     : Verifies the contents of cell of a Gui Grid If it is  present in a normal window .
'			                          gridRowNumber :- Row number of Grid from where value is to be checked
'			                          gridColumnName :- Column name of Grid from where value is to be checked
'			                          gridTitle:- Title of the Gui grid         
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function  VerifyGridCellContentIfExist_RunTime(gridRowNumber,gridColumnName,gridTitle,expectedValue)
'***********************************************************************************
Public Function VerifyGridCellContentIfExist_RunTime(gridTitle,gridRowNumber,gridColumnName,gridIndex,expectedValue)

If gridRowNumber<>"" or  gridColumnName <> "" or  gridTitle<>"" or gridIndex <>"" Then
Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80) 

			If objGuiGrid.Exist then
					   On Error Resume Next
						 strCellValueFetched = objGuiGrid.GetCellData(gridRowNumber,gridColumnName)
						 
						 		
						
						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 'Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Grid cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							  blnCaptureFlag = True
						 Else
							  'Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
					         End If
							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyGridCellContent","1","Column in Gui Grid"," column Name : "&gridColumnName&"  does not exist in"& vbNewLine&" Gui Grid with name   "&gridTitle )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given grid"
					                 End If

			End If
End If

If strStatus = "FAIL"  Then
	VerifyGridCellContentIfExist_RunTime = False
		
ElseIf strStatus = "" Then 
	VerifyGridCellContentIfExist_RunTime = False
Else 
	VerifyGridCellContentIfExist_RunTime = True
	
End If

Set objGuiGrid=Nothing


End function


'************************************************************************************
'End Function -   VerifyGridCellContentIfExist_RunTime
'************************************************************************************

''**********************************************************************************
'Name of the Function   :  VerifyTableCellContentIfExist_RunTime
'Author		     : 
'Description		     : Verifies the contents of cell of a Gui Grid If it is  present in a normal window .
'			                          tableRowNumber :- Row number of Table from where value is to be checked
'			                          tableColumnName :- Column name of Table from where value is to be checked
'			                          tableName:- Name of the Table   
'                                     expectedValue:- Value to be checked    
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,expectedValue
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function  VerifyTableCellContentIfExist_RunTime(tableRowNumber,tableColumnName,tableName,expectedValue)
'***********************************************************************************
Public Function VerifyTableCellContentIfExist_RunTime(tableRowNumber,tableColumnName,tableName,expectedValue)

If tableRowNumber<>"" or  tableName <> "" or  tableColumnName<>""  Then
Set objTable= SAPGuisession(sessionObject).sapguiwindow(windowObject).sapguitable(guiTable,"name:="&tableName)
			
			If objTable.Exist then					  

					   On Error Resume Next
						 strCellValueFetched = objTable.GetCellData (tableRowNumber,tableColumnName)
						 						
						If expectedValue=UCASE(strCellValueFetched) or expectedValue=LCASE(strCellValueFetched)  or INSTR(1,strCellValueFetched,expectedValue,1)<>0  Then
							 'Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","2","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of "& vbNewLine&"Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in "& vbNewLine&"Gui Grid with Title"&gridTitle )
							  strStatus = "PASS"
							  strMsg = " Actual value in the Table cell  :   "  & strCellValueFetched & " matches  with the expected value:   "  & expectedValue & ""
							  blnCaptureFlag = True
						 Else
							  'Call ReporterFunction(strLibraryFileName,"VerifyGridCellContentIfExist","1","Cell in Gui Grid","Supplied Value :-"&expectedValue&"  "& vbNewLine&"     did not Match  with Contents of "& vbNewLine&" Cell With row Number:" & gridRowNumber &" column Name :"&gridColumnName&"in"& vbNewLine&" Gui Grid with Title"&gridTitle )
							  strStatus = "FAIL"
							  
					         End If
							  
							  'msgbox Err.Number
							  If Err.Number=-2147220983 or Err.Number = 13 Then
										  Call ReporterFunction(strLibraryFileName,"VerifyTableCellContentIfExist_RunTime","1","Column in Gui Table"," column Name : "&tableColumnName&"  does not exist in"& vbNewLine&" Gui Table with name   "&tableName )
										  strStatus = "FAIL"
										  strMsg =  " Column not found in the given Table"
					                 End If

			End If
End If

If strStatus = "FAIL"  Then
	VerifyTableCellContentIfExist_RunTime = False
		
ElseIf strStatus = "" Then 
	VerifyTableCellContentIfExist_RunTime = False
Else 
	VerifyTableCellContentIfExist_RunTime = True
	
End If

Set objTable=Nothing


End function


'************************************************************************************
'End Function -   VerifyTableCellContentIfExist_RunTime
'************************************************************************************




Public Function ExportUniqueColumnValues(excelFilePath, outputFilePath, columnToRead)
    Dim objExcel, objWorkbook, objSheet, objFSO, objFile
    Dim dict, lastRow, i, cellValue
	
	strFuncName = "ExportUniqueColumnValues"
	strStepName = "Exporting the unique values to  " & "'" & (outputFilePath) & "'" & " File "

    On Error Resume Next

    ' Create Excel and Dictionary objects
    Set objExcel = CreateObject("Excel.Application")
    objExcel.Visible = False
    Set objWorkbook = objExcel.Workbooks.Open(excelFilePath)
    Set objSheet = objWorkbook.Sheets(1)
    Set dict = CreateObject("Scripting.Dictionary")

    ' Find last row in the specified column
    lastRow = objSheet.Cells(objSheet.Rows.Count, columnToRead).End(-4162).Row  ' -4162 = xlUp

    ' Read values and store unique entries
    For i = 2 To lastRow
        cellValue = Trim(CStr(objSheet.Range(columnToRead & i).Value))
        If Len(cellValue) > 0 Then
            If Not dict.Exists(cellValue) Then
                dict.Add cellValue, ""
            End If
        End If
    Next
    
strMsg = "Pass"
strStatus = "DONE"
	strMsg = "Export of the unique values from : "&excelFilePath&" has been :-"& vbNewLine & "Uploaded to :"& (outputFilePath) &" File successfully"
    ' Write unique values to text file
    Set objFSO = CreateObject("Scripting.FileSystemObject")
    Set objFile = objFSO.CreateTextFile(outputFilePath, True)

    For Each cellValue In dict.Keys
        objFile.WriteLine cellValue
    Next
Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)

If  blnObjectError  Then
								Environment.Value("blnFatalError")=True
							End If

							If strStatus = "FAIL"  Then
								ExportUniqueColumnValues = strMsg
								blnMainFailFlag = True
								ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
							Else
								ExportUniqueColumnValues = True
							End If

							If blnDefault_eSwiftReporting Then  
									Call UpdateResultHtml (strStepName,outputFilePath,strMsg,strStatus,"")
							End If
	'Val = "<b>Button Component :</b>" & tooltipOrButtonName
	
    ' Cleanup
    objFile.Close
    objWorkbook.Close False
    objExcel.Quit

    Set objFile = Nothing
    Set objFSO = Nothing
    Set dict = Nothing
    Set objSheet = Nothing
    Set objWorkbook = Nothing
    Set objExcel = Nothing

    ExportUniqueColumnValues = "Export completed successfully to: " & outputFilePath
End Function


