Public Function VerifyWebTableValue(creationTime,tableClass,TableName,columnNumber,rowNumber,expectedVal)
If Not (Environment.Value("blnFatalError") or ExcelColumnName = DS_SKIP) Then
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyWebTableValue"
		strStepName = "Verify  value from the Table:  "&TableName
		ALMvalue=getEnvironmentVariable("ALMFlag")
		If  ALMvalue=1 Then
			PopUpCreationtime=Cint(creationTime) + 1
		else
		PopUpCreationtime=Cint(creationTime)
		End If
		Dim objWebTable
		If tableClass<> ""  or columnNumber <> "" or rowNumber<>""  Then
			'	columnNumber=Cint(columnNumber)
			rowNumber=Cint(rowNumber)
			On error resume next
			Set objWebTable =Browser("CreationTime:="& PopUpCreationtime).Page("Index:="& PopUpCreationtime).WebTable("html tag:=TABLE","class:="&tableClass,"name:="&TableName)
			If  objWebTable.Exist  then 
				objWebTable.highlight
   	 			val=objWebTable.GetCellData(rowNumber,columnNumber)
   	 
   				If UCASE(val) = UCASE(expectedVal) Then
	 				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
						ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,False)
			    	End if
				    strStatus = "DONE"
				    strMsg= "Actual Value of the WebTable : " & val & " is equal to the Expected Value: "&expectedVal
				    Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","2",strStepName,strMsg)
 				Else
 					blnObjectError=True
   					strStatus = "FAIL"    
   					strMsg ="Actual Value of the WebTable : " & val & " is not equal to the Expected Value: "&expectedVal
   					Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","1",strStepName,strMsg)
 				End if
			Else
		
        		strStatus = "FAIL"
        		strMsg ="Function Parameter Not Passed Properly. Check the --VerifyWebTableValue -- Function Call"
        		Call ReporterFunction(strLibraryFileName,"VerifyWebTableValue","1",strStepName,strMsg)
 			End if
 			
			If  blnObjectError  Then
			       Environment.Value("blnFatalError")=True
			End If

			If strStatus = "FAIL"  Then
			       VerifyWebTableValue = strMsg
			       blnMainFailFlag = True
			       ImagePath=CaptureScreenshot(strStepName,objWebTable,False,False,False)
			Else
			       VerifyWebTableValue = True
			End If
			'If blnWriteDataToOutputSheet Then
			'	                                    strStepName = "Retrieve '"&val&"' value in table '"&gstrOutputSheetName&"' sheet under column "&excelColumnName
			'										call WriteRunTimeDataToExcel (excelColumnName,val)
			'								   ELSE
			'										strStepName = "Retrieve '"&val&"' value in table"
			'	 End If
			If blnDefault_eSwiftReporting Then  
			       Call UpdateResultHtml(strStepName,expectedVal,strMsg,strStatus,"")
			End If

   Set objWebTable=Nothing
   End If
 End If 
End Function


'**********************************************************************************
'Name of the Function    :  ClickButtonByIndex
'Description		              : Clicks on buttons like "save","execute","copy","post goods issue","post goods receipt","complete data".
'			                           			tooltipOrButtonName :- either value of tooltip property  or name property  of button
'					 							blnIsItPopup:- A  parameter which  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Input Parameters	     :  tooltipOrButtonName,blnIsItPopup
'Output Parameters        :Null
'***********************************************************************************
'Function ClickButton(tooltipOrButtonName,blnIsItPopup)
'***********************************************************************************
Function ClickButtonByIndex(tooltipOrButtonName,BtnIndex,blnIsItPopup)

If Not Environment.Value("blnFatalError") Then


	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickButtonByIndex"
	strFuncName = "ClickButton"
	'Val = "<b>Button Component :</b>" & tooltipOrButtonName
	strStepName = "Click " & "'" & Replace(tooltipOrButtonName,"\","") & "'" & " Button"
    
    Dim objButton,objWindow
    Set objWindow= SetSAPwindowObj(blnIsItPopup)
				If  tooltipOrButtonName <>"" Then
							
							 If SAPGuiSession(sessionObject).sapguiwindow(objWindow).SAPGuiButton("guicomponenttype:=40","tooltip:="& tooltipOrButtonName,"index:="&BtnIndex).Exist(2) Then
									 Set objButton=SAPGuiSession(sessionObject).sapguiwindow(objWindow).SAPGuiButton("guicomponenttype:=40","tooltip:="& tooltipOrButtonName,"index:="&BtnIndex)
									 blnObjectFound = True
							 ElseIf SAPGuiSession(sessionObject).sapguiwindow(objWindow).SAPGuiButton("guicomponenttype:=40","name:="&tooltipOrButtonName,"index:="&BtnIndex).Exist(2) Then
									 Set objButton=SAPGuiSession(sessionObject).sapguiwindow(objWindow).SAPGuiButton("guicomponenttype:=40","name:="&tooltipOrButtonName,"index:="&BtnIndex)
									 blnObjectFound = True
							 End If				
                                 If  blnObjectFound = True Then
	

											If  objButton.Exist  Then 	
														blnObjectFound = True
														
																	If blnCaptureFlag = True  or  blnCreateImageEachStep = True or blnCreateTrainingDoc Then
																				ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
																	End If	
																	objButton.Click
																	strStatus = "DONE"
																	strMsg = "Button with :-"& vbNewLine & "tooltipOrButtonName:"& Replace(tooltipOrButtonName,"\","") &" has been clicked  successfully"
																	Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)
																	
											Else 
														strStatus = "FAIL"
														strMsg = "The button: "& Replace(tooltipOrButtonName,"\","") & "is not found"
														blnObjectError=True
														Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)

										    End If			
									
						
			   Else 
							blnObjectError=True
							strStatus = "FAIL"
							strMsg = "The button:: "& tooltipOrButtonName & " is not Found--Check the Screen Properly"
							Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
                
			   End If
							

 	Else
				strStatus = "FAIL"
				strMsg = "Function Parameter Not Passed Properly. Check the --ClickButtonByIndex-- Function Call--"
				Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
    End If

							If  blnObjectError  Then
								Environment.Value("blnFatalError")=True
							End If

							If strStatus = "FAIL"  Then
								ClickButtonByIndex = strMsg
								blnMainFailFlag = True
								ImagePath=CaptureScreenshot(strStepName,objButton,True,True,True)
							Else
								ClickButtonByIndex = True
							End If

							If blnDefault_eSwiftReporting Then  
									Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")
							End If

						Set objButton = Nothing
						Set objWindow= Nothing
End If

End Function
'************************************************************************************
'End Function - ClickButtonByIndex
'************************************************************************************


''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : VerifyifGuiLabelExistsByRelativeid
'Author		     :Subhrajyoti
'Description		     : Verifies if Gui Label exists. This can be used when we have multiple label with same contents in the screen.
'Relativeid is the property used to differentiate multiple labels
'Input Parameters	     :  Content to be verfied
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function VerifyifGuiLabelExistsByRelativeid(Content,Relativeid)
'***********************************************************************************

 

Public Function VerifyifGuiLabelExistsByRelativeid(Content,Relativeid)

 

 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyifGuiLabelExists"
    
    strStepName = "Verify if Gui Label exists "

 

    If Content <>"" Then
     set   objLabel = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiLabel("content:="&Content,"guicomponenttype:=30","relativeid:="&Relativeid)
               If objLabel.Exist Then
                    Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExistsByRelativeid","2",Content,"Gui Label with value "&Content &" exists in the screen")    
                    strStatus = "PASS"
                    strMsg = "Gui Label with value "&Content&" exists in the screen"    
                    blnCaptureFlag = True
                              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                                  ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
                              End If
                    
                    Else
                    Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExistsByRelativeid","1"," Label Content","Gui Label with value "&Content &" doesn't exist  in the screen")    
                    strStatus = "FAIL"
                    blndefectFlag =True
                    strMsg = "Gui Label with value "&Content&" doesn't exist  in the screen"
                    blnObjectError=True
                End If
           Else
        Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExistsByRelativeid","1","Gui Label","Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExistsByRelativeid-- Function Call")
            strStatus = "FAIL" 
            strMsg = "Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExistsByRelativeid-- Function Call-"
    End if

 


If strStatus = "FAIL"  Then
        VerifyifGuiLabelExistsByRelativeid = strMsg
        blnMainFailFlag = True
        ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
    
    Else
        VerifyifGuiLabelExistsByRelativeid = True
    End If
    If blnDefault_eSwiftReporting Then  
        Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
    End If

 

End If
End Function

 


''************************************************************************************
'End Function - VerifyifGuiLabelExistsByRelativeid
'************************************************************************************

''**********************************************************************************
'Name of the Function   :  FocusTextBoxWithIndex
'Description             : To Set Focus on a  Text Box .This Function has an additional property of index added. 
                            'Earlier function is not able to handle multiple similar textboxes                  
'Input Parameters         :  textboxName :- name of text box to be focussed
'                                              attachedText :- attachedtext property of the textbox/text attached with the textbox
 '                                           blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'                                                                            =Yes - if it is popup ;   No/"" =If it is main SAP  window    
'Output Parameters        :Null
'***********************************************************************************
'Function FocusTextBoxWithIndex(attachedText,textboxName,TextIndex,blnIsItPopup)
'***********************************************************************************
Public Function FocusTextBoxWithIndex(attachedText,textboxName,TextIndex,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : FocusTextBoxWithIndex"
Dim objTextboxGuiComp32,objTextboxGuiComp31,objTextbox,objWindow
strStepName=" Set Focus on the TextField " &textboxName
If attachedText<>"" and textboxName<>"" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
    Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","attachedtext:="&attachedText,"name:="&textboxName,"index:="&TextIndex)
    Set objTextboxGuiComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","attachedtext:="&attachedText,"name:="&textboxName,"index:="&TextIndex)
    Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuiComp31)
    
    If objTextbox.Exist Then
                
                If attachedText<>""  then
                strStepName=" Set Focus on the TextField " &attachedText    
                else      
                strStepName=" Set Focus on the TextField " &textboxName                 
              End If
                    objTextbox.SetFocus
                    strStatus = "DONE"
                    If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                          ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
                      End if
                     strMsg=" Textbox Focused successfully"
                     Call ReporterFunction(strLibraryFileName,"FocusTextBoxWithIndex","2","Text Box field","Textbox Focused successfully")
                     
                     
    Else
            Call ReporterFunction(strLibraryFileName,"FocusTextBoxWithIndex","1","Text Box field","Object Missing. Textbox Not Found")
            strStatus="FAIL"
            strMsg = "Object Missing. Textbox Not Found"
            blnObjectError=True
    End if    
else    
Call ReporterFunction(strLibraryFileName,"FocusTextBoxWithIndex","1","Text Box field","Function Parameter Not Passed Properly. Check the --FocusTextBoxWithIndex-- Function Call")
            strStatus="FAIL"
            strMsg = "Function Parameter Not Passed Properly. Check the --FocusTextBoxWithIndex-- Function Call"
        End If
       If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If

 

       If strStatus = "FAIL"  Then
            FocusTextBoxWithIndex = strMsg
            blnMainFailFlag = True
            ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
       Else
            FocusTextBoxWithIndex = strMsg
       End If
    
       If blnDefault_eSwiftReporting Then  
           Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
       End If
Set objTextboxGuiComp32=Nothing
Set objTextbox=Nothing
Set objTextboxGuiComp31=Nothing
Set objWindow=Nothing
End If
End Function
'************************************************************************************
'End Function - FocusTextBoxWithIndex
'************************************************************************************


'**********************************************************************************
'Name of the Function   : SelectRadioButtonByIndexIfPopupExists
'Description		     : Set The radio button in the pop up window if multiple radio buttons are present
'Input Parameters	     :  radiobuttonName - Name of the Radio button
'							radiobuttonIndex- Index of the radio button
						
'Output Parameters        : N/A
'***********************************************************************************
'Function SelectRadioButtonByIndexIfPopupExists(radiobuttonName,radiobuttonIndex)

Function SelectRadioButtonByIndexIfPopupExists(radiobuttonName,radiobuttonIndex)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRadioButtonByIndexIfPopupExists"
strStepName ="Select Radio Button in a popup by Index"
If radiobuttonName <>"" OR radiobuttonIndex<>"" Then
Set objWindow= SetSAPwindowObj(True)

'	radiobuttonName=InputValidation(radiobuttonName)
'	radiobuttonAttachedtext=InputValidation(radiobuttonAttachedtext)
	  Set objPopupRadioButton= SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiRadioButton("guicomponenttype:=41","name:="&radiobuttonName,"index:="&radiobuttonIndex)
          If objPopupRadioButton.Exist Then
                      If VerifyObjectStatus(objPopupRadioButton)=True Then
									If VerifyRadioButton(objPopupRadioButton)=False Then
									
											  objPopupRadioButton.Set
											  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		   						 ImagePath=CaptureScreenshot(strStepName,objPopupRadioButton,False,False,True)
	          							      End if
											  Call ReporterFunction(strLibraryFileName,"SelectRadioButtonByIndexIfPopupExists","2","RadioButton","Value Used :-"& vbNewLine &"RadioButtonName: " &radiobuttonName& "and RadioButton index:"&radiobuttonIndex)
											   strStatus = "DONE"
											   strMsg="Radiobutton in the pop-up is selected successfully"
									Else
											   Call ReporterFunction(strLibraryFileName,"SelectRadioButtonByIndexIfPopupExists","2","RadioButton","Radio button is already selected")
											   strStatus = "DONE"
											   strMsg="Radiobutton in the pop-up is already selected"
									End If
						Else
								Call ReporterFunction(strLibraryFileName,"SelectRadioButtonByIndexIfPopupExists","1","RadioButton","Radio Button  with "& vbNewLine &"RadioButtonName: " &radiobuttonName& "and RadioButton index: "&radiobuttonIndex&" is not enabled.So cannot be set.")
								strStatus = "FAIL"
								strMsg = " The RadioButton Object is not enabled, Please verify the Screen"
								 
								 blnObjectError=True
						End If
         
Else
	   Call ReporterFunction(strLibraryFileName,"SelectRadioButtonByIndexIfPopupExists","1","RadioButton","Function Parameter Not Passed Properly. Check the --SelectRadioButtonByIndexIfPopupExists-- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --SelectRadioButtonByIndexIfPopupExists-- Function Call"
End If
End If
If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRadioButtonByIndexIfPopupExists = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objPopupRadioButton,False,False,True)
	   Else
		    SelectRadioButtonByIndexIfPopupExists = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objPopupRadioButton)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objPopupRadioButton=nothing
End if
End Function

'***************************************************************************************************************************
Function VerifyifGuiLabelExists_ByIndex(Content,Index)

 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyifGuiLabelExists_ByIndex"
	
	strStepName = "Verify if Gui Label exists "

    If Content <>"" Then
     set   objLabel = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiLabel("content:="&Content,"guicomponenttype:=30","index:="&Index)
               If objLabel.Exist Then
					Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists","2",Content,"Gui Label with value "&Content &" exists in the screen")	
					strStatus = "PASS"
					strMsg = "Gui Label with value "&Content&" exists in the screen"	
					blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
                              End If
					
					Else
					Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists_ByIndex","1"," Status bar Content","Gui Label with value "&Content &" doesn't exist  in the screen")	
					strStatus = "FAIL"
					blndefectFlag =True
					strMsg = "Gui Label with value "&Content&" doesn't exist  in the screen"
					blnObjectError=True
				End If
       	Else
    	Call ReporterFunction(strLibraryFileName,"VerifyifGuiLabelExists_ByIndex","1","Gui Label","Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExists-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyifGuiLabelExists_ByIndex-- Function Call-"
	End if


If strStatus = "FAIL"  Then
		VerifyifGuiLabelExists_ByIndex = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objLabel,False,False,False)
    
	Else
		VerifyifGuiLabelExists_ByIndex = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If

End If
End Function

'*******************************************************************************************************************



'**********************************************************************************
'Name of the Function   : GetGridContentByTitle
'Description		     : Get the Grid Content by providing the column name and row number and grid title as parameters
'Input Parameters	     :  gridTitle - Title of the SAP GUI grid
'							gridIndex - Index of the GUI grid
'							columnName - Name of the column from  which data has to be fetched
'							rownumber - Name of the row from which data has to be fetched							
'Output Parameters        : dataTableColumnName -Name of the Column name in output excel sheet where data should be stored
'***********************************************************************************
'Function GetGridContentByTitle(gridTitle,gridIndex,columnName,rownumber,dataTableColumnName)
Public Function GetGridContentByTitle(gridTitle,gridIndex,columnName,rownumber,dataTableColumnName)
	If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetGridContentByRefColumn"
	strStepName = "Get Grid Content"
	If rownumber <>  "" and columnName <> ""  Then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","title:=.*"&gridTitle&".*","index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:=.*"&gridTitle&".*","index:="&gridIndex)
		Set objGrid = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGrid.Exist  Then
				On Error Resume Next
'				strRowNum=objGrid.FindRowByCellContent(refColumn,refFieldVal)
				GetGridContentByTitle=objGrid.GetCellData(rownumber,columnName)
				If Err.Number = 0 Then
					'GetGridContentByRefColumn=objGrid.GetCellData(strRowNum,columnName)
					strStatus="DONE"
					strCapturedText=GetGridContentByTitle
					'If strStatus = "DONE" then
					strStepName = "Get Grid Content" &strCapturedText
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	          			End if
						strMsg = "Grid Content Fetched Into Datatable"
'					Else
'						blnObjectError=True
'						strMsg = "Grid Content Not Fetched Into Datatable"
'					End if
				ElseIf Err.Number = -2147220983 Then	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Column Not Found Within Gui Grid . Please Verify The Screen")
					strStatus="FAIL"
					strMsg =  "Column Not Found Within Gui Grid . Please Verify Screen"
					blnObjectError=True
					Err.Clear
				Else
					Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Invalid Parameter Passed .Check--Column Name--Parameter Of --GetGridContentByTitle--Function Call")
					strStatus = "FAIL" 
					strMsg = "Invalid Parameter Passed .Check--Column name--Parameter Of --GetGridContentByTitle--Function Call"
					
					Err.Clear			
				End If
			Else
				Call ReporterFunction(strLibraryFileName,"GetGridContentByRefColumn","1","Gui Grid","Grid Object Not Found. Check the --GetGridContentByTitle-- Function Call")
				strStatus = "FAIL" 
				strMsg = "Grid Object Not Found. Check the --GetGridContentByTitle-- Function Call"
				blnObjectError=True				
			End If
	Else
		Call ReporterFunction(strLibraryFileName,"GetGridContentByTitle","1","Gui Grid","Function Parameter Not Passed Properly. Check the --GetGridContentByRefColumn-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --GetGridContentByTitle-- Function Call"
	End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetGridContentByTitle = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,False)
	   Else
		    GetGridContentByTitle = strMsg
	   End If
	  If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&columnName&"' as column name and store in '"&gstrOutputSheetName&"' sheet under column "&dataTableColumnName
									'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName&" and store in "&gstrOutputSheetName&" sheet under column Webelement_"&webElementClassORhtmlId
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
										'call WriteRunTimeDataToExcel ("ID_"&webElementClassORhtmlId,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from the grid taking '"&columnName&"' as column name"
										'stepName="Retrieve '"&strCapturedText&"' value from page "&browserName
		End If 
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refFieldVal,strMsg,strStatus,"")
	   End If
	   
	End If

End Function

'**********************************************************************************
'Name of the Function   :  SelectRowRangeGuiGrid
'Description             : Selects a row in a SAP Gui Grid        
'Input Parameters         : gridTitle : Title property of the GuiGrid 
'                columnName :- Name Property of the column having unique value 
'                refValue :- Value in the column  for the given columnName for the particular row to be selected    
'                                                 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'                                                                            =Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectRowRangeGuiGrid(gridTitle,gridIndex,rowno,blnIsItPopup)
'***********************************************************************************
Public Function SelectRowRangeGuiGrid(gridTitle,gridIndex,FromRowno,ToRowno,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowRangeGuiGrid"
Dim objGridGuiComp80,objGridGuiComp201,objGrid


Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select Row range in GuiGrid" 
If FromRowno <> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
        If objGrid.Exist Then
            On error resume Next
'                    strRowNumber=rowno
                    If Err.Number=0 and FromRowno <> "" Then
'                        objGrid.SelectRow strRowNumber
                        objGrid.SelectRowsRange FromRowno,ToRowno
                        
                        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                                  ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
                          End if
                        Call ReporterFunction(strLibraryFileName,"SelectRowRangeGuiGrid","2","SelectRowRangeGuiGrid","Row Selected from :-"& vbNewLine &" Row No : "&FromRowno & " to Row No:" &ToRowno)
                        strMsg="Row Range  [" & FromRowno & " to "& ToRowno &"] selected in GuiGrid."
                        strStatus = "DONE"
'                    ElseIf Err.Number=-2147220983 Then
'                        Call ReporterFunction(strLibraryFileName,"SelectRowGuiGridbyRowNo","1","SelectRowGuiGridbyRowNo","The Column:  "&columnName& " Not Found Within The GuiGrid")
'                         strStatus = "FAIL"
'                         strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
'                         blnObjectError=True
                    Else 
                        blnObjectError=True
                        Call ReporterFunction(strLibraryFileName,"SelectRowRangeGuiGrid","1","SelectRowRangeGuiGrid","Row no is not present in GuiGrid")
                        strStatus = "FAIL"
                        strMsg ="Row no is not present in GuiGrid"
                        
                    End If
        Else 
            blnObjectError=True
            Call ReporterFunction(strLibraryFileName,"SelectRowRangeGuiGrid","1","SelectRowRangeGuiGrid","GuiGrid Object Not Found,Please verify the Screen")
            strStatus = "FAIL"
            strMsg = "GuiGrid Object Not Found,Please verify the Screen"
            
        End If
Else
    Call ReporterFunction(strLibraryFileName,"SelectRowRangeGuiGrid","1","SelectRowRangeGuiGrid","Function Parameter Not Passed Properly. Check the --SelectRowRangeGuiGrid-- Function Call")
    strStatus = "FAIL"
    strMsg = "Function Parameter Not Passed Properly. Check the --SelectRowRangeGuiGrid-- Function Call"
End if                
       If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If


       If strStatus = "FAIL"  Then
            SelectRowRangeGuiGrid = strMsg
            blnMainFailFlag = True
            ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
       Else
            SelectRowRangeGuiGrid = strMsg
       End If
    
       If blnDefault_eSwiftReporting Then  
           Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
       End If
' //////////Word Document ///////////
'                If blnCreateTrainingDoc Then
'                    Check=CheckStatus_Doc(strStatus)
'                    If Check=1 Then
'                        Call storeTableorGridCoordinates(objGrid)
'                        Call StoreSteps(strStepName)
'                    End If
'                End If
' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectRowRangeGuiGrid
'**********************************************************************************
''********************************************************************************** 
'Name of the Function   :  SetHorizontalScrollBar
'Description             : Selects all rows in a SAP Gui Grid        
'Input Parameters         : gridTitle : Title property of the GuiGrid 
'                                                 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'                                                                            =Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SetHorizontalScrollBar(gridTitle,columnName,refValue)
'***********************************************************************************
Public Function SetHorizontalScrollBar(ScrollBarPosition,blnIsItPopup)

 


 If Not (Environment.Value("blnFatalError")) Then
       If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetHorizontalScrollBar"
   Dim objTextbox32,objTextbox31,objTextbox,objWindow
   Set objWindow= SetSAPwindowObj(blnIsItPopup)
   strStepName="Set Horizontal Scroll Bar "
   If ScrollBarPosition<>"" Then
      Set objWindow = SAPGuisession(sessionObject).sapguiwindow(objWindow)
             If objWindow.Exist Then
              objWindow.HorizontalScrollbarPosition ScrollBarPosition
                  strStatus = "DONE"
                        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
                              ImagePath=CaptureScreenshot(strStepName,objWindow,False,False,False)
                          End if
                      Call ReporterFunction(strLibraryFileName,"SetHorizontalScrollBar","2","Window","Horizontal Scroll bar was set at position " & ScrollBarPosition)
                      strMsg="Horizontal Scroll bar was set at position " & ScrollBarPosition
             Else
                   Call ReporterFunction(strLibraryFileName,"SetHorizontalScrollBar","1","Window"," Object Missing")
                   strStatus = "FAIL"
                   strMsg = " The Window Object is not Found, Please verify the Screen"
                   blnObjectError=True
             End If
   Else
                   Call ReporterFunction(strLibraryFileName,"SetHorizontalScrollBar","1","Text box","Function Parameter Not Passed Properly. Check the --SetHorizontalScrollBar-function")
                   strStatus="FAIL"
                   strMsg = "Function Parameter Not Passed Properly. Check the --SetHorizontalScrollBar-- Function Call-"
   End If
       If  blnObjectError  Then
            Environment.Value("blnFatalError")=True
       End If

 


       If strStatus = "FAIL"  Then
            SetHorizontalScrollBar = strMsg
            blnMainFailFlag = True
            ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
       Else
            SetHorizontalScrollBar = strMsg
       End If
       
        
'        If blnWriteDataToOutputSheet Then
'                                        strStepName = "Retrieve '"&strCapturedText&"' value from window and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"                                
'                                        call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
'                            Else
'                                        strStepName = "Retrieve '"&strCapturedText&"' value from textbox"
'                            End If 
                            
    
        If blnDefault_eSwiftReporting Then  
           Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
        End If
      
              
               Set objwindowcaptureSAP =Nothing
'               Set objTextbox31=Nothing
'               Set objTextbox = Nothing
               Set objWindow=Nothing
   End If
   
   
End Function
'************************************************************************************
'End Function - SetHorizontalScrollBar
