End Function


'''**********************************************************************************
'Name of the Function  	   :  SetTextboxNoLabel
'Description		     			: Setting a value into a Textbox having no label or attached text in SAP main window or in popup
'                                                          
'Input Parameters	    	 :  attachedText,textboxName,textboxIndex,textboxValue,blnIsItPopup

'					textboxName:- name property of the text box 
'			       '			        textboxValue :- The value that user want to set into the Text Box.    
'                  textboxIndex-The index of the textbox
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        : Null
'Updates Done : Updated the CaptureScreenshot function call as part of changes for the Training Doc creation.

'************************************************************************************
Function SetTextboxNoName(textboxAttachedText,textboxIndex,textboxValue,blnIsItPopup)
    If Not (Environment.Value("blnFatalError") or textboxValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetTextbox"
	
    	Dim objTextboxGuiComp32,objTextboxGuicomp31,objTextbox,objWindow
	
	
	strStepName = " Set "  & "'" & textboxValue & "'" & " in Textbox : " & "'"& textBoxAttachedText & "'"                   
        Set objWindow= SetSAPwindowObj(blnIsItPopup)
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
	Set objTextboxGuicomp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","attachedtext:="&textboxAttachedText,"Index:="&textboxIndex)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuicomp31)  
'   Set objTextbox= objTextboxGuiComp32
	If objTextbox.Exist then
			
	     	If VerifyObjectStatus(objTextbox) Then  
			If textboxValue= DS_BLANK Then
			      objTextbox.set ""
			Else
			      objTextbox.set textboxValue
			End If
        	        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
			End if
			Call ReporterFunction(strLibraryFileName,"SetTextboxNoName","2",strStepName,"Value Used :-"&  vbNewLine & "Text BoxName: " &textboxAttachedText & vbnewline &"ValueField:" &textboxValue)
			strStatus = "DONE"
			strMsg = "Text box set successfully"
		Else
			Call ReporterFunction(strLibraryFileName,"SetTextboxNoName","1",strStepName,"The Textfield: " & "is not enabled")
			strStatus = "FAIL"
			strMsg = "The Textfield '"&  "' is not enabled"
                   	blnObjectError=True
		End if		
	Else 
	        
	        Call ReporterFunction(strLibraryFileName,"SetTextboxNoName","1",strStepName,"Object Missing--Check the Screen Properly")
		strStatus = "FAIL"
		strMsg = "The Textfield '" & "'  is not Found--Check the Screen Properly"
		blnObjectError=True
	End If		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetTextboxNoName = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
	Else
		SetTextboxNoName = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,textboxValue,strMsg,strStatus,"")
	End If
'	' //////////Word Document ///////////
'			If blnCreateTrainingDoc Then
'				   Check=CheckStatus_Doc(strStatus)
'				   If Check=1 Then
'						  Call storeCoordinates(objTextbox)
'						  Call StoreSteps(strStepName)
'				   End If
'			End If
'	 ' //////////Word Document ///////////
	Set objTextbox=Nothing
	Set objTextboxGuiComp32=Nothing
	Set objTextboxGuicomp31=Nothing
	Set objWindow=Nothing
    End If
End function
'************************************************************************************
Function SetTextboxNoLabel(textboxName,textboxIndex,textboxValue,blnIsItPopup)
    If Not (Environment.Value("blnFatalError") or textboxValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetTextbox"
	
    	Dim objTextboxGuiComp32,objTextboxGuicomp31,objTextbox,objWindow
	
	
	strStepName = " Set "  & "'" & textboxValue & "'" & " in Textbox : " & "'"& textboxName & "'"                   
        Set objWindow= SetSAPwindowObj(blnIsItPopup)
	Set objTextboxGuiComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"Index:="&textboxIndex)
	Set objTextboxGuicomp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"Index:="&textboxIndex)
	Set objTextbox=SetObj(objTextboxGuiComp32,objTextboxGuicomp31)  
	
'   Set objTextbox= objTextboxGuiComp32
	If objTextbox.Exist then
			
	     	If VerifyObjectStatus(objTextbox) Then  
			If textboxValue= DS_BLANK Then
			      objTextbox.set ""
			Else
			      objTextbox.set textboxValue			    
			End If
			StrTextBoxattachedText = objTextbox.GetRoProperty("attachedtext")
			strStepName = " Set "  & "'" & textboxValue & "'" & " in Textbox : " & "'"& StrTextBoxattachedText & "'"  
			If Trim(TextBoxattachedText)<> "" Then
			Call ReporterFunction(strLibraryFileName,"SetTextboxNoLabel","2",strStepName,"Value Used :-"&  vbNewLine & "Text box: " &StrTextBoxattachedText & vbnewline &"ValueField:" &textboxValue)	
			Else
			Call ReporterFunction(strLibraryFileName,"SetTextboxNoLabel","2",strStepName,"Value Used :-"&  vbNewLine & "Text BoxName: " &textboxName & vbnewline &"ValueField:" &textboxValue)	
			End If
        	        If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
			End if
			
			
			strStatus = "DONE"
			strMsg = "Text box set successfully"
		Else
			Call ReporterFunction(strLibraryFileName,"SetTextboxNoLabel","1",strStepName,"The Textfield: " & "is not enabled")
			strStatus = "FAIL"
			strMsg = "The Textfield '"&  "' is not enabled"
                   	blnObjectError=True
		End if		
	Else 
	        
	        Call ReporterFunction(strLibraryFileName,"SetTextboxNoLabel","1",strStepName,"Object Missing--Check the Screen Properly")
		strStatus = "FAIL"
		strMsg = "The Textfield '" & "'  is not Found--Check the Screen Properly"
		blnObjectError=True
	End If		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		SetTextboxNoLabel = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objTextbox,FALSE,False,TRUE)
	Else
		SetTextboxNoLabel = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,textboxValue,strMsg,strStatus,"")
	End If
'	' //////////Word Document ///////////
'			If blnCreateTrainingDoc Then
'				   Check=CheckStatus_Doc(strStatus)
'				   If Check=1 Then
'						  Call storeCoordinates(objTextbox)
'						  Call StoreSteps(strStepName)
'				   End If
'			End If
'	 ' //////////Word Document ///////////
	Set objTextbox=Nothing
	Set objTextboxGuiComp32=Nothing
	Set objTextboxGuicomp31=Nothing
	Set objWindow=Nothing
    End If
End function

'************************************************************************************
'End Function - SetTextbox
'************************************************************************************


'**********************************************************************************
'Name of the Function   :  SelectCheckboxNoLabel
'Description		     : Selects Check Box having no name or label
'			                             
 '			                     checkBoxIndex :- ordinal identifier(index) of the textbox    
'                                     OnOffStatus - On or Off Status of  the checkbox to be selected	 
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Input Parameters	     : checkboxName,OnOffStatus
'Example :          Call SelectCheckbox("HRVPV6A-KATGX","ON")
'Output Parameters        :Null
'***********************************************************************************
'Function SelectCheckbox(checkboxName,checkBoxIndex,OnOffStatus,blnIsItPopup
'***********************************************************************************
Public Function SelectCheckboxNoLabel(checkBoxIndex,OnOffStatus,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectCheckbox"
Set objWindow= SetSAPwindowObj(blnIsItPopup)
Set objChkBox=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiCheckBox("guicomponenttype:=42","name:="&checkboxName,"index:="&checkBoxIndex)
strStepName= "Set  CheckBox: " & " " &  OnOffStatus
If  checkBoxIndex <> "" and OnOffStatus<> "" Then

If objChkBox.Exist  then
		 CheckBoxAttachedText = objChkBox.getROProperty("attachedtext")
		 If CheckBoxAttachedText= "" Then
            CheckBoxAttachedText = textboxName
		 End If
End  If


	 If objChkBox.Exist Then
	 blnObjectFound=True
     If VerifyObjectStatus(objChkBox) Then
	      If  objChkBox.GetROProperty("selected")="False" and OnOffStatus="ON" Then
             objChkBox.set "ON"
            
			 Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is selected")
            strStatus="DONE"
            strMsg= "Checkbox is selected successfully"
	     ElseIf objChkBox.GetROProperty("selected")="True" and OnOffStatus="ON" Then
	          Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is already selected")
              strStatus="DONE"
              strMsg= "Checkbox is already selected"
	     ElseIf  objChkBox.GetROProperty("selected")="True" and OnOffStatus="OFF" Then
             objChkBox.set "OFF"
             
			 Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is unchecked")
             strStatus="DONE"
             strMsg= "Checkbox is unchecked successfully"
        Else
	          Call ReporterFunction(strLibraryFileName,"SelectCheckbox","2"," Check Box ","Check Box is already  unchecked")
              strStatus="DONE"
              strMsg= "Checkbox is already unchecked"
	   End If 
	          If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  ImagePath=CaptureScreenshot(strStepName,objChkBox,False,False,True)
	          End if	   
        else 
        	blnObjectError=True
		   Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Check Box is disabled. It cannot be clicked")
		   strStatus="FAIL"
		   strMsg ="Check Box is disabled ."
		End If
      else 
      blnObjectError=True
	    Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Check Box Object Missing")
	   strStatus="FAIL"
	   strMsg = " The Check Box Object is not Found, Please verify the Screen"
       
  End If
  else
  Call ReporterFunction(strLibraryFileName,"SelectCheckbox","1","Check Box","Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call")
	   strStatus="FAIL"
	   strMsg = " Function Parameter Not Passed Properly. Check the --SelectCheckbox-- Function Call"

  End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectCheckboxNoLabel = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objChkBox,False,False,True)
	   Else
		    SelectCheckboxNoLabel = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,OnOffStatus,strMsg,strstatus,"")
	   End If
   ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objChkBox)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////

Set objWindow=Nothing
Set objSAPwindow=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectCheckboxNolabel
'************************************************************************************

'''**********************************************************************************
'Name of the Function   :  GetWindowValue
'Description		     : Obtains the runtime value generated in SAP Window
'			                          
 '                                   dataTableColumnName : column name in the data sheet where the textbox value will be stored		
 '										blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window        
'Input Parameters	     :  textboxName,daTatableColumnName
'Output Parameters        :textboxValue
'***********************************************************************************
'Function GetWindowValue(dataTableColumnName,blnIsItPopup)
'***********************************************************************************

Public Function GetWindowValue(dataTableColumnName,blnIsItPopup)
   If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : GetWindowValue"
   Dim objTextbox32,objTextbox31,objTextbox,objWindow
   Set objWindow= SetSAPwindowObj(blnIsItPopup)
   strStepName="Get value from the Window: "
   If dataTableColumnName<>"" Then
       Set objwindowcaptureSAP = SAPGuisession(sessionObject).sapguiwindow(objWindow)
            
             If objwindowcaptureSAP.Exist Then
                 GetWindowValue=objwindowcaptureSAP.GetROProperty("text")
                 strCapturedText=GetWindowValue
	              strStatus = "DONE"
				  	  If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  			ImagePath=CaptureScreenshot(strStepName,objwindowcaptureSAP,False,False,False)
	          			End if
					  Call ReporterFunction(strLibraryFileName,"GetWindowValue","2","Window","Values Used :-"& vbNewLine &" Text Value : "&GetWindowValue)
					  strMsg="Window value captured"
             Else
	               Call ReporterFunction(strLibraryFileName,"GetWindowValue","1","Window"," Object Missing")
                   strStatus = "FAIL"
                   strMsg = " The Window Object is not Found, Please verify the Screen"
                   blnObjectError=True
             End If
   Else
                   Call ReporterFunction(strLibraryFileName,"GetWindowValue","1","Text box","Function Parameter Not Passed Properly. Check the --GetWindowValue-function")
                   strStatus="FAIL"
                   strMsg = "Function Parameter Not Passed Properly. Check the --GetWindowValue-- Function Call-"
   End If
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    GetWindowValue = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	   Else
		    GetWindowValue = strMsg
	   End If
	   
	    
	    If blnWriteDataToOutputSheet Then
	                                    strStepName = "Retrieve '"&strCapturedText&"' value from window and store in '"&gstrOutputSheetName&"' sheet under column '"& dataTableColumnName & "'"								
										call WriteRunTimeDataToExcel (dataTableColumnName,strCapturedText)
							Else
										strStepName = "Retrieve '"&strCapturedText&"' value from textbox"
							End If 
							
	
	    If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,strCapturedText)
	    End If
	  
              
               Set objwindowcaptureSAP =Nothing
'               Set objTextbox31=Nothing
'               Set objTextbox = Nothing
			   Set objWindow=Nothing
   End If
  End Function
'************************************************************************************
'End Function - GetWindowValue
'************************************************************************************


''**********************************************************************************
'Name of the Function   :  SelectColumnGuiGrid
'Description		     : Selects a column in a SAP Gui Grid        
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'				columnName :- Name Property of the column having unique value 
'			   
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectColumnGuiGrid(gridTitle,columnName)
'***********************************************************************************
Public Function SelectColumnGuiGrid(gridTitle,gridIndex,columnName,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGrid"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select Column in GuiGrid" 
If columnName<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
					
            		If Err.Number=0 Then
						objGrid.SelectColumn columnName
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			End if
						Call ReporterFunction(strLibraryFileName,"SelectColumnGuiGrid","2","SelectColumnGuiGrid","Column Selected:-"& vbNewLine &" Column : "&columnName)
						strMsg="Column Name [" & columnName & "] selected in GuiGrid."
						strStatus = "DONE"
					ElseIf Err.Number=-2147220983 Then
						Call ReporterFunction(strLibraryFileName,"SelectColumnGuiGrid","1","SelectColumnGuiGrid","The Column:  "&columnName& " Not Found Within The GuiGrid")
						 strStatus = "FAIL"
						 strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
						 blnObjectError=True
					Else 
						blnObjectError=True
						Call ReporterFunction(strLibraryFileName,"SelectColumnGuiGrid","1","SelectColumnGuiGrid","Value "&columnName&" Not Found Within The Column :"&columnName& " of GuiGrid")
						strStatus = "FAIL"
						strMsg ="Value ["&refValue& "] Not Found Within The Column [" & columnName & "] of GuiGrid"
						
					End If
		Else 
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"SelectColumnGuiGrid","1","SelectColumnGuiGrid","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectColumnGuiGrid","1","SelectColumnGuiGrid","Function Parameter Not Passed Properly. Check the --SelectColumnGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectColumnGuiGrid-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRowGuiGrid = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectRowGuiGrid = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objGrid)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectColumnGuiGrid
'************************************************************************************



'********************************************************************************
'Name of the Function   : verifyNoRowExistsGrid
'Description		     : Verify if no Row exists in GuiGrid
'Input Parameters	     : 
'											gridIndex	
'											gridName
'Creation Date : 

'***********************************************************************************
'Function VerifyColumnGuiGrid(gridName,gridIndex,columnName)
'***********************************************************************************

Public Function verifyNoRowExistsGrid(gridName,gridIndex)
	
	If Not (Environment.Value("blnFatalError") or columnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : verifyNoRowExistsGrid"
	
	strStepName = "Verify if no row exists in GuiGrid"
	If  gridName <> "" then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGridGui = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGridGui.Exist  Then
				On Error Resume Next
			    RowCountGrid=objGridGui.getroproperty("rowcount")
				If RowCountGrid = 0 Then
        			  strStatus = "PASS"
					  strMsg = "Grid contains no Row "
					   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
		            	  		End If
					  
                Else	' Verifies whether column is present in the Grid
					Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGrid","1","Gui Grid","Rows Found Within Gui Grid . Please Verify The Screen")
					strStatus = "FAIL" 
					strMsg =  "Rows found Within Gui Grid . Please Verify Screen"
					
					Err.Clear
			   end if
		  Else
							Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGrid","1","Gui Grid","Grid Object Not Found. Check the --verifyNoRowExistsGrid-- Function Call")
							strStatus = "FAIL" 
							strMsg = "Grid Object Not Found. Check the --verifyNoRowExistsGrid-- Function Call"
							blnObjectError=True
							
				End If
        	Else
		Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGrid","1","Gui Grid","Function Parameter Not Passed Properly. Check the --verifyNoRowExistsGrid-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --verifyNoRowExistsGrid-- Function Call"
	End If
	
	If strStatus = "FAIL"  Then
		verifyNoRowExistsGrid = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
	
	Else
		verifyNoRowExistsGrid = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,columnName,strMsg,strStatus,"")
	End If
	End If
	Set objGridGuiGuiComp80=Nothing
	Set objGridGuiComp201=Nothing
	Set objGrid=Nothing
End Function
'******************************************************************************************
'End Function verifyNoRowExistsGrid(gridName,gridIndex)
'******************************************************************************************

''**********************************************************************************
'Name of the Function   : SelectMenuIdToolBar
'Description		     : Selects a menu item ID from  the SAP ToolBar
'Input Parameters	     :  buttonName,toolbarIndex
'Output Parameters        :Null
'***********************************************************************************
 'Function  SelectMenuIdToolBar(buttonName,toolbarIndex)
'***********************************************************************************


Public Function verifyNoRowExistsGridandRowCount(gridName,gridIndex)
	
	If Not (Environment.Value("blnFatalError") or columnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : verifyNoRowExistsGridandRowCount"
	
	strStepName = "Verify if no row exists in GuiGrid"
	If  gridName <> "" then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGridGui = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGridGui.Exist  Then
				On Error Resume Next
			    RowCountGrid=objGridGui.getroproperty("rowcount")
				If RowCountGrid = 0 Then
        			  strStatus = "PASS"
					  strMsg = "Grid contains Rows "
					   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
		            	  		End If
					  
                Else	' Verifies whether column is present in the Grid
				
					Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGridandRowCount","2","Gui Grid","Rows Found Within Gui Grid . Please Verify The Screen")
					strMsg =  "Rows found Within Gui Grid . Please Verify Screen"
					RowCount = RowCountGrid
'					strStatus = "FAIL" 
					Err.Clear
			   end if
		  Else
							Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGridandRowCount","2","Gui Grid","Grid Object Not Found. Check the --verifyNoRowExistsGridandRowCount-- Function Call")
							strStatus = "PASS" 
							strMsg = "Grid Object Not Found. Check the --verifyNoRowExistsGridandRowCount-- Function Call"
							'blnObjectError=True
							
				End If
        	Else
		Call ReporterFunction(strLibraryFileName,"verifyNoRowExistsGridandRowCount","1","Gui Grid","Function Parameter Not Passed Properly. Check the --verifyNoRowExistsGridandRowCount-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --verifyNoRowExistsGridandRowCount-- Function Call"
	End If
	
	If strStatus <> "PASS"  Then
		verifyNoRowExistsGridandRowCount = strMsg
'		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
	
	Else
		verifyNoRowExistsGridandRowCount = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,columnName,strMsg,strStatus,"")
	End If
	End If
	Set objGridGuiGuiComp80=Nothing
	Set objGridGuiComp201=Nothing
	Set objGrid=Nothing
End Function


Public Function verifyGridRowCount(gridName,gridIndex,ExpectedRowCount)
	
	If Not (Environment.Value("blnFatalError") or columnName= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : verifyGridRowCount"
	
	strStepName = "Verify RowCount "&"'" &ExpectedRowCount& "'"&"  matches in the GuiGrid"
	If  gridName <> "" or ExpectedRowCount <> "" then
		Set objGridGuiComp80=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=80","name:="&gridName,"index:="&gridIndex)
		Set objGridGuiComp201=sapguisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","Name:="&gridName,"index:="&gridIndex)
		Set objGridGui = SetObj(objGridGuiComp80,objGridGuiComp201)
			If objGridGui.Exist  Then
				On Error Resume Next
			    RowCountGrid=objGridGui.getroproperty("rowcount")
				If RowCountGrid = ExpectedRowCount Then
				
				Call ReporterFunction(strLibraryFileName,"verifyGridRowCount","2","Gui Grid","Actual rows Found in the GUI Grid are matching With the Expected Grid values ")
					strMsg =  "Rows found Within Gui Grid "&"'"&RowCountGrid&"'"&" are matching with the exepcted count "&"'"&ExpectedRowCount&"'"&""
        			  	strStatus = "PASS"			
					   blnCaptureFlag = True
			              	If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
		            	  		End If
					  
                Else	' Verifies whether column is present in the Grid
				
					Call ReporterFunction(strLibraryFileName,"verifyGridRowCount","1","Gui Grid","Rows Found not matching Within Gui Grid . Please Verify The Screen")
					strMsg =  "Rows found Within Gui Grid are not matching with the exepcted count Please Verify Screen"
					RowCount = RowCountGrid
					strStatus = "FAIL" 
					Err.Clear
			   end if
		  Else
							Call ReporterFunction(strLibraryFileName,"verifyGridRowCount","2","Gui Grid","Grid Object Not Found. Check the --verifyGridRowCount-- Function Call")
							strStatus = "FAIL" 
							strMsg = "Grid Object Not Found. Check the --verifyGridRowCount-- Function Call"
							'blnObjectError=True
							
				End If
        	Else
		Call ReporterFunction(strLibraryFileName,"verifyGridRowCount","1","Gui Grid","Function Parameter Not Passed Properly. Check the --verifyGridRowCount-- Function Call")
		strStatus = "FAIL" 
		strMsg = "Function Parameter Not Passed Properly. Check the --verifyGridRowCount-- Function Call"
	End If
	
	If strStatus <> "PASS"  Then
		verifyGridRowCount = strMsg
'		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objGridGui,False,False,False)
	
	Else
		verifyGridRowCount = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,ExpectedRowCount,strMsg,strStatus,"")
	End If
	End If
	Set objGridGuiGuiComp80=Nothing
	Set objGridGuiComp201=Nothing
	Set objGrid=Nothing
End Function

Function SelectMenuIdToolBar(MenuId,toolbarIndex)

     If Not Environment.Value("blnFatalError") Then
					
				
					If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : ClickButtonToolBar"
					strFuncName = "SelectMenuIdToolBar"
					Val = "<b>Button Name  :</b>" & buttonName 
					strStepName="Click MenuId " & "'" &MenuId&"'" &"in Tool bar"
					Set objWindow= SetSAPwindowObj(blnIsItPopup)
							  If MenuId <> ""  Then
											Set objToolbar202=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiToolbar("guicomponenttype:=202","name:=shel.*","index:="&toolbarIndex)
											Set objToolbar204=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiToolbar("guicomponenttype:=204","name:=shel.*","index:="&toolbarIndex)
											Set objToolbar=SetObj(objToolbar202,objToolbar204)
															If objToolbar.Exist Then
																			
																		   On Error Resume Next
																							  If VerifyObjectStatus(objToolbar) Then
																												Call storeCoordinates(objToolbar)
																												If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
																																ImagePath=CaptureScreenshot(strStepName,objToolbar,True,True,True)
																												End If
'																												msgbox Err.Number
																												If Err.Number =0 Then
																													
																											
																												objToolbar.SelectMenuItemById MenuId
																												strStatus = "DONE"
																												strMsg = "Menu ID "&MenuId&" selected "
																												Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,strMsg)
																												
																							  ElseIf Err.Number = 424 Then
																							  					strStatus = "FAIL"
																												strMsg = "The Menu id "&MenuId&" in the toolbar  is not Found."
																												blnObjectError=True
																												Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																							  
																							  Else
																												strStatus = "FAIL"
																												strMsg = "Toolbar is Disabled, So Menuid can't be clicked"
																												blnObjectError=True
																												Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																							  End If
																							  	End If
																Else
																			strStatus = "FAIL"
																			strMsg = " The  toolbar is not Found, Please verify the Screen"
																			blnObjectError=True
																			Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)
																			
																 End If
								Else
											strStatus = "FAIL"
											strMsg = "Function Parameter Not Passed Properly. Check the --ClickButtonToolBar-- Function Call"                                         				
											Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,strMsg)

								End If	
								If  blnObjectError  Then
																		Environment.Value("blnFatalError")=True
																	End If
										
																	If strStatus = "FAIL"  Then
																		SelectMenuIdToolBar = strMsg
																		blnMainFailFlag = True
																		ImagePath=CaptureScreenshot(strStepName,objToolbar,True,True,True)
																	Else
																		SelectMenuIdToolBar = True
																	End If
										
																	If blnDefault_eSwiftReporting Then  
																			Call UpdateResultHtml (strStepName,Val,strMsg,strStatus,"")																	
																	End If
																	Set objToolbar=nothing
																	Set objToolbar204=nothing
																	Set objToolbar202=nothing
					
     End If
		

End Function
'************************************************************************************
'End Function - SelectMenuIdToolBar
'************************************************************************************
'**********************************************************************************
'Name of the Function   :  ConvertDoubledigit
'Description		     : Convert a single digit to double digit .
'                                                                    
'Input Parameters	     :  String
'Output Parameters        : Null
'***********************************************************************************
'Function VerifyTextBoxContent(textboxName,textboxAttachedText,textboxIndex,expectedValue)
'***********************************************************************************
Public Function ConvertDoubledigit(StrSingle)
If Len (StrSingle)<2 Then
	ConvertDoubledigit= "0" + StrSingle
Else
    ConvertDoubledigit= StrSingle
End If

End Function


'**********************************************************************************
'Name of the Function   :  VerifyTextBoxNoLabelContent
'Description		     : Verifies the contents of Textbox which is present in a normal window .
'                                                                    textboxName:- name property of the text box 
'			                           textboxAttachedText :- attachedtext property of the textbox
'			                      textboxIndex :- ordinal identifier(index) of the textbox    
'                                      expectedValue :- Value to be checked    
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window  
'Input Parameters	     :  textboxName,textboxAttachedText,textboxIndex,expectedValue
'Output Parameters        : Null
'***********************************************************************************
'Function VerifyTextBoxNoLabelContent(textboxName,textboxAttachedText,textboxIndex,expectedValue)
'***********************************************************************************
Public Function VerifyTextBoxNoLabelContent(textboxName,textboxIndex,expectedValue,blnIsItPopup)

  If Not (Environment.Value("blnFatalError") or expectedValue= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyTextBoxContent"
	
Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = " Verify Content of TextBox"
Set objTextboxComp31 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=31","name:="&textboxName,"Index:="&textboxIndex)
Set objTextboxComp32 = SAPGuisession(sessionObject).sapguiwindow(objWindow).sapguiedit("guicomponenttype:=32","name:="&textboxName,"Index:="&textboxIndex)
Set objTextbox=SetObj(objTextboxComp31,objTextboxComp32)
If textboxName<> "" OR textboxAttachedText<>"" OR textboxIndex<>"" Then
		 If objTextbox.Exist then
					  textboxValue = objTextbox.getROProperty("value")
					  If UCASE(expectedValue)=UCASE(textboxValue) or Lcase(expectedValue)=LCASE(textboxValue) or INSTR(1,textboxValue,expectedValue,1)<>null  Then
						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxNoLabelContent","2","TextBox","Supplied Value :-"&expectedValue&"  "& vbNewLine&"   Matched with Contents of Text Box")
						  strStatus = "PASS"
						  strMsg = "Actual Value of the TextBox : " &textboxValue & "   is equal to the Expected Value: " &expectedValue&" "
						    blnCaptureFlag = True
			              If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		            	  ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
		            	  End If
						 
					  Else
						  Call ReporterFunction(strLibraryFileName,"VerifyTextBoxNoLabelContent","1","TextBox","Supplied Value :-"&expectedValue &"  "& vbNewLine&"     didnot Match  with Contents of Text Box" )
						  strStatus = "FAIL"
						  strMsg = "Actual Text Box Value : " &textboxValue & "  does not match with the expected Value: " &expectedValue&" "
			              
					 End If
		 else 
			   'strStepName = "TextBox: " &textboxAttachedText& "  -No Such Object Found"
			   Call ReporterFunction(strLibraryFileName,"VerifyTextBoxNoLabelContent","1","Text Box","Text Box Object Missing")
			   strStatus = "FAIL"
			   strMsg = "Text Box Object Missing"
			   blnObjectError=True
		 End If
 else
    	Call ReporterFunction(strLibraryFileName,"VerifyTextBoxNoLabelContent","1","TextBox","Function Parameter Not Passed Properly. Check the --VerifyTextBoxNoLabelContent- Function Call")
	   strStatus="FAIL"
	   strMsg = "Function Parameter Not Passed Properly. Check the --VerifyTextBoxNoLabelContent-- Function Call"
 End If
 	
 If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyTextBoxNoLabelContent = strMsg
		blnMainFailFlag = True
	    ImagePath=CaptureScreenshot(strStepName,objTextbox,False,False,False)
	Else
		VerifyTextBoxNoLabelContent = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,expectedValue,strMsg,strStatus,"")
	End If
Set objTextboxComp31 =Nothing
Set objTextboxComp32 =Nothing
Set objTextbox=Nothing
Set objWindow=Nothing
End If
End function
'************************************************************************************
'End Function -  VerifyTextBoxNoLabelContent
'************************************************************************************

'**********************************************************************************
'Name of the Function   :  WriteRunTimeDataToExcelGlobalSheet
'Description		     : To update a value in the cell of input global sheet sheet witha a given column name 
							'strVariableName -- Name of column
							'strVariableValue -- Value to be updated
'                                        
'Input Parameters	     :  textboxName,textboxAttachedText,textboxIndex,expectedValue
'Output Parameters        : Null
'***********************************************************************************
'Function WriteRunTimeDataToExcelGlobalSheet (strVariableName,strVariableValue)
'***********************************************************************************

Public Function WriteRunTimeDataToExcelGlobalSheet (strVariableName,strVariableValue)
	On error resume next
	Dim strFileName,strFolderPathToCreate,iRunTimeDataRowCounter 
	Execute strVariableName & " = strVariableValue"
'						If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Writing RunTime Scenario Data in Local File"
	iRunTimeDataRowCounter = 0
	Set InputAppExcel = CreateObject("Excel.Application")     
	Set objInputWorkBook = InputAppExcel.Workbooks.Open(InputFilePath) 		' objInputWorkBook  variable  contains/opens the excel workbook for the input file
	Set objInputSheet =  InputAppExcel.Sheets("Global") 
	Do
			iRunTimeDataRowCounter = iRunTimeDataRowCounter +1
	Loop Until (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = "") or (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = strVariableName)
	If iRunTimeDataRowCounter<> 0 Then
				iRunTimeDataRowCounter = iRunTimeDataRowCounter -1
	End If
	objInputSheet.cells(1,iRunTimeDataRowCounter+1).value = strVariableName
	objInputSheet.cells(gstrWriteDataToExcelRowNo,iRunTimeDataRowCounter+1).value = strVariableValue
	objInputWorkBook.Save
	objInputWorkBook.Close
	InputAppExcel.Quit
	Set InputAppExcel = Nothing
	Set objInputWorkBook =Nothing
	Set objInputSheet =Nothing
End Function 


'*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : VerifyStatusBarMessageType
'Author		     :Subhrajyoti S
'Description		     : Verifies status bar message type (S/E)     
'Input Parameters	     :  Content to be verfied
'Output Parameters        : Null
'Creation Date : 
'***********************************************************************************
'Function VerifyStatusBar(MessageType)
'***********************************************************************************

Function VerifyStatusBarMessageType(MessageType)
 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : VerifyStatusBarMessageType"
	
	strStepName = "Verify StatusBar MessageType "
	Set objStatusBar=SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar)
    objStatusBarText = SAPGuiSession(sessionObject).SapGuiWindow(windowobject).SAPGuiStatusBar(guiStatusBar).GetROProperty("messagetype")
	CompareType="CONTAIN"
    If MessageType <>"" Then
		Select Case UCASE(CompareType)
			   Case "CONTAIN"
				If instr(1, UCASE(objStatusBarText), UCASE(MessageType), vbTextCompare) Then
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBarMessageType","2"," Status bar message type","Actual Value is equal to the Expected Value")	
				strStatus = "PASS"
				strMsg = "Actual Value: " & "'" & objStatusBarText & "'" & " is equal to the Expected Value : " & "'" & MessageType& "'" &  " "
				blnCaptureFlag = True				
				If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   			ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
				End If 
				
				Else
				Call ReporterFunction(strLibraryFileName,"VerifyStatusBarMessageType","1"," Status bar message type","Actual Value is not equal to the Expected Value ")	
				strStatus = "FAIL"
				blndefectFlag =True
				strMsg = "Actual Value: " & objStatusBarText & "  is not equal to the Expected Value: " & "'" & MessageType& "'" &  " "	
				End If
		End Select
	Else
    	Call ReporterFunction(strLibraryFileName,"VerifyStatusBarMessageType","1","StatusBar","Function Parameter Not Passed Properly. Check the --VerifyStatusBarMessageType-- Function Call")
			strStatus = "FAIL" 
			strMsg = "Function Parameter Not Passed Properly. Check the --VerifyStatusBarMessageType-- Function Call"
	End if
	
		
	If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
	End If

	If strStatus = "FAIL"  Then
		VerifyStatusBarMessageType = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot(strStepName,objStatusBar,True,True,True)
	Else
		VerifyStatusBarMessageType = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
	  ' //////////Word Document ///////////
		'	If bDocFlag= 1 Then
			'	Check=CheckStatus_Doc(status)
			'	If Check=1 Then
			'		imageDocPath=CaptureSAPObject_Doc(SAPWindowObject)
			'		Call StoreSteps(strStepName)
			'		Call storeCoordinates(objStatusBar)
			'		call drawShapeImage(imageDocPath)
             '       Call InsertImage(imageDocPath)
			'		Call InsertStepsDoc()
			'		oDicSteps.RemoveAll
			'	End If
			' End If
			    ' //////////Word Document ///////////
	Set objStatusBar=Nothing
	End If
End Function


''************************************************************************************
'End Function - VerifyStatusBarMessageType
'************************************************************************************

'**********************************************************************************
'Name of the Function   :  SetMultipleGridData
'Description		     : Enters value in Grid cell fields. It is used when we have multiple grids in one screen
'Input Parameters	     :  gridTitle,gridRowNumber,gridColumnName,cellValue,blnIsItPopup
 '                							  gridTitle:-Title of the grid
'			       							 gridRowNumber :- Row number of  Grid where value is to be entered
'			        						gridColumnName :- Column name of Grid where value is to be entered
 '                              			gridName:-Name of the grid
'			        						cellValue :- Value to be entered
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window			        
'Output Parameters        :Null
'Updates Done : Updated the CaptureScreenshot function call as part of changes for the Training Doc creation.
'***********************************************************************************
'Function SetMultipleGridData(  gridTitle,gridIndex,gridRowNumber,gridColumnName,cellValue,blnIsItPopup)
'***********************************************************************************
Public Function SetMultipleGridData(gridTitle,gridIndex,gridRowNumber,gridColumnName,cellValue,blnIsItPopup)
	If Not (Environment.Value("blnFatalError") or cellValue= DS_SKIP) Then
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SetMultipleGridData"
		Dim objGuiGrid201,objGuiGrid80,objGuiGrid,objWindow
	
		strStepName = "Set " & "'" & cellValue & "'"& " in Row Number:  "& "'" & gridRowNumber & "'" & " and in Column Name: "& "'" & gridColumnName &  "'" & " in Grid"& gridTitle
		Set objWindow= SetSAPwindowObj(blnIsItPopup)
		Set objGuiGrid201=SAPGuisession(sessionObject).sapguiwindow(windowObject).SAPGuiGrid("guicomponenttype:=201","title:="&gridTitle,"index:="&gridIndex)
		Set objGuiGrid80=SAPGuisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","title:="&gridTitle,"index:="&gridIndex)
		Set objGuiGrid=SetObj(objGuiGrid201,objGuiGrid80)
		
	    If objGuiGrid.Exist then
		   On Error Resume Next

			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,True)
				Err.Clear
			End if
					   objGuiGrid.SelectCell gridRowNumber,gridColumnName
			 				If Err.Number=-2147220983 Then
                                   Call ReporterFunction(strLibraryFileName,"SetMultipleGridData","1","Grid Data Field","The column "&gridColumnName&" does not exist")
								   strStatus = "FAIL"
								   strmsg = "The column '"&gridColumnName&"' does not exist"
                                   blnObjectError=True
								   Err.Clear
						    ElseIf Err.Number=0 Then
						           If cellValue=DS_BLANK Then
									  objGuiGrid.SetCellData  gridRowNumber,gridColumnName,""
								   Else
									  objGuiGrid.SetCellData  gridRowNumber,gridColumnName,cellValue
									  wait 10
									 
								   End If
								   If Err.Number=-2147220476 Then
									  	Call ReporterFunction(strLibraryFileName,"SetMultipleGridData","1","Grid Data Field","The column "&gridColumnName&" is not editable")
								   strStatus = "FAIL"
								   strmsg = "The column '"&gridColumnName&"'  is not editable"
                                   
									Else
								   Call ReporterFunction(strLibraryFileName,"SetMultipleGridData","2","Grid Data Field","Value Used :-" & vbNewLine  &"Row Field: "&gridRowNumber & vbNewLine &"Column Field: "&gridColumnName & vbNewLine &" ValueField: "&strValue)
								   strStatus = "DONE"
								   strmsg = "The GuiGrid "&gridTitle&" set successfully"
								   End If
						    End If

    else 
				           Call ReporterFunction(strLibraryFileName,"SetMultipleGridData","1","Grid Data Field","Object Missing")
					       strStatus = "FAIL"
					       strmsg = "Grid Not Found- Please Check the Screen"
				           blnObjectError=True
   End If
                           If  blnObjectError  Then
						       Environment.Value("blnFatalError")=True
						   End If

	                       If strStatus = "FAIL"  Then
							  SetGridData = strMsg
							  blnMainFailFlag = True
		                      ImagePath=CaptureScreenshot(strStepName,objGuiGrid,False,False,True)
	                       Else
							SetGridData = True
						   End If
						   If blnDefault_eSwiftReporting Then  
		                      Call UpdateResultHtml(strStepName,cellValue,strMsg,strStatus,"")
						   End If
   
   End If

Set objGuiGrid201=Nothing
Set objGuiGrid80=Nothing
Set objGuiGrid=Nothing
Set objWindow=Nothing

End Function
'************************************************************************************
'End Function - SetMultipleGridData
'************************************************************************************


'*****************************************************************************************
'Name of the Function   : SelectRadioButtonIfExist
'Description		     : Selects Radio Button on a normal window with guicomponent=21. It uses index propert to handle multiple radio button with similar properties.
'Input Parameters	     :  radiobuttonName:Name property of the radio button
'                                            :radiobuttonIndex:index of the radio button
'					 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'												=Yes - if it is popup ;   No/""=If it is main SAP  window
'Output Parameters        :Null
'***********************************************************************************
'Function SelectMultipleRadioButton(radiobuttonName,radiobuttonIndex,blnIsItPopup)
'************************************************************************************
Function SelectRadioButtonIfExist(radiobuttonName,radiobuttonIndex,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRadioButtonIfExist"
'If radiobuttonAttachedtext <> "" Then
'   strStepName ="Select Radio Button: " & radiobuttonAttachedtext
'else
   strStepName ="Select Radio Button: " & radiobuttonName
'End If
If radiobuttonAttachedtext <> "" or radiobuttonName <> "" then
Set objWindow= SetSAPwindowObj(blnIsItPopup)
Set objRadioButton= SAPGuiSession(sessionObject).SAPGuiWindow(objWindow).SAPGuiRadioButton("guicomponenttype:=41","name:="&radiobuttonName,"index:="&radiobuttonIndex)
          If objRadioButton.Exist Then
          'blnObjectFound=True
						If VerifyObjectStatus(objRadioButton)=True Then
									If VerifyRadioButton(objRadioButton)=False Then
											  objRadioButton.Set
											  Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfExist","2","RadioButton","Value Used :-"& vbNewLine &"RadioButtonName: " &radiobuttonName)
											   strStatus = "DONE"
											   strMsg="Radiobutton selected successfully"
									Else
											   Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfExist","2","RadioButton","Radio button is already selected")
											   strStatus = "DONE"
											   strMsg = "Radio button is already selected"
											   
									End If
									If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  						ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	          						End if
						Else
									blnObjectError=True
									Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfExist","1","RadioButton","Radio Button  with "& vbNewLine &"RadioButtonName: " &radiobuttonName  &" is not enabled.So cannot be set.")
									strStatus = "FAIL"
									strMsg = " The RadioButton Object is not enabled, Please verify the Screen"
									
						End If
	      else 
'	      				blnObjectError=True
'				        Call ReporterFunction(strLibraryFileName,"SelectMultipleRadioButton","1","RadioButton","RadioButton Object Missing")
'						strStatus="FAIL"
'						strMsg = " The RadioButton Object is not Found, Please verify the Screen"

		  End if
		  else
		  Call ReporterFunction(strLibraryFileName,"SelectRadioButtonIfExist","1","RadioButton","Function Parameter Not Passed Properly. Check the --SelectRadioButtonIfExist-- Function Call-")
						strStatus="FAIL"
						strMsg = " Function Parameter Not Passed Properly. Check the --SelectRadioButtonIfExist-- Function Call-"
						End If
	   If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectRadioButtonIfExist = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objRadioButton,False,False,True)
	   Else
		    SelectRadioButtonIfExist = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,"",strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeCoordinates(objRadioButton)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objRadioButton=nothing
Set objWindow=Nothing
End If
End Function
'*****************************************************************************************
'EndFunction - SelectRadioButtonIfExist
'******************************************************************************************


''**********************************************************************************
'Name of the Function   :  SelectAllRowGuiGrid
'Description		     : Selects all rows in a SAP Gui Grid        
'Input Parameters	     : gridTitle : Title property of the GuiGrid 
'												 blnIsItPopup-A  parameters whiich  checks if the SAP window is main window or a popup 
'																			=Yes - if it is popup ;   No/"" =If it is main SAP  window                                      
'Output Parameters        :Null
'***********************************************************************************
'Function SelectAllRowGuiGrid(gridTitle,columnName,refValue)
'***********************************************************************************
Public Function SelectAllRowGuiGrid(gridTitle,gridIndex,blnIsItPopup)
If Not (Environment.Value("blnFatalError")) Then
	   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : SelectRowGuiGrid"
Dim objGridGuiComp80,objGridGuiComp201,objGrid

Set objWindow= SetSAPwindowObj(blnIsItPopup)
strStepName = "Select All Rows in GuiGrid" 
If blnIsItPopup<> ""  then
Set objGridGuiComp80 = sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=80","name := shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGridGuiComp201= sapguisession(sessionObject).sapguiwindow(objWindow).SAPGuiGrid("guicomponenttype:=201","name:=shell.*","title:="&gridTitle,"index:="&gridIndex)
Set objGrid=SetObj(objGridGuiComp80,objGridGuiComp201)
		If objGrid.Exist Then
			On error resume Next
'					strRowNumber=objGrid.FindRowByCellContent(columnName,refValue)
            		If Err.Number=0 Then
						objGrid.SelectAll
						If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  				ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	          			End if
						Call ReporterFunction(strLibraryFileName,"SelectAllRowGuiGrid","2","SelectAllRowGuiGrid","All Rows Selected")
						strMsg="Row number [" & strRowNumber & "] selected in GuiGrid."
						strStatus = "DONE"
'					ElseIf Err.Number=-2147220983 Then
'						Call ReporterFunction(strLibraryFileName,"SelectAllRowGuiGrid","1","SelectAllRowGuiGrid","The Column:  "&columnName& " Not Found Within The GuiGrid")
'						 strStatus = "FAIL"
'						 strMsg = "Column ["&columnName& "] Not Found Within The GuiGrid"
'						 blnObjectError=True
'					Else 
'						blnObjectError=True
'						Call ReporterFunction(strLibraryFileName,"SelectAllRowGuiGrid","1","SelectAllRowGuiGrid","Value "&refValue&" Not Found Within The Column :"&columnName& " of GuiGrid")
'						strStatus = "FAIL"
'						strMsg ="Value ["&refValue& "] Not Found Within The Column [" & columnName & "] of GuiGrid"
						
					End If
		Else 
			blnObjectError=True
			Call ReporterFunction(strLibraryFileName,"SelectAllRowGuiGrid","1","SelectAllRowGuiGrid","GuiGrid Object Not Found,Please verify the Screen")
		    strStatus = "FAIL"
			strMsg = "GuiGrid Object Not Found,Please verify the Screen"
			
		End If
Else
	Call ReporterFunction(strLibraryFileName,"SelectAllRowGuiGrid","1","SelectAllRowGuiGrid","Function Parameter Not Passed Properly. Check the --SelectAllRowGuiGrid-- Function Call")
	strStatus = "FAIL"
	strMsg = "Function Parameter Not Passed Properly. Check the --SelectAllRowGuiGrid-- Function Call"
End if				
       If  blnObjectError  Then
		    Environment.Value("blnFatalError")=True
	   End If

	   If strStatus = "FAIL"  Then
		    SelectAllRowGuiGrid = strMsg
		    blnMainFailFlag = True
		    ImagePath=CaptureScreenshot(strStepName,objGrid,False,False,True)
	   Else
		    SelectAllRowGuiGrid = strMsg
	   End If
	
	   If blnDefault_eSwiftReporting Then  
		   Call UpdateResultHtml(strStepName,refValue,strMsg,strStatus,"")
	   End If
 ' //////////Word Document ///////////
'				If blnCreateTrainingDoc Then
'					Check=CheckStatus_Doc(strStatus)
'					If Check=1 Then
'						Call storeTableorGridCoordinates(objGrid)
'						Call StoreSteps(strStepName)
'					End If
'				End If
 ' //////////Word Document ///////////
Set objGrid=Nothing
Set objWindow=Nothing
Set objGridGuiComp80=Nothing
Set objGridGuiComp201=Nothing
End If
End Function
'************************************************************************************
'End Function - SelectAllRowGuiGrid
