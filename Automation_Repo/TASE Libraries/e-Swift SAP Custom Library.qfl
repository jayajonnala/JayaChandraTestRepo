'***********************************************************************************
'Name of the Function   : LaunchSAPConnection(fileName,connectionString)
'Author     :Niranjan
'Modified By : Nikhil
'Description     : Launch SAP
'  fileName :  Location of SAP Logon executable file . 
'       connectionString :-  Description for SAP Server name in the SAP Log on Pad  in local machine
'Input Parameters     : ConnectionString
'Output Parameters      :
'Creation Date : 15/11/2010
'Modification Date : 2/12/2011
'Modified By : Mrudula Gopal
'Modified On: 26/Oct/2015
'***********************************************************************************
'Function LaunchSAPConnection(fileName,connectionString)
'***********************************************************************************
Function LaunchSAPConnection(fileName,connectionString)


If Not (Environment.Value("blnFatalError") ) Then ' Included this line just in case there is any fatal error before this function is called.
If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LaunchSAPConnection"
'ConnectionString = InputValidation(connectionString)' Commented this line as the variable value will be assiged to variable connectionString from the StartExecution Function itself.
CloseSessionsSAP()
'Lauches SAP connection based on the IP. If fails, tries to launch after opening the logon pad from the filename location and then opens the connection string
on error resume next
err.clear
SAPGuiUtil.OpenConnectionByIP(connectionString)
If err.number<>0 Then
SystemUtil.Run fileName,"","","Open"
Set SAPWindow = Window("regexpwndtitle:=SAP.*", "regexpwndclass:=SAP_FRONTEND_SESSION")
If Not SAPWindow.Exist(0) Then SAPGuiUtil.OpenConnection(connectionString)
End If
End If
End Function
'======= End of modified function======

'***********************************************************************************
'Name of the Function   : CloseSessionsSAP()
'Author		     						:Niranjan
'Description		    		 : Close SAPSessions 
'Creation Date : 15/11/2010
'***********************************************************************************
'Function CloseSessionsSAP()
'***********************************************************************************
Function CloseSessionsSAP()

If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CloseSessionsSAP"
	Do
		   Closed = False
		   Set TempSAP = SAPGuiSession("type:=GuiSession","index:=0")
		   If TempSAP.Exist(2) Then
                TempSAP.Close
				Closed = True
		   End If
   Loop Until Closed = False
End Function
'************************************************************************************
'End Function - CloseSessionsSAP
'************************************************************************************


'**********************************************************************************


'Name of the Function   : Login
'Author     :Ankita
'Description     : Login into SAP R/3
'       username :- valid username
'       password :-valid Password
'Input Parameters     : username,password
'Output Parameters      :Null
'Creation Date : 26/10/2010
'Modified By : Mrudula Gopal
'Modified  Date: 26/10/2015
'***********************************************************************************
'Function Login(username,password)
'***********************************************************************************
'========= Modified function-LOGIN====================


Function Login(username,password)
If Not (Environment.Value("blnFatalError") )Then ' Checking for the fatal error
If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : Login"
    strFuncName = "Login"
strStepName = "Enter User Name : "&username&" and Password : ********"
strInputValue= username&" ********"
     Set objUserName= sapguisession(sessionObject).sapguiwindow(windowObject).sapguiedit(usernameField)
Set objPassword= sapguisession(sessionObject).sapguiwindow(windowObject).sapguiedit(passwordField)
 If  objUserName.Exist  and objPassword.Exist Then
             If username <> "" and password <> "" Then
 If IsNull(username)=True OR IsNull(password)=True Then
Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,"Function Parameter Not Passed Properly. Check the --Login-- Function Call")
                            strStatus = "FAIL"
                            strMsg = "Function Parameter Not Passed Properly. Username Value or Password Value Is Null.Check the --Login-- Function Call"
                      else
If DT_SAPSYSTEM = "RGB - SAP RETAIL Sandbox GLOBAL" Or DT_SAPSYSTEM = "RGD - SAP RETAIL Development GLOBAL" then 
'"guicomponenttype:=32","attachedtext:="&textboxAttachedText,"name:="&textboxName,"Index:="&textboxIndex
Set objClient= sapguisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=31","name:=RSYST-MANDT")
objClient.Set "401"

End If 

If DT_SAPSYSTEM = "R1P - SAP RETAIL Production EUROPE"  then 
'"guicomponenttype:=32","attachedtext:="&textboxAttachedText,"name:="&textboxName,"Index:="&textboxIndex
Set objClient= sapguisession(sessionObject).sapguiwindow(windowObject).sapguiedit("guicomponenttype:=31","name:=RSYST-MANDT")
objClient.Set "200"
End If 


objUserName.Set username
objPassword.SetSecure password
                            If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
ImagePath=CaptureScreenshot(strStepName,sapguisession(sessionObject).sapguiwindow(windowObject),True,False,False)' Taking the snapshot of the complete window
End if
Call ReporterFunction(strLibraryFileName,strFuncName,"2",strStepName,"Values Used:"& vbNewLine &" Username:"&username&""&vbNewLine&" Password: "&password)
strStatus = "DONE" ' 
strMsg=" Username and Password entered in the login page"
                     End If
 else 
              Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,"Function Parameter Not Passed Properly. Check the --Login-- Function Call")
                strStatus = "FAIL"
                strMsg = "Function Parameter Not Passed Properly. Check the --Login-- Function Call"
        End If
 else 
       Call ReporterFunction(strLibraryFileName,strFuncName,"1",strStepName,"Objects Missing")
  strStatus="FAIL"
       strMsg = " The Object is not Found, Please verify the Screen"
  blnObjectError=True ' added this variable for the failed case
 End If
 If  blnObjectError  Then
Environment.Value("blnFatalError")=True
 End If
 If strStatus = "FAIL"  Then
Login = strMsg
blnMainFailFlag = True
ImagePath=CaptureScreenshot(strStepName,sapguisession(sessionObject).sapguiwindow(windowObject),True,False,False)
Else
Login = True
End If
If blnDefault_eSwiftReporting Then  
Call UpdateResultHtml(strStepName,strInputValue,strMsg,strStatus,"")
End If
 Set objUserName=Nothing
 Set objPassword=Nothing
End if
End Function
'================ End of Function===================

'**************************************************************************************
'Name of the Function   : SetSAPwindowObj()
'Description		     : Assigns popupwindow object if it  exists else assigns normal window object.
'Input Parameters	     : blnIsItPopup - Flag for checking if popup window is present or not.                                        
'Output Parameters        : Object
'**********************************************************************************
Function SetSAPwindowObj(blnIsItPopup)
     If blnIsItPopup Then
	    Set SetSAPwindowObj=windowObject1
	    Set objSAPwindow=windowObject1
	 Else
		Set SetSAPwindowObj=windowObject
		Set objSAPwindow=SAPwindowObject
	 End If
End Function
'************************************************************************************
'End Function - SetSAPwindowObj()
'***********************************************************************************

'**************************************************************************************
'Name of the Function   : SetObj()
'Author		     : Ritu
'Description		     : Assigns object1 to object if object1 exists else assigns object2 to object
'Input Parameters	     : object1 , object2                                        
'Output Parameters        : Object
'Creation Date : 28/11/2011
'**********************************************************************************
Function SetObj(obj1,obj2)
  If obj1.Exist Then
	  Set SetObj= obj1
	  Else Set SetObj=obj2
  End If
'Set SetObj= object
End Function
'************************************************************************************
'End Function - SetObj()
'***********************************************************************************

'**************************************************************************************************************
'Name of the Function   :  VerifyObjectStatus
'Author		     : Nikhil
'Date 			: 18/ Nov/2011	
'Description		     :  This function verifies whether an SAP object (Textbox,Checkbox,RadioButton)  is Enabled or not.                                 
'Input Parameters	     :  ObjToBeVerified :-  An SAP object that needs to be verified
' Output Parameters        : Null
'Example					:     VerifyObjectStatus(obj)  
'**************************************************************************************************************
'Function VerifyObjectStatus(obj)  
'**************************************************************************************************************
Public Function VerifyObjectStatus(objToBeVerified)
    If objToBeVerified.GetROProperty("enabled") Then
		VerifyObjectStatus = true
	Else
		VerifyObjectStatus = false
   	End If
End Function

'**************************************************************************************************************
'End Function VerifyObjectStatus(obj)  
'**************************************************************************************************************

Function LogOff()

	If Not (Environment.Value("blnFatalError") ) Then ' Included this line just in case there is any fatal error before this function is called.
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : LogOff"
   Set objPopup = SAPGuiSession(sessionObject).SAPGuiWindow(windowObject1)
		Do While objPopup.Exist
			objPopup.Close
		Loop
   Call SetTcode("ex")
   SAPGuiSession(sessionObject).SAPGuiWindow(windowObject).SendKey ENTER
   End If
End Function


'Name of the Function   :getEnvironmentVariable(variable)
'Author		     :Nishanth
'Description		     : Fetches the Value from the Environment Variable'	        
'Input Parameters	     :  Environment Varible Name
'Output Parameters        : Value of the Environment Variable.
'Creation Date : 26/11/2010
'***********************************************************************************
 'Function getEnvironmentVariable(variable)
'***********************************************************************************

Function getEnvironmentVariable(Variable)
   Set WshShell = CreateObject("WScript.Shell")
   Set WshEnv = WshShell.Environment("USER")
       tmp = WshEnv(Variable)
      getEnvironmentVariable = tmp
	  Set WshShell = nothing
      Set WshEnv = nothing
End Function

'************************************************************************************
'End Function - getEnvironmentVariable




'**********************************************************************************
'Name of the Function   : CheckTCodeScreen
'Author		     :Subhrajyoti S
'Description		     : Screen Validations			        
'Input  Parameters	     : tcode - valid  SAP Transaction Code
  '                                          
'Output Parameters        :
'Creation Date : 
'***********************************************************************************
'Function CheckTCodeScreen(tcode)
'***********************************************************************************8
Public Function CheckTCodeScreen(tcode)

  If Not (Environment.Value("blnFatalError")) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : CheckTCodeScreen"
	
 strStepName  = "Screen TCode Validation for " & tcode

SAPScreen_text = SAPGuiSession(sessionObject).SAPGuiWindow(windowObject).GetROProperty("transaction") '--- Added by Subhrajyoti
 If instr(1, UCASE(SAPScreen_text ), UCASE(tcode), vbTextCompare) Then
	Call ReporterFunction(strLibraryFileName,"CheckTCodeScreen","0","SAP Screen ","Validation : Passed")
    strStatus = "PASS" 
	strMsg = "TCode is as per expected :" & tcode
	blnCaptureFlag= True
	 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
		   ImagePath=CaptureScreenshot("<SKIPSTEP>",windowObject,False,False,False)
'		   ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
	End If 
 else 
	Call ReporterFunction(strLibraryFileName,"CheckTCodeScreen","1","SAP Screen ","Validation : The screen did not pass the Tcode Validation")
    strStatus = "FAIL" 
	blndefectFlag =True
	strMsg = "Validation : The screen did not pass the Validation"
 end if 
	     
	     
	  If  blnObjectError  Then
		Environment.Value("blnFatalError")=True
		
	End If

	If strStatus = "FAIL"  Then
		CheckTCodeScreen = strMsg
		blnMainFailFlag = True
		ImagePath=CaptureScreenshot("<SKIPSTEP>",windowObject,False,False,False)
'		ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
	Else
		CheckTCodeScreen = True
	End If
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
          
 End If 
End Function


''*********************************************************************************
'Functions Definition
'**********************************************************************************
'Name of the Function   : TakeScreenShot
'Author		     :Subhrajyoti S
'Description		     : Capture screenshot and update in report    
'Input Parameters	     :  Null
'Output Parameters        : Null
'Creation Date : 05:10:2020
'***********************************************************************************
'Function TakeScreenShot
'***********************************************************************************

Function TakeScreenShot()
 If Not (Environment.Value("blnFatalError") or Content= DS_SKIP) Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now : TakeScreenShot"
	
	strStepName = "Take ScreenShot "
	Set SAPWindowObj=SAPGuiSession(sessionObject).SapGuiWindow(windowobject)
	blnCaptureFlag= True
	 If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
'		   ImagePath=CaptureScreenshot(strStepName,objStatusBar,False,False,False)
		    ImagePath=CaptureScreenshot(strStepName,"",False,False,False)
'		   ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
	End If 
   	If Err.Number = 0 then   
		   strStatus = "DONE"
		   strMsg="Screenshot was captured. "	
		   Call ReporterFunction(strLibraryFileName,"TakeScreenshot","2"," Take Screenshot",strMsg)	
		 Else 
		  strStatus = "FAIL"
		   strMsg="Screenshot was not captured. "	
		   Call ReporterFunction(strLibraryFileName,"TakeScreenshot","2"," Take Screenshot",strMsg)	
		 End If
	
	If blnDefault_eSwiftReporting Then  
		Call UpdateResultHtml(strStepName,Content,strMsg,strStatus,"")
	End If
	
		  
	End If
End Function


''************************************************************************************
'End Function - TakeScreenShot
