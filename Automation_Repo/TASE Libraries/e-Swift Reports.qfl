	On  error resume Next
	Set oWord=createObject("Word.Application")
	oWord.Documents.Open(gstrScreenShotDocument) 
	oWord.Visible= False
	oWord.Selection.TypeParagraph
	oWord.Selection.Font.Bold = True
	oWord.Selection.Font.Name = "Cambria"
	oWord.Selection.Font.Color =16757350 
	oWord.Selection.Font.Size=18
	oWord.Selection.Typetext vbTab & Vbtab & vbtab & vbtab &"Test Scenario Training Manual"  
	oWord.Selection.Font.Color = -587137025
	oWord.Selection.Font.Size=11
	oWord.ActiveDocument.Save
	oWord.quit
	Set oWord=Nothing
End Function


Public Function InsertImage_MultipleSteps(strImagePath)
                On  error resume Next
    Set oWord = CreateObject("Word.Application")             ' oWord  variable  contains the word object for the screenshot
	Dim j :j=0
	
	If Err.number =429  Then
						   Err.Clear    
							Call InsertImage_OpenOffice(strScreenName,strImagePath)
							Exit function 
	End If
	 oWord.Documents.Open(gstrScreenShotDocument)
					'/
					ReDim Preserve TestNameArray(Ubound(TestNameArray)+1)
					TestNameArray(Ubound(TestNameArray))=TestName
					If Ubound(TestNameArray)=1 or (Ubound(TestNameArray)>=2 and TestNameArray(Ubound(TestNameArray)-1) <>TestNameArray(Ubound(TestNameArray))) Then
					j=j+1
					strTestName=TestNameArray(Ubound(TestNameArray))
					oWord.Selection.EndKey 6, 0
					oWord.Selection.TypeParagraph
					oWord.Selection.Font.Bold = True
					oWord.Selection.Font.Size=12
                    oWord.Selection.Font.Name = "Cambria"
					oWord.Selection.Font.Color = 10046464  
					'oWord.Selection.Font.Color = 10498160
'					oWord.Selection.Typetext  " Test Case "&j&" : "& gstrTestCaseName
					oWord.Selection.Typetext  " Test Case " &": "& gstrTestCaseName
										oWord.Selection.Font.Color = -587137025
					oWord.Selection.Font.Bold = False
					End If
					'/
				If  gstrTestCaseName<>""Then
			
					ReDim Preserve Tcode(Ubound(Tcode)+1)
					Tcode(Ubound(Tcode))=gstrTestCaseName
					If Ubound(Tcode)>2 and Tcode(Ubound(Tcode)-1) =Tcode(Ubound(Tcode))Then
							strScreenName= "Continue with Tcode: "&Tcode(Ubound(Tcode))
					Else
							strScreenName= "Tcode: "&Tcode(Ubound(Tcode))
					End If
				End If
                   
					'oWord.ActiveDocument.Range.InsertParagraphAfter()
					oWord.Selection.EndKey 6, 0
					oWord.Selection.TypeParagraph
					oWord.Selection.Font.Bold = True
					oWord.Selection.Font.Size=11
					oWord.Selection.Font.Color = -587137025
					oWord.Selection.Typetext strScreenName
					oWord.Selection.Font.Bold = False
					'oWord.ActiveDocument.Range.InsertAfter strScreenName
					Set oDoc = oWord.ActiveDocument
					Set oRange = oDoc.content
					'oRange.ParagraphFormat.Alignment = 0
					'oRange.insertafter vbcrlf 
					oRange.collapse(0)
				   
                    oRange.InlineShapes.AddPicture strImagePath, False, True
				    height=275
					width=460
					ImageIndex=oDoc.InlineShapes.count
                    oDoc.InlineShapes(ImageIndex).Height =height
					oDoc.InlineShapes(ImageIndex).Width =  width
                    oDoc.InlineShapes(ImageIndex).Borders.OutsideLineStyle = wdLineStyleThinThickLargeGap
                    oDoc.InlineShapes(ImageIndex).Borders.OutsideLineStyle= wdLineWidth100pt
                    oWord.Selection.TypeParagraph
   				    oWord.ActiveDocument.Save
					oWord.Quit 	

			Set oWord = Nothing
			Set oDoc=Nothing
			Set oRange=Nothing
			If objFSO.FileExists(strImagePath) then
				objFSO.DeleteFile(strImagePath) 'Remove object screenshot post saving the word document.
			End If 
End Function

'-------------------------------code for Report conversion(summary and Detailed in WOrd and PDF)----------------------

Public Function createSummaryReportDoc(XMLpath,pdfFileRequired,graphType)
Dim tempChartPicturePath : tempChartPicturePath = gstrUISettingsXMLPath &"\chart.jpg"
Set gobjFso = createObject("Scripting.FileSystemObject")
Dim docPathToSave : docPathToSave = gobjFso.GetParentFolderName(XMLpath)&"\Execution Summary Report.doc"
Dim pdfOutputFile : pdfOutputFile = gobjFso.GetParentFolderName(XMLpath)&"\Execution Summary Report.pdf"
Set objWord = CreateObject("Word.Application")
objWord.Visible = False
Set objDoc = objWord.Documents.Add()
    Const wdHeaderFooterPrimary=1
	Const wdSeekMainDocument = 0
	Const wdSeekCurrentPageHeader = 9
	Const wdSeekCurrentPageFooter = 10
	Const wdPrintView = 3
		

objDoc.ShowSpellingErrors = False
objWord.DisplayAlerts = False
objDoc.Background.Fill.Visible = True
objDoc.Background.Fill.ForeColor.RGB = RGB(222, 222, 222)
objDoc.Background.Fill.Solid
'objWord.ActiveWindow.View.Type = wdWebLayout
'objDoc.ActiveWindow.ActivePane.View.Zoom.Percentage = 70
With objWord.ActiveDocument.PageSetup
    '.Orientation = wdOrientLandscape
    '.TopMargin = objWord.InchesToPoints(0.92)
    '.BottomMargin = objWord.InchesToPoints(0.92)
    .LeftMargin = objWord.InchesToPoints(0.7)
    .RightMargin = objWord.InchesToPoints(0.7)
    .PageWidth = objWord.InchesToPoints(11)
    .PageHeight = objWord.InchesToPoints(8.5)
End With
		

' --------------------------------------------- Loading Summary XML ----------------------------------------------
Dim totalIterationCount : totalIterationCount = 0
Dim passIterationCount : passIterationCount = 0
Dim failIterationCount : failIterationCount = 0
set objXml = CreateObject("Microsoft.XMLDOM")
objXml.Load(XMLpath)
set objIterationsList = objXml.SelectNodes("//execution-summary/Summary-Report/Iteration")
Set summaryNameNode =  objXml.SelectSingleNode("//execution-summary/Summary-Report/ScenarioName")
scenarioName = summaryNameNode.Text
For each objIteration in objIterationsList
		totalIterationCount = totalIterationCount + 1
		Set objIterationStatus = objIteration.SelectSingleNode("ExecutionStatus")
		If uCase(objIterationStatus.Text) = "PASS" Then
			passIterationCount = passIterationCount + 1
		ElseIf Ucase(objIterationStatus.Text) = "FAIL" Then
			failIterationCount = failIterationCount + 1
		End If
Next
Set objIterationsList = Nothing

'------------------------------------------- Creating Test Scenario title ------------------------------------------- 
Set objSelection = objWord.Selection
objSelection.TypeParagraph() 
Set objRange = objSelection.Range
objDoc.Tables.Add objRange, 1, 1
Set objTable = objDoc.Tables(1)
objTable.AutoFormat(16) 
With objTable        
			With .Cell(1, 1)
					 .Shading.BackgroundPatternColor = RGB(11,124,192)
					.Range.Font.TextColor = RGB(255,255,255)
					.Range.Font.Size = 09
					.Range.Font.Name = "Verdana"
					.Range.Font.Bold = false
					.Range.Text = scenarioName
					'.Range.ParagraphFormat.Alignment= 2
					'.Range.Text ="TCS - "& gstrCustomerName &" Confidential"
					.SetWidth 650,wdAdjustNone 
			End With   
End With

'----------------------- creating Summary title ---------------------------------------------------

objSelection.EndKey END_OF_STORY,0
set objSelection = objWord.Selection
objSelection.TypeParagraph() 
set objRange = objSelection.Range
objDoc.Tables.Add objSelection.Range, 1, 1
set objTable = objDoc.Tables(2)
'objTable.AutoFormat(16) 
With objTable        
				With .Cell(1, 1)
							.Range.Font.TextColor = RGB(0,95,153)
							.Range.Font.Size = 12
							.Range.Font.Name = "Verdana"
							.Range.Font.Bold = True
							.Range.Text = "Summary"
				            .SetWidth 90,wdAdjustNone 
				End With   
End With

'-----------------------------------creating summary table --------------------------------------------------------

objSelection.EndKey END_OF_STORY,0
Set objSelection = objWord.Selection
objSelection.TypeParagraph() 
set objRange = objSelection.Range
objDoc.Tables.Add objRange, 2, 5
set objTable = objDoc.Tables(3)
objTable.AutoFormat(16)
With objTable.Borders 
		 .InsideLineStyle = wdLineStyleSingle 
		 .OutsideLineStyle = wdLineStyleDouble 
End With
objTable.Rows(1).Cells.Merge
objTable.Cell(1, 1).Range.Text = "Iterations"
objTable.Cell(1, 1).Range.Font.Size = 11
objTable.Cell(1, 1).Range.Font.Name = "Verdana"
objTable.Cell(1, 1).SetWidth 650,wdAdjustNone 
For Each aBorder In objTable.Borders 
			 aBorder.Color = RGB(0,0,0)
			 'aBorder.LineStyle = wdLineStyleDashDot 
			 'aBorder.LineWidth = wdLineWidth075pt 
Next 
For Iterator = 1 To 5 Step 1
With objTable         
    With .Cell(2, Iterator)
        .Range.Font.TextColor = RGB(0,95,153)
        .Range.Font.Size = 11
		.Range.Font.Name = "Verdana"
        .Range.Font.Bold = True
		.SetWidth 130,wdAdjustNone
        .Range.ParagraphFormat.Alignment = wdAlignParagraphCenter		
    End With   
End With
Next
objTable.Cell(2, 1).Range.Text = totalIterationCount & " total"
objTable.Cell(2, 1).Range.Font.TextColor = 0
objTable.Cell(2, 2).Range.Text = passIterationCount&" pass" 
objTable.Cell(2, 2).Range.Font.TextColor = 32768
objTable.Cell(2, 3).Range.Text = failIterationCount&" fail"
objTable.Cell(2, 3).Range.Font.TextColor = 255
objTable.Cell(2, 4).Range.Text = (failIterationCount/totalIterationCount)*100&"% failure rate"
objTable.Cell(2, 4).Range.Font.TextColor = 255
objTable.Cell(2, 5).Range.Text = (passIterationCount/totalIterationCount)*100&"% success rate"
objTable.Cell(2, 5).Range.Font.TextColor = 32768
For Iterator = Instr(objTable.Cell(2, 1).Range.Text,"total") To Instr(objTable.Cell(2, 1).Range.Text,"total") + Len("total") Step 1
    objTable.Cell(2, 1).Range.Characters(Iterator).Font.Superscript = True      		
Next
For Iterator = Instr(objTable.Cell(2, 2).Range.Text,"pass") To Instr(objTable.Cell(2, 2).Range.Text,"pass") + Len("pass") Step 1
    objTable.Cell(2, 2).Range.Characters(Iterator).Font.Superscript = True      		
Next
For Iterator = Instr(objTable.Cell(2, 3).Range.Text,"fail") To Instr(objTable.Cell(2, 3).Range.Text,"fail") + Len("fail") Step 1
    objTable.Cell(2, 3).Range.Characters(Iterator).Font.Superscript = True      		
Next
For Iterator = Instr(objTable.Cell(2, 4).Range.Text,"failure rate") To Instr(objTable.Cell(2, 4).Range.Text,"failure rate") + Len("failure rate") Step 1
    objTable.Cell(2, 4).Range.Characters(Iterator).Font.Superscript = True      		
Next
For Iterator = Instr(objTable.Cell(2, 5).Range.Text,"success rate") To Instr(objTable.Cell(2, 5).Range.Text,"success rate") + Len("success rate") Step 1
    objTable.Cell(2, 5).Range.Characters(Iterator).Font.Superscript = True      		
Next


'----------------------------------- creating chart image--------------------------------------------------

set objExcel = CreateObject("Excel.Application")
objExcel.Visible = false
set objWorkbook = objExcel.Workbooks.Add
set objWorksheet = objWorkbook.Worksheets(1)
objWorksheet.Cells(1,1) = "Pass"
objWorksheet.Cells(2,1) = "Fail"
objWorksheet.Cells(1,2) = passIterationCount
objWorksheet.Cells(2,2) = failIterationCount
set objRange = objWorksheet.UsedRange
objRange.Select
set colCharts = objExcel.Charts
colCharts.Add()
set objChart = colCharts(1)
objChart.Activate
If graphType = "PIE" Then
		'objchart.PlotArea.Top = 50
		'objChart.ChartArea.bottom = 75
		'objChart.PlotArea.Height = objChart.ChartArea.Height*3/4
		'objChart.PlotArea.Width = objChart.ChartArea.width*3/4
		objChart.ChartType = Xlpie
		objChart.Legend.Font.Size = 30
		objChart.ApplyDataLabels xlDataLabelsShowvalue
		objChart.SeriesCollection(1).DataLabels.Font.Size = 30
		objChart.SeriesCollection(1).DataLabels.Font.Color = RGB(0,0,0) 
		objChart.Legend.Format.Line.Visible = True
		'objChart.Activate
    		objExcel.ActiveChart.SeriesCollection(1).Points.Item(1).Interior.ColorIndex = 10
		objExcel.ActiveChart.SeriesCollection(1).Points.Item(2).Interior.ColorIndex = 9
Elseif graphType = "BAR" Then
		'objChart.Axes(xlValue).Font.Size = 16
		'objChart.Axes(xlCategory).AxisTitle.Font.Name = "Times New Roman"
End if
objChart.Export tempChartPicturePath,"JPG"
objExcel.ActiveWorkbook.Close False
objExcel.Quit
set objExcel = Nothing

'---------------------------------------------  Inserting image -----------------------------------------
objSelection.EndKey END_OF_STORY,0
objSelection.TypeParagraph() 
set objRange = objSelection.Range
set objShape = objSelection.InlineShapes.AddPicture(tempChartPicturePath)
objShape.Borders.OutsideLineStyle = wdLineStyleSingle
objShape.Height = 130
objShape.Width = 170
'objShape.Range.Left = wdShapeRight
'Set objShapeRange = objDoc.Shapes.Range(1)
'objShapeRange.Left = wdShapeRight
'objShape.Select
'objWord.Selection.ParagraphFormat.Alignment = wdAlignParagraphCenter
objWord.ActiveDocument.SaveAs docPathToSave

'   ------------------------------------------------------------   Iteration Details ---------------------------------------------------------------------------------------------------------------------------------------
set objDoc = objWord.Documents.Open(docPathToSave)
set objIterationsList = objXml.SelectNodes("//execution-summary/Summary-Report/Iteration")
Dim iterationNumber : iterationNumber = 0
Dim executionTime : executionTime = 0
Dim executionStatus : executionStatus = ""
Dim testCaseName : testCaseName = ""
Dim noofRows : noofRows = 1
For each objCurrentIteration in objIterationsList
		iterationNumber = iterationNumber + 1
		index = 0
		Set executionTimeNode = objCurrentIteration.SelectSingleNode("ExecutionTime")
        	Set objIterationStatus = objCurrentIteration.SelectSingleNode("ExecutionStatus")
		executionTime = executionTimeNode.Text
		executionStatus = objIterationStatus.Text
		xmlParentFolderPath = gobjFso.GetParentFolderName(XMLpath)
		iterationFolderPath = xmlParentFolderPath&"\Iteration_"&iterationNumber

									' ------------------------------------------- Iteration title -----------------------------------------
									set objSelection = objWord.Selection
									objSelection.EndKey END_OF_STORY,0
									objSelection.ParagraphFormat.Alignment = wdAlignParagraphLeft
									objSelection.TypeParagraph()
									set objRange = objSelection.Range
									objWord.Selection.Tables.Add objRange, 1, 2
									set objTable = objDoc.Tables(4+((iterationNumber-1)*3))
									For Iterator = 1 To 2
													With objTable        
																	With .Cell(1, Iterator)
																					.Shading.BackgroundPatternColor = RGB(11,124,192)
																					.Range.Font.TextColor = RGB(255,255,255)
																					.Range.Font.Size = 10
																					.Range.Font.Name = "Verdana"
																					.Range.Font.Bold = True
																					If Iterator = 1 Then
																							.Range.Text = "Iteration"& iterationNumber &" - "& scenarioName
																					ElseIf Iterator = 2 Then
																							.Range.Text = "Execution Time : "& FormatNumber(executionTime,1) & " second(s)"
																					End If
																					.SetWidth 325,wdAdjustNone 
																	End With   
													End With    
									Next
									
									'-----------------------------------creating Test case table --------------------------------------------------------
									
									objSelection.EndKey END_OF_STORY,0
									Set objSelection = objWord.Selection
									objSelection.TypeParagraph() 
									set objRange = objSelection.Range
									objDoc.Tables.Add objRange, 2, 3
									Set objTable = objDoc.Tables(5+((iterationNumber-1)*3))
									objTable.AutoFormat(16)
									With objTable.Borders 
									 .InsideLineStyle = wdLineStyleSingle 
									 .OutsideLineStyle = wdLineStyleDouble 
									End With
									objTable.Rows(1).Cells.Merge
									objTable.Cell(1, 1).Range.Text = "Test cases"
									objTable.Cell(1, 1).Range.Font.Size = 10
									objTable.Cell(1, 1).Range.Font.Name = "Verdana"
									objTable.Cell(1, 1).SetWidth 240,wdAdjustNone 
									For Each aBorder In objTable.Borders 
											 aBorder.Color = RGB(0,0,0)
											 'aBorder.LineStyle = wdLineStyleDashDot 
											 'aBorder.LineWidth = wdLineWidth075pt 
									Next 
									For Iterator = 1 To 3 Step 1
											With objTable         
														With .Cell(2, Iterator)
																   ' .Shading.BackgroundPatternColor = RGB(11,124,192)
																	.Range.Font.TextColor = RGB(0,95,153)
																	.Range.Font.Size = 10
																	.Range.Font.Name = "Verdana"
																	.Range.Font.Bold = true
																	.SetWidth 80,wdAdjustNone
																	.Range.ParagraphFormat.Alignment = wdAlignParagraphCenter		
														End With   
											End With
									Next							
									Set objTotalTestCases = objCurrentIteration.SelectSingleNode("TotalTestCases")
									Set objPassTestCases = objCurrentIteration.SelectSingleNode("PassTestCases")
									Set objFailTestCases = objCurrentIteration.SelectSingleNode("FailTestCases")
									Set objTestCaseList = objCurrentIteration.SelectNodes("TestCase")
									objTable.Cell(2, 1).Range.Text = objTotalTestCases.Text &" total" 
									objTable.Cell(2, 1).Range.Font.TextColor = 0
									objTable.Cell(2, 2).Range.Text = objPassTestCases.Text &" pass"
									objTable.Cell(2, 2).Range.Font.TextColor = 32768
									objTable.Cell(2, 3).Range.Text = objFailTestCases.Text &" fail"
									objTable.Cell(2, 3).Range.Font.TextColor = 255
									For Iterator = Instr(objTable.Cell(2, 1).Range.Text,"total") To Instr(objTable.Cell(2, 1).Range.Text,"total") + Len("total") Step 1
										objTable.Cell(2, 1).Range.Characters(Iterator).Font.Superscript = True      		
									Next
									For Iterator = Instr(objTable.Cell(2, 2).Range.Text,"pass") To Instr(objTable.Cell(2, 2).Range.Text,"pass") + Len("pass") Step 1
										objTable.Cell(2, 2).Range.Characters(Iterator).Font.Superscript = True      		
									Next
									For Iterator = Instr(objTable.Cell(2, 3).Range.Text,"fail") To Instr(objTable.Cell(2, 3).Range.Text,"fail") + Len("fail") Step 1
										objTable.Cell(2, 3).Range.Characters(Iterator).Font.Superscript = True      		
									Next
									
									' -------------------------------------------- creating testcase list ------------------------------------------------------------------------------------------------------------
									testCaseName = ""
									noofRows = (objTotalTestCases.Text/2)+1
									objSelection.EndKey END_OF_STORY,0
									Set objSelection = objWord.Selection
									objSelection.ParagraphFormat.Alignment = wdAlignParagraphLeft
									objSelection.TypeParagraph()
									set objRange = objSelection.Range
									objWord.Selection.Tables.Add objRange, noofRows, 2
									Set objTable = objDoc.Tables(6+((iterationNumber-1)*3))
									Set objTestCaseList = objCurrentIteration.SelectNodes("TestCase")
									Dim rowNum : rowNum = 1
									Dim colNum : colNum = 1
									For each objTestCase in objTestCaseList
																Set objTestCaseStatus = objTestCase.SelectSingleNode("Status")
																index=index+1		
																testCaseName = "Test Case " & index & " - " & split(objTestCase.GetAttribute("id"),"_")(0)
																If colNum > 2 Then
																		rowNum =  rowNum+1
																		colNum = 1
																End If
																With objTable        
																					With .Cell(rowNum,colNum)
																									
																									'With objword.ActiveDocument.Styles("Hyperlink").Font
																									'			.Name = "Verdana"
																									'			.Underline = wdUnderlineSingle
																									'			If objTestCaseStatus.Text = "FAIL" Then
																									'				.Color = RGB(255,0,0)
																									'			Else
																									'				.Color = 32768
																									'			End If
																									'			.Size = 16
																									'End With
																									'objword.ActiveDocument.Styles("Hyperlink").BaseStyle = "Default Paragraph Font"
																									If gobjFso.FileExists(iterationFolderPath&"\e-Swift Detailed Report.doc") Then
																													set objLink = objDoc.Hyperlinks.Add(objTable.Cell(rowNum,colNum).Range, "Iteration_"&iterationNumber&"\e-Swift Detailed Report.doc", , ,testCaseName)
																									Elseif  gobjFso.FileExists(iterationFolderPath&"\e-Swift Detailed Report.docx") Then
																													set objLink = objDoc.Hyperlinks.Add(objTable.Cell(rowNum,colNum).Range, "Iteration_"&iterationNumber&"\e-Swift Detailed Report.docx", , ,testCaseName)
																									Elseif  gobjFso.FileExists(iterationFolderPath&"\e-Swift Detailed Report.pdf") Then
																													set objLink = objDoc.Hyperlinks.Add(objTable.Cell(rowNum,colNum).Range, "Iteration_"&iterationNumber&"\e-Swift Detailed Report.pdf", , ,testCaseName)
																									Else
																													set objLink = objDoc.Hyperlinks.Add(objTable.Cell(rowNum,colNum).Range, "Iteration_"&iterationNumber&"\e-Swift Detailed Report.html", , ,testCaseName)
																									End If
																									With objLink
																										.Range.Font.Size = 8
																										.Range.Font.Name = "Verdana"
																									If objTestCaseStatus.Text = "FAIL" Then
																													.Range.Font.TextColor = RGB(255,0,0)
																												Else
																													.Range.Font.TextColor = 32768
																												End If
																									
																									End with
																									.SetWidth 250,wdAdjustNone
																									.Range.ListFormat.ApplyBulletDefault
																									colNum = colNum + 1 
																					End With
																End With
									Next

Set executionTimeNode = Nothing
Set objIterationStatus = Nothing
objWord.ActiveDocument.Save
Next
for itr = 1 To iterationNumber 
set objTable = objDoc.Tables(4+((itr-1)*3))
	objTable.Cell(1,2).Select
	objWord.Selection.ParagraphFormat.Alignment = wdAlignParagraphRight        
Next
objWord.ActiveDocument.Save
objShape.Select
objWord.Selection.ParagraphFormat.Alignment = wdAlignParagraphCenter  
Set summaryNameNode = Nothing

'' ---------------------------------------------------------------------------------------------  Updations completed ------------------------------------------------------------------------------------------------------


'Move the page to print view as headers and footers can only be added in print view
		
	objDoc.ActiveWindow.ActivePane.View.Type = wdPrintView
		'Select the footer view and add the footer
	Set oSelection= objWord.Selection
	objDoc.ActiveWindow.ActivePane.View.SeekView = wdSeekCurrentPageFooter
	objDoc.Sections(1).Footers(wdHeaderFooterPrimary).Range.Select 
'	With oSelection
'	.Font.Size ="8"
'		.Font.Bold = False
'		.ParagraphFormat.Alignment=0
'		.TypeText "TCS - "& gstrCustomerName &" Confidential"
'		.TypeText vbCrLF
'    End with
	footerText= "TCS - "& gstrCustomerName &" Confidential"
	objWord.Selection.TypeText footerText
	oSelection.EndKey END_OF_STORY




objWord.ActiveDocument.Save
if pdfFileRequired Then
	objDoc.SaveAs pdfOutputFile, wdFormatPDF
End if

objDoc.Close WdDoNotSaveChanges
Objword.Quit WdDoNotSaveChanges
set objDoc = Nothing
set objWord = Nothing
If pdfFileRequired and not(gblnCreateDetailedAndSummaryReportDoc) Then
	gobjFso.DeleteFile(docPathToSave)
End if
End Function



Public function createDetailedReportDoc(XMLpath,pdfFileRequired)
'Dim XMLpath : XMLpath = "C:\Users\343926\Desktop\Result_ProcureToPay Cycle_Scenario_11.19.2015_4.20.16 PM\e-Swift Summary Details.xml"
Set gobjFso = createObject("Scripting.FileSystemObject")
Set objWord = CreateObject("Word.Application")
objWord.Visible = False

objWord.DisplayAlerts = False
	
Set objDoc = objWord.Documents.Add
Const wdHeaderFooterPrimary=1
Const wdSeekMainDocument = 0
Const wdSeekCurrentPageHeader = 9
Const wdSeekCurrentPageFooter = 10
Const wdPrintView = 3

' --------------------------------------------- Loading Summary XML ----------------------------------------------
Dim totalIterationCount : totalIterationCount = 0
Dim passIterationCount : passIterationCount = 0
Dim failIterationCount : failIterationCount = 0
set objXml = CreateObject("Microsoft.XMLDOM")
objXml.Load(XMLpath)
set objIterationsList = objXml.SelectNodes("//execution-summary/Detailed-Report/Iteration")
Set summaryNameNode =  objXml.SelectSingleNode("//execution-summary/Summary-Report/ScenarioName")
scenarioName = summaryNameNode.Text
Dim currentIterationNumber : currentIterationNumber = 0
For each objIteration in objIterationsList
											currentIterationNumber = currentIterationNumber + 1
											If gobjFso.folderExists(gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber) Then
												docPathToSave =	gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber&"\e-Swift Detailed Report.doc"
												pdfOutputFile = gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber&"\e-Swift Detailed Report.pdf"
											Else
												docPathToSave = gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber&" e-Swift Detailed Report.doc"
												pdfOutputFile = gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber&"e-Swift Detailed Report.pdf"
											End if
											Set objDoc = objWord.Documents.Add()
											objDoc.ShowSpellingErrors = False
											'objDoc.Background.Fill.Visible = True
											'objDoc.Background.Fill.ForeColor.RGB = RGB(222, 222, 222)
											'objDoc.Background.Fill.Solid
											With objWord.ActiveDocument.PageSetup
													.LeftMargin = objWord.InchesToPoints(0.7)
													.RightMargin = objWord.InchesToPoints(0.7)
													.PageWidth = objWord.InchesToPoints(13)
													.PageHeight = objWord.InchesToPoints(10)
											End With
											objWord.ActiveDocument.SaveAs docPathToSave
											'------------------------------------------- Creating Test Iteration title ------------------------------------------- 
											Set objSelection = objWord.Selection
											objSelection.EndKey END_OF_STORY,0
											objSelection.TypeParagraph() 
											Set objRange = objSelection.Range
											objDoc.Tables.Add objRange, 1, 1
											Set objTable = objDoc.Tables(objDoc.Tables.count)
											objTable.AutoFormat(16) 
											With objTable        
													With .Cell(1, 1)
															.Shading.BackgroundPatternColor = RGB(11,124,192)
															.Range.Font.TextColor = RGB(255,255,255)
															.Range.Font.Size = 16
															.Range.Font.Name = "Verdana"
															.Range.Font.Bold = True
															.Range.Text = "Iteration "& currentIterationNumber& " - " & scenarioName
															'.Range.Font.Bold = false
															'.Range.ParagraphFormat.Alignment= 2
															'.Range.Font.Size = 9
															'.Range.Text ="TCS - "& gstrCustomerName &" Confidential"
															.SetWidth 750,wdAdjustNone 
													End With   
											End With
											Set testCaseNodeList = objIteration.SelectNodes("TestCase")
											Dim presentTestCaseNumber : presentTestCaseNumber = 0
											For Each objTestCaseNode in testCaseNodeList 
																					presentTestCaseNumber = presentTestCaseNumber + 1
																					'----------------------- creating Test Case title ---------------------------------------------------
																				
																					objSelection.EndKey END_OF_STORY,0
																					set objSelection = objWord.Selection
																					objSelection.TypeParagraph() 
																					set objRange = objSelection.Range
																					objDoc.Tables.Add objRange, 1, 1
																					set objTable = objDoc.Tables(objDoc.Tables.count)
																					objTable.AutoFormat(16) 
																					With objTable        
																							With .Cell(1, 1)
																								.Shading.BackgroundPatternColor = RGB(216,233,243) ' or try rgb(180,211,232)
																								.Range.Font.TextColor = RGB(0,95,153)
																								.Range.Font.Size = 12
																								.Range.Font.Name = "Verdana"
																								.Range.Font.Bold = True
																								.Range.Text = split(objTestCaseNode.GetAttribute("id"),"_")(0)
																								.SetWidth 750,wdAdjustNone 
																							End With   
																					End With

																					'----------------------- creating Test Case individual step details  ---------------------------------------------------
																					Set stepNodeList = objTestCaseNode.SelectNodes("Step")
																					objSelection.EndKey END_OF_STORY,0
																					set objSelection = objWord.Selection
																					objSelection.TypeParagraph() 
																					set objRange = objSelection.Range
																					objDoc.Tables.Add objRange, stepNodeList.Length+2,7 
																					set objTable = objDoc.Tables(objDoc.Tables.count)
																					objTable.AutoFormat(16)
																					For Each aBorder In objTable.Borders 
																							 aBorder.Color = RGB(179,211,236)
																							 'aBorder.LineStyle = wdLineStyleDashDot 
																							 'aBorder.LineWidth = wdLineWidth075pt 
																					Next
																					With objTable.Borders 
																						 .InsideLineStyle = wdLineStyleDouble
																						 .OutsideLineStyle = wdLineStyleSingle 
																					End With  
																						' -----------------------------  Creating Header cells of step details table ----------------------------------		
																	
																					For itr = 1 to 7 step 1
																							With objTable        
																												With .Cell(1,itr)
																															.Shading.BackgroundPatternColor = rgb(180,211,232) ' or try RGB(216,233,243) 
																															.Range.Font.TextColor = RGB(0,95,153)
																															.Range.Font.Size = 9
																															.Range.Font.Name = "Verdana"
																															.Range.Font.Bold = True
																															Select case itr
																																			Case 1
																																				.Range.Text = "step number"					
																																				.SetWidth 50,wdAdjustNone 
																																			Case 2
																																				.Range.Text = "step description"
																																				.SetWidth 150,wdAdjustNone 
																																			Case 3
																																				.Range.Text = "input data"	
																																				.SetWidth 150,wdAdjustNone 
																																			Case 4
																																				.Range.Text = "message/error"
																																				.SetWidth 150,wdAdjustNone 
																																			Case 5
																																				.Range.Text = "status"
																																				.SetWidth 50,wdAdjustNone 
																																			Case 6
																																				.Range.Text = "output"
																																				.SetWidth 100,wdAdjustNone 
																																			Case 7	
																																				.Range.Text = "execution time"
																																				.SetWidth 100,wdAdjustNone 
																															End select
																												End With   
																							End With
																						Next
																						'---------------------------------------- Created header cells -----------------------------------
																					
																					Dim presentStepNumber : presentStepNumber = 0	
																					for each objStepNode in stepNodeList 
																														'---------------------------------------- creating content of cells ----------------------------------------
																														presentStepNumber = presentStepNumber + 1
																														for itr = 1 to 7 step 1
																															With objTable        
																																					With .Cell(1+presentStepNumber,itr)' Adding header row count
																																									.Shading.BackgroundPatternColor = RGB(238,243,247)
																																									.Range.Font.TextColor = RGB(0,0,0)
																																									.Range.Font.Size = 9
																																									.Range.Font.Name = "Verdana"
																																									.Range.Font.Bold = false
																																									Select case itr
																																														Case 1
																																															.Range.Text = presentStepNumber					
																																															.SetWidth 50,wdAdjustNone 
																																														Case 2
																																															.Range.Text = objStepNode.SelectSingleNode("Description").Text
																																															.SetWidth 150,wdAdjustNone 
																																														Case 3
																																															.Range.Text = objStepNode.SelectSingleNode("InputData").Text
																																															.SetWidth 150,wdAdjustNone 
																																														Case 4
																																															.Range.Text = objStepNode.SelectSingleNode("Message").Text
																																															.SetWidth 150,wdAdjustNone 
																																														Case 5
																																															.Range.Text = objStepNode.SelectSingleNode("Status").Text ' Change colour according to status
																																															If objStepNode.SelectSingleNode("Status").Text = "PASS" Then
																																																.Range.Font.TextColor = 32768	
																																															Elseif objStepNode.SelectSingleNode("Status").Text = "PASS" Then
																																																.Range.Font.TextColor = 255
																																															Elseif objStepNode.SelectSingleNode("Status").Text = "DONE" or objStepNode.SelectSingleNode("Status").Text = "WARNING" Then
																																																.Range.Font.TextColor = RGB(0,0,0)								
																																															End if
																																															.SetWidth 50,wdAdjustNone 
																																														Case 6
																																															Set objCellRange = objTable.Cell(1+presentStepNumber,itr).Range 
																										        																				objTable.Cell(1+presentStepNumber,itr).Select	
																						        																								Set objSelection = objWord.Selection	
																																															objCellRange.Paragraphs.Add
																																														        Set objRange = objCellRange.Paragraphs(1).Range

																																			
																																															Dim outputTotalRefPaths : outputTotalRefPaths = objStepNode.SelectSingleNode("Output").Text
																																															outputPathArray = Split(outputTotalRefPaths,",")								
																																															Dim imageIndex : imageIndex = 0
																																															Dim fileIndex : fileIndex = 0
																																															for i=0 To Ubound(outputPathArray) 	
																																																Dim presentOutputImageOrFilePath : presentOutputImageOrFilePath = outputPathArray(i)
																																																if Instr(presentOutputImageOrFilePath,"##IMAGE::") > 0 Then
																																																	refPath = gobjFso.GetParentFolderName(XMLpath)&"\Iteration_"&currentIterationNumber&"\ScreenShots\"&Split(Split(presentOutputImageOrFilePath,"##IMAGE::")(1),".\ScreenShots\")(1)																																																																																																												
																																																	set objLink = objDoc.Hyperlinks.Add(objSelection.Range, refPath, , ,"ScreenShot : "&imageIndex)
																																																	imageIndex = imageIndex + 1
																																																	objSelection.TypeText Chr(11)
																																																Else
																																																	refPath = Split(presentOutputImageOrFilePath,"##FILE::")(1)
																																																	set objLink = objDoc.Hyperlinks.Add(objselection.Range, refPath, , ,"FileAttachment : "&fileIndex)						
																																																	objSelection.TypeText Chr(11)
																																																	fileIndex = fileIndex + 1 
																																																End if
																																															refpath = "" 																																																											
																																															Next	
																																															.SetWidth 100,wdAdjustNone 
																																														Case 7	
																																															.Range.Text = objStepNode.SelectSingleNode("ExecutionTime").Text
																																															.SetWidth 100,wdAdjustNone 
																																									End select
																																					End With   
																															End With
																														Next
																					Next '------ Step loop completed
																					
																					' ----------------------------------  creating final status of test case -------------------------------------------
																					Set finalStatusNode =  objTestCaseNode.SelectSingleNode("Final-Step") 
																					For itr = 1 to 7 step 1
																							With objTable        
																											With .Cell(stepNodeList.Length+2,itr) ' Adding header row + No.Of steps + 1 -- last row
																																.Shading.BackgroundPatternColor = RGB(238,243,247)
																																if finalStatusNode.SelectSingleNode("Status").Text = "PASS" Then
																																	.Range.Font.TextColor = 32768 ' change color according to pass or fail
																																Else
																																	.Range.Font.TextColor = 255 ' change color according to pass or fail	
																																End if	
																																.Range.Font.Size = 9
																																.Range.Font.Name = "Verdana"
																																.Range.Font.Bold = True
																																
																																Select case itr
																																					Case 1		
																																						.SetWidth 50,wdAdjustNone 
																																					Case 2
																																						.Range.Text = finalStatusNode.SelectSingleNode("FinalMessage").Text
																																						.SetWidth 150,wdAdjustNone 
																																					Case 3
																																						.SetWidth 150,wdAdjustNone 
																																					Case 4
																																						.Range.Text = finalStatusNode.SelectSingleNode("Status").Text
																																						.SetWidth 150,wdAdjustNone 
																																					Case 5
																																						.SetWidth 50,wdAdjustNone 
																																					Case 6
																																						.SetWidth 100,wdAdjustNone 
																																					Case 7	
																																						.Range.Text = finalStatusNode.SelectSingleNode("Duration").Text
																																						.SetWidth 100,wdAdjustNone 
																																End select
																											End With   
																							End With
																					Next
																					Set finalStatusNode = Nothing
																					Set myRange = objword.ActiveDocument.Range(objTable.Cell(stepNodeList.Length+2,1).Range.Start,objTable.Cell(stepNodeList.Length+2,3).Range.End) 
																					myRange.Select
																					objWord.Selection.Cells.Merge
																			
																					Set myRange = objword.ActiveDocument.Range(objTable.Cell(stepNodeList.Length+2,3).Range.Start,objTable.Cell(stepNodeList.Length+2,5).Range.End) 
																					myRange.Select
																					objWord.Selection.Cells.Merge 		
																					Set stepNodeList = nothing	
																	' ----------------------------------  created final status of test case -------------------------------------------	
												Next ' ---- testcase loop completed
												
objDoc.ActiveWindow.ActivePane.View.Type = wdPrintView
'Select the footer view and add the footer
Set oSelection= objWord.Selection
objDoc.ActiveWindow.ActivePane.View.SeekView = wdSeekCurrentPageFooter
objDoc.Sections(1).Footers(wdHeaderFooterPrimary).Range.Select 
'With oSelection
'               .Font.Size ="8"
'		.Font.Bold = False
'		.ParagraphFormat.Alignment=0
'		.TypeText "TCS - "& gstrCustomerName &" Confidential"
'		.TypeText vbCrLF
'End with
footerText= "TCS - "& gstrCustomerName &" Confidential"
objWord.Selection.TypeText footerText
oSelection.EndKey END_OF_STORY
												
												
												Set testCaseNodeList = Nothing
												objWord.ActiveDocument.Save
												if pdfFileRequired Then
													objDoc.SaveAs pdfOutputFile, wdFormatPDF
												End if
												objDoc.Close WdDoNotSaveChanges
												if pdfFileRequired and Not (gblnCreateDetailedAndSummaryReportDoc) Then
													gobjFso.DeleteFile(docPathToSave)
												End if

Next' ------ Iteration loop completed
Set objIterationsList = Nothing
objWord.Quit
Set objWord = Nothing
Set ObjXML = Nothing
Set gobjFso = Nothing

End function

'''**********************************************************************************
'Name of the Function  	   :  UpdateResultToReport
'Description		     			: Update the script result to the report
'                                                          
'Input Parameters	    	 : StepDescription,inputParameter,message,status,outputParameter
'					StepDescription: The Ste description to be updated in the report
'					inputParameter:- The value should enter under the Input parameter column in the report 
'			       '	message :- The message to be updated under the Message column in report
'                                  status:- The status to be updated under the Status column in report
'					'outputParameter         : The outputParameter to be updated under the outputParameter column in report

'************************************************************************************

Public Function UpdateResultToReport(StepDescription,inputParameter,message,status,outputParameter)
			Call UpdateResultHtml(StepDescription,inputParameter,message,status,outputParameter)
			If blnCaptureFlag  or  blnCreateImageEachStep or blnCreateTrainingDoc Then
				  		Call StoreSteps(message)
			Call InsertImage_MultipleSteps("")
        	Call InsertStepsDoc_MultipleSteps()
	        oDicSteps.RemoveAll
	        End if
End Function

'*******************************************************************************************************************************
