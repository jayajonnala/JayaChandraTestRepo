    strHtmlSummaryFile.writeline("</tr>") 
    strHtmlSummaryFile.writeline("<tr>")
    strHtmlSummaryFile.writeline("<td ><SPAN class='total'> Total :</td>") 
    strHtmlSummaryFile.writeline("<td align='left'><SPAN class='total'> " & giTotalIterationCount & " </td>")
	strHtmlSummaryFile.writeline("</tr>") 
    strHtmlSummaryFile.writeline("</table>")
    strHtmlSummaryFile.writeline("</td>") 
    strHtmlSummaryFile.writeline("</tr>")
    strHtmlSummaryFile.writeline("</table>") 
    strHtmlSummaryFile.writeline("</td>")
    strHtmlSummaryFile.writeline("</tr>") 
    strHtmlSummaryFile.writeline("</table>")
    strHtmlSummaryFile.writeline("</td><td></td>") 
    strHtmlSummaryFile.writeline("</table>")
    strHtmlSummaryFile.writeline("</div>") 
    strHtmlSummaryFile.writeline("")			
	strHtmlSummaryFile.writeline("<div class='report-content' style='padding-top:30px;'>")
	strHtmlSummaryFile.writeline("<a href='#' id='expandAll' class='expand-collepse' style='position:absolute;right:10px;top:9px;'><img src='Report Styling/images/all-plus.png' alt='Expand all' title='Expand All'> Expand All</a>")
	For j = 1 To giTotalIterationCount
		strHtmlSummaryFile.writeline("<div id='" & j & "' name='" & j & "' class='report-content-summary'>")	
		strHtmlSummaryFile.writeline("<h3 id='Iteration" & j & "' class='action-collepse'>Iteration " & j & " - " & ScenarioName)
		Set objReport = objXml.SelectSingleNode("//Summary-Report")
		Set objCurrentIteration = objReport.SelectSingleNode("Iteration[@id='" & j & "']")
		Set objItrExeTime = objCurrentIteration.SelectSingleNode("ExecutionTime")
		strHtmlSummaryFile.writeline("<span class='exectime'>Execution Time: " & FormatNumber(objItrExeTime.Text,1) & " Second(s)</span>")		
		strHtmlSummaryFile.writeline("</h3>")		
		strHtmlSummaryFile.writeline("<div class='iteration-details action-expand'>")			
		strHtmlSummaryFile.writeline("<table cellspacing='0' cellpadding='0' border='0' class='case-status'>")			
		strHtmlSummaryFile.writeline("<caption>Test Case<span>*Click to get related case study highlighted</span></caption>")		
		strHtmlSummaryFile.writeline("<tbody><tr>")
		Set objTotalTestCases = objCurrentIteration.SelectSingleNode("TotalTestCases")
		Set objPassTestCases = objCurrentIteration.SelectSingleNode("PassTestCases")
		Set objFailTestCases = objCurrentIteration.SelectSingleNode("FailTestCases")
		Set objTestCaseList = objCurrentIteration.SelectNodes("TestCase")
		strHtmlSummaryFile.writeline("<td class='total' id='totalCases-Iteration" & j & "'><nobr><a href='#totalCases-Iteration" & j & "'><span class='count'>" & objTotalTestCases.Text & "</span><span>Total</span></a></nobr></td>")
		strHtmlSummaryFile.writeline("<td class='pass' id='passCases-Iteration" & j & "'><nobr><a href='#passCases-Iteration" & j & "'><span class='count'>" & objPassTestCases.Text & "</span><span>Pass</span></a></nobr></td>")
		strHtmlSummaryFile.writeline("<td class='fail' id='failCases-Iteration" & j & "'><nobr><a href='#failCases-Iteration" & j & "'><span class='count'>" & objFailTestCases.Text & "</span><span>Fail</span></a></nobr></td>")
		strHtmlSummaryFile.writeline("</tr>")			
		strHtmlSummaryFile.writeline("</tbody></table>")			
		strHtmlSummaryFile.writeline("<h2 class='case-title'>Test Case Title</h2>")		
		strHtmlSummaryFile.writeline("<ul class='case-sub-head clearfix' id='TestCaseList-Iteration" & j & "'>")
		Dim index:index=0
		For each objTestCase in objTestCaseList
			Set objTestCaseStatus = objTestCase.SelectSingleNode("Status")
			index=index+1
			If objTestCaseStatus.Text = "PASS" Then
				strHtmlClass = "pass"
			Else
				strHtmlClass = "fail"
			End If
			requiredText=""
			testcaseName1=Split(objTestCase.getAttribute("id"),"_")
			For Iterator = 0 To ubound(testcaseName1)-1 Step 1
				If requiredText="" Then
					requiredText=testcaseName1(Iterator)
				Else
					requiredText=requiredText&"_"&testcaseName1(Iterator)
				End If
				
			Next
			Dim testCaseName : testCaseName = "Test Case " & index & " - " & requiredText
	    	If Len(testCaseName) > 35 Then
	    		testCaseName = Mid(testCaseName,1,34) & "<span class='continue-text'></span>"
	    	End If
			If giTotalIterationcount = 1 and not gblnScenarioMode Then
				strHtmlSummaryFile.writeline("<li class='" & strHtmlClass & " total'><a target='_blank' href='" & gstrDetailedHTMLFileName & "#" & index & "' class='masterTooltip' title='Test Case " & index & " - " & split(objTestCase.GetAttribute("id"),"_")(0) & "'>" & testCaseName & "</a></li>")
			Else
				strScenarioIterationFolder = "Iteration_" & j
				strHtmlSummaryFile.writeline("<li class='" & strHtmlClass & " total'><a target='_blank' href='" & strScenarioIterationFolder & "/" & gstrDetailedHTMLFileName & "#" & index & "' class='masterTooltip' title='Test Case " & index & " - " & split(objTestCase.GetAttribute("id"),"_")(0) & "'>" & testCaseName & "</a></li>")
			End If

Next
		strHtmlSummaryFile.writeline(" </ul>")
		strHtmlSummaryFile.writeline("</div>")
		strHtmlSummaryFile.writeline("</div>")
	Next
	strHtmlSummaryFile.writeline("</div>")			
	strHtmlSummaryFile.writeline("</div>")
	strHtmlSummaryFile.writeline("<a href='#' id='collapseAll' class='expand-collepse collapse-all' style='position:fixed;right:41px;bottom:20px;'><img src='Report Styling/images/all-minus.png' alt='Collapse all' title='Collapse All'> Collapse All</a>")
	strHtmlSummaryFile.writeline("<a href='#top' style='position:fixed;right:45px;bottom:60px;' class='backtop'>&#9650; Go to top</a>")
	strHtmlSummaryFile.writeline("</body>")		
	strHtmlSummaryFile.writeline("</html>")
	Set objTestCaseStatus = Nothing
	Set objTestCaseList = Nothing
	Set objFailTestCases = Nothing
	Set objPassTestCases = Nothing
	Set objTotalTestCases = Nothing
	Set objTestCaseCount = Nothing
	Set objCurrentIteration = Nothing
	Set objReport = Nothing
	Set objItrExeTime = Nothing
	Set objSpecIteration = Nothing
   	Set objIterationStatus = Nothing
   	Set objIterationsList = Nothing
   	Set objXml = Nothing
End Function




Function Q(string)
	Q= chr(34) & string & chr(34) 
End Function

Function ConvertArrayToString(arrSourceArray)
	Dim strTempString
	On error Resume Next
	strTempString  = ""
	If isArray(arrSourceArray) Then
		For  i=Ubound(arrSourceArray) to 0   Step -1
			strTempString = cstr(arrSourceArray(i)) & " " & strTempString  
		Next 
	End If
	ConvertArrayToString = cstr(strTempString)
End Function


'*******************************************************************************************************************************************
'Name of the Function : StartupFunction
'Author		    : Sai Satvik
'Date			    : 20/10/2015
'Description	    : Starting point of Scenario wise execution along with multiple iterations
'Input Parameters	    : input data excel name, excel row to fetch the data, total no.of iterations
'Output Parameters    : None
'*******************************************************************************************************************************************
Function StartupFunction(scenarioDataExcelName,parameterizationIndex,scenarioTotalIterations)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing StartupFunction" End if 
   Set objShell = CreateObject("WScript.Shell")
    Dim dataPath,xmlDoc
	objShell.Environment("USER").Item("gblnScenarioMode") = True
	 gblnScenarioMode=objShell.Environment("USER").Item("gblnScenarioMode")
    giTestCaseNumber = 0
    giHTMLRowNumber = 1
   objShell.Environment("USER").Item("blnFatalError") = False
    Environment.Value("blnFatalError") = False
    blnMainFailFlag = False
    Set objXml = CreateObject("Microsoft.XMLDOM")
    'get Datafolderpath and resultFolderPath from UISettings XML
    'scenarioDataExcelPath = datafolderpath form XML + ScenarioDataExcelName     
    'initialize the global variable gstrmainResultfolder with resultFolderPath
    If gblnFirstIteration Then
    	gblnFirstIteration = False
    	If objFso.FileExists(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName) Then
	       	Set xmlDoc = CreateObject("Microsoft.XMLDOM")
	       	xmlDoc.Load(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
			Set resultFolderPath = xmlDoc.SelectSingleNode("//ResultFolderPath")
			If resultFolderPath.Text <> "" Then
				gstrMainResultFolder = resultFolderPath.Text
				objShell.Environment("USER").Item("gstrMainResultFolder") = gstrMainResultFolder
			Else
				Msgbox "Please provide resultFolderPath in Settings tab of TASE UI"
				Environment("blnFatalError") = True
				Exit Function
			End If
			Set dataFolderPath = xmlDoc.SelectSingleNode("//DataFolderPath")
			dataPath = dataFolderPath.Text
			Set trainingDoCFlag = xmlDoc.SelectSingleNode("//Creation")
		'msgbox trainingDoCFlag.Text
		If trainingDoCFlag.Text = "Yes" Then
			blnCreateTrainingDoc=True
			Set trainingDoCFormat = xmlDoc.SelectSingleNode("//Format")
			If instr(trainingDoCFormat.Text,"WORD")>0 Then
				blnCreateWordTrainingDoc=True
			else
				blnCreateWordTrainingDoc=False
			End If
			If instr(trainingDoCFormat.Text,"PDF")>0 Then
				blnCreatePDFTrainingDoc=True
			Else
				blnCreatePDFTrainingDoc=False
			End If
		End If
		Set reportFormat = xmlDoc.SelectSingleNode("//ReportFormat")
		'msgbox reportFormat.text
		If instr(reportFormat.Text,"WORD")>0 Then
				gblnCreateDetailedAndSummaryReportDoc=True
			else
				gblnCreateDetailedAndSummaryReportDoc=False
			End If
			If instr(reportFormat.Text,"PDF")>0 Then
				gblnCreatePDFDetailedAndSummaryReportDoc=True
			Else
				gblnCreatePDFDetailedAndSummaryReportDoc=False
			End If
			xmlDoc.Save(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
			Set xmlDoc = Nothing
			'if Xml present delete it and create new in installation folder
	       	'add xml header for created XML
	       	If objFso.FileExists(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName) Then
	    		objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
			End If
    		Set objRoot = objXml.CreateElement("execution-summary")
    		objXml.appendChild objRoot
    		rootNodeName = objRoot.nodeName
    		If dataPath <> "" Then
    			dataPath = dataPath & "\" & scenarioDataExcelName
    			If Not objFso.FileExists(dataPath) Then
			        Msgbox "Please Check Scenario Excel is present in specified path."
					Environment("blnFatalError") = True
					Exit Function
			    End If
			Else
				Msgbox "Please provide dataFolderPath in Settings tab of TASE UI"	
				Environment("blnFatalError") = True
				Exit Function
    		End If
    		Set objIntro = objXml.createProcessingInstruction("xml","version='1.0'")  
			objXml.insertBefore objIntro,objXml.childNodes(0)
			objXml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
			Set objXml = Nothing
			'need to create the Summary-Report and Detailed-Report tags as child of root node
			Call CreateTagInSummaryXML(rootNodeName,"","Summary-Report","","Summary-Report")    		
			Call CreateTagInSummaryXML(rootNodeName,"","Detailed-Report","","Detailed-Report")
			'Create tags scenarioDataExcelPath, ResultFolderPath, TotalNumberOfIterations to store input excel path, result folder path and scenarioTotalIterations in summary-Report
			Call CreateTagInSummaryXML("Summary-Report","","ScenarioDataExcelPathandName",dataPath,"Summary-Report")    		
			Call CreateTagInSummaryXML("Summary-Report","","TotalNumberofIterations",scenarioTotalIterations,"Summary-Report")
			Call CreateTagInSummaryXML("Summary-Report","","ResultFolderPath",gstrMainResultFolder,"Summary-Report")
			'need to create the iteration tag with id = 1 in both Summary and Detailed Report tags
			Call CreateIterationTaginXML("Summary-Report",1,parameterizationIndex,"Summary-Report")
			Call CreateIterationTaginXML("Detailed-Report",1,parameterizationIndex,"Detailed-Report")
			Set objIntro = Nothing
			Set objExcelPathandName = Nothing
			Set objRoot = Nothing
	    Else
	    	msgbox "Please provide dataFolderPath and resultFolderPath in Settings tab of TASE UI"
			Environment("blnFatalError") = True
			Exit Function   
		End If
    Else
		'need to create the iteration tag with id = count of iteration tags + 1
       'objXml.load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
       'Set objRoot = objXml.SelectSingleNode("//execution-summary")
       'rootNodeName = objRoot.nodeName
       giCurrentIteration = giCurrentIteration + 1
       objShell.Environment("USER").Item("giCurrentIteration") = giCurrentIteration
	   	objShell.Environment("USER").Item("blnFatalError") = Environment.Value("blnFatalError")
       Call CreateIterationTaginXML("Summary-Report",giCurrentIteration,parameterizationIndex,"Summary-Report")
       Call CreateIterationTaginXML("Detailed-Report",giCurrentIteration,parameterizationIndex,"Detailed-Report")
       'Set objRoot = Nothing
       'Set objXml = Nothing
	     Set objShell = Nothing
    End If
End Function
'*******************************************************************************************************************************************
'Name of the Function : CreateIterationTaginXML
'Author		    : Sai Satvik
'Date			    : 20/10/2015
'Description	    : Used to Create the Iteration inside the Summary XML
'Input Parameters	    : Iteration tag's parent node name, Attribute value of Iteration tag, excel row number in test case sheet from where the data needs to be fetched
'Output Parameters    : None
'*******************************************************************************************************************************************
Public Function CreateIterationTaginXML(parentNodeName,iterationId,excelRowNumber,reportName)
    Set objShell = CreateObject("WScript.Shell")
    objShell.Environment("USER").Item("giCurrentIteration") = iterationId
    giCurrentIteration= objShell.Environment("USER").Item("giCurrentIteration")
'	giCurrentIteration = iterationId
	Call CreateTagWithAttributeInSummaryXML(parentNodeName,"","Iteration",iterationId,reportName)
	If reportName = "Summary-Report" Then
		'Create sub tags of parameterizationRowNumber to store the row number of input excel.
		Call CreateTagInSummaryXML("Iteration",iterationId,"excelRowNumber",excelRowNumber,reportName)
		'Create sub tags of totaltestcase, PassTestCase, failtestCase to keep track of test cases.
		Call CreateTagInSummaryXML("Iteration",iterationId,"TotalTestCases",0,reportName)
		Call CreateTagInSummaryXML("Iteration",iterationId,"PassTestCases",0,reportName)
		Call CreateTagInSummaryXML("Iteration",iterationId,"FailTestCases",0,reportName)
		'create sub tags executionStatus,executionTime,StartTime,EndTime
		Call CreateTagInSummaryXML("Iteration",iterationId,"ExecutionStatus","",reportName)
		Call CreateTagInSummaryXML("Iteration",iterationId,"ExecutionTime","",reportName)
		Call CreateTagInSummaryXML("Iteration",iterationId,"StartTime",Timer(),reportName)
		Call CreateTagInSummaryXML("Iteration",iterationId,"EndTime","",reportName)
	End If
End Function
'*******************************************************************************************************************************************
'Name of the Function : CreateTagInSummaryXML
'Author		    : Sai Satvik
'Date			    : 20/10/2015
'Description	    : Create tag inside the Summary XML
'Input Parameters	    : Parent Element name, parent element attribute value, node name which needs to be added, node value
'Output Parameters    : None
'*******************************************************************************************************************************************
Function CreateTagInSummaryXML(parentNodeName,parentNodeId,elementNodeName,elementNodeValue,reportName)
	Set objectxml = CreateObject("Microsoft.XMLDOM")
	objectxml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	If parentNodeId <> "" Then
		Set objParent = objectxml.SelectSingleNode("//" & parentNodeName & "[@id='" & parentNodeId & "']")
	Else
		Set objParent = objectxml.SelectSingleNode("//" & parentNodeName)
	End If
	if objParent.nodeName = "Iteration" Then
		Set objReport = objectxml.SelectSingleNode("//" & reportName)			'in order to uniquely identify Iteration tags (Summary or Detailed)
		If parentNodeId <> "" Then
			Set objParent = objReport.SelectSingleNode(parentNodeName & "[@id='" & parentNodeId & "']")
		Else
			Set objParent = objReport.SelectSingleNode(parentNodeName)
		End If
	End If
	if objParent.ParentNode.nodeName = "Iteration" Then
		Set objReport = objectxml.SelectSingleNode("//" & reportName)			'in order to handle "Final-Step" tag in test Case details
		Set objIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")			'in order to uniquely identify test case tags
		If parentNodeId <> "" Then
			Set objParent = objIteration.SelectSingleNode(parentNodeName & "[@id='" & parentNodeId & "']")
		Else
			Set objParent = objIteration.SelectSingleNode(parentNodeName)
		End If
	ElseIf objParent.ParentNode.nodeName = "TestCase" Then						'Case for including the Step details tag in Sumamry XML
		Set objReport = objectxml.SelectSingleNode("//" & reportName)
		Set objIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
		Set objTestCase = objIteration.SelectSingleNode("TestCase[@id='" & gstrTestCaseName & "_" & giTestCaseNumber & "']")
		If parentNodeId <> "" Then
			Set objParent = objTestCase.SelectSingleNode(parentNodeName & "[@id='" & parentNodeId & "']")
		Else
			Set objParent = objTestCase.SelectSingleNode(parentNodeName)
		End If
	End If
	Set objElement = objectxml.CreateElement(elementNodeName)
	objElement.Text = elementNodeValue
	objParent.AppendChild objElement
	objectxml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objElement = Nothing
	Set objParent = Nothing
	Set objectxml = Nothing
End Function


'*******************************************************************************************************************************************
'Name of the Function : CreateTagWithAttributeInSummaryXML
'Author		    : Sai Satvik
'Date			    : 20/10/2015
'Description	    : Create Attribute for the tag specified inside the Summary XML
'Input Parameters	    : Parent Element name, parent element attribute value, node name which needs to be added, node attribute value
'Output Parameters    : None
'*******************************************************************************************************************************************
'Creation of Iteration tag in xml won't give much priority to reportName since reportName will be provided as parentNodeName.
'Creation of Test Case tag in xml needs reportName since we need to know where exactly the tag should be created i.e in summary or detailed.
'Creation of step in Test Case tag creates importance for knowing the reportname and Iteration tag (child of reportName)
Function CreateTagWithAttributeInSummaryXML(parentNodeName,parentNodeId,elementNodeName,elementNodeId,reportName)
	Set objectxml = CreateObject("Microsoft.XMLDOM")
	objectxml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	If parentNodeId <> "" Then
		Set objParent = objectxml.SelectSingleNode("//" & parentNodeName & "[@id='" & parentNodeId & "']")
	Else
		Set objParent = objectxml.SelectSingleNode("//" & parentNodeName)
	End If
	if objParent.nodeName = "Iteration" Then
		Set objReport = objectxml.SelectSingleNode("//" & reportName)			'in order to uniquely identify Iteration tags (Summary or Detailed)
		If parentNodeId <> "" Then
			Set objParent = objReport.SelectSingleNode(parentNodeName & "[@id='" & parentNodeId & "']")
		Else
			Set objParent = objReport.SelectSingleNode(parentNodeName)
		End If
	ElseIf objParent.nodeName = "TestCase" Then					'mostly used when we are inserting steps in a test case
		Set objReport = objectxml.SelectSingleNode("//" & reportName)			'in order to uniquely identify Iteration tags (Summary or Detailed)
		Set objIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
		If parentNodeId <> "" Then
			Set objParent = objIteration.SelectSingleNode(parentNodeName & "[@id='" & parentNodeId & "']")
		Else
			Set objParent = objIteration.SelectSingleNode(parentNodeName)
		End If
	End If
	Set objElement = objectxml.CreateElement(elementNodeName)
	objParent.AppendChild objElement
	Set objAttr = objectxml.CreateAttribute("id")
	objAttr.Value = elementNodeId
	objElement.Attributes.SetNamedItem objAttr
	objectxml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objAttr = Nothing
	Set objElement = Nothing
	Set objParent = Nothing
	Set objReport = Nothing
	Set objIteration = Nothing
	Set objectxml = Nothing
End Function

'*******************************************************************************************************************************************
'Name of the Function : ClosureFunction
'Author		    : Sai Satvik
'Date			    : 20/10/2015
'Description	    : Closure point of Scenario wise execution along with multiple iterations
'Input Parameters	    : None
'Output Parameters    : None
'*******************************************************************************************************************************************
Function ClosureFunction()
       Set objShell = CreateObject("WScript.Shell")
	Environment.Value("blnFatalError") = objShell.Environment("USER").Item("blnFatalError")
	 gstrIterationResultFolder=objShell.Environment("USER").Item("gstrIterationResultFolder")
	Set objShell = Nothing
If Not Environment.Value("blnFatalError") Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing ClosureFunction"  End if 
    'Get current Iteration value by taking count of iteration tags and Total Iteration Value from TotalNumberOfIterations tag
    Set objXml = CreateObject("Microsoft.XMLDOM")
    objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
    Set objReport = objXml.SelectSingleNode("//Summary-Report")
	Set objCurrentIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
	'get the total no.of test cases
	Set objTotalTests = objCurrentIteration.SelectSingleNode("TotalTestCases")
	Dim totalTestCases : totalTestCases = objTotalTests.Text
	'update End timer to that
	Set objEndTime = objCurrentIteration.SelectSingleNode("EndTime")
	'get the StartTime tag value
    Set objStartTime = objCurrentIteration.SelectSingleNode("StartTime")
    'Format the number between start time and end time and store it in ExecutionTime tag
    Set objExeTime = objCurrentIteration.SelectSingleNode("ExecutionTime")
    'Get the collection of testcase tags inside current iteration value tag.
    Set objExeStatus = objCurrentIteration.SelectSingleNode("ExecutionStatus")
    objExeStatus.Text = "PASS"
    Set objTestsList = objCurrentIteration.SelectNodes("TestCase")
    'compare the status of each testcase tag in the collection with fail status, one fail testcase then update the status of current Iteration ExexcutionStatus tag value to fail.
    For each objTest in objTestsList
    	Set objStatus = objTest.SelectSingleNode("Status")
    	If objStatus.Text = "FAIL" Then
    		objExeStatus.Text = "FAIL"
    		Exit For
    	End If
    Next
    Set objTotalIterations = objXml.SelectSingleNode("//TotalNumberofIterations")
    totalIterations = objTotalIterations.Text
    objEndTime.Text = Timer()
    objExeTime.Text = FormatNumber(objEndTime.Text - objStartTime.Text, 3)
    objXml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
    If blnCreateTrainingDoc Then		'Scenario Doc creation for Failed Iterations are handled inside the function
    	Call CreateScenarioTrainingDocument(totalTestCases)	
    End If
	'*******************before updating(double comments indicates already commented in before updating)***********************
    'If CInt(giCurrentIteration) = Cint(totalIterations) Then
     '   'Call the appropriate function which takes care of creating the Summary Report
      '  Call CreateSummaryReport()
       ' If setUploadZippedResultFile Then
	'		Call ResultZipFile_Upload(objFso.GetParentFolderName(gstrIterationResultFolder))
	'	End If
        ''Delete the Summary Details XML
        ''objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
    'End If
	'*******************after updating***********************
    If Cint(giCurrentIteration) = Cint(totalIterations) Then
        'Call the appropriate function which takes care of creating the Summary Report
		strScenarioFolder = objFso.GetParentFolderName(gstrIterationResultFolder) & "\"
		objFso.CopyFile gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName,strScenarioFolder,True
		If gblnCreateDetailedAndSummaryReportDoc or gblnCreatePDFDetailedAndSummaryReportDoc Then
					Call createDetailedReportDoc(strScenarioFolder & "\" & gstrSummaryDetailsXMLName,gblnCreatePDFDetailedAndSummaryReportDoc)
		End If
		If gblnCreateExecutionSummaryReport Then
			If gblnCreateDetailedAndSummaryReportDoc or gblnCreatePDFDetailedAndSummaryReportDoc Then
					Call createSummaryReportDoc(strScenarioFolder & "\" & gstrSummaryDetailsXMLName,gblnCreatePDFDetailedAndSummaryReportDoc,gstrSummaryGraphType)
				        Call CreateSummaryReport() 			
			End If
			 Call CreateSummaryReport() 
		End If
	        If setUploadZippedResultFile Then
			strScenarioFolder = objFso.GetParentFolderName(gstrIterationResultFolder)
			Call ResultZipFile_Upload(objFso.GetParentFolderName(strScenarioFolder))
		End If
		objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
    End If
    giLastUpdatedTime = Timer()
    Call DeleteBlankLogFile()
    Set objTotalIterations = Nothing
    Set objStatus = Nothing
    Set objTestsList = Nothing
    Set objExeStatus = Nothing
    Set objExeTime = Nothing
    Set objStartTime = Nothing
    Set objEndTime = Nothing
    Set objTotalTests = Nothing
    Set objCurrentIteration = Nothing
    Set objReport = Nothing
    Set objXml = Nothing
	 Set objShell = Nothing
End If
End Function

'''  Creating ScreenShot document
Function CaptureScreenShot(strCustomMessage,objTargetObject,blnNavigatorFunction,blnCaptureObject,blnStoreObjectOrdinates)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Running : CaptureScreenshot"  End if 
    Dim blnCapturedScreenshot,strNewImagePath
    blnCapturedScreenshot = False
    If Not IsObject(objTargetObject) Then
        If objTargetObject = "" and (strCustomMessage = "<SKIPSTEP> " or strCustomMessage = "") Then 
			blnCaptureFlag = True 
	    End If
	End if 
	If blnCaptureFlag or blnMainFailFlag or blnCreateImageEachStep Then
		If blnMainFailFlag Then			'Deleting the training document if the test case is failed
			If objFso.FileExists(gstrScreenShotDocument) Then
				objFso.DeleteFile gstrScreenShotDocument,True
			End If
		End If
		ImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
		Dim tempPath : tempPath = ".\ScreenShots" & Split(ImagePath,"\ScreenShots")(1)
		aImagePathArray(iImageCounterForHTML) = tempPath
		iImageCounterForHTML = iImageCounterForHTML +1
		blnCapturedScreenshot = True
	End If
	blnCaptureFlag=False
	If gblnMultipleObjectsInSingleScreenshot and blnCreateTrainingDoc and Not blnMainFailFlag Then
		If strCustomMessage <> "<SKIPSTEP>" Then ' used to skip final status function(used as navigator function for uncaptured actions) step description in training document
			Call StoreSteps(strCustomMessage)
		End If
		If blnStoreObjectOrdinates and IsObject(objTargetObject) Then
			'webeditobj.ToString() = [WebEdit] edit box
			Select Case True
				Case instr(Ucase(objTargetObject.ToString),"SAPGUITABLE"),instr(Ucase(objTargetObject.ToString),"SAPGUIGRID")
					Call storeTableorGridCoordinates(objTargetObject)	
				Case Else
					Call storeCoordinates(objTargetObject) 
			End Select			   	
		End If
		If blnNavigatorFunction Then
			If Not blnCapturedScreenshot Then
				strNewImagePath = CaptureSAPObject_Doc(SAPWindowObject,False)
				ImagePath = strNewImagePath
			else
				strNewImagePath = Split(ImagePath,".png")(0) & "123.png" 
				objFso.CopyFile ImagePath,strNewImagePath		'Creating a temp file of already linked 				screenshot and performing the operations to add to training doc
			End If
		    If blnCaptureObject Then
		       	ImageButtonPath = CaptureSAPObject_Doc(objTargetObject,True) ' imageButtonPath is a global variable like image path 
		    End If
		    'If CheckStatus_Doc(strStepStatus) Then  
	        Call drawShapeImage_MultipleSteps(strNewImagePath)
        	Call InsertImage_MultipleSteps(strNewImagePath)
        	Call InsertStepsDoc_MultipleSteps()
	        oDicSteps.RemoveAll				                 
		   'End If 					                   
		End If
	ElseIf blnCreateTrainingDoc and Not blnMainFailFlag Then
		If Not blnCapturedScreenshot Then
			strNewImagePath = CaptureSAPObject_Doc(Desktop,False) 
			ImagePath = strNewImagePath
		else
			strNewImagePath = Split(ImagePath,".png")(0) & "123.png"
			objFso.CopyFile ImagePath,strNewImagePath
		End If
		If IsObject(objTargetObject) and blnCreateTrainingDoc = true Then
			If (Not isEmpty(objTargetObject) ) or (Not IsNull(objTargetObject)) Then
				On error resume next
				inX = objApplicationObject.getroproperty("abs_x")
				inY= objApplicationObject.getroproperty("abs_y")
				inHeight = objApplicationObject.getroproperty("width")
				inWidth = objApplicationObject.getroproperty("height")
				HighlightAndCropController gstrScreenShotDocument, strCustomMessage, strNewImagePath, inX, inY, inHeight, inWidth
			End If
		End If
	End If
	CaptureScreenshot = ImagePath								
End Function 


Public Function CaptureSAPObject_Doc(ByRef gobject,IsObjectOrWindow) ' For buttons or links - pass 'True' for Window or browser or SAPWindow pass 'False' as parameter
	Set qtApp = getObject("","QuickTest.Application")   
	qtApp.WindowState = "Minimized" 
	Set qtApp = Nothing
	sImagePath = gstrIterationResultFolder & "\ScreenShots\"
   	str = Split(time,":",-1,1)
	str1 = screenCount & "_" & str(0) & str(1) & str(2)
	screenCount = screenCount + 1 'used for naming screenshots unqiuely. To be removed post addition ofmilliseconds to screenshot name
	On Error Resume Next
	if IsObjectOrWindow then
		If IsObject(gobject) and gobject.Exist(1) Then
			ReferenceName = SanitizeStringFromSpecialCharacters(gobject.GetROProperty("text"))
			gobject.CaptureBitmap sImagePath & ReferenceName & "_" & str1 & ".png",True
			strImagePath = sImagePath & ReferenceName & "_" & str1 & ".png"
		End If
	Else
		If IsObject(gobject) and gobject.Exist(1) Then
			ReferenceName = SanitizeStringFromSpecialCharacters(gobject.GetROProperty("text"))

			gobject.CaptureBitmap sImagePath & ReferenceName & "_" & str1 & ".png",True
		Else
			ReferenceName = SanitizeStringFromSpecialCharacters(Desktop.GetROProperty("text"))
			Desktop.CaptureBitmap sImagePath & ReferenceName & "_" & str1 & ".png",True
		End If
		strImagePath = sImagePath & ReferenceName & "_" & str1 & ".png"
	End if	
	Err.Clear   
	CaptureSAPObject_Doc = strImagePath
End Function

Public Function StoreSteps(stepname)
   	If blnCreateTrainingDoc Then
   		oDicSteps.Add oDicSteps.count+1,stepname
   	End If
End Function

Public Function storeCoordinates(obj)
	On error resume next
	oDicAbsX.Add oDicAbsX.count+1,obj.getroproperty("abs_x")
	oDicAbsY.Add oDicAbsY.count+1,obj.getroproperty("abs_y")
	oDicHeight.Add oDicHeight.count+1,obj.getroproperty("height")
   	oDicWidth.Add oDicWidth.count+1,obj.getroproperty("width")
End Function

Public Function storeTableorGridCoordinates(obj)
   	On error resume next
   	If oDicAbsX.count <> 0 Then
		xcoordinate=oDicAbsX.item(oDicAbsX.count)
   		ycoordinate=oDicAbsY.item(oDicAbsY.count)
   	End If
	
   	If Not (oDicAbsX.count>=1 and  xcoordinate=obj.getroproperty("abs_x") and ycoordinate=obj.getroproperty("abs_y")) Then
		oDicAbsX.Add oDicAbsX.count+1,obj.getroproperty("abs_x")
		oDicAbsY.Add oDicAbsY.count+1,obj.getroproperty("abs_y")
		oDicHeight.Add oDicHeight.count+1,250
		oDicWidth.Add oDicWidth.count+1,450
   	End If
End Function

Public Function drawShapeImage_MultipleSteps(byval strimagePath)
	On error resume next
	For i=1 to oDicAbsX.count
		call DrawRectangle(strimagePath,oDicAbsX.Item(i),oDicAbsY.Item(i),oDicWidth.Item(i),oDicHeight.Item(i),"Red")
		call DrawEclipse(strimagePath,oDicAbsX.Item(i)+oDicWidth.Item(i)+10,oDicAbsY.Item(i),20,20,"Red","Yellow")
		drawText=stepCount&CHR(96+i)
		DrawString strimagePath,oDicAbsX.Item(i)+oDicWidth.Item(i)+12,oDicAbsY.Item(i),drawText,"RED"
	Next
	oDicAbsX.removeAll
	oDicAbsY.removeAll
	oDicWidth.removeAll
	oDicHeight.removeAll
	oDicObject.removeAll
End Function

Public Function InsertStepsDoc_MultipleSteps()
	On error resume Next
	Set oWord=createObject("Word.Application")
	Dim j : j=0  
	oWord.Documents.Open(gstrScreenShotDocument) 
	Set oDoc = oWord.ActiveDocument
	Set oRange = oDoc.content
	oWord.Visible= False
	oWord.Selection.EndKey 6, 0
	oWord.Selection.Font.Size=11
	oWord.Selection.Font.Color = -587137025
	oWord.Selection.TypeParagraph
	
	For i=1 to oDicSteps.Count
		If (i>1and Right(oDicSteps.Item(i-1),9)=" in Table" and Right(oDicSteps.Item(i),9)=" in Table") or (i>1and Right(oDicSteps.Item(i-1),8)=" in Grid" and Right(oDicSteps.Item(i),8)= " in Grid")  Then
			'oRange.ParagraphFormat.Alignment = 0
			'oRange.insertafter vbtab
			oWord.Selection.Font.Bold =True
			oWord.Selection.Font.Italic=True
			oWord.Selection.TypeText  vbTab & oDicSteps.Item(i)
			oWord.Selection.TypeParagraph
			j=j+1
		else
			oWord.Selection.Font.Bold = True
			oWord.Selection.Font.Color = -587137025
			oWord.Selection.Typetext "Step "&stepCount&CHR(96+( i-j))&". "
			'oWord.Selection.Font.Color = 32768
			oWord.Selection.Font.Name = "Calibri"
			oWord.Selection.Font.Bold = True
			oWord.Selection.Font.Italic=True
			'oWord.Selection.TypeText oDicSteps.Item(i)
			'******************************************************************************************
			steptext=oDicSteps.Item(i)
			steptext1=split(steptext,"'")
		
			If ubound(steptext1)>0 Then
				For k=0 to ubound(steptext1)
					If k<>0 Then
						x=k mod 2
						If x=0 Then
							oWord.Selection.Font.Color = -587137025
							oWord.Selection.Font.Italic=False
						Else
							oWord.Selection.Font.Color = 32768
							oWord.Selection.Font.Italic=True
							If k=3 then
								oWord.Selection.Font.Color = 13458026
								oWord.Selection.Font.Italic=True
							End If
						End If
						oWord.Selection.TypeText steptext1(k)
					Else
						oWord.Selection.TypeText steptext1(k)
					End If
					'If step corresponds to a 'Click' step, then insert button image in the statement
					If k=1 and trim(steptext1(0))="Click" and imageButtonPath <> "SKIP"  Then
						oRange.Collapse(0)
						oRange.InlineShapes.AddPicture imageButtonPath, False, True
						oWord.Selection.EndKey 6, 0
					End If
				Next
			Else
				oWord.Selection.TypeText oDicSteps.Item(i)
			End If
			oWord.Selection.Font.Color = -587137025
			oWord.Selection.Font.Italic=False
			oWord.Selection.TypeParagraph
		End If
	Next
	oRange.collapse(0)
	oWord.Selection.Collapse(0)
	oWord.Selection.InsertBreak wdPageBreak 'Inserts a page break
	oWord.ActiveDocument.Save
	oWord.quit
	stepCount=stepCount+1 'Increment step count per each screen
	Set oWord=Nothing
	Set oDoc=Nothing
	Set oRange=Nothing
	'Remove Image file references
	If objFSO.FileExists(imageButtonPath) Then
		objFSO.DeleteFile(imageButtonPath)
	End If
	imageButtonPath="SKIP"
End Function

Function DrawString(ByVal strImagePath,ByVal inX,ByVal inY,ByVal iStr,ByVal strColor)
	Dim oPens,oGraphics,oImage,oBitmap,oRect,oFile,oFont,oBrushes
	Set oImage=DotNetFactory.CreateInstance("System.Drawing.Image","System.Drawing")
	Set oGraphics=DotNetFactory.CreateInstance("System.Drawing.Graphics","System.Drawing")
	'Set oRect=DotNetFactory.CreateInstance("System.Drawing.Rectangle","System.Drawing",inX,inY,inHeight,inWidth)
	Set oPens=DotNetFactory.CreateInstance("System.Drawing.Pens","System.Drawing") 
	Set oFont=DotNetFactory.CreateInstance("System.Drawing.Font","System.Drawing","Arial",10)
	Set oBrushes=DotNetFactory.CreateInstance("System.Drawing.Brushes","System.Drawing")
	Set oFile=DotNetFactory.CreateInstance("System.IO.File","")
	Set oImage=oImage.FromFile(strImagePath)
	Set oBitmap=DotNetFactory.CreateInstance("System.Drawing.Bitmap","System.Drawing",oImage) 
	Set oGraphics = oGraphics.FromImage(oBitmap)
	'Execute "oGraphics.DrawString "&istr&",oFont,oBrushes."&strColor&","&inX&","&inY&""
	oGraphics.DrawString istr,oFont,oBrushes.Red,inX,inY
	oImage.Dispose
	oFile.Delete(strImagePath)
	oBitmap.Save(strImagePath)
	Set oPens=Nothing
	Set oGraphics=Nothing
	Set oImage=Nothing
	Set oFile=Nothing
	Set oBitmap=Nothing
	Set oRect=Nothing
	
End Function

