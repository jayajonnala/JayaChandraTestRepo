    	strHtmlSummaryFile.writeline("</div>")
    	strHtmlSummaryFile.writeline("</div>")
	Else		'failureTurn = split(cStr(failureTurn),".")
		strHtmlSummaryFile.writeline("<div id='pieSlice1' class='hold'>")
    	strHtmlSummaryFile.writeline("<div class='pie' style='background-color: red; -webkit-transform:rotate(0.50turn); -moz-transform:rotate(0.50turn); -o-transform:rotate(0.50turn);-ms-transform:rotate(0.50turn); transform:rotate(0.50turn);'>")
    	strHtmlSummaryFile.writeline("</div>")
    	strHtmlSummaryFile.writeline("</div>")
		strHtmlSummaryFile.writeline("<div id='pieSlice1'>")
    	strHtmlSummaryFile.writeline("<div class='pie' style='background-color: red; -webkit-transform:rotate(" & failureTurn & "turn); -moz-transform:rotate(" & failureTurn & "turn); -o-transform:rotate(" & failureTurn & "turn);-ms-transform:rotate(" & failureTurn & "turn); transform:rotate(" & failureTurn & "turn);'>")	
    	strHtmlSummaryFile.writeline("</div>")
    	strHtmlSummaryFile.writeline("</div>")
    End If 
    strHtmlSummaryFile.writeline("</div>")
    strHtmlSummaryFile.writeline("</div>") 
    strHtmlSummaryFile.writeline("</td>")
	strHtmlSummaryFile.writeline("<td style='width:30%'>") 
    strHtmlSummaryFile.writeline("<table align ='right'>")
    strHtmlSummaryFile.writeline("<tr>") 
    strHtmlSummaryFile.writeline("<td ><SPAN class='pass total'>Pass :</td>")
    strHtmlSummaryFile.writeline("<td align='left'><SPAN class='pass total'> " & giPassIterationCount & " </td>") 
    strHtmlSummaryFile.writeline("</tr>")
    strHtmlSummaryFile.writeline("<tr>") 
    strHtmlSummaryFile.writeline("<td width='90'><SPAN class='fail total'>Fail :</td>")
    strHtmlSummaryFile.writeline("<td align='left'><SPAN class='fail total'> " & giFailIterationCount & " </td>") 
    strHtmlSummaryFile.writeline("</tr>")
    strHtmlSummaryFile.writeline("<tr>") 
