'***********************************************************************************
'Name of the Function  -> AutomaticDefectLog
'Author		     					  ->Debabrata Khuntia
'Date			     				   ->16-Nov-2011
'Description		    	 	->  Logging defect automatically in Qc
'			       							    
'Input Parameters	     ->  DefectMandatoryFieldList->Manadtory column name list  for defect
'												DefectSummary-Summary of defect
'												DefectSeverity-Severity of defect
'												DefectAssignedTo-whom to assign the defect
'												DefectDetectedBy-who detects defect
'												DefectPriority-Priority of defect
'												DefectStatus-Status of defect
'												DefectProjectName-Project name for the defect
'												DefectDescription-Description of the defect
'												AttachmentPath-local Path for error scrren shot 
'Output Parameters     ->
'***********************************************************************************
'AutomaticDefectLog(DefectMandatoryFieldList,DefectSummary,DefectSeverity,DefectAssignedTo,DefectDetectedBy,DefectPriority,DefectStatus,DefectProjectName,DefectDescription,AttachmentPath)
'***********************************************************************************


Function AutomaticDefectLog(DefectMandatoryFieldList,DefectSummary,DefectSeverity,DefectAssignedTo,DefectDetectedBy,DefectPriority,DefectStatus,DefectProjectName,DefectDescription,AttachmentPath)
        startTime=Timer()
		Dim MandatoryFieldList,i
                   On Error Resume Next	
			MandatoryFieldList=split(cstr(DefectMandatoryFieldList),",",-1,1)
				For i=0 To ubound(MandatoryFieldList)'.count-1
                	If Not MandatoryFieldList(i)="" Then
						'Msgbox "No Mandatory Field for Defect "
'						Else
						Execute("Temp="&MandatoryFieldList(i))
						If Temp="" And DefectSummary="" Then
										stepName="Check Defect Mandatory Field "	       
										inputParameter="<b>" & MandatoryFieldList(i) & " : </b>" & Temp &"<br><b>DefectSummary : </b> " & DefectSummary
										status="FAIL"
										Flag=1
										blnMainFailFlag = True
										message="Mandatory Field Missing for Defect Logging."
										Call ReporterFunction("e-Swift_ReportCreation.vbs","AutomaticDefectLog","1",stepName,message)
										 endTime=Timer()
										 ExeTime = FormatNumber(endTime - startTime,3) 
										Call UpdateResultHtml(stepName,inputParameter,message,status,outputParameter)
										Exit Function
			'							Msgbox "Please Enter Value Against each Mandatory Field"
					   End If						
                  End If
                Next

             If Not TDConnection.Connected Then
                         Call IsQCConnected(QCServerName,QCUserName,QCPassword,QCDomain,QCProject)
             End If
              If QCUtil.IsConnected Then
			            DefectDetectedBy = QCUtil.QCConnection.UserName
			  else
			            DefectDetectedBy=DefectDetectedBy

              End If
'Get the IBugFactory
         Set BugFactory = TDConnection.BugFactory
'Add a new empty bug
         Set objBug = BugFactory.AddItem (Nothing)
'fill the bug with relevant parameters
		objBug.Summary =DefectSummary
		objBug.Status = DefectStatus
		objBug.Priority = DefectPriority  ' depends on the DB
		objBug.AssignedTo =DefectAssignedTo  ' user that must exist in the DB's users list
		objBug.DetectedBy = DefectDetectedBy  ' user that must exist in the DB's users list
		objBug.Field("BG_SEVERITY") = DefectSeverity
		objBug.Field("BG_DETECTION_DATE") = Date
		objBug.Field("BG_PROJECT")=DefectProjectName      
		objBug.Field("BG_DESCRIPTION") = DefectDescription
		Set ObjAttch = objBug.Attachments
		Set a=ObjAttch.AddItem(Null)
		a.FileName = AttachmentPath
		a.Type = 1 
		a.post
		a.Refresh
		objBug.Post
		objBug.Refresh
	   Set a=Nothing
	   Set ObjAttch=Nothing
	   Set objBug=Nothing
	   Set BugFactory=Nothing
	   'Disconnect TD session
	   TDConnection.Disconnect
	   Set TDConnection=Nothing
End Function
'**********************************************************************************
'End Function - AutomaticDefectLog
'***********************************************************************************




'***********************************************************************************
'Name of the Function  -> IsQCConnected
'Author		     					  ->Debabrata Khuntia
'Date			     				   ->16-Nov-2011
'Description		    	 	->  connecting QC through OTA feature
'			       							    
'Input Parameters	     -> QCServerName-Server name of QC
'												QCUserName-Username of Qc
'												QCPassword-Password of Qc
'                                                QCDomain-Domain name of Qc
	'											 QCProject-Project name of QC
'Output Parameters     ->
'***********************************************************************************
 'IsQCConnected(QCServerName,QCUserName,QCPassword,QCDomain,QCProject)
'***********************************************************************************
Public Function IsQCConnected(QCServerName,QCUserName,QCPassword,QCDomain,QCProject)

                 startTime=Timer()
		         stepName="QC Connection"	       
                 inputParameter="<b>Server Name : </b> "& Server &"<br><b>UserName : </b> " & UserName & "<br><b> Password : </b> " & "*****" & "<br><b> QCDomain : </b> " & QCDomain & "<br><b> QCProject : </b> " & QCProject
               On Error Resume Next	
              
					If Err.Number <> 0 Then
				errorDescription= "Unable to create an instance of the TestDirector API And OLE (TestDirector Connection) Object."
				Err.Clear : Exit Function
				End If

				TDConnection.InitConnection QCServerName ' URL for the DB
				If Err.Number <> 0 Then
					errorDescription= Err.Description
					Exit Function
				End If
              TDConnection.Login QCUserName,QCPassword
                 If Err.Number <> 0 Then
					errorDescription=Err.Description
					Exit Function
				ElseIf Not TDConnection.LoggedIn Then
					errorDescription= "Unable to login to Quality Center. Please verify your login credentials."
					Exit Function
				End If
              TDConnection.Connect  QCDomain,QCProject  ' Valid login information
 	             If Err.Number <> 0 Then
					errorDescription= Err.Description
					Exit Function
				ElseIf Not TDConnection.ProjectConnected Then
					errorDescription= "Unable to connect to '" & QCDomain & "/" & QCProject & "'."
					Exit Function
				End If
              On Error Goto 0
						
		    If TDConnection.Connected Then		
						status="DONE"
						message="QC  Connection Successful"
						Call ReporterFunction( "e-Swift_ReportCreation.vbs","IsQCConnected","2",stepName,message)
		   Else 	
				status="FAIL"
				Flag=1
				blnMainFailFlag = True
				message="QC Connection Failed." & vbnewline & "Error Description:" & errorDescription
				Call ReporterFunction("e-Swift_ReportCreation.vbs","IsQCConnected","1",stepName,message)
		   End If				
				 endTime=Timer()
				 ExeTime = FormatNumber(endTime - startTime,3) 
				 If status="FAIL" Then   
				 Call UpdateResultHtml(stepName,inputParameter,message,status,outputParameter)
				 End If     	
	End Function


'**********************************************************************************
'End Function - IsQCConnected
'***********************************************************************************

'***********************************************************************************************************************************
Function SanitizeStringFromSpecialCharacters(strString)
   Dim strTemp 
	strTemp = RemoveSpacesInString(strString)
    strTemp = Replace(strTemp,"!","")
	strTemp = Replace(strTemp,"@","")
	strTemp = Replace(strTemp,"#","")
	strTemp = Replace(strTemp,"$","")
	strTemp = Replace(strTemp,"%","")
	strTemp = Replace(strTemp,"^","")
	strTemp = Replace(strTemp,"&","")
	strTemp = Replace(strTemp,"*","")
	strTemp = Replace(strTemp,"(","")
	strTemp = Replace(strTemp,")","")
	strTemp = Replace(strTemp,"/","")
	strTemp = Replace(strTemp,"?","")
	strTemp = Replace(strTemp,":","")
	strTemp = Replace(strTemp,";","")
	strTemp = Replace(strTemp,"'","")
	strTemp = Replace(strTemp,"|","")
	strTemp = Replace(strTemp,"\","")
    strTemp = Replace(strTemp,"{","")
	strTemp = Replace(strTemp,"}","")
	strTemp = Replace(strTemp,"<","")
	strTemp = Replace(strTemp,">","")
	strTemp = Replace(strTemp,",","")
	strTemp = Replace(strTemp,"-","_")
	strTemp = Replace(strTemp,"+","")
	strTemp = Replace(strTemp,"=","_")
	strTemp = Replace(strTemp,".","")
	strTemp = Replace(strTemp,"–","_")
	
	strTemp = Replace(strTemp,Chr(34),"") '--- Added for double quote special charcter ----- 
	
	SanitizeStringFromSpecialCharacters = strTemp
End Function

''*******************************************************************************************************************************************


''***********************************************************************************
'Name of the Function  : CreateSummaryReport
'Author		    	: Prashant Sharma
'Date			    :   13 May 2013
'Description	    :  Create the Summary HTML report
'Input Parameters	:  None
'Output Parameters  :  None
'***********************************************************************************
'MODIFIED BY -> Sai Satvik
'MODIFIED DATE -> 27/11/2015		..added summary report code according to new report structure
Function CreateSummaryReport()
	Dim aIterationStatus()
	giTotalIterationCount = 0
	giPassIterationCount = 0
	giFailIterationCount = 0
	Set objXml = CreateObject("Microsoft.XMLDOM")
	objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objReport = objXml.SelectSingleNode("//Summary-Report")
	Set objIterationsList = objReport.SelectNodes("Iteration")
	Set objSpecIteration = objReport.SelectSingleNode("Iteration[@id='1']") 
	Set objTestCaseCount = objSpecIteration.SelectNodes("TestCase")		'...to get the testcases count in each iteration
	For each objIteration in objIterationsList
		giTotalIterationCount = giTotalIterationCount + 1
		ReDim preserve aIterationStatus(giTotalIterationCount-1)
		Set objIterationStatus = objIteration.SelectSingleNode("ExecutionStatus")
		If uCase(objIterationStatus.Text) = "PASS" Then
			giPassIterationCount = giPassIterationCount + 1
			aIterationStatus(giTotalIterationCount-1) = "PASS"
		ElseIf Ucase(objIterationStatus.Text) = "FAIL" Then
			giFailIterationCount = giFailIterationCount + 1
			aIterationStatus(giTotalIterationCount-1) = "FAIL"
		End If
	Next
	iFailurePercent = FormatPercent(giFailIterationCount/giTotalIterationCount,1)
	iSuccessPercent = FormatPercent(giPassIterationCount/giTotalIterationCount,1)
	If gblnScenarioMode Then
		strScenarioFolder = objFso.GetParentFolderName(gstrIterationResultFolder)
		Set strHtmlSummaryFile = objFso.CreateTextFile(strScenarioFolder & "\" & gstrSummaryTitle &".html" , True)
	Else
		Set strHtmlSummaryFile = objFso.CreateTextFile(gstrIterationResultFolder & "\" & gstrSummaryTitle &".html" , True)
	End If
	strHtmlSummaryFile.writeline("<!DOCTYPE html PUBLIC '-//W3C//DTD XHTML 1.0 Transitional//EN' 'http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd'>")
	strHtmlSummaryFile.writeline("<html xmlns='http://www.w3.org/1999/xhtml'>")
	strHtmlSummaryFile.writeline("<head>")
	strHtmlSummaryFile.writeline("<meta http-equiv='Content-Type' content='text/html;charset=utf-8'>")
	strHtmlSummaryFile.writeline("<title>TASE Report</title>")
	strHtmlSummaryFile.writeline("<link rel='stylesheet' type='text/css' media='all' href='Report Styling/css/report.css'>")
	strHtmlSummaryFile.writeline("<style>")
	strHtmlSummaryFile.writeline(".dd {width: 960px; margin-top: 05px; margin-right: 20px;margin-bottom: 0pxmargin-left: auto padding: 0; padding-top: 0px;padding-right: 0px;padding-bottom: 0px;padding-left: 0px;}")
	If giTotalIterationCount < 3 Then
		strHtmlSummaryFile.writeline("ul.iter-sub-head li {float:left;width:100%}")
	Else
		strHtmlSummaryFile.writeline("ul.iter-sub-head li {float:left;width:292px;margin:0 18px 0 0;}")
	End If
	If objTestCaseCount.Length < 3 Then
		strHtmlSummaryFile.writeline("ul.case-sub-head li {float:left;width:100%;}")
	Else
		strHtmlSummaryFile.writeline("ul.case-sub-head li {float:left;width:280px;margin:0 18px 0 0;list-style:none;}}")
	End If
	strHtmlSummaryFile.writeline("</style>")
	strHtmlSummaryFile.writeline("<script type='text/javascript' src='Report Styling/js/jquery.min.js'></script>")
	strHtmlSummaryFile.writeline("<script type='text/javascript' src='Report Styling/js/accordion.js'></script>")
	strHtmlSummaryFile.writeline("<script type='text/javascript' src='Report Styling/js/common-script.js'></script>")
	strHtmlSummaryFile.writeline("<script type='text/javascript' src='Report Styling/js/summary-script.js'></script>")
	strHtmlSummaryFile.writeline("<script>")
	strHtmlSummaryFile.writeline("$(document).ready(function(){")
	'......if condition should be used, get the value from Xml and e-Swift UI.. now adding default values.
	If true Then
		strHtmlSummaryFile.writeline("$('#frd').prop('checked',true);")
		strHtmlSummaryFile.writeline("$('#pie').prop('checked',true);")
		strHtmlSummaryFile.writeline("$('#srate').css({'display':'none'});")
		strHtmlSummaryFile.writeline("$('#frate').css({'display':'table-cell'});")
	Else
		strHtmlSummaryFile.writeline("$('#frd').prop('checked',true);")
		strHtmlSummaryFile.writeline("$('#bar').prop('checked',true);")
		strHtmlSummaryFile.writeline("$('#srate').css({'display':'none'});")
		strHtmlSummaryFile.writeline("$('#frate').css({'display':'table-cell'});")
	End If
	
	'...end the condition
	If Ucase(gstrSummaryGraphType) = "BAR" Then
		strHtmlSummaryFile.writeline("$('#bargraph').css({'display':'inline'});")
		strHtmlSummaryFile.writeline("for (var j = 0; j < $('.vert-bars .data li').length; ++j) {")
		strHtmlSummaryFile.writeline("$('.vert-bars .bar:eq(' + j + ')').animate({")
		strHtmlSummaryFile.writeline("height: $('.vert-bars .value:eq(' + j + ')').attr('value')")
		strHtmlSummaryFile.writeline("}, 500);")
		strHtmlSummaryFile.writeline("}")
		strHtmlSummaryFile.writeline("$('#piegraph').css({'display':'none'});")
		strHtmlSummaryFile.writeline("$('#piehead').css({'display':'none'});")
	Else
		strHtmlSummaryFile.writeline("$('#piegraph').css({'display':'inline'});")
		strHtmlSummaryFile.writeline("$('#piehead').css({'display':'inline'});")
		strHtmlSummaryFile.writeline("$('#bargraph').css({'display':'none'});")
	End If
	strHtmlSummaryFile.writeline("});")
	strHtmlSummaryFile.writeline("</script>")
	strHtmlSummaryFile.writeline("</head>")
   	strHtmlSummaryFile.writeline("<body>")
	strHtmlSummaryFile.writeline("<div id='top'></div>")
	strHtmlSummaryFile.writeline("<div id='report-wrapper'>")
	strHtmlSummaryFile.writeline("<div class='report-heading'>")
	If scenarioName <> "" Then
		strHtmlSummaryFile.writeline("<h1>" & scenarioName & "</h1>")
	else
		strHtmlSummaryFile.writeline("<h1>Automation Summary Report</h1>")	
	End If
strHtmlSummaryFile.writeline("<div align='right' class='dd'>")
strHtmlSummaryFile.writeline("<span>TCS - "& gstrCustomerName &"Confedential&nbsp;&nbsp;&nbsp;&nbsp;</span>")
strHtmlSummaryFile.writeline("</div>")   
	strHtmlSummaryFile.writeline("<a id='setting-trigger' href='#'>SETTINGS <span>&#x25BC;</span></a>")
	strHtmlSummaryFile.writeline("<div id='setting-content'>")
	strHtmlSummaryFile.writeline("<form>")
	strHtmlSummaryFile.writeline("<fieldset>")
	strHtmlSummaryFile.writeline("<h5>Graph Type</h5>")
	strHtmlSummaryFile.writeline("<div class='layer'>")
	strHtmlSummaryFile.writeline("<input type='radio' name='graphtype' id='pie'><label for='pie'>Pie Graph</label>")
	strHtmlSummaryFile.writeline("<input type='radio' name='graphtype' id='bar'><label for='bar'>Bar Graph</label>")
    strHtmlSummaryFile.writeline("</div>")            
    strHtmlSummaryFile.writeline("<h5>Success/Failure Rate</h5>")            
    strHtmlSummaryFile.writeline("<div class='layer'>")
	strHtmlSummaryFile.writeline("<input type='checkbox' id='srd'><label for='srd'>Success Rate</label>")    
	strHtmlSummaryFile.writeline("<input type='checkbox' id='frd'><label for='frd'>Failure Rate</label>")
	strHtmlSummaryFile.writeline("</div>")
	strHtmlSummaryFile.writeline("</fieldset>")
	strHtmlSummaryFile.writeline("</form>")
	strHtmlSummaryFile.writeline("</div>")
	strHtmlSummaryFile.writeline("</div>")
	strHtmlSummaryFile.writeline("<div class='report-content light-gray'>")
	strHtmlSummaryFile.writeline("<h2>Summary</h2>")
	strHtmlSummaryFile.writeline("<table border='0'><tr><td> <div  class='logo-image'><img src='Report Styling/images/r-summary.png' alt='' /></div></td><td style='width:85%'>")
    strHtmlSummaryFile.writeline("<table  class='stat-status' border='0' cellspacing='0' cellpadding='0' >")
  	strHtmlSummaryFile.writeline("<caption>Iterations<span>*Click to get related title highlighted</span></caption>")
    strHtmlSummaryFile.writeline("<tr>")
    strHtmlSummaryFile.writeline("<td class='total'><nobr><a href='#'><span class='count'>" & giTotalIterationCount & "</span><span>Total</span></a></nobr></td>")
    strHtmlSummaryFile.writeline("<td class='pass'><nobr><a href='#'><span class='count'>" & giPassIterationCount & "</span><span>Pass</span></a></nobr></td>")
    strHtmlSummaryFile.writeline("<td class='fail'><nobr><a href='#'><span class='count'>" & giFailIterationCount & "</span><span>Fail</span></a></nobr></td>")
    strHtmlSummaryFile.writeline("<td class='pass' id='srate'><nobr><a href='#'><span class='count'>" & iSuccessPercent & "</span><span>Success Rate</span></a></nobr></td>")
    strHtmlSummaryFile.writeline("<td class='fail' id='frate'><nobr><a href='#'><span class='count'>" & iFailurePercent & "</span><span>Failure Rate</span></a></nobr></td>")
    strHtmlSummaryFile.writeline("</tr>")
