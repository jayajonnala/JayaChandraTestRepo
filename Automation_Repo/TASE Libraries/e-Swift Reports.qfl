		Else
			strHtmlSummaryFile.writeline("<li class='fail total' id='sub-head-Iteration" & i & "'><a href='#Iteration'" & i & " class='masterTooltip' title='Iteration " & i & " - " & scenarioName & "'>" & iterationName & "</a></li>")				
    	End If
    Next
    strHtmlSummaryFile.writeline("</ul>")    
    strHtmlSummaryFile.writeline("</td><td style='border:1px solid black;width:30%; margin-left:100px;'>")    
    strHtmlSummaryFile.writeline("<table style='width:90%'>")      
    strHtmlSummaryFile.writeline("<tr>")  
    strHtmlSummaryFile.writeline("<td style='width:75%'>") 
    strHtmlSummaryFile.writeline("<table style='width:100%'>") 
    strHtmlSummaryFile.writeline("<tr id='piehead'>") 
    strHtmlSummaryFile.writeline("<th colspan='5'><h2 class='pieheader' style='margin-left:65px'>Pie Chart</h2></th>") 
    strHtmlSummaryFile.writeline("</tr>") 
    strHtmlSummaryFile.writeline("<tr id='bargraph'>") 
    strHtmlSummaryFile.writeline("<td>") 
    strHtmlSummaryFile.writeline("<div class='vert-bars'>") 
    strHtmlSummaryFile.writeline("<h2>Bar Graph</h2>") 
    strHtmlSummaryFile.writeline("<ul class='data'>") 
    strHtmlSummaryFile.writeline("<li>") 
    strHtmlSummaryFile.writeline("<span class='value' value='100%'> " & giTotalIterationCount & " </span>") 
    strHtmlSummaryFile.writeline("<div class='bar' style='background:blue'></div>") 
    strHtmlSummaryFile.writeline("</li>") 
