Public Function RetrieveExcelData(InputFilePath, sQuery, ByRef aArrayVariable)
    On Error Resume Next
    Dim startTime, endTime, ExeTime, objRecSet
    Dim blnFunctionFound, iColumnCount
    blnFunctionFound = False
    Dim oConn, oRS, arrData, x, iRow : iRow = 0
    Const adOpenStatic = 3
    Const adLockOptimistic = 3
    Const adCmdText = " & H0001"
    'startTime = Now

    Set oConn = CreateObject("ADODB.Connection")
    Set objRecSet = CreateObject("ADODB.RecordSet")
'    oConn.Open("Provider=Microsoft.ACE.OLEDB.12.0;" & "Data Source=" & InputFilePath & ";" & "Extended Properties=""Excel 8.0;HDR=Yes;"";") 'Open Connection
	oConn.Open "DRIVER={Microsoft Excel Driver (*.xls)};DBQ="&InputFilePath & ";Readonly=True"
    objRecSet.Open sQuery, oConn, 3, 3, 1  ' Open Recordset
    iColumnCount = objRecSet.Fields.Count - 1
    ReDim aArrayVariable(iColumnCount)

    If Not objRecSet.EOF Then
        For x = 0 To objRecSet.Fields.Count - 1
            aArrayVariable(x) = Trim(objRecSet(x).Value)
            'msgbox "aArrayVariable("  &  x  &  ") - "  &  aArrayVariable(x)
        Next
    End If

    objRecSet.Close()
    oConn.Close()
    Set oConn = Nothing
    Set objRecSet = Nothing
    'endTime = Now.Subtract(startTime)
    'ExeTime = endTime.TotalSeconds
End Function

Function RemoveSpacesInString(sSourceString)
    Dim arrTemp
    Dim strTemp
    strTemp = ""
    arrTemp = Split(Trim(sSourceString), " ")
    For i = 0 To UBound(arrTemp)
        strTemp = strTemp + arrTemp(i)
    Next
    RemoveSpacesInString = strTemp
End Function

Class BalloonTooltipClass
	Private oNtfy,oToolTip,oIcon,icon_Path
	Private sub Class_Initialize
		icon_Path=gstrIconPathForNotification
		Set oNtfy=DotNetFactory.CreateInstance("System.Windows.Forms.NotifyIcon","System.Windows.Forms")
		Set oToolTip =DotNetFactory.CreateInstance("System.Windows.Forms.ToolTipIcon","System.Windows.Forms")
		Set oIcon=DotNetFactory.CreateInstance("System.Drawing.Icon","System.Drawing",icon_Path)
	End Sub
	
	Function Show(ByVal strTitle,ByVal strContent)
		oNtfy.Icon=oIcon
		oNtfy.BalloonTipIcon=oToolTip.Info
		oNtfy.Visible=True
		oNtfy.Text = strTitle
		oNtfy.BalloonTipTitle = strTitle
		oNtfy.BalloonTipText=strContent
		oNtfy.ShowBalloonTip(5000)
	End Function
	
	Private Sub Class_Terminate
		oNtfy.Dispose()
		Set oIcon =Nothing
		Set oTool =Nothing
		Set oNtfy=Nothing
	End Sub
End Class


 '***********************************************************************************'***********************************************************************************
'Name of the Function  -> CreateRunTimeExcelFile
'Author		   						  ->TCS
'Dat		     						->30/06/2014
'Description  	   				->  Runtime Data would be updated updated in the excel file whose name should be the Test Scenario Name
'Input Parameters	     -> strFileName = Excel file name (Test Scenario Name)  - This function is called by WriteRunTimeScenarioData
'Output Parameters     -> None
'***********************************************************************************'***********************************************************************************
Function CreateRunTimeExcelFile(strFileName)
		Set InputAppExcel = CreateObject("Excel.Application")  
		InputAppExcel.Visible = False
		Set objWorkbook = InputAppExcel.Workbooks.Add()
		objWorkbook.SaveAs strFileName,39
		InputAppExcel.Quit
		Set InputAppExcel = Nothing
End Function

 '***********************************************************************************'***********************************************************************************
'Name of the Function  -> WriteRunTimeScenarioData
'Author		   						  ->TCS
'Dat		     						->30/06/2014
'Description  	   				->  Runtime Data would be updated updated in the excel file whose name should be the Test Scenario Name
'Input Parameters	     -> strRunTimeExcelFileName = Excel file name (Test Scenario Name) . SHould be supplied from within the script with unique Scenario Name
'												strVariableName  = Name of the variable holding the runtime value
'												strVariableValue  =  Runtime value
'Output Parameters     -> None
'***********************************************************************************'***********************************************************************************
Public Function WriteRunTimeScenarioData(strRunTimeExcelFileName,strVariableName,strVariableValue)
						Dim strFileName,strFolderPathToCreate,iRunTimeDataRowCounter 
						If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Writing RunTime Scenario Data in Local File"
						gstrRuntimeScenarioDataFilePath = trim(gstrRuntimeScenarioDataFilePath)
						If gstrRuntimeScenarioDataFilePath="" Then
									strFolderPathToCreate = gstrMainResultFolder  & "\" & gstrRunTimeDataSheetFolderName
						else
									If right(gstrRuntimeScenarioDataFilePath,1) = "\" then 
												gstrRuntimeScenarioDataFilePath= left(gstrRuntimeScenarioDataFilePath,len(gstrRuntimeScenarioDataFilePath)-1) 
									End if 
									If  instr(gstrRuntimeScenarioDataFilePath,gstrRunTimeDataSheetFolderName)= 0  Then
												strFolderPathToCreate  = gstrRuntimeScenarioDataFilePath & "\" & gstrRunTimeDataSheetFolderName
									else
												strFolderPathToCreate  = gstrRuntimeScenarioDataFilePath
									End If
						End If

                        If (objFso.FolderExists(strFolderPathToCreate )) = False Then   
											aFolders= split(strFolderPathToCreate ,"\")
											strTempFolder= ""
											If Ubound(aFolders) > 0 Then
																strTempFolder= aFolders(iCnt)
																For iCnt=0 to Ubound(aFolders)
																		If  iCnt>0 Then
																				strTempFolder =strTempFolder &"\" & aFolders(iCnt)
																		End If
																		If (objFso.FolderExists(strTempFolder)) = False Then
																				objFso.createfolder(strTempFolder)
																		End if 
																Next
											End if 
						End if 
						gstrRuntimeScenarioDataFilePath = strFolderPathToCreate 
						strFileName = gstrRuntimeScenarioDataFilePath  & "\" & strRunTimeExcelFileName & ".xls"

						If Not (objFso.FileExists(strFileName)) Then
										CreateRunTimeExcelFile strFileName
						End if 
						iRunTimeDataRowCounter = 0
						Set InputAppExcel = CreateObject("Excel.Application")     
						Set objInputWorkBook = InputAppExcel.Workbooks.Open(strFileName) 		' objInputWorkBook  variable  contains/opens the excel workbook for the input file
						Set objInputSheet =  InputAppExcel.Sheets("Sheet1") 
						Do
								iRunTimeDataRowCounter = iRunTimeDataRowCounter +1
						Loop Until (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = "") or (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = strVariableName)
						If iRunTimeDataRowCounter<> 0 Then
									iRunTimeDataRowCounter = iRunTimeDataRowCounter -1
						End If
						objInputSheet.cells(1,iRunTimeDataRowCounter+1).value = strVariableName
						objInputSheet.cells(2,iRunTimeDataRowCounter+1).value = strVariableValue
						objInputWorkBook.Save
						objInputWorkBook.Close
						InputAppExcel.Quit
						Set InputAppExcel = Nothing
						Set objInputWorkBook =Nothing
						Set objInputSheet =Nothing
	
End Function

 '***********************************************************************************'***********************************************************************************
'Name of the Function  -> GetRunTimeDataFromExcel
'Author		   						  ->TCS
'Dat		     						->30/06/2014
'Description  	   				->  Runtime Data updated in the excel file would be fetched
'Input Parameters	     -> strRunTimeExcelFileName = Excel file name (Test Scenario Name) , 
'												IterationIndex  = Row number in the sheet 
'Output Parameters     -> Run time Data value as updated in the sheet
'***********************************************************************************'***********************************************************************************
Public Function GetRunTimeDataFromExcel(strRunTimeExcelFileName,IterationIndex)
		err.clear
		Dim strFolderPathToFind
		On error resume next
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Reading RunTime Data From Local Excel"
		If gstrRuntimeScenarioDataFilePath="" Then
									strFolderPathToFind = gstrMainResultFolder  & "\" & gstrRunTimeDataSheetFolderName
		Else
									If right(gstrRuntimeScenarioDataFilePath,1) = "\" then 
												gstrRuntimeScenarioDataFilePath= left(gstrRuntimeScenarioDataFilePath,len(gstrRuntimeScenarioDataFilePath)-1) 
									End if 
									If  instr(gstrRuntimeScenarioDataFilePath,gstrRunTimeDataSheetFolderName)= 0  Then
												strFolderPathToFind  = gstrRuntimeScenarioDataFilePath& "\" & gstrRunTimeDataSheetFolderName
									else
												strFolderPathToFind  = gstrRuntimeScenarioDataFilePath
									End If
		End If
		gstrRuntimeScenarioDataFilePath = strFolderPathToFind
		strFileName= gstrRuntimeScenarioDataFilePath & "\" & strRunTimeExcelFileName & ".xls"
		
		Dim oConn, oRS, arrData, x,iStart
		
		CONST adOpenStatic = 3
		CONST adLockOptimistic = 3
		CONST adCmdText = "&H0001"

		Set oConn = CreateObject("ADODB.Connection")
		Set objRecSet= CreateObject("ADODB.RecordSet")
			'Open Connection
'		oConn.Open "Provider=Microsoft.ACE.OLEDB.12.0;" &_		
'				    "Data Source=" & strFileName & ";" & _
'					"Extended Properties=""Excel 8.0;HDR=Yes;"";"
		oConn.Open "DRIVER={Microsoft Excel Driver (*.xls)};DBQ="&strFileName & ";Readonly=True"
					
		sQuery = "Select * From [" & "Sheet1" & "$]"
        objRecSet.Open sQuery, oConn, 3, 3, 1		'Run query against WorkBook

		For x = 2 to IterationIndex - 1				'Move RecordSet to the target Row
			objRecSet.MoveNext
		 Next
		For x = iStart   to objRecSet.Fields.Count - 1					'Use a For..Loop to iterate through Recordset
					DataItemName = trim(objRecSet(x).Name)
					DataItemValue=trim(objRecSet(x).Value)
					Execute DataItemName &"= DataItemValue"       '' The variable value is assigned to the vairable name
		Next
		set oConn = Nothing
		set objRecSet = Nothing

End Function
'***********************************************************************************'***********************************************************************************
'Name of the Function  -> GetLastDateOf_Month
'Author		   						  ->TCS
'Dat		     						->30/06/2014
'Description  	   				->  Get Last day of any month sent
'Input Parameters	     -> strDate = Date value 
'Output Parameters     ->  Last day of the month of date sent
'***********************************************************************************'***********************************************************************************
Function GetLastDateOf_Month(strDate)
	iMonth = Month(strDate)
	Select Case iMonth
			Case "1"  iLastDay =  "31" 
			Case "2"  iLastDay =  "28" 
			Case "3"  iLastDay =  "31" 
			Case "4"  iLastDay =  "30" 
			Case "5"  iLastDay =  "31" 
			Case "6"  iLastDay =  "30" 
			Case "7"  iLastDay =  "31" 
			Case "8"  iLastDay =  "31" 
			Case "9"  iLastDay =  "30" 
			Case "10"  iLastDay =  "31" 
			Case "11"  iLastDay =  "30" 
			Case "12"  iLastDay =  "31" 
	End Select
	GetLastDateOf_Month =  FmtDate( iLastDay &"/"& Month(strDate) &"/"& Year(strDate))
End Function


'***********************************************************************************'***********************************************************************************
'Name of the Function  -> GetRandomAlphaNum
'Author		   						  ->TCS
'Dat		     						->30/06/2014
'Description  	   				->  Get Random Alphanumeric/numeric/alphabets
'Input Parameters	     ->  intMaxAlphabetCount = Length of the word
'											   intNumDigitCount=length of the number
'Output Parameters     ->  
'***********************************************************************************'***********************************************************************************

Function GetRandomAlphaNum(intMaxAlphabetCount,intNumDigitCount)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: GetRandomAlphaNum" 
	Dim  k,i, intValue, strChar, strValue,BatchName,BatchRandom
	strAlphaNumericValue = ""
	Const Chars =  "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	Randomize
	If  intMaxAlphabetCount <> 0Then
		For k=1 to intMaxAlphabetCount
			strValue=Fix(26 * Rnd())
			strChar = Mid(Chars, strValue + 1, 1)
			strAlphaNumericValue = strAlphaNumericValue & strChar	
		Next
	End If
	If intNumDigitCount<> 0 Then
		For i=1 to intNumDigitCount
			intValue = Fix(10*Rnd())
			BatchRandom = strAlphaNumericValue & intValue
			strAlphaNumericValue=BatchRandom
		Next
	End if 
	GetRandomAlphaNum = Ucase(strAlphaNumericValue)	
End Function

'***************************************************************************************************************************************
'Name of the Function   : Format the date
'***************************************************************************************************************************************
Function FmtDate(theDate) 
   If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: FmtDate" 
  Months = Array("Jan", "Feb", "Mar", "Apr", "May", "Jun", _ 
                 "Jul", "Aug", "Sep", "Oct", "Nov", "Dec") 
  FmtDate = Day(theDate) & "-" _ 
          & Months(Month(theDate)-1) & "-" _ 
          & Year(theDate) 
End Function 

Function CreateDummyFileInScreenshotFolder()
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: CreateDummyFileInScreenshotFolder" 
	FolderPath= gstrIterationResultFolder & "\ScreenShots"
	Set fs = CreateObject("Scripting.FileSystemObject")
	If fs.FolderExists(FolderPath) Then
		Set sFolder = fs.GetFolder(FolderPath)
		If sFolder.Size= 0 Then
			fs.CreateTextFile(FolderPath & "\Image.jpg")
		End if 
	End If
End Function

Function CreateandWriteDummyFile(strFileName)
	On error resume Next    
	logFileName= gstrIterationResultFolder & "\" & strFileName
	Set objFile  = objFso.createtextfile(logFileName , True)
	objFile.WriteLine "DUMMY DUMMY DUMMY "
	objFile.WriteLine "DUMMY DUMMY DUMMY "
	objFile.WriteLine "DUMMY DUMMY DUMMY "
	objFile.Close
	Set objFile = Nothing		'Destroy the objFile object
End Function


Function DeleteDummyFile(strFileName)
	FileName =gstrIterationResultFolder & "\" & strFileName
	Set fs = CreateObject("Scripting.FileSystemObject")
	If fs.FileExists(FileName) Then
		Set file = fs.GetFile(FileName)
		fs.DeleteFile(FileName)
	End If
End Function

Function DeleteBlankLogFile()
   	FileName =gstrIterationResultFolder & "\" & "e-Swift LogFile" &".txt"
	Set fs = CreateObject("Scripting.FileSystemObject")
	If fs.FileExists(FileName) Then
	    Set file = fs.GetFile(FileName)
	    If file.Size = 0 Then
			fs.DeleteFile(FileName)
	    End if 
	End If
End Function

Public Function WriteRunTimeDataToExcel (strVariableName,strVariableValue)
	'On error resume next
	Dim strFileName,strFolderPathToCreate,iRunTimeDataRowCounter 
	Execute strVariableName & " = strVariableValue"
'						If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Writing RunTime Scenario Data in Local File"
	iRunTimeDataRowCounter = 0
	Set InputAppExcel = CreateObject("Excel.Application")     
	Set objInputWorkBook = InputAppExcel.Workbooks.Open(InputFilePath) 		' objInputWorkBook  variable  contains/opens the excel workbook for the input file
	Set objInputSheet =  InputAppExcel.Sheets("OUTPUT") 
	Do
			iRunTimeDataRowCounter = iRunTimeDataRowCounter +1
	Loop Until (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = "") or (objInputSheet.cells(1,iRunTimeDataRowCounter).value  = strVariableName)
	If iRunTimeDataRowCounter<> 0 Then
				iRunTimeDataRowCounter = iRunTimeDataRowCounter -1
	End If
	objInputSheet.cells(1,iRunTimeDataRowCounter+1).value = strVariableName
	objInputSheet.cells(gstrWriteDataToExcelRowNo,iRunTimeDataRowCounter+1).value = strVariableValue
	objInputWorkBook.Save
	objInputWorkBook.Close
	InputAppExcel.Quit
	Set InputAppExcel = Nothing
	Set objInputWorkBook =Nothing
	Set objInputSheet =Nothing
End Function 

Function CloseOpenIEBrowsers()
		Dim strQCTitle,iCreationTime,strCASurl
		
		Dim objLink
		On error resume next
		strQCTitle ="HP Quality Center"
		strCASurl = "Contractor Access Service"
		strGRAurl = "GRA - Home"
    	numWindowFlag = 1
		Set objShell = CreateObject("shell.application")
		Set objWinShell = objShell.windows
		numWindowCount = objShell.windows.count
       If  numWindowCount > 0 Then
       		For  iCreationTime=numWindowCount  to 0 step -1 
						If  Browser("CreationTime:="& iCreationTime).Exist(1) Then
									strTitle =Browser("CreationTime:="& iCreationTime).GetROProperty("Title")
									If Instr(strTitle,strCASurl)= 0  or  Instr(strTitle,strGRAurl)= 0Then
										
													
													If Instr(strTitle,strQCTitle)= 0  and Instr(strTitle,"Oracle Applications Home Page")>0 Then
																	Set objMainBrowser = Browser("name:="& strTitle).Page("title:="& strTitle)
																	Set objLink = Description.Create()
																	objLink("micclass").value= "Link"
																	objLink("html tag").value= "A"
																	objLink("name").value= "Logout"
																	Set objChildrenLink = objMainBrowser.ChildObjects(objLink)
																	If  objChildrenLink(0).Exist(1) Then
																			objChildrenLink(0).Click
																			Call WaitForObject(Browser("CreationTime:="& iCreationTime),30)
																			Browser("CreationTime:="& iCreationTime).Close
																	End If
													else
																	Browser("CreationTime:="& iCreationTime).Close
																
																	
													End If
									End if 
						End If
			Next
		End if 
		Set objShell= Nothing
		Set objWinShell= Nothing
End Function



'***********************************************************************************'***********************************************************************************
'Name of the Function -> StartExecution
'Author				  -> Sai Satvik
'Date				  -> 21/10/2015
'Description  	   	  -> Entry point of execution for any test case, all types of initializations will take place here.
'Input Parameters	  -> Input excel path, excel sheet name to fetch the data, row number of excel,result folder path
'Output Parameters    -> None
'update comments: strResultFolderPath to retrieve customise result folder path in runtime
'***********************************************************************************'***********************************************************************************

Public Function StartExecution(excelPath,strTestCaseName,iterationIndex,strResultFolderPath)
Call RefreshExcelSheet(excelPath)
Set objShell = CreateObject("WScript.Shell")
Environment.Value("blnFatalError") = objShell.Environment("USER").Item("blnFatalError")
'''''' This lines of code is added to reset the value of theblnFatalError & blnObjectError to exeute the test cases locally without any issues.
If Environment.Value("blnFatalError") Then
	Environment.Value("blnFatalError") = False
End If

if blnObjectError then 
	blnObjectError = False
End if 
''''' End of the section
If Not Environment.Value("blnFatalError") Then
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Intiating automation execution"  End if
	Dim xmlDoc
	If gstrTestCaseName = "" Then
    	gstrTestCaseName  = strTestCaseName
    End If
    giHTMLRowNumber = 1
    giTestCaseNumber = giTestCaseNumber + 1
	Set objXml = CreateObject("Microsoft.XMLDOM")
	rootNodeName = "execution-summary"
	If gblnScenarioMode Then
	    objXml.load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	    'excelPath = get scenarioDataExcelPath from XML 
	    Set objReport = objXml.SelectSingleNode("//Summary-Report")
	    Set objExcelScenarioPath = objReport.SelectSingleNode("ScenarioDataExcelPathandName")
	    excelPath = objExcelScenarioPath.Text
	    If excelPath = "" Then
	        Msgbox "Please provide DataFolderPath in Settings tab of TASE UI"
			Environment("blnFatalError") = True
			Exit Function
	    End If
		If Not objFso.FileExists(excelPath) Then
	        Msgbox "Please provide valid DataFolderPath in Settings tab of TASE UI-failed to fetch scenario excel sheet"
			Environment("blnFatalError") = True
			Exit Function
	    End If
	    Set objCurrentIteration = objReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
	    Set objExcelRow = objCurrentIteration.SelectSingleNode("excelRowNumber")
	    iterationIndex = objExcelRow.Text
	    'Create Testcase tag with id of test case name
	    Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Summary-Report")
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Detailed-Report")
        'Create default tags like status, executiontime
        Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Status","","Summary-Report")
		Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"ExecutionTime","","Summary-Report")
        Set objExcelRow = Nothing
        Set objReport = Nothing
	    Set objCurrentIteration = Nothing
	    Set objExcelScenarioPath = Nothing
	    Set objXml = Nothing
	Else
		Environment.Value("blnFatalError") = False
		Set xmlDoc = CreateObject("Microsoft.XMLDOM")
       	xmlDoc.Load(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
'		Set resultFolderPath = xmlDoc.SelectSingleNode("//ResultFolderPath")
'		If resultFolderPath.Text <> "" Then
'			gstrMainResultFolder = resultFolderPath.Text
		Set objEnvironment = xmlDoc.SelectSingleNode("//Fav1") '----- updated for sandbox
		envValue = objEnvironment.Text '----- updated for sandbox
'		msgbox envValue '----- updated for sandbox
		
		'set report folder path in runtime
		If strResultFolderPath <> "" Then
		gstrMainResultFolder = strResultFolderPath
		'msgbox resultFolderPath
		Else
			Msgbox "Please provide resultFolderPath in Test Parameter"
			Environment("blnFatalError") = True
			Exit Function
		End If
		Set dataFolderPath = xmlDoc.SelectSingleNode("//DataFolderPath")
		dataPath = dataFolderPath.Text
		Set trainingDoCFlag = xmlDoc.SelectSingleNode("//Creation")
		'msgbox trainingDoCFlag.Text
		If trainingDoCFlag.Text = "Yes" Then
			blnCreateTrainingDoc=True
			Set trainingDoCFormat = xmlDoc.SelectSingleNode("//Format")
			If instr(trainingDoCFormat.Text,"WORD")>0 Then
				blnCreateWordTrainingDoc=True
			else
				blnCreateWordTrainingDoc=False
			End If
			If instr(trainingDoCFormat.Text,"PDF")>0 Then
				blnCreatePDFTrainingDoc=True
			Else
				blnCreatePDFTrainingDoc=False
			End If
		End If
		Set reportFormat = xmlDoc.SelectSingleNode("//ReportFormat")
		'msgbox reportFormat.text
		If instr(reportFormat.Text,"WORD")>0 Then
				gblnCreateDetailedAndSummaryReportDoc=True
			else
				gblnCreateDetailedAndSummaryReportDoc=False
			End If
			If instr(reportFormat.Text,"PDF")>0 Then
				gblnCreatePDFDetailedAndSummaryReportDoc=True
			Else
				gblnCreatePDFDetailedAndSummaryReportDoc=False
			End If
	
		xmlDoc.Save(gstrUISettingsXMLPath & "\" & gstrUISettingsXMLName)
		Set xmlDoc = Nothing
		'if Xml present delete it and create new in installation folder
       	'add xml header for created XML
       	If objFso.FileExists(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName) Then
    		objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
		End If
		Set objRoot = objXml.CreateElement("execution-summary")
		objXml.appendChild objRoot
		rootNodeName = objRoot.nodeName
		'Create tags scenarioDataExcelPath, ResultFolderPath, TotalNumberOfIterations to store input excel path, result folder path and scenarioTotalIterations
		If dataPath <> "" Then
			scenarioDataExcelName = objFso.GetFileName(excelPath)
			dataPath = dataPath & "\" & scenarioDataExcelName
		Else
			'Msgbox "Please provide dataFolderPath in Settings tab of TASE UI"	
			'Environment("blnFatalError") = True
			'Exit Function
		End If
		Set objIntro = objXml.createProcessingInstruction("xml","version='1.0'")  
		objXml.insertBefore objIntro,objXml.childNodes(0)
		objXml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
		Set objXml = Nothing
		If objFso.FileExists(dataPath) and dataPath <> "" Then
    		excelPath = datapath
		ElseIf gblnDownloadInputExcelFromQC Then
        	strExcelPath = DataSheetAutoDownload(dataPath)
            If strExcelPath <> "ERROR" Then  
            	excelPath = strExcelPath
            End If            
		End If
		Call CreateTagInSummaryXML(rootNodeName,"","Summary-Report","","Summary-Report")    		
		Call CreateTagInSummaryXML(rootNodeName,"","Detailed-Report","","Detailed-Report")
		'Create tags scenarioDataExcelPath, ResultFolderPath, TotalNumberOfIterations to store input excel path, result folder path and scenarioTotalIterations in summary-Report
		Call CreateTagInSummaryXML("Summary-Report","","ScenarioDataExcelPathandName",excelPath,"Summary-Report")    		
		Call CreateTagInSummaryXML("Summary-Report","","TotalNumberofIterations",scenarioTotalIterations,"Summary-Report")
		Call CreateTagInSummaryXML("Summary-Report","","ResultFolderPath",gstrMainResultFolder,"Summary-Report")
		'need to create the iteration tag with id = 1 in both Summary and Detailed Report tags
		Call CreateIterationTaginXML("Summary-Report",1,iterationIndex,"Summary-Report")
		Call CreateIterationTaginXML("Detailed-Report",1,iterationIndex,"Detailed-Report")
		'Create Testcase tag with id of test case name
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Summary-Report")
		Call CreateTagWithAttributeInSummaryXML("Iteration",giCurrentIteration,"TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Detailed-Report")
        'Create default tags like status, executiontime
        Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Status","","Summary-Report")
		Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"ExecutionTime","","Summary-Report")
		Set objIntro = Nothing
		Set objRoot = Nothing
	End If
	blnSkipSteps= False
	Call GetInputFromExcel(excelPath,strTestCaseName,iterationIndex)
	InputFilePath =excelPath
	Call GetInputFromExcel(excelPath,"COMMON",2)
	If giCurrentIteration = 1 Then
		Call CreateTagInSummaryXML("Summary-Report","","ScenarioName",ScenarioName,"Summary-Report")    				   			
	End If
	If gblnScenarioMode Then
		Call CreateResultFolder(ScenarioName)
	Else
		Call CreateResultFolder(gstrTestCaseName)	
	End If
	If blnSetReporterFlag and blnSetLogFileFlag Then
		Call CreateLogFile()
	End If						
	errorCount=1  
	Reporter.Filter = rfDisableAll 
	giTestCaseStartTime=Timer()	

	If gstrGeneralTestCase = "" Then
		Call Html_iteration(gstrTestCaseName)
	else
		Call Html_iteration(gstrGeneralTestCase)
	End if 

	If blnCreateTrainingDoc = True Then
		Call CreateTrainingDoc(strTestCaseName)
	End if
	giLastUpdatedTime = Timer()
End If
Set objShell= Nothing

''** START - Updated on 24-Nov by Kumar
	'' Update the Environment in eswift settings xml in Fav1 attribute
	''msgbox envValue
	''Condition for Setting the Environment in DT_SAPSYSTEM
		    If envValue <> "" AND envValue = "Sandbox" Then
		    	DT_SAPSYSTEM = "RGB - SAP RETAIL Sandbox GLOBAL"
		    	Environment.Value("SAPSYSTEM")="RGB - SAP RETAIL Sandbox GLOBAL"
		    	
		    	ElseIf envValue <> "" AND envValue = "Development" Then
		    	DT_SAPSYSTEM = "RGD - SAP RETAIL Development GLOBAL"
		    	Environment.Value("SAPSYSTEM")="RGD - SAP RETAIL Development GLOBAL" 
		    End If
	''** END    
SAPGuiUtil.CloseConnections '---- Closing any open SAp window before execution
End Function

'***********************************************************************************'***********************************************************************************
'Name of the Function -> CreateResultFolder
'Author				  -> Vinay
'Date				  -> 20/10/2015
'Description  	   	  -> Creates the result folder based on the scenario wise and normal executions
'Input Parameters	  -> test Case name
'Output Parameters    -> None
'***********************************************************************************'***********************************************************************************
Function  CreateResultFolder(strTestCaseName)	
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Creating Result folder in Path " & gstrMainResultFolder  End if 
	On error resume next
    Dim currentDate,currentTime
	    Set objShell = CreateObject("WScript.Shell")
    'gstrMainResultFolder=objShell.Environment("USER").Item("gstrMainResultFolder")
    Set objXml = CreateObject("Microsoft.XMLDOM")
    objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
    Set objCurrentIteration = objXml.SelectSingleNode("//Iteration[@id='" & giCurrentIteration & "']")
    Set objTestCasesList = objCurrentIteration.SelectNodes("TestCase")
    If giCurrentIteration = 1 and objTestCasesList.Length = 1 Then
    	currentDate = Replace(Date, "/", ".")
		currentTime = Replace(Time, ":", ".")
		If gblnScenarioMode Then
			gstrResultFolderName = "\Result_"& strTestCaseName & "_Scenario_" & currentDate & "_" & currentTime
		Else
			gstrResultFolderName = "\Result_"& strTestCaseName & "_TestCase_" & currentDate & "_" & currentTime		
		End If
		gstrScenarioResultFolder= gstrMainResultFolder & gstrResultFolderName
		Environment.Value("HtmlResultReportpath") = gstrScenarioResultFolder ' Added this line of code to update hte result folder path to runtime
		objShell.Environment("USER").Item("gstrScenarioResultFolder")=gstrScenarioResultFolder
    End If
    Set objTestCasesList = Nothing
    Set objCurrentIteration = Nothing
    Set objXml = Nothing
	If gblnScenarioMode Then
	     gstrIterationResultFolder = gstrScenarioResultFolder & "\Iteration_" & giCurrentIteration '& get the iteration number from total noof iteartions tag value
	Else
	     gstrIterationResultFolder = gstrScenarioResultFolder
    	End If
	 objShell.Environment("USER").Item("gstrIterationResultFolder")=gstrIterationResultFolder
    	If (objFso.FolderExists(gstrIterationResultFolder)) = False Then   
		aFolders= split(gstrIterationResultFolder,"\")
		strTempFolder= ""
		If Ubound(aFolders) > 0 Then
			strTempFolder= aFolders(iCnt)
    		For iCnt = 0 to Ubound(aFolders)
				If iCnt > 0 Then
						strTempFolder =strTempFolder &"\" & aFolders(iCnt)
				End If
				If (objFso.FolderExists(strTempFolder)) = False Then
						objFso.createfolder(strTempFolder)
				End if 
			Next
		Else
			objFso.createfolder(gstrIterationResultFolder)
		End If
		objFso.createfolder(gstrIterationResultFolder & "\ScreenShots")
		err.clear							''cleared to check if the report styling is present provided folder or not
		If gblnScenarioMode Then				''creation of css, js  and images for detailed and summary reports
			strScenarioFolder = objFso.GetParentFolderName(gstrIterationResultFolder)
			If Not objFso.FolderExists(strScenarioFolder & "\Report Styling") Then
				objFso.CopyFolder gstrMasterResultDrive & "\Report Styling",strScenarioFolder & "\Report Styling"
			End If
		Else
			If Not objFso.FolderExists(gstrIterationResultFolder & "\Report Styling") Then
				objFso.CopyFolder gstrMasterResultDrive & "\Report Styling",gstrIterationResultFolder & "\Report Styling"
			End If		
		End If
		If err.number = 76 and Ucase(err.description) = Ucase("Path Not Found") Then
			msgbox "Please place the Report Styling folder in """ & gstrMasterResultDrive & """ and then continue the execution"
			Environment("blnFatalError") = True
			Exit function
		End If
		Call CreateHTMLResultFile(strTestCaseName)
	End if 
		Set objShell= Nothing
End Function


'**********************************************************************************
'Name of the Function   :DataSheetAutoDownload(dataExcelPath)
'Modified by : Vinay
'Description		     : Automatic download of data sheet to the path specified in startexecution before Test Execution       
'Input Parameters	     :  
'Output Parameters        : Null
'***********************************************************************************
 'Function DataSheetAutoDownload()
'***********************************************************************************
Public Function DataSheetAutoDownload(dataExcelPath)
	On error Resume next
	Set QCConn = QCUtil.QCConnection
	If Err.Number=CLng(-2147221500) Or QCUtil.IsConnected=false Then
		Err.clear
		DataSheetAutoDownload = "ERROR"
		Exit Function
	Else
		Set AttachmentFactory= QCUtil.CurrentTest.Attachments
		Set attchList=AttachmentFactory.NewList("")
		If attchList.Count > 0 Then
			For i = 1 to attchList.Count
				Set attchObj = attchList.Item(i)
				tempPath = attchObj.FileName
				arrayPath = split(tempPath,"\")
				eCount = UBOUND(arrayPath)
				tempName = arrayPath(eCount)
				excelArray =split(dataExcelPath,"\")
				Counter=UBOUND(excelArray)
				datasheetName=excelArray(Counter)
				If instr(1,tempName,datasheetName) Then
					attchObj.Load True , ""
					Set objFS = CreateObject("Scripting.FileSystemObject")
					dataFolderPath = LEFT(dataExcelPath,(INSTRREV(dataExcelPath,"\",-1,1)))
					localPath = dataFolderPath & tempName 
					'Check to see if the file exist -- if it does delete it before copying new file 
					if objFS.FileExists(localPath) then 
						objFS.DeleteFile(localPath) 
					end if 
					objFS.MoveFile tempPath,localPath 
					'Check to see if a file with the same name exist in the target folder. 
					'If it does delete it before renaming 
					if objFS.FileExists(dataExcelPath)then 
						objFS.DeleteFile(dataExcelPath)
					end if 
					objFS.MoveFile localPath,dataExcelPath 
					Set objFS = Nothing
					Exit for 
				End If
			Next 
		End IF 
		Set attchList = Nothing
		Set AttachmentFactory = Nothing
	End If
	Set QCConn = Nothing
	DataSheetAutoDownload = dataExcelPath
End Function

'***********************************************************************************
 'End Function DataSheetAutoDownload(dataExcelPath)
'***********************************************************************************
 

Function processControlFlags(InputValidation)
	 If Instr(1,UCASE(InputValidation),"<RANDOM(",vbTextCompare) Then
	  				   posRandom =Instr(1,UCASE(InputValidation),"RANDOM(",vbTextCompare)
	                  				posLength = posRandom+7
	                  				charLength = MID(InputValidation,posLength,1)
					  startPosition = 10^(charLength-1)
                   					   RandomNum = RandomNumber (Cint(startPosition),10^charLength) 
	                				  temp = Len(MID(InputValidation,posRandom-2))
					  If IsEmpty(temp) Then
                   						     processControlFlags=RandomNum
					Else
	               					   processControlFlags=MID(InputValidation,1,(LEN(InputValidation)-temp)) & RandomNum	
					End If	
     elseIf CSTR(UCASE(InputValidation))="<DATE>" or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(InputValidation)),"<DATE+",vbTextCompare)=1 Then
	                Interval=MID(InputValidation,6)
						  	If Instr(Interval,"+")>0 Then
		                      	Interval=Split(Split(Interval,"+")(1),">")(0)
		                  	ElseIf Instr(Interval,"-")>0 Then
							  	Interval=Split(Interval,">")(0)
						  	Else
							  	Interval = 0					  
	                     	End If
                    reqDate = DateAdd("d",Interval,Cstr(Date))
					 varDay = DatePart("D",reqDate)
                     varMonth = DatePart("M",reqDate)
                     varYear = DatePart("YYYY",reqDate)
					 processControlFlags =  varDay & "." &  varMonth & "." &  varYear					
	Elseif CSTR(UCASE(InputValidation)) = "<BLANK>" Then
		processControlFlags = ""
	Elseif CSTR(UCASE(InputValidation)) = "<SKIP>" Then
		processControlFlags = "SKIP-STEP"
	End If
End Function

Public Function GetInputFromExcel_FromQC(InputFilePath,strSheetName,IterationIndex)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: GetInputFromExcel_FromQC" 
	Dim strVariableName ,strVariableValue
	Datatable.SetCurrentRow IterationIndex-1
	iColCount=DataTable.GetSheet(strSheetName).getparametercount
	iRowCount = DataTable.GetSheet(strSheetName).GetRowCount
	For iCnt=1 to iColCount
				strVariableName = DataTable.GetSheet(strSheetName).GetParameter(iCnt).Name
				strVariableValue = Datatable.Value(strVariableName,strSheetName)
				If CSTR(UCASE(DataItemValue))="<BLANK>" or CSTR(UCASE(DataItemValue))="<SKIP>" or Instr(1,UCASE(DataItemValue),"<RANDOM(",vbTextCompare)>0 or CSTR(UCASE(DataItemValue))="<DATE>" or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE+",vbTextCompare)=1 Then
			      		strVariableValue = processControlFlags(strVariableValue)	
				End If
				Execute strVariableName &"= strVariableValue"       '' The variable value is assigned to the vairable name
	Next 
End Function


Public Function GetInputFromExcel_ViaDatatable(InputFilePath,strSheetName,IterationIndex)
				
				If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: GetInputFromExcel_ViaDatatable" 
				Dim strVariableName ,strVariableValue
				Datatable.Import InputFilePath
				Datatable.SetCurrentRow IterationIndex-1
				iColCount=DataTable.GetSheet(strSheetName).getparametercount
				iRowCount = DataTable.GetSheet(strSheetName).GetRowCount
				For iCnt=1 to iColCount
							strVariableName = DataTable.GetSheet(strSheetName).GetParameter(iCnt).Name
							strVariableValue = Datatable.Value(strVariableName,strSheetName)
			If CSTR(UCASE(DataItemValue))="<BLANK>" or CSTR(UCASE(DataItemValue))="<SKIP>" or Instr(1,UCASE(DataItemValue),"<RANDOM(",vbTextCompare)>0 or CSTR(UCASE(DataItemValue))="<DATE>" or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE+",vbTextCompare)=1 Then
			      					strVariableValue = processControlFlags(strVariableValue)	
							End If
							Execute strVariableName &"= strVariableValue"       '' The variable value is assigned to the vairable name
				Next 
End Function



''''''''''''  ***************************************    Functions related to validation Reporting ****************************************************************************************					

Function GetTestCaseDetails(InputFilePath,sheetName,iStepNo,ByRef aManualTCDetails)

			Err.clear
			On Error Resume Next
			If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: GetTestCaseDetails" 
			Dim oConn, oRS, arrData, x
			Dim aTemp,aTemp2
			CONST adOpenStatic = 3
			CONST adLockOptimistic = 3
			CONST adCmdText = "&H0001"
	
			Set oConn = CreateObject("ADODB.Connection")
			Set objRecSet= CreateObject("ADODB.RecordSet")
	
			'Open Connection
'			oConn.Open "Provider=Microsoft.ACE.OLEDB.12.0;" &_		
'						"Data Source=" & InputFilePath & ";" & _
'						"Extended Properties=""Excel 8.0;HDR=Yes;"";"
						
						
		oConn.Open "DRIVER={Microsoft Excel Driver (*.xls)};DBQ="&InputFilePath & ";Readonly=True"
	
			sQuery = "Select [StepDescription],[Expected] From [" & sheetName & "$] Where [StepName]=" & iStepNo &""

			If err.number<>0 Then
				If instr(err.description,"is not a valid path")>0  or instr(err.description,"Invalid argument")>0  Then
							Call GetTestCaseDetails_FromQC(InputFilePath,sheetName,iStepNo,aManualTCDetails)
				End If
				err.clear
				Exit Function
			End If
	
			objRecSet.Open sQuery, oConn, 3, 3, 1
			aManualTCDetails(0) = trim(cstr(objRecSet(0).Value))
			aManualTCDetails(1)= trim(cstr(objRecSet(1).Value))

			If instr(aManualTCDetails(0),"<") > 0   Then
							temp = replace(aManualTCDetails(0),"<","<'")
							aManualTCDetails(0) = temp
				end if 
				If  instr(aManualTCDetails(0),">") > 0   Then
							temp = replace (aManualTCDetails(0),">","'>")
							aManualTCDetails(0) = temp
				End If


				If instr(aManualTCDetails(1),"<") > 0   Then
							temp = replace(aManualTCDetails(0),"<","<'")
							aManualTCDetails(1) = temp
				end if 
				If  instr(aManualTCDetails(1),">") > 0   Then
							temp = replace (aManualTCDetails(0),">","'>")
							aManualTCDetails(1) = temp
				End If

				aTemp = split(aManualTCDetails(0),chr(10))
				If Ubound(aTemp) > 0  Then
						aManualTCDetails(0)= ""
						For i=0 to Ubound(aTemp)
								aManualTCDetails(0) = aManualTCDetails(0) &"<br>"& aTemp(i)
						Next
				End If
				aTemp2 = split(aManualTCDetails(1),chr(10))
				If Ubound(aTemp2) > 0  Then
						aManualTCDetails(1)= ""
						For i=0 to Ubound(aTemp2)
								aManualTCDetails(1) = aManualTCDetails(1) &"<br>"& aTemp2(i)
						Next
				End If

		'objRecSet.MoveNext
		err.clear
		objRecSet.Close 
		set oConn = Nothing
		set objRecSet = Nothing
		
End Function



Public Function GetTestCaseDetails_FromQC(InputFilePath,strSheetName,iStepNo,ByRef aManualTCDetails)
				Dim strVariableName ,strVariableValue
				'Datatable.SetCurrentRow iStepNo-1
				'iColCount=DataTable.GetSheet(strSheetName).getparametercount
				iRowCount = DataTable.GetSheet(strSheetName).GetRowCount
				For iCnt = 1 to iRowCount
					Datatable.SetCurrentRow iCnt
					If  Datatable.Value(1,strSheetName) = iStepNo Then
						Exit For
					End If
				Next
				
				aManualTCDetails(0) = Cstr(Datatable.Value(2,strSheetName))
				aManualTCDetails(1) = Cstr(Datatable.Value(3,strSheetName))

				If instr(aManualTCDetails(0),"<") > 0   Then
							temp = replace(aManualTCDetails(0),"<","<'")
							aManualTCDetails(0) = temp
				end if 
				If  instr(aManualTCDetails(0),">") > 0   Then
							temp = replace (aManualTCDetails(0),">","'>")
							aManualTCDetails(0) = temp
				End If


				If instr(aManualTCDetails(1),"<") > 0   Then
							temp = replace(aManualTCDetails(0),"<","<'")
							aManualTCDetails(1) = temp
				end if 
				If  instr(aManualTCDetails(1),">") > 0   Then
							temp = replace (aManualTCDetails(0),">","'>")
							aManualTCDetails(1) = temp
				End If
				
End Function


'''''''''''  *************************************** ****************************************************************************************

'				UpdateResultHtml ("1.1","", strActual, "PASS","")
Public Function UpdateResultHtml(iStepNumber,inputParameter,strActual,status,outputParameter)
	Dim aManualTCDetails(2),iStep,iFileAttachStep
	If  blnDefault_eSwiftReporting Then
		stepName = iStepNumber
		iStepNumber = giHTMLRowNumber
	else
		outputParameter=""
		Call GetTestCaseDetails(InputFilePath,strTestCaseName,iStepNumber,aManualTCDetails) ' Function to capture all manual step details from Input excel
		strDescription = aManualTCDetails(0)
		strExpected= aManualTCDetails(1)
	End If
	Call CreateTagWithAttributeInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Step",iStepNumber,"Detailed-Report")
	If blnDefault_eSwiftReporting Then
		Call CreateTagInSummaryXML("Step",iStepNumber,"Description",stepName,"Detailed-Report")
		Call CreateTagInSummaryXML("Step",iStepNumber,"InputData",inputParameter,"Detailed-Report")
	else
		Call CreateTagInSummaryXML("Step",iStepNumber,"Description",strDescription,"Detailed-Report")
		Call CreateTagInSummaryXML("Step",iStepNumber,"InputData",strExpected,"Detailed-Report")
	End If
	Call CreateTagInSummaryXML("Step",iStepNumber,"Message",strActual,"Detailed-Report")
	Call CreateTagInSummaryXML("Step",iStepNumber,"Status",status,"Detailed-Report")
	On Error Resume Next
	Set htmlFile = objFso.OpenTextFile(gstrIterationResultFolder &"\" & gstrDetailedHTMLFileName, 8)
	err.clear
	If Ucase(status) = "PASS" or Ucase(status) = "DONE" Then
		If (giHTMLRowNumber mod 2)= 0 then
			htmlFile.writeline("<tr>")
		else
			htmlFile.writeline("<tr class='alter'>")
		End if 
		giHTMLRowNumber = giHTMLRowNumber + 1
		htmlFile.writeline("<td> " & iStepNumber & " </td> ")
		
		If blnDefault_eSwiftReporting Then
			htmlFile.Write("<td>" & stepName & " </td>")
			htmlFile.Write("<td>" & inputParameter & "</td>")
		else
			htmlFile.writeline("<td> " & strDescription & " </td> ")
			htmlFile.writeline("<td> " & strExpected & " </td> ")
		End If
		htmlFile.writeline("<td> " & strActual & " </td> ")
		
		If Ucase(status) = "PASS" Then
			htmlFile.writeline("<td><p class='pass'>" & status & "</p></td>")
		ElseIf Ucase(status) = "DONE" Then   	
			htmlFile.writeline("<td><p>" & status & "</p></td>")
		End If
		
		errorCount=errorCount+1
		iStep = 1  ' Counter for publishing substep # against the image hyperlinks in HTML
		htmlFile.writeline("<td><p class='pass'>" & outputParameter &"</p><br/>")
		For iCnt= iCurrentImageCounterForHTML to iImageCounterForHTML
			If Not isEmpty(aImagePathArray(iCnt)) Then
				htmlFile.writeline("<a href=' "& aImagePathArray(iCnt) & "' target="& Q("_blank")& ">ScreenShot:"& (iCnt+1) &"<br/>")
				If imageRefPaths = "" Then
					imageRefPaths = "##IMAGE::" & aImagePathArray(iCnt)
				Else
					imageRefPaths = imageRefPaths & ",##IMAGE::" & aImagePathArray(iCnt)
				End if
				iStep = iStep +1
			End If
		Next
		iCurrentImageCounterForHTML = iImageCounterForHTML
		iFileAttachStep = 1
		For iCnt= giCurrentFileAttachmentCounterForHTML to giFileAttachmentCounterForHTML
			If Not isEmpty(aFileAttachmentPathArray(iCnt)) Then
				htmlFile.writeline("<a href=' "& aFileAttachmentPathArray(iCnt) & "' target="& Q("_blank")& ">OutPut Report:"& iFileAttachStep &"<br/>")
				If imageRefPaths = "" Then
					imageRefPaths = "##FILE::" & aFileAttachmentPathArray(iCnt)
				Else
					imageRefPaths = imageRefPaths & ",##FILE::" & aFileAttachmentPathArray(iCnt)
				End if
				iFileAttachStep =iFileAttachStep +1
			End If
		Next
		giCurrentFileAttachmentCounterForHTML = giFileAttachmentCounterForHTML
		Call CreateTagInSummaryXML("Step",iStepNumber,"Output",imageRefPaths,"Detailed-Report")
		htmlFile.writeline("</td>")
		
		endTime = Timer()
		htmlFile.writeline("<td>"& FormatNumber(endTime - giLastUpdatedTime ,1) &" Second(s)</td>")
		Call CreateTagInSummaryXML("Step",iStepNumber,"ExecutionTime",FormatNumber(endTime - giLastUpdatedTime ,1),"Detailed-Report")
		htmlFile.writeline("</tr>")
	ElseIf Ucase(status) = "FAIL" or Ucase(status) = "WARNING" Then
		If (giHTMLRowNumber mod 2)= 0 then
			htmlFile.writeline("<tr class='fail'>")
		else
			htmlFile.writeline("<tr class='alter fail'>")
		End if 
		giHTMLRowNumber = giHTMLRowNumber + 1
		htmlFile.writeline("<td> " & iStepNumber & " </td> ")
		
		If blnDefault_eSwiftReporting Then
			htmlFile.Write("<td>" & stepName & " </td>")
			htmlFile.Write("<td>" & inputParameter & "</td>")
		else
			htmlFile.writeline("<td> " & strDescription & " </td> ")
			htmlFile.writeline("<td> " & strExpected & " </td> ")
		End If
		
		If  status = "FAIL" Then
			If Environment.Value("strFatalMessage")<>"" Then
				strActual= " <br> -----------  Error found at this step ------------ <br>"  & strActual  & Environment.Value("strFatalMessage")
				Environment.Value("strFatalMessage")= ""
			End If
			giFailedStepNumber =iStepNumber
		End If
		htmlFile.writeline("<td> " & strActual & " </td> ")
		If Ucase(status) = "FAIL" Then
			htmlFile.writeline("<td><p class='fail'>" & status & "</p></td>")
		ElseIf Ucase(status) = "WARNING" Then
			htmlFile.writeline("<td><p class='warning'>" & status  & "<b> !!!</b></p></td>")
		End If
		errorCount=errorCount+1
		iStep =1
		blnMainFailFlag = True
		Reporter.ReportEvent micFail,"Step# : " & iStepNumber,strActual
		htmlFile.writeline("<td>")
		if outputParameter <> "" Then
			htmlFile.writeline("<p class='fail'>" & outputParameter &"</p><br/>")	
		End if 
		For iCnt= iCurrentImageCounterForHTML to iImageCounterForHTML
			If Not isEmpty(aImagePathArray(iCnt)) Then
				htmlFile.writeline("<a href=' "& aImagePathArray(iCnt) & "' target="& Q("_blank") &">ScreenShot:"& (iCnt+1) &"<br/>")
				imageRefPaths = imageRefPaths & "," & aImagePathArray(iCnt)
				iStep = iStep +1
			End If
		Next
		iCurrentImageCounterForHTML = iImageCounterForHTML
		iFileAttachStep = 1
		For iCnt= giCurrentFileAttachmentCounterForHTML to giFileAttachmentCounterForHTML
			If Not isEmpty(aFileAttachmentPathArray(iCnt)) Then
				htmlFile.writeline("<a href=' "& aFileAttachmentPathArray(iCnt) & "' target="& Q("_blank")& ">OutPut Report:"& iFileAttachStep &"<br/>")
				imageRefPaths = imageRefPaths & "," & aImagePathArray(iCnt)
				iFileAttachStep = iFileAttachStep +1
			End If
		Next
		giCurrentFileAttachmentCounterForHTML = giFileAttachmentCounterForHTML
		htmlFile.writeline("</td>")
		Call CreateTagInSummaryXML("Step",iStepNumber,"Output",imageRefPaths,"Detailed-Report")
		If setDefectFlag Then
			Dim DefectSummary,DefectDescription,AttachmentPath
			DefectSummary=Output 
			DefectDescription=Output 
			AttachmentPath=ImagePath
			Call AutomaticDefectLog(DefectMandatoryFieldList,DefectSummary,DefectSeverity,DefectAssignedTo,DefectDetectedBy,DefectPriority,DefectStatus,DefectProjectName,DefectDescription,AttachmentPath)
		End If
		ImagePath = ""
		
		endTime = Timer()
		htmlFile.writeline("<td>"& FormatNumber(endTime - giLastUpdatedTime ,1) &" Second(s)</td>")
		Call CreateTagInSummaryXML("Step",iStepNumber,"ExecutionTime",FormatNumber(endTime - giLastUpdatedTime ,1),"Detailed-Report")
		htmlFile.writeline("</tr>")		
	End If
   	htmlFile.Close
   	giLastUpdatedTime = endTime 
   	blnCaptureFlag=False
   	Environment.Value("strFatalMessage")= ""
End Function
	


Public Function GetInputFromExcel(InputFilePath,sheetName,IterationIndex)
		err.clear
		If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: GetInputFromExcel" End If
		On error resume next

		Dim oConn, oRS, arrData, x,iStart
		CONST adOpenStatic = 3
		CONST adLockOptimistic = 3
		CONST adCmdText = "&H0001"

		Set oConn = CreateObject("ADODB.Connection")
		Set objRecSet= CreateObject("ADODB.RecordSet")

		'Open Connection
'		oConn.Open "Provider=Microsoft.ACE.OLEDB.12.0;" &_		
'				    "Data Source=" & InputFilePath & ";" & _
'					"Extended Properties=""Excel 8.0;HDR=Yes;"";"
		oConn.Open "DRIVER={Microsoft Excel Driver (*.xls)};DBQ="&InputFilePath & ";Readonly=True"
		
		sQuery = "Select * From [" & sheetName & "$]"

		If err.number<>0 Then
			If instr(err.description,"is not a valid path")>0  or instr(err.description,"Invalid argument")>0  Then
				Call GetInputFromExcel_FromQC(InputFilePath,sheetName,IterationIndex)
			End If
			err.clear
			Exit Function
		End If
		'Run query against WorkBook
		objRecSet.Open sQuery, oConn, 3, 3, 1
		If err.number<>0 Then
			If insrt(err.description,"Too many") > 0  Then
				Call GetInputFromExcel_ViaDatatable(InputFilePath,strSheetName,IterationIndex)
				Exit Function
			End If
		End if 
		'Move RecordSet to the target Row
		For x = 2 to IterationIndex - 1
			objRecSet.MoveNext
		 Next
		'Use a For..Loop to iterate through Recordset

		If Ucase(sheetName) = "COMMON" Or Ucase(sheetName) = "OUTPUT" or Ucase(sheetName)= "DEFECT"  Then
				iStart = 0
		ElseIf blnDefault_eSwiftReporting Then
				iStart = 0
		Else
				iStart = 3
		End If
		For x = iStart to objRecSet.Fields.Count - 1
			DataItemName = trim(objRecSet(x).Name)
			DataItemValue=trim(objRecSet(x).Value)
			If CSTR(UCASE(DataItemValue))="<BLANK>" or CSTR(UCASE(DataItemValue))="<SKIP>" or Instr(1,UCASE(DataItemValue),"<RANDOM(",vbTextCompare)>0 or CSTR(UCASE(DataItemValue))="<DATE>" or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE-",vbTextCompare)=1 or  Instr(1,CSTR(UCASE(DataItemValue)),"<DATE+",vbTextCompare)=1 Then
			      DataItemValue = processControlFlags(DataItemValue)	
			End If
			Execute DataItemName & " = DataItemValue"       '' The variable value is assigned to the vairable name
		Next
		set oConn = Nothing
		set objRecSet = Nothing
		gstrWriteDataToExcelRowNo = IterationIndex
End Function


''*******************************************************************************************************************************************
'Name of the Function : FormatReportMessage
'Author		    : Prashant Sharma
'Date			    : 18/09/2013
'Description	    : Function to Consolidate returned message from TASE Functions for result reporting
'Input Parameters	    : Array containing the messages
'Output Parameters    : Consolidated message from functions
'*******************************************************************************************************************************************

Function FormatReportMessage(aMessageArray,ByRef strReturnMessage)
			strReturnMessage =""
			iEmptyCounter = 0
			strStatus = "PASS"
			
			If Ubound(aMessageArray)>0  Then
						Call RemoveEmptyValuesInArray(aMessageArray)
						For iX=0 To Ubound(aMessageArray)
										If  Not IsEmpty(aMessageArray(iX)) Then
															If  (NOT  IsBoolean(aMessageArray(iX))) Then
																			strReturnMessage = strReturnMessage &" [" &aMessageArray(iX)  &" ]"
																			strStatus="FAIL"
																			'blnSkipSteps= True
																			'Exit For
															elseif  IsBooleanFalse( aMessageArray(iX)) Then 
																		    strStatus="FAIL"

															End If
										else
												iEmptyCounter = iEmptyCounter+1 
										End If
						Next
			Else
						strReturnMessage= "Possible exception found during Step Execution"	
						
			End If


			If iEmptyCounter= Ubound(aMessageArray)+ 1 Then
					strReturnMessage= "TASE Functions Skipped Due to Error " & Environment.Value("strFatalMessage")
					strStatus="FAIL"
			End If

			If strStatus="FAIL" Then
						FormatReportMessage = "FAIL"
						'ImagePath=CaptureScreenshot("","")		
						If gblnContinueExecutionIFFailed =True  and Environment.Value("blnFatalError")= False Then  '  Make variable gblnContinueExecutionIFFailed = True  in your script if error should be ignored and exection is not to ne stopped
    								gblnContinueExecutionIFFailed = False
						else
									Environment.Value("blnFatalError")= True		
						End If
			Else
						FormatReportMessage = "PASS" 
			End If
		
End Function

'*******************************************************************************************************************************************
'Name of the Function : IsBoolean
'Author		    : Prashant Sharma
'Date			    : 18/09/2013
'Description	    : Function to Verify if a data is of type boolean
'Input Parameters	    : strData := Data to be checked
'Output Parameters    : True/False
'*******************************************************************************************************************************************
Function IsBoolean(strData)
			 	If isEmpty(strData) Then
						IsBoolean = False
						Exit Function
				Else

							If vartype(strData) = 11 Then  'or  Asc(strData) = 70 
									IsBoolean = True
							else
								   IsBoolean= False
							End If
				End If
End Function

'*******************************************************************************************************************************************
'Name of the Function : IsBooleanFalse
'Author		    : TCS
'Date			    : 18/09/2013
'Description	    : Function to Verify if a data is of type boolean FALSE
'Input Parameters	    : strData := Data to be checked
'Output Parameters    : True/False
'*******************************************************************************************************************************************
Function IsBooleanFalse(strData)
			 	If isEmpty(strData) Then
						IsBoolean = False
						Exit Function
				Else

							If  Asc(strData) = 70 Then
									IsBooleanFalse = True
							else
								    IsBooleanFalse= False
							End If
				End If
End Function

