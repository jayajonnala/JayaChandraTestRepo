''*******************************************************************************************************************************************
'Name of the Function : Html_iteration  
'Author		    : Prashant Sharma
'Date			    : 18/09/2013
'Description	    : Function to add testcase execution details for each iteration.This is mainly the header for the report 
'Input Parameters	    : TestCaseName
'Output Parameters    : None
'*******************************************************************************************************************************************
'MODIFIED BY  ->  Sai Satvik
'MODIFIED DATE -> 18/11/2015

Public Function Html_iteration(testCaseName)
If Not Environment.Value("blnFatalError") Then
    On error resume next
    Set objXml = CreateObject("Microsoft.XMLDOM")
    objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objCurrentIteration = objXml.SelectSingleNode("//Iteration[@id='" & giCurrentIteration & "']")
	Set objTotalTests = objCurrentIteration.SelectSingleNode("TotalTestCases")
	If gstrTestCaseName <> "" Then testCaseName = gstrTestCaseName End If
	Set htmlFile = objFso.OpenTextFile(gstrIterationResultFolder &"\" & gstrDetailedHTMLFileName, 8)
    htmlFile.WriteLine("<div class='report-content-summary'>")
    htmlFile.WriteLine("<h3 id='" & objTotalTests.Text + 1 & "' name='" & objTotalTests.Text + 1 & "' class='action-collepse'>Test Case " & objTotalTests.Text + 1 & " - " & testCaseName & "</h3>")
    htmlFile.WriteLine("<div class='iteration-details action-expand'>")
    htmlFile.WriteLine("<table class='detail-report'>")
    htmlFile.WriteLine("")
    htmlFile.WriteLine("<thead>")
    htmlFile.WriteLine("<tr>")
    If blnDefault_eSwiftReporting Then
		htmlFile.WriteLine("<th class='step-number'>Step Number</th>")
        htmlFile.WriteLine("<th class='step-desc'>Step Description</th>")
        htmlFile.WriteLine("<th class='input-data'>Input Data</th>")
        htmlFile.WriteLine("<th class='message-error'>Message/Error</th>")
        htmlFile.WriteLine("<th class='status'>Status</th>")
        htmlFile.WriteLine("<th class='output'>Output</th>")
        htmlFile.WriteLine("<th class='execution-time'>Execution Time</th>")	 
    else
        htmlFile.WriteLine("<th class='step-number'>Step Number</th>")
        htmlFile.WriteLine("<th class='step-desc'>Description</th>")
        htmlFile.WriteLine("<th class='input-data'>Expected</th>")
        htmlFile.WriteLine("<th class='message-error'>Actual</th>")
        htmlFile.WriteLine("<th class='status'>Status</th>")
        htmlFile.WriteLine("<th class='output'>Objective Evidence</th>")
        htmlFile.WriteLine("<th class='execution-time'>Execution Time</th>")	
    End if
    htmlFile.WriteLine("</tr>")
    htmlFile.WriteLine("</thead>")
    htmlFile.WriteLine("<tbody>")
    htmlFile.Close
    Set objTotalTests = Nothing
    Set objCurrentIteration = Nothing
    Set objXml = Nothing
End If
End Function

''*******************************************************************************************************************************************
'Name of the Function : FormatTimeDuration
'Author		    : Prashant Sharma
'Date			    : 07/08/2014
'Description	    : Function to format the execution duration into user friendly format
'Input Parameters	    : Time duration
'Output Parameters    : user friendly format
'*******************************************************************************************************************************************

Function FormatTimeDuration(iTotalTime)
	If  iTotalTime > 60 Then
		giMinuteValue = split(iTotalTime/60,".")(0)
		giSeconds = iTotalTime mod 60
	else
		giSeconds = iTotalTime
		giMinuteValue = 0
	End If
	If  giMinuteValue < 60  Then
		giHourValue = 0 
	else
		giHourValue = split(giMinuteValue/60,".")(0)
		giMinuteValue = giMinuteValue mod 60
	End If
	If giHourValue > 0 Then
		FormatTimeDuration =  giHourValue & " Hour(s) " & giMinuteValue &" Minute(s) " & giSeconds & " Seconds " 
	ElseIf giMinuteValue > 0 Then
		FormatTimeDuration =  giMinuteValue & " Minute(s) " & giSeconds & " Seconds " 	
	Else
		FormatTimeDuration =  giSeconds & " Seconds " 	
	End If

End Function

''*******************************************************************************************************************************************
'Name of the Function : FinalStatus
'Author		    : Prashant Sharma
'Date			    : 18/09/2013
'MODIFIED BY -> Vinay
'MODIFIED DATE -> 20/10/2015
'Description	    : Function to report final Pass or Fail status in the report
'Input Parameters	    : TestCaseName
'Output Parameters    : None
'*******************************************************************************************************************************************

Public Function FinalStatus()
'If Not Environment.Value("blnFatalError") Then
    If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Running : Finishing Report Creation"  End if 
'	If oDicSteps.Count >=1 Then 
'		Call CaptureScreenshot("<SKIPSTEP>","",True,False,False) '  Inorder to accommodate steps if any exist after final navigator function
'	End If
	If blnCreatePDFTrainingDoc and blnCreateTrainingDoc and Not gblnScenarioMode and Not blnMainFailFlag Then    'Saving in PDF format
		Call CreatePDFTrainingDoc(gstrScreenShotDocument)	
	End If
	Reporter.Filter = rfEnableAll
	On error Resume Next
	Dim message,status,strTimeMessage
	Set htmlFile = objFso.OpenTextFile(gstrIterationResultFolder &"\" & gstrDetailedHTMLFileName,8) 

	giTestCaseEndTime = Timer()
    giTotalTime= FormatNumber(giTestCaseEndTime - giTestCaseStartTime,0) 
	strTimeMessage= FormatTimeDuration(giTotalTime)
	'------------------------------ starting of addition of footer of status ----------------------
	htmlFile.writeline("</tbody>")
    htmlFile.writeline("<tfoot>")
	' Update Totaltestcase tag by 1 in iteration tag with id = count of iteration tag
	Set objXml = CreateObject("Microsoft.XMLDOM")
	objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objSummaryReport = objXml.SelectSingleNode("//Summary-Report")
	Set objCurrentIteration = objSummaryReport.SelectSingleNode("Iteration[@id='" & giCurrentIteration & "']")
	Set objTotalTests = objCurrentIteration.SelectSingleNode("TotalTestCases")
	objTotalTests.Text = objTotalTests.Text + 1
	Set objCurrentTest = objCurrentIteration.SelectSingleNode("TestCase[@id='" & gstrTestCaseName & "_" & giTestCaseNumber & "']")
	Set objStatus = objCurrentTest.SelectSingleNode("Status")
	Set objExeTime = objCurrentTest.SelectSingleNode("ExecutionTime")
	objExeTime.Text = strTimeMessage
	If blnMainFailFlag Then
		' update status of TESTCASE Tag with id = gstrTestcaseName to fail
		objStatus.Text = "Fail"
		status = "Fail"
		' Update Failtestcase tag by 1 in iteration tag with id = count of iteration tag
		Set objFailTests = objCurrentIteration.SelectSingleNode("FailTestCases")
		objFailTests.Text = objFailTests.Text + 1
		message="Test :  [ "& gstrTestCaseName &"  ] Completed"
		Reporter.ReportEvent micFail, message, "Failed"
		'---------------- Adding failed test case status -------------------------------
		htmlFile.writeline("<tr id='" & giTestCaseNumber & "End' class='fail'>")
		htmlFile.writeline("<td colspan='3' class='align-center'>" & message & "</td>")
		htmlFile.writeline("<td  colspan='1' class='align-center'>FAIL</td>")
		htmlFile.writeline("<td  colspan='3' class='align-center'>" & " Duration =  [ "  &    strTimeMessage   & "   ]  " & "  <br> Execution completed at [  " &  Time &   " ] </td>")
		'---------------- completed Adding failed test case status -------------------------------
	else
		' update status of TESTCASE Tag with id = gstrTestcaseName to Pass
		objStatus.Text = "Pass"
		status = "Pass"
		' Update Passtestcase tag by 1 in iteration tag with id = count of iteration tag
		Set objPassTests = objCurrentIteration.SelectSingleNode("PassTestCases")
		objPassTests.Text = objPassTests.Text + 1
		message="Test :  [ "& gstrTestCaseName & "] Completed."
		Reporter.ReportEvent micPass, message, "Passed"
        '---------------- Adding passed test case status -------------------------------
        htmlFile.writeline("<tr id='" & giTestCaseNumber & "End'>")
        htmlFile.writeline("<td colspan='3' class='align-center pass'>" & message & "</td>")
		htmlFile.writeline("<td  colspan='1' class='align-center pass'>PASS</td>")
		htmlFile.writeline("<td  colspan='3' class='align-center pass'>" & " Duration =  [ "  &    strTimeMessage   & "   ]  " & "  <br> Execution completed at [  " &  Time &   " ] </td>")
        '---------------- completed Adding passed test case status -------------------------------		
	End If
	If Not gblnScenarioMode Then
		Set objItrExeStatus = objCurrentIteration.selectSingleNode("ExecutionStatus")
		Set objItrExeTime = objCurrentIteration.selectSingleNode("ExecutionTime")
		objItrExeStatus.Text = objStatus.Text
		objItrExeTime.Text = giTotalTime
	End If
	objXml.Save(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objSummaryReport= Nothing
	Set objCurrentIteration = Nothing
	Set objCurrentTest = Nothing
	Set objStatus = Nothing
	Set objExeTime = Nothing
	Set objTotalTests = Nothing
	Set objPassTests = Nothing
	Set objFailTests = Nothing
	Set objXml = Nothing
	Call CreateTagInSummaryXML("TestCase",gstrTestCaseName & "_" & giTestCaseNumber,"Final-Step","","Detailed-Report")
	Call CreateTagInSummaryXML("Final-Step","","FinalMessage",message,"Detailed-Report")
	Call CreateTagInSummaryXML("Final-Step","","Duration",strTimeMessage,"Detailed-Report")
	Call CreateTagInSummaryXML("Final-Step","","Status",status,"Detailed-Report")	
	
	Environment.Value("TCExecutionStatus") = status ' Added this line code for storing the status of the TC during runtime(Changed on 30/07/2024)
	' -------------------  Ending tags inclusion -----------------
	htmlFile.writeline("</tr>")
	htmlFile.writeline("</tfoot>")
	htmlFile.writeline("</table>")
	htmlFile.writeline("</div>")
	htmlFile.writeline("</div>")
	htmlFile.Close
	Set htmlFile = Nothing
	'-----------------------------------------------------------------
	Call DeleteBlankLogFile()
	Call CreateDummyFileInScreenshotFolder()

	' Check here if gblnScenariomode is activated or not and accordingly call createsummaryreport
	'*************before updating***********
	'If gblnCreateExecutionSummaryReport and Not gblnScenarioMode Then
	'	Call CreateSummaryReport()
	''Delete the Summary Details XML 'double comment indicates already commented in before updating
        ''objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	'End If	
		'*************after updating***********	
	If Not gblnScenarioMode Then
		objFso.CopyFile gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName,gstrIterationResultFolder,True 
		If gblnCreateDetailedAndSummaryReportDoc or gblnCreatePDFDetailedAndSummaryReportDoc Then
					Call createDetailedReportDoc(gstrIterationResultFolder & "\" & gstrSummaryDetailsXMLName,gblnCreatePDFDetailedAndSummaryReportDoc)
		End If
		If gblnCreateExecutionSummaryReport Then
			If gblnCreateDetailedAndSummaryReportDoc or gblnCreatePDFDetailedAndSummaryReportDoc Then
					Call createSummaryReportDoc(gstrIterationResultFolder & "\" & gstrSummaryDetailsXMLName,gblnCreatePDFDetailedAndSummaryReportDoc,gstrSummaryGraphType)
					Call CreateSummaryReport()		
			End If
			Call CreateSummaryReport()
		End If
		objFso.DeleteFile(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	End If	

	If setUploadZippedResultFile and Not gblnScenarioMode Then
		Call ResultZipFile_Upload(gstrIterationResultFolder)
	End If
	gstrTestCaseName = ""
	blnMainFailFlag=False
	  Set objShell = CreateObject("WScript.Shell")
'	 objShell.Environment("USER").Item("blnFatalError") = Environment.Value("blnFatalError")
		Set objShell = Nothing
'End If
End Function

''*******************************************************************************************************************************************
'Name of the Function : CreatePDFTrainingDoc
'Author		    : Sai Satvik
'Date			    : 21/10/2015
'Description	    : Function to create PDF document from word document
'Input Parameters	    : word document path, flag whether to delete the word document after creating PDF document
'Output Parameters    : None
'*******************************************************************************************************************************************

Function CreatePDFTrainingDoc(documentPath)
	Dim strDocumentName, strDocumentPath
	strDocumentPath = objFso.GetParentFolderName(documentPath)
	strDocumentName = split(objFso.GetFileName(documentPath),".doc")(0)
	Set oWord = CreateObject("Word.Application")
	Set objDoc = oWord.Documents.open(documentPath) 
	oWord.ActiveDocument.SaveAs strDocumentPath & "\" & strDocumentName & ".pdf", wdFormatPDF
	objDoc.Close
	oWord.quit
	Set oWord = Nothing
	Set objDoc = Nothing
	If Not(blnCreateWordTrainingDoc) Then 		'need to add another condition if scenario training doc creation is an optional one
		objFso.deletefile documentPath		
	End If	
End Function


''*******************************************************************************************************************************************
'Name of the Function : CreateScenarioTrainingDocument
'Author		    : Vinay
'Date			    : 20/10/2015
'Description	    : Function to create Scenario training document
'Input Parameters	    : None
'Output Parameters    : None
'*******************************************************************************************************************************************


Function CreateScenarioTrainingDocument(totalNoofTestCases)
    Dim iterationFolder,scenarioDoc, strScenarioFolder,scenarioDocPath,objWord
    strScenarioFolder = objFso.GetParentFolderName(gstrIterationResultFolder)
	Set iterationFolder = objFso.GetFolder(gstrIterationResultFolder)
    If Not blnMainFailFlag Then
		err.Clear
		strScenarioFolder = strScenarioFolder & "\Scenario Training Documents" 
		If Not objFso.FolderExists(strScenarioFolder) Then
			objFso.CreateFolder strScenarioFolder 			'Created seperate folder to store the Iteration wise training docs	
		End If
		Set objWord = CreateObject("Word.Application")
		Set scenarioDoc = objWord.Documents.Add
		If ScenarioName <> "" Then
			scenarioDocPath = strScenarioFolder & "\Iteration-" & giCurrentIteration & "_" & ScenarioName & "_Scenario Document.doc"
		Else
			scenarioDocPath = strScenarioFolder & "\Iteration-" & giCurrentIteration & "_Scenario Document.doc"
		End If
		scenarioDoc.SaveAs scenarioDocPath
		scenarioDoc.Close
		objWord.quit
		Set scenarioDoc = Nothing
		Set objWord = Nothing
		Set objRecSet = CreateObject("ADOR.Recordset")
		Call OrderingTrainingDocuments(iterationFolder,objRecSet,totalNoofTestCases)
		Do Until objRecSet.EOF
    		Call ProcessFile(scenarioDocPath,objRecSet("name").Value, False) ' if empty page is needed in between test case docs make flag "true"	
	    	objRecSet.MoveNext
		Loop
		If blnCreatePDFTrainingDoc Then    'Saving in PDF format
			Call CreatePDFTrainingDoc(scenarioDocPath)	
		End If
	End If
    For each objDocument in iterationFolder.Files
		If ucase(right(objDocument.path,4)) = ".DOC" Then
        	objFso.DeleteFile objDocument.path 			'deleting the test case training documents available in Iteration folder
		End If		
	Next
	Set objRecSet = Nothing
	Set iterationFolder = Nothing
End Function

''*******************************************************************************************************************************************
'Name of the Function : OrderingTrainingDocuments
'Author		    : Sai Satvik
'Date			    : 03/11/2015
'Description	    : Function to order doc files in a folder by test case numbers
'Input Parameters	    : Folder object which has all files
'Output Parameters    : None
'*******************************************************************************************************************************************

Function OrderingTrainingDocuments(objFileCollection,ByRef objList,iTotalTestCases)
	objList.Fields.Append "name", 200, 255
    'objList.Fields.Append "CreationTime", 7
    objList.Open
    For Iterator = 1 To iTotalTestCases
    	For Each objFile In objFileCollection.Files
    		aTemp = split(objFile.Name,"_")
      		If ucase(aTemp(Ubound(aTemp))) = Iterator & ".DOC" Then		'removing other documents from the recordset
			  objList.AddNew
		      objList("name").Value = objFile.Path
		      'objList("CreationTime").Value = objFile.DateCreated 
		      objList.Update
		      Exit for
	    	End If
		Next
    Next
    objList.MoveFirst
    'objList.Sort = "CreationTime ASC"
End Function

''*******************************************************************************************************************************************
'Name of the Function : ProcessFile
'Author		    : Vinay
'Date			    : 20/10/2015
'Description	    : Function to load testcase doc content to scenarioDoc 
'Input Parameters	    : testcase document path, scenario document path, flag whether to insert page break or not after loading the content
'Output Parameters    : None
'*******************************************************************************************************************************************

Function ProcessFile(scenarioDocPath,testCaseDocPath,insertBreak)
	Dim scenarioDoc, objWordApp, testCaseDoc
	Set objWordApp = CreateObject("Word.Application")
	Set scenarioDoc = objWordApp.Documents.Open(scenarioDocPath)
	Set testCaseDoc = objWordApp.Documents.Open(testCaseDocPath)
	testCaseDoc.Activate
	objWordApp.Selection.WholeStory
	objWordApp.Selection.Copy
	scenarioDoc.Activate
	if insertBreak then objWordApp.Selection.InsertBreak wdPageBreak
	objWordApp.Selection.EndKey wdStory 'Move to end of document
	objWordApp.Selection.PasteAndFormat wdPasteDefault 'Pastes in the content
	scenarioDoc.Save
	scenarioDoc.Close
	testCaseDoc.Close
	objWordApp.Quit
	Set testCaseDoc = Nothing
	Set scenarioDoc = Nothing
	Set objWordApp = Nothing
End Function 


''*******************************************************************************************************************************************
'Name of the Function : CreateTrainingDoc
'Author		    : 
'Date			  :
'Description	    : This will MS word document  with screnshots images in it
'Input Parameters	    : test case name
'Output Parameters    : None
'*******************************************************************************************************************************************

Public Function CreateTrainingDoc(strTestCaseName)
If Not Environment.Value("blnFatalError") Then
	On error resume next
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Creating Test case training doc" End If
	Dim strTrainingDocFileName 
	Set oWord = CreateObject("Word.Application")
	oWord.DisplayAlerts = False
	oWord.Visible = False 
	Set oDoc = oWord.Documents.Add
	Const wdHeaderFooterPrimary=1
	Const wdSeekMainDocument = 0
	Const wdSeekCurrentPageHeader = 9
	Const wdSeekCurrentPageFooter = 10
	Const wdPrintView = 3

	'Move the page to print view as headers and footers can only be added in print view
	oDoc.ActiveWindow.ActivePane.View.Type = wdPrintView

	'Select the header view and add the header
	oDoc.ActiveWindow.ActivePane.View.SeekView = wdSeekCurrentPageHeader
	oDoc.Sections(1).Headers(wdHeaderFooterPrimary).Range.Select

	Set oSelection= oWord.Selection
	With oSelection
		.Font.Size ="9"
		.Font.Bold = False
		'.Font="Calibri"
		.ParagraphFormat.Alignment=0
		.TypeText "TASE Automation Framework"
		.TypeText vbCrLF
		.Font.Size ="9"
		.Font.Bold = True
		.ParagraphFormat.Alignment=2
	End With
	If gblnScenarioMode Then
		oSelection.TypeText "Scenario Manual"
	Else
		oSelection.TypeText "Test Case Manual"
	End If
	oSelection.InlineShapes.AddHorizontalLineStandard
	'ActiveDocument.InlineShapes(1).HorizontalLineFormat.PercentWidth = 50					
	'Select the footer view and add the footer
	oDoc.ActiveWindow.ActivePane.View.SeekView = wdSeekCurrentPageFooter
	oDoc.Sections(1).Footers(wdHeaderFooterPrimary).Range.Select 
	With oSelection
	.Font.Size ="8"
		.Font.Bold = False
		.ParagraphFormat.Alignment=0
		.TypeText "TCS - "& gstrCustomerName &" Confidential"
		.TypeText vbCrLF
    End with
	footerText= cstr(date)
	oWord.Selection.TypeText footerText
	oDoc.Sections(1).Footers(1).PageNumbers.Add(2)  ' Adding page numbers
	'oWord.ActiveDocument.Saveas(gstrScreenShotDocument)
	'Swicth back to the main document
	oDoc.ActiveWindow.ActivePane.View.SeekView = wdSeekMainDocument

	oWord.ActiveDocument.Sections(1).Borders.Enable = True    ' Adding Border
	oSelection.TypeText vbcrlf
	oSelection.ParagraphFormat.Alignment=1

	Set objXml = CreateObject("Microsoft.XMLDOM")
	objXml.Load(gstrSummaryDetailsXMLPath & "\" & gstrSummaryDetailsXMLName)
	Set objCurrentIteration = objXml.SelectSingleNode("//Iteration[@id='" & giCurrentIteration & "']")
	Set objTestList = objCurrentIteration.SelectNodes("TestCase")

	Const END_OF_STORY = 6
	Set objSelection = oSelection
	If gblnScenarioMode and objTestList.Length = 1 Then
		objSelection.Font.Name = "Browallia New"
		objSelection.Font.Size = 22
		objSelection.Font.Color = RGB(58,58,60)
		objSelection.Font.Bold = True
		If scenarioName <> "" Then
			objSelection.TypeText "Training Manual for " & ScenarioName
		Else
			objSelection.TypeText "Training Manual for Scenario"		
		End If
	End If
	objSelection.TypeParagraph()	

	Set objTestList = Nothing
	Set objCurrentIteration = Nothing
	Set objXml = Nothing

	Set objRange = objSelection.Range
	oDoc.Tables.Add objRange, 3, 2
	Set objTable = oDoc.Tables(1)

	objTable.Range.Style = "Medium Shading 1 - Accent 5" 
	'objTable.Range.Style = "Light List - Accent 1"   '3
	objTable.Cell(1, 1).Range.ParagraphFormat.Alignment=0
	objTable.Cell(1, 1).Range.Font.Name = "Browallia New"
	objTable.Cell(1, 1).Range.Font.Size = 18
	objTable.Cell(1, 1).Range.Text = "Test Case Name"

	objTable.Cell(1, 1).Range.Font.Name = "Browallia New"
	objTable.Cell(1, 2).Range.ParagraphFormat.Alignment=0
	objTable.Cell(1, 2).Range.Font.Size = 18
	objTable.Cell(1, 2).Range.Text = strTestCaseName


	objTable.Cell(2, 1).Range.Font.Size = 14
	objTable.Cell(2, 1).Range.Font.Name = "Browallia New"
	objTable.Cell(2, 1).Range.ParagraphFormat.Alignment=0
	objTable.Cell(2, 1).Range.Text = "Description"

	objTable.Cell(2, 2).Range.Font.Size = 14
	objTable.Cell(2, 2).Range.Font.Name = "Browallia New"
	objTable.Cell(2, 2).Range.ParagraphFormat.Alignment=0
	objTable.Cell(2, 2).Range.ParagraphFormat.Alignment=0
	objTable.Cell(2, 2).Range.Text = gstrTCDescription

	objTable.Cell(3, 1).Range.Font.Size = 14
	objTable.Cell(3, 1).Range.Font.Name = "Browallia New"
	objTable.Cell(3, 1).Range.ParagraphFormat.Alignment=0
	objTable.Cell(3, 1).Range.Text = "Pre-Requisites"

	objTable.Cell(3, 2).Range.Font.Name = "Browallia New"
	objTable.Cell(3, 2).Range.Font.Size = 14
	objTable.Cell(3, 2).Range.ParagraphFormat.Alignment=0
	objTable.Cell(3, 2).Range.Text = gstrTCPrerequisite

	objSelection.EndKey END_OF_STORY
	objSelection.TypeParagraph()

	'objSelection.TypeText "Table 2"
	objSelection.TypeParagraph()

	Set objRange = objSelection.Range
	oDoc.Tables.Add objRange, 2, 1

	Set objTable = oDoc.Tables(2)
	objTable.Range.Style = "Light List - Accent 1"   '3
	objTable.Cell(1, 1).Range.Font.Size = 18
	objTable.Cell(1, 1).Range.ParagraphFormat.Alignment=1
	objTable.Cell(1, 1).Range.Text = "Step Details"
	'
	'								
	objSelection.EndKey END_OF_STORY
	objSelection.TypeParagraph()'	

	strTrainingDocFileName = gstrIterationResultFolder &"\" &  gstrTestCaseName &"_" & gstrTrainingDocFileName &"_"& RandomNumber(RandomNumber(1,50),99) & "_" & giTestCaseNumber
	If Len(strTrainingDocFileName)>251 Then
		strTrainingDocFileName=Left(strTrainingDocFileName,251)
	End If
	gstrScreenShotDocument=  strTrainingDocFileName  & ".doc"
	gstrScreenShotDocumentPDF = strTrainingDocFileName & ".pdf"
	oWord.ActiveDocument.Saveas(gstrScreenShotDocument)
	oWord.Quit
	Set oWord=nothing
	giStepCounterForTrainingDoc = 0   ' Assigning Value zero to start the counter for step marking in training doc
End If
End Function
''*******************************************************************************************************************************************
'Name of the Function : CreateScreenshotDoc_OpenOffice
'Author		    : 
'Date			  :
'Description	    : This will  Open office  document  with screnshots images in it
'Input Parameters	    : test case name
'Output Parameters    : None
'*******************************************************************************************************************************************

Public Function CreateScreenshotDoc_OpenOffice(strTestCaseName)
	If blnShowNotification Then BalloonTooltip.Show "TASE Automation","Executing Now: CreateScreenshotDoc_OpenOffice" 
	Set oSM = CreateObject("com.sun.star.ServiceManager")				'Instanciate OOo : this line is mandatory with VB for OOo API
	Set oDesk = oSM.createInstance("com.sun.star.frame.Desktop")	'Create the first and most important service
	Set oDoc = oDesk.loadComponentFromURL("private:factory/swriter", "_blank", 0, array())				  				'Create a new doc
	Call oDoc.storeToURL(FileName2URL(gstrScreenShotDocument) , Array())
	'Close the doc
	oDoc.Close (True)
	Set oDoc = Nothing
End Function
