    strHtmlSummaryFile.writeline("<span class='value' value='" & (giPassIterationCount/giTotalIterationCount)*100 & "%'> " & giPassIterationCount & " </span>") 
    strHtmlSummaryFile.writeline("<div class='bar' style='background:green'></div>") 
    strHtmlSummaryFile.writeline("</li>") 
